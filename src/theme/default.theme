# -------------------------------------------------------------------------
# elev.popover — (Elev 5) menu, tooltip, context menu, drag ghost.
#
# NOT the drop-down list any more. A drop-down used to be one framed box
# on this rung with its rows kept inside it; it is now the anchor plus N
# separate elements, each dressed as the anchor is (`[button]`), with
# `[menu].anchor_gap` of background between them and nothing drawn around
# the group. The rung keeps its glosses for the objects that are still a
# single surface.
# -------------------------------------------------------------------------
[elev.popover]
# glass — two quads; skipped entirely while rank is 0
glass.rank           = 0                      # frost rank of the popover: 0 emits no blur() run at all · - · n, 0..3 (softness rank, NOT a mip index) · no derivation — raise to 1..3 for a family-B glass sheet; clamped by Gfx::glass_ranks()
