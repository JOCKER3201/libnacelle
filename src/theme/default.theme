border_width          = @border.edge.width    # stroke weight of the ring · 3 · str (device px, never panel-scaled) or same_as_parent · @border.edge.width -> @stroke.hair, i.e. the "solid 1x" of 5.18's table
border_color          = @border.default       # colour of the ring · 3 · colour or same_as_parent · -> @border.default -> alpha(@accent.primary, 0.78)
border_alpha          = 1.0                   # alpha multiplier on border_color · 3 · frac, 0..1 · opaque
fill                  = @surface.inset        # the interior · 3 · colour, none, or same_as_parent · 5.18's table
fill_alpha            = 1.0                   # alpha multiplier on fill · 3 · frac, 0..1 · opaque
fill_to               = @shape.key.fill       # the far stop of the interior gradient · 3 · colour · == fill, so the fill is flat
fill_angle            = 90deg                 # direction of the interior gradient · 3 · deg, 0..360 · ignored while fill_to == fill
round_segments        = @corner.segments      # arc tessellation of a round corner · 3 · n, 3 .. 16 · @corner.segments = 6, a 0.4px chord error at an 8px radius: invisible, and 6 quads instead of 16
glow                  = none                  # which glow class this preset's edge wears · 3 · @glow.<class> or none · no glow class fits this preset
dash                  = @border.edge.dash     # dash length along the ring · 3 · len · @border.edge.dash = 1.6u; used only when border_style = segmented
gap                   = @border.edge.gap      # gap length along the ring · 3 · len · @border.edge.gap = 0.8u; used only when border_style = segmented
phase                 = @border.edge.phase    # where the dash pattern starts on the ring · 3 · len · @border.edge.phase = 0u; used only when border_style = segmented
bracket_len           = @border.edge.bracket_len
                                              # length of each corner bracket · 3 · frac of the SHORTER SIDE of the host rect, clamped [0.8u, 4.0u] · @border.edge.bracket_len = 18%; used only when border_style = brackets
bracket_inset         = @border.edge.bracket_inset
                                              # how far the brackets sit inside the ring · 3 · len · @border.edge.bracket_inset = 0u; used only when border_style = brackets

# ---------------------------------------------------------------- shape.modal
# the settings modal
# 5.18's table names @stroke.regular for this preset's border. That
# heavier ring arrives through elev.modal.edge.width; writing it here as
# well would make default.theme emit its own override note at load
[shape.modal]
corners               = [ chamfer, @corner.lg ]
                                              # all four corners of the modal ring · - · [ style, len ] · enum: square | round | chamfer | chevron | hexagon · the same cut as a window frame
corners_tl            = [ same_as_parent, same_as_parent ]
                                              # the top-left corner alone · - · [ style, len ] · a slot left same_as_parent copies @shape.modal.corners
corners_tr            = [ same_as_parent, same_as_parent ]
                                              # the top-right corner alone · - · [ style, len ] · a slot left same_as_parent copies @shape.modal.corners
corners_br            = [ same_as_parent, same_as_parent ]
                                              # the bottom-right corner alone · - · [ style, len ] · a slot left same_as_parent copies @shape.modal.corners
corners_bl            = [ same_as_parent, same_as_parent ]
                                              # the bottom-left corner alone · - · [ style, len ] · a slot left same_as_parent copies @shape.modal.corners
border_style          = solid                 # how the ring is stroked · - · enum: solid | segmented | brackets | none · @border.edge.style; brackets draw only the corners and any preset may wear them (5.7)
border_width          = same_as_parent        # stroke weight of the ring · - · str (device px, never panel-scaled) or same_as_parent · reads elev.modal.edge.width
border_color          = same_as_parent        # colour of the ring · - · colour or same_as_parent · reads elev.modal.edge.color
border_alpha          = 1.0                   # alpha multiplier on border_color · - · frac, 0..1 · opaque
fill                  = same_as_parent        # the interior · - · colour, none, or same_as_parent · @elev.modal.fill -> @surface.panel
fill_alpha            = 1.0                   # alpha multiplier on fill · - · frac, 0..1 · opaque
fill_to               = @shape.modal.fill     # the far stop of the interior gradient · - · colour · == fill, so the fill is flat
fill_angle            = 90deg                 # direction of the interior gradient · - · deg, 0..360 · ignored while fill_to == fill
round_segments        = @corner.segments      # arc tessellation of a round corner · - · n, 3 .. 16 · @corner.segments = 6, a 0.4px chord error at an 8px radius: invisible, and 6 quads instead of 16
glow                  = @glow.panel_edge      # which glow class this preset's edge wears · - · @glow.<class> or none · every glow.*.enabled is false in default, so this reference costs nothing until a theme turns it on
dash                  = @border.edge.dash     # dash length along the ring · - · len · @border.edge.dash = 1.6u; used only when border_style = segmented
gap                   = @border.edge.gap      # gap length along the ring · - · len · @border.edge.gap = 0.8u; used only when border_style = segmented
phase                 = @border.edge.phase    # where the dash pattern starts on the ring · - · len · @border.edge.phase = 0u; used only when border_style = segmented
bracket_len           = @border.edge.bracket_len
                                              # length of each corner bracket · - · frac of the SHORTER SIDE of the host rect, clamped [0.8u, 4.0u] · @border.edge.bracket_len = 18%; used only when border_style = brackets
bracket_inset         = @border.edge.bracket_inset
                                              # how far the brackets sit inside the ring · - · len · @border.edge.bracket_inset = 0u; used only when border_style = brackets

# ---------------------------------------------------------------- shape.spare
# the one reserved preset slot, so a seventeenth shape needs no ABI break
[shape.spare]
corners               = [ square, 0u ]        # all four corners of the spare ring · - · [ style, len ] · enum: square | round | chamfer | chevron | hexagon · square and invisible until a theme claims it
corners_tl            = [ same_as_parent, same_as_parent ]
                                              # the top-left corner alone · - · [ style, len ] · a slot left same_as_parent copies @shape.spare.corners
corners_tr            = [ same_as_parent, same_as_parent ]
                                              # the top-right corner alone · - · [ style, len ] · a slot left same_as_parent copies @shape.spare.corners
corners_br            = [ same_as_parent, same_as_parent ]
                                              # the bottom-right corner alone · - · [ style, len ] · a slot left same_as_parent copies @shape.spare.corners
corners_bl            = [ same_as_parent, same_as_parent ]
                                              # the bottom-left corner alone · - · [ style, len ] · a slot left same_as_parent copies @shape.spare.corners
border_style          = none                  # how the ring is stroked · - · enum: solid | segmented | brackets | none · @border.edge.style; brackets draw only the corners and any preset may wear them (5.7)
border_width          = @border.edge.width    # stroke weight of the ring · - · str (device px, never panel-scaled) or same_as_parent · @border.edge.width -> @stroke.hair, i.e. the "solid 1x" of 5.18's table
border_color          = @border.default       # colour of the ring · - · colour or same_as_parent · -> @border.default -> alpha(@accent.primary, 0.78)
border_alpha          = 1.0                   # alpha multiplier on border_color · - · frac, 0..1 · opaque
fill                  = none                  # the interior · - · colour, none, or same_as_parent · no fill, so an unclaimed slot draws nothing at all
fill_alpha            = 1.0                   # alpha multiplier on fill · - · frac, 0..1 · opaque
fill_to               = @shape.spare.fill     # the far stop of the interior gradient · - · colour · == fill, so the fill is flat
fill_angle            = 90deg                 # direction of the interior gradient · - · deg, 0..360 · ignored while fill_to == fill
round_segments        = @corner.segments      # arc tessellation of a round corner · - · n, 3 .. 16 · @corner.segments = 6, a 0.4px chord error at an 8px radius: invisible, and 6 quads instead of 16
glow                  = none                  # which glow class this preset's edge wears · - · @glow.<class> or none · no glow class fits this preset
dash                  = @border.edge.dash     # dash length along the ring · - · len · @border.edge.dash = 1.6u; used only when border_style = segmented
gap                   = @border.edge.gap      # gap length along the ring · - · len · @border.edge.gap = 0.8u; used only when border_style = segmented
phase                 = @border.edge.phase    # where the dash pattern starts on the ring · - · len · @border.edge.phase = 0u; used only when border_style = segmented
bracket_len           = @border.edge.bracket_len
                                              # length of each corner bracket · - · frac of the SHORTER SIDE of the host rect, clamped [0.8u, 4.0u] · @border.edge.bracket_len = 18%; used only when border_style = brackets
bracket_inset         = @border.edge.bracket_inset
                                              # how far the brackets sit inside the ring · - · len · @border.edge.bracket_inset = 0u; used only when border_style = brackets
# TODO(default): chosen here, spec silent. 5.18's table leaves
# shape.spare's three columns as em dashes; square + no border + no fill
# is the only value set that draws nothing at all, which is what an
# unclaimed slot must do.

# ---------------------------------------------------------------- preset-specific
# Five keys that exist on one preset each. A tab is a rect whose TOP corners
# are shaped, whose bottom corners are square and one of whose edges is
# skipped so it fuses with its strip; a chevron is the rect with one or both
# vertical ends collapsed to a point at mid-height, and at chevron_depth =
# 100% with dir = right it is also image 9's solid `>` paging arrow -
# GEOMETRY, NOT A FONT GLYPH, deliberately, so an arrow that must match the
# border colour and width exactly does so.
[shape.tab]
slant                 = 0u                    # horizontal inset at the top, per side · 1, 2 · len, 0u .. 4u · 0u = a plain rect; above 0 the ring becomes a trapezoid BEFORE corners are applied
open                  = bottom                # which edge of the frame is not drawn · 1, 2 · enum: none | bottom | top | left | right · bottom, so the tab fuses with the strip it sits on

[shape.taskbar]
chevron_depth         = 50%                   # how far each end collapses toward mid-height · 7, 9 · frac of the HEIGHT, per end · at 100% with dir = right this preset is image 9's solid paging arrow
chevron_dir           = both                  # which ends are collapsed · 7 · enum: left | right | both · both, image 7's stretched chevron taskbar

[shape.hex]
orientation           = pointy                # which way the hexagon's vertex points · 1, 3 · enum: pointy | flat · pointy, image 1's five hexagons

# TODO(default): chosen here, spec silent - three items in the block above.
#   1. 5.18's heading sums the family as 16 x 18 + 5 = 293, but the per-preset
#      list it prints holds twenty tokens once corners_tl/tr/br/bl are counted
#      as the four keys they are. This fragment writes all twenty, so shape.*
#      is 16 x 20 + 5 = 325 keys. Lead: the count in the heading needs fixing,
#      not the file.
#   2. SETTLED 2026-08-17 (vector K6): `chevron` and `hexagon` are written as
#      corner STYLE words even though 5.18's CornerStyle enum lists only
#      Square/Round/Chamfer. Neither of the two ways out this note proposed
#      was taken. The words name a SHAPE KIND, which the draw record has
#      carried a field for since K3 (bits 8-11), and CornerStyle stays the
#      three cuts a corner can take; view::paint::preset reads the corners
#      word once, hands the kind to the record and the cut to the corners.
#      No new key, no fourth cut, and no preset table to keep in step.
#      A shape word on a PER-CORNER key means nothing — one corner of a
#      hexagon is not a shape — and falls back to this preset's own cut.
#   3. fill_to defaults to this preset's own fill (flat) rather than to a
#      sentinel, so `fill_to == fill => flat` from 5.20 holds by construction.

# =========================================================================
# icon - an icon FONT is the primary path, entering through the existing R8
# atlas, because tinting is then a vertex colour and image 4 (everything red)
# costs nothing. A baked RGBA sprite sheet cannot be re-skinned and would need
# one sheet per hue; SVG tessellation buys resolution independence the atlas
# already provides and costs usvg + lyon.
# 
# The RGBA ImageId path is retained and RESTRICTED to photographs and
# non-themeable artwork - LIVE FEED thumbnails, avatars, the video-call tile,
# app logos, wallpaper. Image 4 keeps its LIVE FEED thumbnail in natural
# photographic colour, which is exactly the boundary: anything the theme must
# be able to recolour is a GLYPH; anything that must keep its own colour is an
# IMAGE.
# 
# NAMES, NOT CODEPOINTS. A widget names an icon; the name resolves to a
# codepoint once, at theme load, into a sorted [(u32 name_hash, u32 cp); N]
# table, and at draw time the widget passes an IconId(u32) it obtained once.
# No string reaches a draw call. Unmapped names fall back to the compiled-in
# polyline set glyph by glyph, so a partial icon font is legal and useful.
# =========================================================================

[icon]
size.xs               = 1.8u                  # inline glyph beside a label · 1, 7 · len · no derivation; a ladder step
size.sm               = 2.2u                  # list-row and status glyph · 1, 7 · len · no derivation; a ladder step
size.md               = 3.6u                  # the default icon size, toolbar and tile glyphs · 1, 8 · len · no derivation; a ladder step
size.lg               = 5.2u                  # taskbar button glyph above its caption · 9 · len · no derivation; a ladder step
size.launcher         = 7.2u                  # the launcher grid's app glyphs · 1 · len · no derivation; the largest step
stroke                = 0.10em                # line weight of the BUILT-IN VECTOR FALLBACK only · - · em, 0.02em .. 0.30em · a wart, and it says so: with an icon font the stroke is baked into the outlines. The resolver WARNS rather than silently ignoring when a theme sets this while an icon font is live; a theme wanting heavier icons ships a heavier icon font
stroke_thin           = @stroke.hair          # hairline rules inside an icon: document lines, chart ticks · 8 · str · @stroke.hair -> 1 device px at 1080p and 1440p
baseline_shift        = 0.18em                # vertical nudge that optically centres a glyph on body x-height · 1, 7 · em · no derivation; a glyph box centred on the line box sits visually high
color                 = @accent.primary       # the single-layer icon colour · 1-10 · colour · -> @palette.accent, so every glyph in the interface re-skins with one line
duo1                  = @accent.primary       # layer 1 of a two-layer icon · 8 · colour · the theme's own hue
duo2                  = @accent.dim           # layer 2 of a two-layer icon · 8 · colour · lum(@accent.primary, 0.62): the same hue, dimmer. NOTE this pair cannot make image 8's YELLOW-AND-BLUE folder - see the worked example below
alpha                 = 1.0                   # constant alpha on every icon · 1-10 · frac, 0..1 · opaque
container             = none                  # whether an icon is drawn inside a box at all · 1 · enum: none | square | hex | circle | tile · A STYLE, NOT A LENGTH. Image 1's "each icon in its own bordered square" is container = square
container_size        = @icon.size.md         # the container box's side · 1 · len · THIS is what inset_ratio is a ratio of
container_shape       = @shape.icon_tile      # which shape preset draws the container · 1 · shape · -> shape.icon_tile: round 0.7u, solid 1x at 0.45 alpha
container_pad         = 0.35em                # space between the container's ring and the glyph · 1 · em · no derivation
container_fill        = @surface.raised       # the container's interior · 1 · colour · the level that floats above a panel
container_border      = @stroke.hair          # the container's ring weight · 1 · str · @stroke.hair -> 1 device px
active_color          = @accent.warm          # glyph colour of the ACTIVE item · 8 · colour · -> @severity.warning.text: image 8's ORANGE HOME among cyan neighbours
active_fill           = alpha(@accent.warm, 0.15)
                                              # container fill of the active item · 8 · colour · the same warm hue at a fill's alpha
active_border         = @accent.warm          # container ring of the active item · 8 · colour · @accent.warm
disabled_alpha        = 0.30                  # alpha of an icon whose control is disabled · - · frac, 0..1 · no derivation; the state ladder's disabled row multiplies this
inset_ratio           = 0.27x @icon.container_size
                                              # glyph box inside its container · 1 · rat of @icon.container_size · unified from today's 0.26 / 0.28 / 0.26. The old right-hand side, `container`, was an ENUM, so the ratio had no length to be a ratio of
fallback              = builtin               # what draws a name the icon font does not map · 1, 8, 9 · enum: builtin | none · the compiled-in polyline set: ~40 names as 8-20-point recipes, ~1.5 kB of const data, so the ICONS never vanish - a panel of empty boxes reads as breakage
max_layers            = 3                     # hard cap on layers per icon · 8 · n, 1 .. 3 · beyond three an icon is artwork and belongs on the image path

# TODO(default): chosen here, spec silent. 5.19 says "25 controls" and its
#   table prints twenty-three. icon.fallback and icon.max_layers are the two
#   the prose describes but never names: "unmapped names fall back to the
#   built-in vector set" and "hard cap 3". Lead: confirm the spellings.

# =========================================================================
# icon.<name>.layers - the 64 icon slots. ICON_COUNT = 64: forty required
# names, every one traceable to an image, plus twenty-four reserved slots a
# theme fills with its own.
# 
# A LAYER MAY NAME ANY COLOUR TOKEN, INCLUDING AN INDEXED ONE. IconDef stores
# layer_color: [u32; 3] as ColorToken ids, and ColorToken covers the eight data
# series and the sixteen ANSI slots as contiguous ranges (DataSeries0..7,
# TermAnsi0..15 - 7.1), so @data.series[3] and @term.ansi[4] are legal here and
# legal as a type.<role>.fg. Without that an icon layer could reach about 150
# of the ~174 colours the engine resolves and nobody could say which 24 were
# missing.
# 
# THE FOLDER IS THE WORKED TWO-HUE EXAMPLE and every other multi-layer icon is
# copied from it. icon.duo1/duo2 are one hue in two lightnesses and cannot
# produce image 8's YELLOW-AND-BLUE folder; two data-series slots can, and both
# still re-skin when palette.data changes.
# =========================================================================

[icon]
chip.layers           = [ U+E200 @icon.color ]
                                              # the PROCESOR row's glyph · 1, 7 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
cpu.layers            = [ U+E201 @icon.color ]
                                              # the CPU panel and launcher tile · 1 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
gpu.layers            = [ U+E202 @icon.color ]
                                              # the GPU panel · 1 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
memory.layers         = [ U+E203 @icon.color ]
                                              # the PAMIEC row's glyph · 1, 7 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
disk.layers           = [ U+E204 @icon.color ]
                                              # storage rows and the data archive tile · 1, 8 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
wifi.layers           = [ U+E205 @icon.color ]
                                              # the SIEC row's glyph · 1, 7 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
network.layers        = [ U+E206 @icon.color ]
                                              # the NETWORK panel and tile · 1 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
signal_bars.layers    = [ U+E207 @icon.color ]
                                              # the NETWORK STATUS panel's signal glyph · 1 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
bolt.layers           = [ U+E208 @icon.color ]
                                              # the ENERGIA row's YELLOW lightning · 1, 7 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
battery.layers        = [ U+E209 @icon.color ]
                                              # charge state beside the energy row · 7 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
phone.layers          = [ U+E20A @icon.color ]
                                              # the STATUS SIECI panel's phone glyph · 1 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
video.layers          = [ U+E20B @icon.color ]
                                              # the POLACZENIE AKTYWNE video-call tile · 7, 8 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
lock.layers           = [ U+E20C @icon.color ]
                                              # the SYSTEM LOCKDOWN button's padlock · 5 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
unlock.layers         = [ U+E20D @icon.color ]
                                              # the released state of the padlock · 5 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
home.layers           = [ U+E20E @icon.color ]
                                              # image 8's ORANGE active taskbar icon · 8 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
search.layers         = [ U+E20F @icon.color ]
                                              # the SZUKAJ taskbar button and the search field · 7, 8, 9 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
folder.layers         = [ U+E210 @data.series[7], U+E211 @data.series[2] ]
                                              # image 8's folder: body amber, tab blue · 8 · list of at most 3 (codepoint, colour) layers · two data-series slots, so the folder is two independent hues in every seed and still re-skins when palette.data changes
folder_open.layers    = [ U+E212 @data.series[7], U+E213 @data.series[2] ]
                                              # the opened folder, same two hues · 8 · list of at most 3 (codepoint, colour) layers · copied from folder.layers - this is the pattern every multi-layer icon follows
document.layers       = [ U+E214 @icon.duo1 ] # the document beside the folders · 8 · list of at most 3 (codepoint, colour) layers · one layer: follows the accent through @icon.duo1
archive.layers        = [ U+E215 @icon.color ]
                                              # the DATA ARCHIVE launcher tile · 1, 8 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
menu.layers           = [ U+E216 @icon.color ]
                                              # the START taskbar button's hamburger · 7, 8, 9 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
terminal.layers       = [ U+E217 @icon.color ]
                                              # the TERMINAL launcher tile · 1 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
files.layers          = [ U+E218 @icon.color ]
                                              # the FILES launcher tile · 1 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
star_map.layers       = [ U+E219 @icon.color ]
                                              # the STAR MAP launcher tile · 1 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
planet.layers         = [ U+E21A @icon.color ]
                                              # the planet behind the station render · 1, 7 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
ship.layers           = [ U+E21B @icon.color ]
                                              # the small ship silhouette at the render's right · 1 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
radar.layers          = [ U+E21C @icon.color ]
                                              # the DANE NAWIGACYJNE reticle's own glyph · 1 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
gear.layers           = [ U+E21D @icon.color ]
                                              # the PREFERENCJE SYSTEMOWE gear button · 1 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
sliders.layers        = [ U+E21E @icon.color ]
                                              # the PREFERENCJE SYSTEMOWE sliders button · 1 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
equalizer.layers      = [ U+E21F @icon.color ]
                                              # the PREFERENCJE SYSTEMOWE equalizer button · 1 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
globe.layers          = [ U+E220 @icon.color ]
                                              # the two globe buttons and the wireframe globe · 1, 7 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
user.layers           = [ U+E221 @icon.color ]
                                              # a crew row with no photograph · 1 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
avatar.layers         = [ U+E222 @icon.color ]
                                              # the STATUS ZALOGI avatar ring · 1 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
heart.layers          = [ U+E223 @icon.color ]
                                              # image 6's cyan vitality glyphs, the healthy CREW STATUS · 6 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
bell.layers           = [ U+E224 @icon.color ]
                                              # POWIADOMIENIA (4 NOWE) · 7, 9 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
alert.layers          = [ U+E225 @icon.color ]
                                              # the ALERT: line and the KRYTYCZNY ALARM half of the top bar · 1, 4, 7 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
close.layers          = [ U+E226 @icon.color ]
                                              # the window control X · 1, 7 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
minimize.layers       = [ U+E227 @icon.color ]
                                              # the window control _ · 1 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
maximize.layers       = [ U+E228 @icon.color ]
                                              # the window control [] · 1 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary
chevron.layers        = [ U+E229 @icon.color ]
                                              # image 9's < > paging arrows · 9 · list of at most 3 (codepoint, colour) layers · one layer at @icon.color -> @accent.primary

# --- the reserved slots. ICON_COUNT = 64. An empty list draws nothing;
# --- fill one and a widget can name it like any of the forty above. Of the
# --- original twenty-four, six are claimed by name (arrow_left/up/right/down,
# --- power below, link_badge at the end); spare05-spare22 remain.
arrow_left.layers     = []                    # the on-screen keyboard's ← cursor cap · 3, 5 · list of at most 3 (codepoint, colour) layers · claims reserved slot 0 so ICON_COUNT stays 64; empty keeps the keyboard's own drawn triangle at keyboard.arrow_size in the key rung's glyph colour — a theme fills this to replace the mark with a glyph (the icon.link_badge.layers pattern)
arrow_up.layers       = []                    # the on-screen keyboard's ↑ cursor cap · 3, 5 · list of at most 3 (codepoint, colour) layers · claims reserved slot 1 so ICON_COUNT stays 64; empty keeps the drawn triangle, as arrow_left.layers documents
arrow_right.layers    = []                    # the on-screen keyboard's → cursor cap · 3, 5 · list of at most 3 (codepoint, colour) layers · claims reserved slot 2 so ICON_COUNT stays 64; empty keeps the drawn triangle, as arrow_left.layers documents
arrow_down.layers     = []                    # the on-screen keyboard's ↓ cursor cap · 3, 5 · list of at most 3 (codepoint, colour) layers · claims reserved slot 3 so ICON_COUNT stays 64; empty keeps the drawn triangle, as arrow_left.layers documents
power.layers          = []                    # the control panel's EXIT glyph slot (u2 §2.12: power beside the caption; gear.layers is SETTINGS') · 5, 9 · list of at most 3 (codepoint, colour) layers · claims reserved slot 4 so ICON_COUNT stays 64; empty keeps the control widget's own drawn power mark at button.icon_size in the button rung's glyph colour — a theme fills this to replace it with a glyph
spare05.layers        = []                    # reserved icon slot 5 · - · list of at most 3 (codepoint, colour) layers · empty; the theme that claims it writes [ U+E22F @icon.color ]
spare06.layers        = []                    # reserved icon slot 6 · - · list of at most 3 (codepoint, colour) layers · empty; the theme that claims it writes [ U+E230 @icon.color ]
spare07.layers        = []                    # reserved icon slot 7 · - · list of at most 3 (codepoint, colour) layers · empty; the theme that claims it writes [ U+E231 @icon.color ]
spare08.layers        = []                    # reserved icon slot 8 · - · list of at most 3 (codepoint, colour) layers · empty; the theme that claims it writes [ U+E232 @icon.color ]
spare09.layers        = []                    # reserved icon slot 9 · - · list of at most 3 (codepoint, colour) layers · empty; the theme that claims it writes [ U+E233 @icon.color ]
spare10.layers        = []                    # reserved icon slot 10 · - · list of at most 3 (codepoint, colour) layers · empty; the theme that claims it writes [ U+E234 @icon.color ]
spare11.layers        = []                    # reserved icon slot 11 · - · list of at most 3 (codepoint, colour) layers · empty; the theme that claims it writes [ U+E235 @icon.color ]
spare12.layers        = []                    # reserved icon slot 12 · - · list of at most 3 (codepoint, colour) layers · empty; the theme that claims it writes [ U+E236 @icon.color ]
spare13.layers        = []                    # reserved icon slot 13 · - · list of at most 3 (codepoint, colour) layers · empty; the theme that claims it writes [ U+E237 @icon.color ]
spare14.layers        = []                    # reserved icon slot 14 · - · list of at most 3 (codepoint, colour) layers · empty; the theme that claims it writes [ U+E238 @icon.color ]
spare15.layers        = []                    # reserved icon slot 15 · - · list of at most 3 (codepoint, colour) layers · empty; the theme that claims it writes [ U+E239 @icon.color ]
spare16.layers        = []                    # reserved icon slot 16 · - · list of at most 3 (codepoint, colour) layers · empty; the theme that claims it writes [ U+E23A @icon.color ]
spare17.layers        = []                    # reserved icon slot 17 · - · list of at most 3 (codepoint, colour) layers · empty; the theme that claims it writes [ U+E23B @icon.color ]
spare18.layers        = []                    # reserved icon slot 18 · - · list of at most 3 (codepoint, colour) layers · empty; the theme that claims it writes [ U+E23C @icon.color ]
spare19.layers        = []                    # reserved icon slot 19 · - · list of at most 3 (codepoint, colour) layers · empty; the theme that claims it writes [ U+E23D @icon.color ]
spare20.layers        = []                    # reserved icon slot 20 · - · list of at most 3 (codepoint, colour) layers · empty; the theme that claims it writes [ U+E23E @icon.color ]
spare21.layers        = []                    # reserved icon slot 21 · - · list of at most 3 (codepoint, colour) layers · empty; the theme that claims it writes [ U+E23F @icon.color ]
spare22.layers        = []                    # reserved icon slot 22 · - · list of at most 3 (codepoint, colour) layers · empty; the theme that claims it writes [ U+E240 @icon.color ]
link_badge.layers     = []                    # the symlink marker on a file tile · 8 · list of at most 3 (codepoint, colour) layers · claims reserved slot 23 so ICON_COUNT stays 64; empty keeps the filesystem widget's own drawn diagonal tick in component.file.glyph_link — a theme fills this to replace the mark with a glyph

# TODO(default): chosen here, spec silent. 5.19 fixes only three codepoints -
#   folder U+E210/U+E211, folder_open U+E212/U+E213, document U+E214 - so the
#   other thirty-seven names are laid out around them from U+E200 upward and
#   the reserved slots continue at U+E22A. Any icon font shipped with a theme
#   must agree with icons.map, not with this file; these are the built-in
#   fallback set's own codepoints.

# =========================================================================
# ornament - the decorative vocabulary, seven families. Two classes:
#   T  the theme switches it on and the toolkit draws it, no widget involved
#   B  the theme owns appearance, the widget owns data and anchors
# 
# EXPLICITLY NOT ORNAMENTS: PCB traces, vignette, scanlines, noise, ribbon
# waves, grid, glass, glow, reflection. Those are decor.* and elev.* (5.12,
# 5.15) and live in another part of this file.
# 
# THREE TOKENS HERE ARE CYCLIC ANIMATION SOURCES and are counted against
# motion.idle_cap exactly as if they were motion ids (5.22):
# ornament.reticle.sweep + sweep_period, ornament.dump.refresh_hz and
# ornament.node.pulse. They carry the is_cyclic bit in the generated token
# table. A radar that sweeps forever costs the same idle CPU as a glow that
# breathes forever, and the fact that it is spelled ornament.* rather than
# motion.* does not change the electricity bill.
# =========================================================================

# ---------------------------------------------------------------- leader (B)
# Image 1's lines pointing at features of the station render, labelled
# DAMAGE BREACH in orange and UNIDENTIFIED UNIT (I45) in dim mint. The
# widget supplies (anchor_xy, side, text, severity) and the COLOUR COMES
# FROM THE SEVERITY INDEX - that is how DAMAGE BREACH is orange in a mint
# theme with no per-widget editing.
[ornament.leader]
width                 = @stroke.hair          # the line itself · 1 · str · @stroke.hair -> 1 device px at 1080p and 1440p
color                 = @accent.primary / 0.75
                                              # the line's colour when no severity is supplied · 1 · colour · alpha(@accent.primary, 0.75); a severity index overrides it at draw time
style                 = elbow                 # how the line gets from the anchor to the label · 1 · enum: straight | elbow · elbow, image 1: out from the feature, then horizontal to the text
elbow_ratio           = 0.65                  # where along the run the elbow turns · 1 · frac, 0..1 · no derivation; 0.65 puts the corner past the midpoint so the horizontal leg carries the label
dot_radius            = 0.45u                 # the marker sitting on the anchor point · 1 · len · no derivation
dot_style             = filled                # how that marker is drawn · 1 · enum: filled | ring | none · no derivation
label_role            = leader.label          # type role the label is set in · 1 · role · -> type.leader.label: ui 1.82u, 0.150em, upper
label_gap             = 0.45em                # space between the line's end and the label · 1 · em · no derivation
label_rule            = true                  # draw a short rule under the label · 1 · bool · the rule is what makes a floating label read as attached to its line
label_color           = @text.muted           # label colour when no severity is supplied · 1 · colour · -> the dim mint of UNIDENTIFIED UNIT (I45)

# ---------------------------------------------------------------- scale (B)
# Image 7's left-edge vertical measuring scale: tick marks and numbers,
# purely instrumental decoration that gives the glass an edge to be
# measured against.
[ornament.scale]
orientation           = vertical              # which way the scale runs · 7 · enum: vertical | horizontal · vertical, image 7's left edge
major_len             = 2.2u                  # length of a labelled tick · 7 · len · no derivation
minor_len             = 0.9u                  # length of an unlabelled tick · 7 · len · no derivation
minor_per_major       = 4                     # minor ticks between two majors · 7 · n, 1 .. 20 · no derivation
width                 = @stroke.hair          # every tick's weight · 7 · str · @stroke.hair -> 1 device px
color                 = @accent.primary       # tick colour · 7 · colour · -> @palette.accent
major_alpha           = 0.85                  # alpha of a labelled tick · 7 · frac, 0..1 · no derivation
minor_alpha           = 0.40                  # alpha of an unlabelled tick · 7 · frac, 0..1 · less than half of major_alpha, so the majors count themselves
label_role            = data                  # type role the numbers are set in · 7 · role · -> type.data: mono 1.87u, tabular, so the column does not shiver
label_every           = 1                     # label every Nth major tick · 7 · n, 1 .. 10 · no derivation
label_gap             = 0.40em                # space between tick and number · 7 · em · no derivation
side                  = near                  # which side of the rail the ticks grow toward · 7 · enum: near | far | both · near, image 7: the ticks point into the screen
pitch                 = 2u                    # distance between two minor ticks · 7 · len · no derivation

# ---------------------------------------------------------------- node (B)
# Image 1's NETWORK STATUS node graph and image 8's SYMULACJE AI neural
# net: dots joined by thin lines.
[ornament.node]
radius                = 0.6u                  # a node dot's radius · 1, 8 · len · no derivation
shape                 = square                # the dot's outline · 1, 8 · enum: square | round · square, image 1: a square dot at this size costs 2 triangles and reads sharper than a 6-gon
fill                  = @accent.primary       # the dot's interior · 1, 8 · colour · -> @palette.accent
fill_alpha            = 0.90                  # alpha of the interior · 1, 8 · frac, 0..1 · no derivation
border                = 0                     # how many concentric rings the dot wears · 1, 8 · n, 0 .. 3 · 0 = none; the graph reads from its dots, not from their outlines
edge_width            = @stroke.hair          # weight of the lines joining the dots · 1, 8 · str · @stroke.hair -> 1 device px
edge_color            = @accent.primary       # colour of those lines · 1, 8 · colour · -> @palette.accent
edge_alpha            = 0.35                  # alpha of those lines · 1, 8 · frac, 0..1 · well under fill_alpha so the nodes sit in front of their edges
pulse                 = 0.0hz                 # rate at which a node's ALPHA breathes · 1, 8 · hz, 0hz .. 4hz · 0hz = static. IS_CYCLIC: counted against motion.idle_cap (5.22). PULSE MODULATES ALPHA ONLY, NEVER RADIUS - modulating radius would re-tessellate and would look like a bug on a static graph

# ---------------------------------------------------------------- hex (B)
# Image 1's five gradient hexagons under MONITOR ZASOBOW; image 3's solid
# ones. Image 3's theme sets fill_to = fill and gets flat fills - the
# gradient itself is free, being per-vertex colour on a 6-triangle fan.
[ornament.hex]
size                  = 5u                    # circumradius of one cell · 1, 3 · len · no derivation
gap                   = 1u                    # space between two cells · 1, 3 · len · no derivation
cols                  = 5                     # cells per row · 1, 3 · n, 1 .. 16 · image 1 shows five
fill                  = @accent.primary / 0.85
                                              # the near stop of the cell gradient · 1, 3 · colour · alpha(@accent.primary, 0.85)
fill_to               = @accent.primary / 0.15
                                              # the far stop of the cell gradient · 1, 3 · colour · alpha(@accent.primary, 0.15); SET fill_to = fill FOR IMAGE 3's FLAT CELLS
fill_angle            = 90deg                 # direction of the cell gradient · 1 · deg, 0..360 · vertical, image 1
empty_alpha           = 0.12                  # alpha of a cell that carries no value · 1, 3 · frac, 0..1 · faint enough to read as a slot rather than a reading
caption_role          = caption               # type role of the tiny label under the row · 1 · role · -> type.caption: ui 1.77u, 0.200em, upper - image 1's NETWORK
caption_gap           = @space.1              # space between the row and its caption · 1 · len · @space.1 = 0.5u
glow                  = @glow.hexagon         # which glow class a cell wears · 1 · @glow.<class> or none · glow.hexagon.enabled is false in default, so this costs nothing until a theme turns it on

# ---------------------------------------------------------------- reticle (T)
# Image 1's DANE NAWIGACYJNE radar. Cost: 144 ring quads + 24 ticks + an
# ~8-triangle sweep fan, drawn at most twice per screen; the sweep's
# trailing fade is a per-vertex alpha ramp and is free.
[ornament.reticle]
rings                 = 3                     # concentric range rings · 1 · n, 1 .. 8 · no derivation
ring_width            = @stroke.hair          # weight of a ring · 1 · str · @stroke.hair -> 1 device px
ring_color            = @accent.primary       # colour of a ring · 1 · colour · -> @palette.accent
ring_alpha            = 0.45                  # alpha of a ring · 1 · frac, 0..1 · no derivation
ring_segments         = 48                    # polyline segments per ring · 1 · n, 12 .. 128 · 48 keeps a 100px ring's chord error under a quarter pixel
ticks                 = 24                    # bearing ticks around the outer ring · 1 · n, 0 .. 72 · 24 = one every 15 degrees
tick_len              = 0.7u                  # length of a bearing tick · 1 · len · no derivation
tick_every            = 6                     # every Nth tick is drawn long · 1 · n, 1 .. 12 · 6 of 24 = the four cardinals
crosshair             = true                  # draw the two axes through the centre · 1 · bool · no derivation
crosshair_alpha       = 0.30                  # alpha of those axes · 1 · frac, 0..1 · under ring_alpha: the crosshair locates, the rings measure
sweep                 = true                  # draw the rotating sweep wedge · 1 · bool · IS_CYCLIC: counted against motion.idle_cap (5.22)
sweep_arc             = 40deg                 # angular width of the wedge · 1 · deg, 5deg .. 180deg · no derivation
sweep_period          = 4.0s                  # one full revolution · 1 · s, 0.5s .. 30s · IS_CYCLIC: counted against motion.idle_cap (5.22)
sweep_color           = @accent.primary       # colour at the wedge's leading edge · 1 · colour · -> @palette.accent
sweep_alpha           = 0.55                  # alpha at the wedge's leading edge · 1 · frac, 0..1 · the trailing fade to 0 is a per-vertex alpha ramp

# ---------------------------------------------------------------- dump (T)
# Image 9's hexadecimal margins, labelled BAZA DANYCH and STATUS - pure
# instrument decoration filling otherwise dead margin. source = random is
# DELIBERATE: this is decoration a THEME turns on, and requiring a widget
# to exist for it would mean the layout has to change to change the look,
# which contradicts "the same layout re-skinned six times by changing the
# palette alone". The content comes from a seeded PRNG in the toolkit;
# churn and refresh_hz keep the cost to a few dozen character replacements
# per second. IT IS OFF IN DEFAULT, IT MUST ALWAYS CARRY ITS HEADING, AND
# IT MUST NEVER BE RENDERED IN A COLOUR ROLE OTHER THAN text.instrument -
# which is contrast-exempt precisely because it is non-informational.
[ornament.dump]
role                  = data.dump             # type role the characters are set in · 9 · role · -> type.data.dump: mono 1.35u, -0.020em, upper, leading 1.05, alpha 0.45
source                = off                   # where the characters come from · 9 · enum: off | random | telemetry · OFF IN DEFAULT. random = a seeded PRNG in the toolkit; telemetry = real numbers a widget supplies
seed                  = 0                     # PRNG seed, so a theme's margin is reproducible · 9 · n · no derivation
alphabet              = "0123456789ABCDEF"    # the characters drawn from · 9 · text · hexadecimal, image 9
col_cells             = 9                     # mono cells per column · 9 · n, 2 .. 32 · no derivation
gutter_cells          = 1                     # mono cells between two columns · 9 · n, 0 .. 8 · no derivation
width                 = 24u                   # total width of the margin block · 9 · len · no derivation
color                 = @text.instrument      # the characters' colour · 9 · colour · -> the 1.87:1 role that is contrast-exempt BECAUSE IT CARRIES NO INFORMATION. Do not set this to anything else
alpha                 = 0.45                  # alpha on top of that colour · 9 · frac, 0..1 · the same 0.45 type.data.dump.alpha carries
refresh_hz            = 2.0hz                 # how often the block churns · 9 · hz, 0hz .. 10hz · IS_CYCLIC: counted against motion.idle_cap (5.22)
churn                 = 0.06                  # fraction of characters replaced per refresh · 9 · frac, 0..1 · 0.06 of a 9-cell column is under one character: the block shimmers rather than flickers
label_role            = label.section         # type role of the block's heading · 9 · role · -> type.label.section: ui 2.03u, 0.180em, upper - image 9's BAZA DANYCH
heading               = true                  # draw that heading · 9 · bool · MUST STAY TRUE: an unlabelled block of moving hex reads as a fault, not as decoration

# ---------------------------------------------------------------- bracket (T)
# An ALIAS family. These four write into the owning ShapeSpec, so a theme
# can say shape.panel.border_style = brackets and nothing else. Corner
# brackets are a border STYLE, not a separate ornament, which is what lets
# any of the sixteen shape presets wear them.
[ornament.bracket]
len                   = @border.edge.bracket_len
                                              # length of each corner bracket · 9 · frac of the SHORTER SIDE of the host rect, clamped [0.8u, 4.0u] · @border.edge.bracket_len = 18%
inset                 = @border.edge.bracket_inset
                                              # how far the brackets sit inside the ring · 9 · len · @border.edge.bracket_inset = 0u
width                 = @border.edge.width    # stroke weight of a bracket · 9 · str · @border.edge.width -> @stroke.hair
color                 = @border.default       # colour of a bracket · 9 · colour · -> alpha(@accent.primary, 0.78)

# TODO(default): chosen here, spec silent - three items in the block above.
#   1. 5.20's heading sums the family as 62 tokens; the seven bodies it prints
#      hold 74 (leader 10, scale 13, node 9, hex 10, reticle 15, dump 13,
#      bracket 4). All 74 are written here. Lead: the heading needs fixing.
#   2. ornament.node.border is written as a count (0 = no ring). 5.20 gives it
#      as a bare `0` beside edge_width/edge_color/edge_alpha, which reads as a
#      number rather than a bool.
#   3. Ranges on the scalar tokens are this fragment's, not 5.20's; they exist
#      so the comment's third field is never empty. None of them clamps a
#      value 5.20 states.



# ============================================================ 50-state

# =========================================================================
# 5.21  state.* — the GLOBAL interaction ladder (7 states x 8 channels = 56)
#
# Seven mutually exclusive slots, resolved to a u8 index:
#   State = Idle | Hover | Press | Selected | SelectedHover | Dragging | Disabled
# Precedence, first hit wins:
#   Disabled > Dragging > Press > SelectedHover > Hover > Selected > Idle
# Disabled is first on purpose: a disabled control must never light up under
# the pointer.
#
# This block is the default EVERY class inherits (5.27 lists which of the 49
# classes support which slot). A class overrides one cell with the dotted form
#   <class>.state.<state>.<channel> = <value>
# and nothing else changes. The [panel:hover] section-header form is CUT: it
# cannot express a global default, and two syntaxes for one idea is what
# 1.2(6) refuses.
#
# "base" is a documented KEYWORD meaning "this class's own base colour",
# legal only inside a state channel. The five legal operators over it are the
# ordinary functions alpha, shade, tint, mix, sat (6) — all evaluated in
# OKLab, so this ladder on a mint accent and the same ladder on a crimson
# accent read as the same AMOUNT of change. sRGB dim() does not: it makes red
# vanish while green survives.
#
# Eight channels, named exactly as ClassStyle spells them (7.1):
#   fill · edge · text · glyph · edge_width · glow_radius · glow_alpha · elevation
# =========================================================================
# =========================================================================
# CLASS BASES — what the state ladder is applied TO (m1 §3.1)
#
# [state] writes every rung as arithmetic on `base` — "this class's own base
# colour" — and until now nothing declared what that base IS, so every state
# token baked against white. These twenty-six rows are the missing origin:
# one per interactive class of the 5.27 matrix. @accent.primary is the
# identity element (it is exactly what ctx.theme.base was at every migrated
# site), and a theme differs a row only when it means to.
# =========================================================================
[class]
button          = @accent.primary   # the ladder's base for the parallelogram button · 1,7 · col · @accent.primary
icon_button     = @accent.primary   # window controls, the close and add plates · 1,7 · col · @accent.primary
chip            = @accent.primary   # the settings colour-depth chips · - · col · @accent.primary
tab             = @accent.primary   # the shell's session tabs · - · col · @accent.primary
menu.item       = @accent.primary   # a window-menu or context-menu row · - · col · @accent.primary; a DROP-DOWN's row is not one of these — it is a list row and wears list.item below
field           = @accent.primary   # the search box and the SAVE AS name field · 7 · col · @accent.primary
checkbox        = @accent.primary   # the SNAP TO GRID box · - · col · @accent.primary
slider.track    = @accent.primary   # a slider's groove ring · - · col · @accent.primary
slider.knob     = @accent.primary   # a slider's handle · - · col · @accent.primary
list.item       = @accent.primary   # a task, notification or process row, and the row of an open drop-down · 1,7 · col · @accent.primary
tile            = @accent.primary   # a launcher tile, a file tile, an ADD WIDGET entry · 1,8 · col · @accent.primary
launcher.icon   = @accent.primary   # a launcher glyph · 1,8 · col · @accent.primary
key             = @accent.primary   # an on-screen keyboard cap · 3,5 · col · @accent.primary
window          = @border.default   # the frame around a foreign window · 7,8 · col · @border.default
panel           = @border.default   # a bordered panel as a container · 1-10 · col · @border.default
dialog          = @border.default   # the resolution dialog · - · col · @border.default
taskbar.button  = @accent.primary   # a dock item · 7,8,9 · col · @accent.primary
titlebar        = @accent.primary   # a window title band · 7,8 · col · @accent.primary
scrollbar.thumb = @accent.primary   # the scroll thumb · - · col · @accent.primary
resize.grip     = @accent.primary   # the corner resize grip · - · col · @accent.primary
term.cell       = @term.fg          # a terminal cell as an interactive thing · 3 · col · @term.fg
editor.proxy    = @accent.primary   # a widget proxy in the layout editor · - · col · @accent.primary
boards.tile     = @accent.primary   # a board miniature in the BOARDS view · - · col · @accent.primary
filetile        = @accent.primary   # a file browser tile · 1 · col · @accent.primary
table.head      = @accent.primary   # a sortable table heading · 1,9 · col · @accent.primary; the 5.27 matrix has always given this class hover / press / selected (selected = the SORTED column) and ui.rs has always asked for it by name — the row itself was missing, so class_id answered None and every heading fell back to StateStyle::RAW: no wash under the pointer, no press, no mark on the column being sorted by
script.row      = @accent.primary   # a selectable row a script widget draws · 1 · col · @accent.primary

# =========================================================================
# 5.21b family — which state ladder a class reads (added 2026-08-23, after
# an audit found 22 of the 26 classes above sharing @accent.primary AND the
# one global [state] formula: same colour AND same maths is why a button
# and a scrollbar thumb amounted to the same object wearing two names).
#
# A class named here reads the ladder its word points at ([state.input] or
# [state.window], both below) instead of the bare [state] ladder. A class
# NOT named here is unchanged: it still reads [state], which keeps its
# original role as the button/actionable-control formula rather than
# becoming a fourth, nameless family. `base` and `window` are the only two
# legal words; the engine treats anything else as absent (5.6's error
# policy — degrade, never refuse to start).
#
# The split follows Qt's QPalette::Button vs ::Base: `button` classes are
# things pressed to FIRE an action (a momentary event); `base` classes are
# surfaces you TYPE INTO, DRAG or TOGGLE (a sustained, checkable state);
# `window` classes are containers, not controls — 5.21's own comment on
# `[focus]` already called window/panel/dialog out as a different kind of
# thing from the rest of this list.
# =========================================================================
[family]
window          = window   # the frame around a foreign window
panel           = window   # a bordered panel as a container
dialog          = window   # the resolution dialog
field           = input    # the search box and the SAVE AS name field
checkbox        = input    # the SNAP TO GRID box
slider.track    = input    # a slider's groove ring
slider.knob     = input    # a slider's handle
scrollbar.thumb = input    # the scroll thumb
resize.grip     = input    # the corner resize grip
list.item       = input    # a task, notification or process row, and the row of an open drop-down — Qt's own Base role covers exactly this (list/tree rows), not Button

[state]

# ---- idle · every class must define it; the resting look -----------------
idle.fill            = alpha(base, 0.07)   # a resting control's interior; images 1,7,9; 0..1; MUST NOT be surface.base (5.21)
idle.edge            = alpha(base, 0.40)   # a resting control's ring; images 1,7,9; 0..1; the 1px glowing border of family A
idle.text            = alpha(base, 0.70)   # resting label text; images 1-10; 0..1; APCA advisory a11y.lc_secondary
idle.glyph           = alpha(base, 0.70)   # resting icon/glyph strokes; images 1,8; 0..1; tracks idle.text
idle.edge_width      = @stroke.hair        # resting ring width; images 1-6; device px via stroke(); -> stroke.hair
idle.glow_radius     = 0u                  # no glow at rest; -; u, 0u .. 6u; glow.<C>.enabled is false in default (5.13)
idle.glow_alpha      = 0.00                # no glow at rest; -; 0..1; scaled by glow.alpha_scale
idle.elevation       = 0                   # material rank at rest; -; n, 0 .. 8; index into elev.* (5.12)

# ---- hover · pointer inside the hit rect. Keyboard never produces hover ---
hover.fill           = alpha(base, 0.22)   # pointer inside the hit rect; image 7; 0..1; unified from winframe 0.12 / dropdown 0.25
hover.edge           = alpha(base, 0.80)   # ring brightens under the pointer; image 7; 0..1; closes dropdown.rs:41's fill-only hover
hover.text           = base                # label goes to full base under the pointer; image 7; colour; keyword "base"
hover.glyph          = base                # glyph goes to full base under the pointer; image 8; colour; keyword "base"
hover.edge_width     = @stroke.hair        # width does NOT change on hover; -; device px; -> stroke.hair
hover.glow_radius    = 1.2u                # soft halo under the pointer; image 7; u, 0u .. 6u; drawn only if the class's glow is enabled
hover.glow_alpha     = 0.35                # hover halo strength; image 7; 0..1; the only 0..1 glow magnitude (5.0 naming law 6)
hover.elevation      = 0                   # hover does not lift the material; -; n, 0 .. 8; -

# ---- press · held, or the 150 ms decay after a click (today's `flash`) ----
press.fill           = alpha(base, 0.45)   # held interior; images 1,9; 0..1; unified from libnacelle 0.35 / control plugin 0.55
press.edge           = alpha(base, 0.95)   # held ring, all but solid; images 1,9; 0..1; -
press.text           = base                # held label; images 1,9; colour; keyword "base"
press.glyph          = base                # held glyph; images 1,9; colour; keyword "base"
press.edge_width     = @stroke.hair        # width does NOT change on press; -; device px; -> stroke.hair
press.glow_radius    = 1.6u                # press halo, wider than hover; image 7; u, 0u .. 6u; -
press.glow_alpha     = 0.60                # press halo strength; image 7; 0..1; -
press.elevation      = 0                   # press does not lift the material; -; n, 0 .. 8; -

# ---- selected · this one of a set is the chosen one, persistently --------
# shell tabs, the current board tile, a latched modifier key, image 8's
# orange active launcher icon (which needs form (a): nothing derived from
# cyan produces orange, so launcher.icon overrides .glyph explicitly).
selected.fill        = alpha(base, 0.14)   # the chosen item's wash; image 8; 0..1; lighter than hover on purpose - persistence is not pressure
selected.edge        = alpha(base, 0.95)   # the chosen item's ring; image 8; 0..1; -
selected.text        = alpha(base, 0.95)   # the chosen item's label; image 8; 0..1; -
selected.glyph       = alpha(base, 0.95)   # the chosen item's glyph; image 8; 0..1; -
selected.edge_width  = @stroke.thin        # selection thickens the ring one step; image 8; device px; -> stroke.thin
selected.glow_radius = 1.0u                # steady selection halo; image 8; u, 0u .. 6u; -
selected.glow_alpha  = 0.25                # steady selection halo strength; image 8; 0..1; -
selected.elevation   = 0                   # selection does not lift the material; -; n, 0 .. 8; -

# ---- selected_hover · the eighth combination that actually happens -------
# Without it a hovered selected tab loses its selection mark. Engine default
# is channel-wise max(Selected, Hover) in alpha with Selected's hue; the rows
# below write that result out so an author can see and move it.
selected_hover.fill        = alpha(base, 0.26)  # chosen AND pointed at; image 8; 0..1; max(selected 0.14, hover 0.22) + a step
selected_hover.edge        = base               # ring goes solid; image 8; colour; keyword "base"
selected_hover.text        = base               # label goes solid; image 8; colour; keyword "base"
selected_hover.glyph       = base               # glyph goes solid; image 8; colour; keyword "base"
selected_hover.edge_width  = @stroke.thin       # keeps the selection's thicker ring; image 8; device px; -> stroke.thin
selected_hover.glow_radius = 1.4u               # between selected 1.0u and press 1.6u; image 8; u, 0u .. 6u; -
selected_hover.glow_alpha  = 0.40               # between selected 0.25 and press 0.60; image 8; 0..1; -
selected_hover.elevation   = 0                  # no lift; -; n, 0 .. 8; -

# ---- dragging · grabbed and moving; a drag lasts and must read detached ---
dragging.fill        = alpha(base, 0.18)   # grabbed item's interior; -; 0..1; deliberately below hover - the lift carries the signal
dragging.edge        = alpha(base, 0.90)   # grabbed item's ring; -; 0..1; -
dragging.text        = base                # grabbed item's label; -; colour; keyword "base"
dragging.glyph       = base                # grabbed item's glyph; -; colour; keyword "base"
dragging.edge_width  = @stroke.thin        # a dragged edge reads one step heavier; -; device px; -> stroke.thin
dragging.glow_radius = 2.8u                # the widest halo in the ladder - the shadow of a lifted object; image 7; u, 0u .. 6u; -
dragging.glow_alpha  = 0.50                # lifted-object halo strength; image 7; 0..1; -
dragging.elevation   = 2                   # THE material change: a drag rises two ranks; image 7; n, 0 .. 8; index into elev.* (5.12)

# ---- disabled · present, visible, not actionable -------------------------
# Pass D lint 2 clamps any disabled channel that exceeds idle: a disabled
# control that looks more available than an enabled one is a lie the engine
# can catch arithmetically.
disabled.fill        = alpha(base, 0.00)   # no interior at all; settings; 0..1; the fill is what "available" means
disabled.edge        = alpha(base, 0.18)   # a ghost of the ring; settings; 0..1; below idle 0.40 by rule
disabled.text        = alpha(base, 0.28)   # inert label; settings; 0..1; raised from the code's 0.25, which fell under the floor
disabled.glyph       = alpha(base, 0.28)   # inert glyph; settings; 0..1; tracks disabled.text
disabled.edge_width  = @stroke.hair        # thinnest ring; settings; device px; -> stroke.hair
disabled.glow_radius = 0u                  # a disabled control never glows; -; u, 0u .. 6u; -
disabled.glow_alpha  = 0.00                # a disabled control never glows; -; 0..1; -
disabled.elevation   = 0                   # a disabled control never lifts; -; n, 0 .. 8; -

# =========================================================================
# 5.21c [state.input] — the ladder for surfaces you type into, drag or
# toggle (5.21b): field, checkbox, a slider's track and knob, the
# scrollbar thumb, the resize grip, a list/task row. The shape of this
# ladder is identical to [state]'s (seven states, eight channels, `base`
# bound to the class's own colour) — only the numbers differ, and they
# differ on purpose: an input surface has to be FOUND at rest (idle reads
# stronger than a button's, which is allowed to all but disappear until
# touched), and its persistent state has to read unmistakably once it is
# ON (selected jumps hard, because "checked" and "not checked" is the one
# distinction this family exists to make loud). Hover is deliberately
# quieter than a button's: pointing at a checkbox is not "about to fire".
#
# UNMEASURED, same as [state] originally was before Pass D's arithmetic
# lint: reasoned from the family's job, not from a screen. A theme is free
# to override every cell exactly as it already could for [state].
# =========================================================================
[state.input]

idle.fill            = alpha(base, 0.10)   # a resting surface must read as a surface, not wait to be touched; 0..1
idle.edge            = alpha(base, 0.55)   # a checkbox/field boundary has to be findable at rest; 0..1; stronger than button's 0.40
idle.text            = alpha(base, 0.70)   # resting label text; 0..1; unchanged from the button ladder's floor
idle.glyph           = alpha(base, 0.70)   # resting icon/glyph strokes; 0..1; tracks idle.text
idle.edge_width      = @stroke.hair        # resting ring width; device px via stroke()
idle.glow_radius     = 0u                  # no glow at rest; u, 0u .. 6u
idle.glow_alpha      = 0.00                # no glow at rest; 0..1
idle.elevation       = 0                   # material rank at rest; n, 0 .. 8

hover.fill           = alpha(base, 0.14)   # pointer inside the hit rect; 0..1; quieter than button's 0.22 - proximity, not "about to fire"
hover.edge           = alpha(base, 0.70)   # ring brightens under the pointer; 0..1
hover.text           = base                # label goes to full base under the pointer; colour
hover.glyph          = base                # glyph goes to full base under the pointer; colour
hover.edge_width     = @stroke.hair        # width does NOT change on hover; device px
hover.glow_radius    = 0.8u                # soft halo under the pointer; u, 0u .. 6u; smaller than button's 1.2u
hover.glow_alpha     = 0.20                # hover halo strength; 0..1
hover.elevation      = 0                   # hover does not lift the material; n, 0 .. 8

press.fill           = alpha(base, 0.30)   # held interior, e.g. a slider knob mid-grab; 0..1
press.edge           = alpha(base, 0.85)   # held ring; 0..1
press.text           = base                # held label; colour
press.glyph          = base                # held glyph; colour
press.edge_width     = @stroke.hair        # width does NOT change on press; device px
press.glow_radius    = 1.0u                # press halo; u, 0u .. 6u
press.glow_alpha     = 0.35                # press halo strength; 0..1
press.elevation      = 0                   # press does not lift the material; n, 0 .. 8

selected.fill        = alpha(base, 0.55)   # the ON state, and this family's reason to exist: checked/selected must be unmistakable, not merely "lighter"; 0..1
selected.edge        = base                # the checked ring goes fully solid, not a fraction of base; colour
selected.text        = base                # the checked label goes solid; colour
selected.glyph       = base                # the checked glyph (e.g. the tick) goes solid; colour
selected.edge_width  = @stroke.thin        # selection thickens the ring one step; device px
selected.glow_radius = 0.6u                # steady selection halo; u, 0u .. 6u
selected.glow_alpha  = 0.18                # steady selection halo strength; 0..1
selected.elevation   = 0                   # selection does not lift the material; n, 0 .. 8

selected_hover.fill        = alpha(base, 0.62)  # checked AND pointed at; 0..1
selected_hover.edge        = base               # ring stays solid; colour
selected_hover.text        = base               # label stays solid; colour
selected_hover.glyph       = base               # glyph stays solid; colour
selected_hover.edge_width  = @stroke.thin       # keeps the selection's thicker ring; device px
selected_hover.glow_radius = 0.9u               # between selected 0.6u and press 1.0u; u, 0u .. 6u
selected_hover.glow_alpha  = 0.28               # between selected 0.18 and press 0.35; 0..1
selected_hover.elevation   = 0                  # no lift; n, 0 .. 8

dragging.fill        = alpha(base, 0.35)   # a grabbed slider knob's interior; 0..1; the thumb's position is the signal, not the fill
dragging.edge        = alpha(base, 0.90)   # grabbed item's ring; 0..1
dragging.text        = base                # grabbed item's label; colour
dragging.glyph       = base                # grabbed item's glyph; colour
dragging.edge_width  = @stroke.thin        # a dragged edge reads one step heavier; device px
dragging.glow_radius = 1.6u                # widest halo in this ladder; u, 0u .. 6u
dragging.glow_alpha  = 0.35                # lifted-object halo strength; 0..1
dragging.elevation   = 1                   # a dragged knob or thumb rises one rank; n, 0 .. 8; quieter than button family's 2 - it is a small control, not a whole tile

disabled.fill        = alpha(base, 0.03)   # a ghost of the resting interior; 0..1; below idle by rule (Pass D)
disabled.edge        = alpha(base, 0.22)   # a ghost of the ring; 0..1; below idle 0.55 by rule
disabled.text        = alpha(base, 0.28)   # inert label; 0..1
disabled.glyph       = alpha(base, 0.28)   # inert glyph; 0..1; tracks disabled.text
disabled.edge_width  = @stroke.hair        # thinnest ring; device px
disabled.glow_radius = 0u                  # a disabled control never glows; u, 0u .. 6u
disabled.glow_alpha  = 0.00                # a disabled control never glows; 0..1
disabled.elevation   = 0                   # a disabled control never lifts; n, 0 .. 8

# =========================================================================
# 5.21d [state.window] — the ladder for containers: window, panel, dialog
# (5.21b). These are not controls in the sense the rest of §5.21 assumes -
# 5.21's own note below says as much for focus, which this family also
# uses. Hover and press are correspondingly close to silent (a container's
# body is a backdrop, not a target); dragging is the one state that
# genuinely happens to a window, so it is the one state this ladder lifts
# at all, and only one rank - a whole window rising two full ranks like a
# pressed button would read as an animation error, not a container being
# picked up.
#
# UNMEASURED, same caveat as [state.input].
# =========================================================================
[state.window]

idle.fill            = alpha(base, 0.04)   # the panel/window body is a backdrop, not a target; 0..1; quieter than button's 0.07
idle.edge            = alpha(base, 0.35)   # close to button's 0.40 on purpose - the glowing panel edge is family A's signature look and this ladder must not dim it
idle.text            = alpha(base, 0.70)   # resting label text; 0..1
idle.glyph           = alpha(base, 0.70)   # resting icon/glyph strokes; 0..1
idle.edge_width      = @stroke.hair        # resting ring width; device px
idle.glow_radius     = 0u                  # no glow at rest; u, 0u .. 6u
idle.glow_alpha      = 0.00                # no glow at rest; 0..1
idle.elevation       = 0                   # material rank at rest; n, 0 .. 8

hover.fill           = alpha(base, 0.05)   # hovering a container's body is not a signal; barely moves off idle; 0..1
hover.edge           = alpha(base, 0.40)   # ring brightens slightly; 0..1
hover.text           = base                # colour
hover.glyph          = base                # colour
hover.edge_width     = @stroke.hair        # device px
hover.glow_radius    = 0u                  # containers do not halo on hover - that reads as a control, not a frame; u, 0u .. 6u
hover.glow_alpha     = 0.00                # 0..1
hover.elevation      = 0                   # n, 0 .. 8

press.fill           = alpha(base, 0.06)   # a titlebar press just before a drag starts; minimal; 0..1
press.edge           = alpha(base, 0.45)   # 0..1
press.text           = base                # colour
press.glyph          = base                # colour
press.edge_width     = @stroke.hair        # device px
press.glow_radius    = 0u                  # u, 0u .. 6u
press.glow_alpha     = 0.00                # 0..1
press.elevation      = 0                   # n, 0 .. 8

selected.fill        = alpha(base, 0.06)   # rarely reached - kept close to idle so a stray query never answers something loud; 0..1
selected.edge        = alpha(base, 0.45)   # 0..1
selected.text        = base                # colour
selected.glyph       = base                # colour
selected.edge_width  = @stroke.hair        # device px
selected.glow_radius = 0u                  # u, 0u .. 6u
selected.glow_alpha  = 0.00                # 0..1
selected.elevation   = 0                   # n, 0 .. 8

selected_hover.fill        = alpha(base, 0.07)  # 0..1
selected_hover.edge        = alpha(base, 0.50)  # 0..1
selected_hover.text        = base               # colour
selected_hover.glyph       = base               # colour
selected_hover.edge_width  = @stroke.hair       # device px
selected_hover.glow_radius = 0u                 # u, 0u .. 6u
selected_hover.glow_alpha  = 0.00               # 0..1
selected_hover.elevation   = 0                  # n, 0 .. 8

dragging.fill        = alpha(base, 0.08)   # a window being moved - a subtle lift, not a flashy control-drag; 0..1
dragging.edge        = base                # the edge goes solid while being repositioned - "I am the one moving"; colour
dragging.text        = base                # colour
dragging.glyph       = base                # colour
dragging.edge_width  = @stroke.thin        # device px
dragging.glow_radius = 1.0u                # u, 0u .. 6u
dragging.glow_alpha  = 0.20                # 0..1
dragging.elevation   = 1                   # one rank while being dragged; n, 0 .. 8; quieter than button family's 2 - a whole window lifting two ranks would read as broken, not held

disabled.fill        = alpha(base, 0.00)   # no interior; 0..1
disabled.edge        = alpha(base, 0.15)   # a ghost of the ring; 0..1
disabled.text        = alpha(base, 0.25)   # inert label; 0..1
disabled.glyph       = alpha(base, 0.25)   # inert glyph; 0..1
disabled.edge_width  = @stroke.hair        # device px
disabled.glow_radius = 0u                  # u, 0u .. 6u
disabled.glow_alpha  = 0.00                # 0..1
disabled.elevation   = 0                   # n, 0 .. 8

# =========================================================================
# 5.21  focus.* — orthogonal to the state ladder (6)
#
# FOCUS IS NOT A STATE SLOT. It is a bool on CONTAINERS only (window, panel,
# dialog, the focused board) and does exactly three things: swaps the
# container's edge role to @accent.focus, enables the container's focus glow,
# and multiplies every descendant's resolved alpha by focus.unfocused_dim
# when not focused. Image 7's magenta-framed ZADANIA BIEZACE is exactly this
# - two tokens, and nothing else in that panel changes. A state slot would
# re-bake an entire Surface. [CONFLICT 3]
#
# There is no per-class member here and no `button.focus = ring` to write:
# 5.27's focus column is an engine constant recording which treatment each
# class receives.
# =========================================================================
[focus]
unfocused_dim = 0.62            # alpha multiplier on an unfocused container's whole subtree · 7 · f, 0.3 .. 1.0 · winframe.rs:325's literal
ring.color    = @accent.focus   # ring around the focused CONTROL, separate from container focus · 7 · colour · @accent.focus
ring.width    = @stroke.thin    # the ring's stroke weight · 7 · str · @stroke.thin
ring.offset   = 0.4u            # gap between the control's edge and its focus ring · 7 · len (u), 0u .. 2u · -
# The list below is the DECLARATION, not prose: §3.2's `enum:` spelling is
# what interns the words, and `enum_index("dashed")` answers None until it is
# written this way — which is how a ring cached its word slots as None for
# the life of the process and stayed solid whatever the theme said.
ring.style    = solid           # how the ring is stroked · 7 · enum: solid | dashed · -
ring.corner   = @field.corner   # the ring's own corner radius · 7 · len (u) | pill · @field.corner; a ring drawn square around a rounded field is two shapes claiming one control, and the field is the control a focus ring is seen on most
ring.corner_style = @field.corner_style   # which shape that radius is cut to · 7 · enum: square | round | chamfer · follows the field for the same reason the radius does
# The ring's own rhythm. It used to borrow border.edge.dash / .gap, whose
# declaration reserves them for the `segmented` style of a CONTAINER's
# outline: a different object, a different scale, and no way for a theme to
# move one without moving the other.
ring.dash     = @border.edge.dash   # length of one dash when ring.style is dashed · 7 · len (u) · @border.edge.dash = 1.6u, which is what the ring drew while it was borrowing
ring.gap      = @border.edge.gap    # length of the gap between two dashes · 7 · len (u) · @border.edge.gap = 0.8u, likewise
ring.enabled  = true            # draw a focus ring at all · 7 · bool · MUST survive high_contrast and reduced motion

# =========================================================================
# 5.22  motion.* — a CLOSED catalogue (18 effects x 8 keys + board_ride's
#       6 extras + 2 globals = 152)
#
# The theme owns: whether an effect exists, its duration, its easing, its
# period and amplitude, and a global scale. The theme does NOT own: the frame
# rate, the epsilon at which a transition is finished, or the GEOMETRY of the
# motion. Geometry of motion is a layout fact - the accordion unfolds from
# the anchor's bottom edge because that is where the anchor is - and a theme
# that could change it could produce an unhittable menu.
#
# Six easing curves, closed set:
#   linear · ease_out 1-(1-t)^2 · ease_in t^2 · ease_in_out t*t*(3-2t)
#   · sine 0.5-0.5*cos(2*pi*t) (CYCLIC ONLY) · step (t < duty ? 1 : floor)
#   · custom cubic-bezier through easing_p[4], 4 Newton iterations
#
# Per entry, exactly these eight keys:
#   duration_ms · period_ms · amplitude · floor · duty · easing · easing_p · enabled
# duration_ms drives one-shot transitions; period_ms drives cyclic effects.
# An entry uses one or the other; the unused one is 0ms and is documented as
# such rather than omitted, because a theme file is documentation.
#
# ONE entry carries more than eight: motion.board_ride adds perspective,
# gesture_frac, rubber_gain, rubber_max, epsilon and void. They are not a
# ninth key of the SHAPE - no other effect has them, and none may grow
# them - but the six numbers that decide what the board ride IS, and they
# all have readers (nacelle-desktop main.rs for the first five, deco.rs
# for the void). The header counted 146 for a while, which is 18 x 8 + 2:
# the arithmetic of the shape, applied to a catalogue that has one entry
# it does not describe. `the_catalogue_is_closed_and_counted` in
# src/motion.rs is what keeps the two from parting again.
#
# Six prohibitions, enforced by the grammar because there is no token for
# them: per-cell terminal colour · blur radius · anything that affects layout
# · more than motion.idle_cap always-on cyclic SOURCES · per-glyph animation
# · new effect ids (an unknown id is reported and ignored).
#
# The cyclic cap counts SOURCES across families, not motion ids. The union it
# counts is: motion.glow_pulse, motion.alarm_blink, motion.caret_blink,
# motion.term_cursor_blink, motion.value_blink, decor.ribbons.speed,
# decor.scanlines.drift, ornament.reticle.sweep, ornament.dump.refresh_hz,
# ornament.node.pulse. caret_blink and term_cursor_blink are EXEMPT BY NAME
# (one quad each; freezing them leaves a half-lit block where the user is
# looking). Remaining precedence when the cap bites:
#   alarm_blink > value_blink > glow_pulse > ornament.reticle.sweep
#   > ornament.node.pulse > decor.ribbons > decor.scanlines.drift
#   > ornament.dump.refresh_hz
# Losers are frozen at their mean and each is named in a warning.
#
# Reduced motion (a11y.reduced_motion): motion.scale forced to 0 - which the
# engine implements as JUMP TO THE END STATE, never "run in 0 ms";
# glow_pulse freezes at its mean; alarm_blink freezes at its HIGH value, not
# its mean and not off, because what reduced motion removes is the flicker,
# not the alarm; caret_blink, term_cursor_blink and value_blink freeze ON;
# board_ride becomes a cut; the mood wash is skipped entirely.
# =========================================================================
[motion]
scale    = 1.0   # multiplies every duration and period; -; f, 0.0 .. 4.0; 0 = jump to the end state (the reduced-motion implementation)
idle_cap = 1     # how many always-on cyclic SOURCES may run at once; -; n, 0 .. 4; idle CPU is ~5% and must not regress

# ---- hover · state crossfade into and out of Hover -----------------------
[motion.hover]
duration_ms = 90ms                    # crossfade into/out of Hover; image 7; ms, 0ms .. 2000ms; -
period_ms   = 0ms                     # unused - hover is a one-shot transition; -; ms; -
amplitude   = 0.00                    # unused outside cyclic effects; -; 0..1; -
floor       = 0.00                    # unused outside step easing; -; 0..1; -
duty        = 0.00                    # unused outside step easing; -; 0..1; -
easing      = ease_out                # curve · - · enum: linear | ease_out | ease_in | ease_in_out | sine | step | custom · -
easing_p    = [0.25, 0.10, 0.25, 1.00] # cubic-bezier control points, read only when easing = custom; -; 4 x f; TODO(default): chosen here, spec silent
enabled     = true                    # run this effect at all; -; bool; -

# ---- press · Press decay; today's `flash`, 0.15 s hard-coded in four files
[motion.press]
duration_ms = 150ms                   # the decay after a click; images 1,9; ms, 0ms .. 2000ms; -
period_ms   = 0ms                     # unused - press is a one-shot decay; -; ms; -
amplitude   = 0.00                    # unused outside cyclic effects; -; 0..1; -
floor       = 0.00                    # unused outside step easing; -; 0..1; -
duty        = 0.00                    # unused outside step easing; -; 0..1; -
easing      = ease_out                # curve · - · enum: linear | ease_out | ease_in | ease_in_out | sine | step | custom · -
easing_p    = [0.25, 0.10, 0.25, 1.00] # bezier points for easing = custom; -; 4 x f; TODO(default): chosen here, spec silent
enabled     = true                    # run this effect at all; -; bool; -

# ---- select · Selected crossfade ----------------------------------------
[motion.select]
duration_ms = 120ms                   # crossfade into/out of Selected; image 8; ms, 0ms .. 2000ms; -
period_ms   = 0ms                     # unused - one-shot transition; -; ms; -
amplitude   = 0.00                    # unused outside cyclic effects; -; 0..1; -
floor       = 0.00                    # unused outside step easing; -; 0..1; -
duty        = 0.00                    # unused outside step easing; -; 0..1; -
easing      = ease_out                # curve · - · enum: linear | ease_out | ease_in | ease_in_out | sine | step | custom · -
easing_p    = [0.25, 0.10, 0.25, 1.00] # bezier points for easing = custom; -; 4 x f; TODO(default): chosen here, spec silent
enabled     = true                    # run this effect at all; -; bool; -

# ---- focus · container focus edge + unfocused dim crossfade --------------
[motion.focus]
duration_ms = 120ms                   # the edge re-role and the subtree dim, together; image 7; ms, 0ms .. 2000ms; -
period_ms   = 0ms                     # unused - one-shot transition; -; ms; -
amplitude   = 0.00                    # unused outside cyclic effects; -; 0..1; -
floor       = 0.00                    # unused outside step easing; -; 0..1; -
duty        = 0.00                    # unused outside step easing; -; 0..1; -
easing      = ease_out                # curve · - · enum: linear | ease_out | ease_in | ease_in_out | sine | step | custom · -
easing_p    = [0.25, 0.10, 0.25, 1.00] # bezier points for easing = custom; -; 4 x f; TODO(default): chosen here, spec silent
enabled     = true                    # run this effect at all; -; bool; focus.ring.enabled is a separate, a11y-protected switch

# ---- disable · into and out of Disabled ---------------------------------
[motion.disable]
duration_ms = 160ms                   # crossfade into/out of Disabled; settings; ms, 0ms .. 2000ms; slowest of the state fades on purpose
period_ms   = 0ms                     # unused - one-shot transition; -; ms; -
amplitude   = 0.00                    # unused outside cyclic effects; -; 0..1; -
floor       = 0.00                    # unused outside step easing; -; 0..1; -
duty        = 0.00                    # unused outside step easing; -; 0..1; -
easing      = ease_in_out             # curve · - · enum: linear | ease_out | ease_in | ease_in_out | sine | step | custom · -
easing_p    = [0.25, 0.10, 0.25, 1.00] # bezier points for easing = custom; -; 4 x f; TODO(default): chosen here, spec silent
enabled     = true                    # run this effect at all; -; bool; -

# ---- menu_unfold · accordion / window-menu unfold ------------------------
[motion.menu_unfold]
duration_ms = 150ms                   # the whole pull - the slide out from under the anchor AND the unfold, one duration; image 7's taskbar menus; ms, 0ms .. 2000ms; the boundary between the two phases is the list's own geometry (owner 2026-08-16), not a token
period_ms   = 0ms                     # unused - one-shot transition; -; ms; -
amplitude   = 0.00                    # unused outside cyclic effects; -; 0..1; -
floor       = 0.00                    # unused outside step easing; -; 0..1; -
duty        = 0.00                    # unused outside step easing; -; 0..1; -
easing      = ease_out                # curve · - · enum: linear | ease_out | ease_in | ease_in_out | sine | step | custom · -
easing_p    = [0.25, 0.10, 0.25, 1.00] # bezier points for easing = custom; -; 4 x f; TODO(default): chosen here, spec silent
enabled     = true                    # run this effect at all; -; bool; WHERE it unfolds from is layout, not theme

# ---- board_ride · board transition --------------------------------------
[motion.board_ride]
duration_ms = 300ms                   # riding from one board to the next; -; ms, 0ms .. 2000ms; becomes a hard cut under reduced motion
period_ms   = 0ms                     # unused - one-shot transition; -; ms; -
amplitude   = 0.00                    # unused outside cyclic effects; -; 0..1; -
floor       = 0.00                    # unused outside step easing; -; 0..1; -
duty        = 0.00                    # unused outside step easing; -; 0..1; -
easing      = ease_in_out             # curve · - · enum: linear | ease_out | ease_in | ease_in_out | sine | step | custom · -
easing_p    = [0.25, 0.10, 0.25, 1.00] # bezier points for easing = custom; -; 4 x f; TODO(default): chosen here, spec silent
enabled     = true                    # run this effect at all; -; bool; WHICH WAY the board rides is layout, not theme
perspective = 2.2                     # focal length of the cube turn, as a multiple of the viewport width; -; f, 1.0 .. 8.0; main.rs:1788 — the ONE number that decides whether the turn reads as a cube or a slide
gesture_frac = 60%                    # hand travel for a full quarter turn or a full ride; -; % of the viewport; main.rs:674/:696 — a theme that wants a flick rather than a drag says so here
rubber_gain = 0.15                    # the rubbery give past the end of the row; -; f, 0.0 .. 1.0; main.rs:687 — the give is a visible material property, not a bound
rubber_max  = 10%                     # how far that give may stretch at most; -; % of the viewport; main.rs:687's clamp, companion of rubber_gain
epsilon     = 0.05                    # below this progress the ride is not drawn at all; -; f, 0.0 .. 0.5; main.rs:1676 — a rendering guard with a visible threshold
void        = @backdrop.solid         # the space the cube turns in: painted under the whole turn, and what a wall turning away settles toward; -; colour; @backdrop.solid — THE GROUND A STANDING BOARD LAYS (deco::board_ground's first level), so the turn opens and closes on the colour that was already there and a ride is a turn rather than a flash. It read @surface.void until 2026-08-18, which said the same thing while a standing frame painted nothing but the swapchain clear; the moment the frame laid its ground the two parted by a rung of the ladder (measured: 0.0096,0.0240,0.0171 against 0.0418,0.0758,0.0613) and every sideways ride dimmed the screen fourfold for its duration

# ---- widget_grow · editor tear-off growth --------------------------------
[motion.widget_grow]
duration_ms = 250ms                   # a widget growing out of the editor grid; -; ms, 0ms .. 2000ms; -
period_ms   = 0ms                     # unused - one-shot transition; -; ms; -
amplitude   = 0.00                    # unused outside cyclic effects; -; 0..1; -
floor       = 0.00                    # unused outside step easing; -; 0..1; -
duty        = 0.00                    # unused outside step easing; -; 0..1; -
easing      = ease_out                # curve · - · enum: linear | ease_out | ease_in | ease_in_out | sine | step | custom · -
easing_p    = [0.25, 0.10, 0.25, 1.00] # bezier points for easing = custom; -; 4 x f; TODO(default): chosen here, spec silent
enabled     = true                    # run this effect at all; -; bool; a rigid transform on an already-solved rect, never a re-layout

# ---- hold · hold-to-confirm, today's HOLD_SECS ---------------------------
[motion.hold]
duration_ms = 5000ms                  # how long a destructive control must be held; image 5's SYSTEM LOCKDOWN; ms, 1500ms .. 8000ms; clamped to that range — object/button.rs draw_hold through motion::hold, which runs it on UNSCALED wall time: this ramp is the interlock, and motion.scale = 0 must not make it a click
period_ms   = 0ms                     # unused - one-shot ramp; -; ms; -
amplitude   = 0.00                    # unused outside cyclic effects; -; 0..1; -
floor       = 0.00                    # unused outside step easing; -; 0..1; -
duty        = 0.00                    # unused outside step easing; -; 0..1; -
easing      = linear                  # curve · - · enum: linear | ease_out | ease_in | ease_in_out | sine | step | custom · linear because the ring IS the progress readout — and NOT honoured: motion::hold runs linear whatever the word says, because `step` with duty 0 and an overshooting `custom` both reach 1.0 early, and this number is the interlock
easing_p    = [0.25, 0.10, 0.25, 1.00] # bezier points for easing = custom; -; 4 x f; TODO(default): chosen here, spec silent
enabled     = true                    # run this effect at all; -; bool; setting false makes the control fire immediately - a safety decision

# ---- window_open · a window or dialog appearing --------------------------
[motion.window_open]
duration_ms = 180ms                   # window/dialog entry; image 7; ms, 0ms .. 2000ms; object/winframe.rs present() through motion::gate_dir — and this entry is the one a TOOLTIP and a TOAST arrive on too: the catalogue names EVENTS, not objects, so there is no motion.tooltip_* or motion.toast_* and there will not be
period_ms   = 0ms                     # unused - one-shot transition; -; ms; -
amplitude   = 0.00                    # unused outside cyclic effects; -; 0..1; -
floor       = 0.00                    # unused outside step easing; -; 0..1; -
duty        = 0.00                    # unused outside step easing; -; 0..1; -
easing      = ease_out                # curve · - · enum: linear | ease_out | ease_in | ease_in_out | sine | step | custom · -
easing_p    = [0.25, 0.10, 0.25, 1.00] # bezier points for easing = custom; -; 4 x f; TODO(default): chosen here, spec silent
enabled     = true                    # run this effect at all; -; bool; -

# ---- window_close · a window or dialog leaving ---------------------------
[motion.window_close]
duration_ms = 140ms                   # window/dialog exit, faster than entry; image 7; ms, 0ms .. 2000ms; object/winframe.rs present(); the pair is TWO entries precisely so the exit may be faster and curve the other way, which is what motion::gate_dir exists for
period_ms   = 0ms                     # unused - one-shot transition; -; ms; -
amplitude   = 0.00                    # unused outside cyclic effects; -; 0..1; -
floor       = 0.00                    # unused outside step easing; -; 0..1; -
duty        = 0.00                    # unused outside step easing; -; 0..1; -
easing      = ease_in                 # curve · - · enum: linear | ease_out | ease_in | ease_in_out | sine | step | custom · ease_in so the exit accelerates away
easing_p    = [0.25, 0.10, 0.25, 1.00] # bezier points for easing = custom; -; 4 x f; TODO(default): chosen here, spec silent
enabled     = true                    # run this effect at all; -; bool; -

# ---- mood_change · the full-screen mood wash -----------------------------
[motion.mood_change]
duration_ms = 250ms                   # the wash quad fading from its declared alpha to 0; images 4,5; ms, 0ms .. 2000ms; -
period_ms   = 0ms                     # unused - one-shot transition; -; ms; -
amplitude   = 0.00                    # unused outside cyclic effects; -; 0..1; -
floor       = 0.00                    # unused outside step easing; -; 0..1; -
duty        = 0.00                    # unused outside step easing; -; 0..1; -
easing      = ease_in_out             # curve · images 4,5 · enum: linear | ease_out | ease_in | ease_in_out | sine | step | custom · -
easing_p    = [0.25, 0.10, 0.25, 1.00] # bezier points for easing = custom; -; 4 x f; TODO(default): chosen here, spec silent
enabled     = true                    # run this effect at all; -; bool; the theme still swaps instantly - this animates one extra quad

# ---- glow_pulse · cyclic glow breathing (CYCLIC SOURCE) ------------------
[motion.glow_pulse]
duration_ms = 0ms                     # unused - glow_pulse is cyclic; -; ms; -
period_ms   = 1600ms                  # one breath of the panel-edge halo; images 2,7; ms, 200ms .. 8000ms; -
amplitude   = 0.25                    # +/- swing applied to glow_alpha; images 2,7; 0..1; freezes at its mean under reduced motion — motion::Effect::cyclic_amplitude, a path of its own precisely because a BLINK freezes fully visible and a BREATH freezes at the middle
floor       = 0.00                    # unused outside step easing; -; 0..1; -
duty        = 0.00                    # unused outside step easing; -; 0..1; -
easing      = sine                    # curve · images 2,7 · enum: linear | ease_out | ease_in | ease_in_out | sine | step | custom · sine is legal on cyclic effects only
easing_p    = [0.25, 0.10, 0.25, 1.00] # bezier points for easing = custom; -; 4 x f; TODO(default): chosen here, spec silent
enabled     = false                   # OFF in default, like every glow class (5.13); -; bool; costs one of motion.idle_cap sources when on — and a theme must ask TWICE before anything moves, because object/window.rs's panel_edge_glow returns on glow.panel_edge.enabled before it ever asks the clock

# ---- alarm_blink · cyclic alarm emphasis (CYCLIC SOURCE) -----------------
[motion.alarm_blink]
duration_ms = 0ms                     # unused - alarm_blink is cyclic; -; ms; -
period_ms   = 1000ms                  # one alarm cycle; images 1,4; ms, 200ms .. 8000ms; the alert mood turns this on
amplitude   = 0.00                    # unused: step easing swings between 1 and floor; -; 0..1; -
floor       = 0.35                    # the low half of the blink - the alarm never goes dark; images 1,4; 0..1; -
duty        = 0.50                    # fraction of the period spent HIGH; images 1,4; 0..1; -
easing      = step                    # curve · images 1,4 · enum: linear | ease_out | ease_in | ease_in_out | sine | step | custom · step: t < duty ? 1 : floor
easing_p    = [0.25, 0.10, 0.25, 1.00] # bezier points for easing = custom; -; 4 x f; TODO(default): chosen here, spec silent
enabled     = false                   # OFF in default; a mood turns it on (3.4); bool; freezes at its HIGH value under reduced motion

# ---- caret_blink · the text caret (CYCLIC SOURCE, CAP-EXEMPT) ------------
[motion.caret_blink]
duration_ms = 0ms                     # unused - caret_blink is cyclic; -; ms; -
period_ms   = 1060ms                  # one caret cycle; image 7's search field; ms, 200ms .. 8000ms; -
amplitude   = 0.00                    # unused: step easing swings between 1 and floor; -; 0..1; -
floor       = 0.00                    # the caret is fully hidden in the off phase; image 7; 0..1; -
duty        = 0.60                    # fraction of the period the caret is drawn; image 7; 0..1; longer on than off, deliberately
easing      = step                    # curve · image 7 · enum: linear | ease_out | ease_in | ease_in_out | sine | step | custom · step: t < duty ? 1 : floor
easing_p    = [0.25, 0.10, 0.25, 1.00] # bezier points for easing = custom; -; 4 x f; TODO(default): chosen here, spec silent
enabled     = true                    # ON in default; image 7; bool; EXEMPT from motion.idle_cap by name; freezes ON under reduced motion

# ---- term_cursor_blink · the terminal cursor (CYCLIC SOURCE, CAP-EXEMPT) -
[motion.term_cursor_blink]
duration_ms = 0ms                     # unused - term_cursor_blink is cyclic; -; ms; -
period_ms   = 1060ms                  # one terminal-cursor cycle; -; ms, 200ms .. 8000ms; matches caret_blink so the two do not beat
amplitude   = 0.00                    # unused: step easing swings between 1 and floor; -; 0..1; -
floor       = 0.00                    # the cursor is fully hidden in the off phase; -; 0..1; -
duty        = 0.50                    # fraction of the period the cursor block is drawn; -; 0..1; -
easing      = step                    # curve · - · enum: linear | ease_out | ease_in | ease_in_out | sine | step | custom · step: t < duty ? 1 : floor
easing_p    = [0.25, 0.10, 0.25, 1.00] # bezier points for easing = custom; -; 4 x f; TODO(default): chosen here, spec silent
enabled     = true                    # ON in default; -; bool; EXEMPT from motion.idle_cap; the ONLY animated thing in the terminal

# ---- value_blink · a ticking separator inside a value (CYCLIC SOURCE) ----
# Image 1's clock colon in 21:57:30. clock.rhai already does this by reading
# host.t directly, which bypasses motion.scale = 0 entirely; 5.29 gives the
# script blink(id) so the script names the effect instead of the clock.
[motion.value_blink]
duration_ms = 0ms                     # unused - value_blink is cyclic; -; ms; -
period_ms   = 1000ms                  # one tick of the clock colon; image 1; ms, 200ms .. 8000ms; one second, because it marks seconds
amplitude   = 0.00                    # unused: step easing swings between 1 and floor; -; 0..1; -
floor       = 0.00                    # the separator vanishes on the off beat; image 1; 0..1; -
duty        = 0.50                    # fraction of the period the separator is drawn; image 1; 0..1; -
easing      = step                    # curve · image 1 · enum: linear | ease_out | ease_in | ease_in_out | sine | step | custom · step: t < duty ? 1 : floor
easing_p    = [0.25, 0.10, 0.25, 1.00] # bezier points for easing = custom; -; 4 x f; TODO(default): chosen here, spec silent
enabled     = true                    # ON in default; image 1; bool; the one non-exempt cyclic source default spends its idle_cap on

# ---- scroll_settle · inertial settle after a scroll ----------------------
[motion.scroll_settle]
duration_ms = 220ms                   # the settle after a flick; -; ms, 0ms .. 2000ms; -
period_ms   = 0ms                     # unused - one-shot transition; -; ms; -
amplitude   = 0.00                    # unused outside cyclic effects; -; 0..1; -
floor       = 0.00                    # unused outside step easing; -; 0..1; -
duty        = 0.00                    # unused outside step easing; -; 0..1; -
easing      = ease_out                # curve · - · enum: linear | ease_out | ease_in | ease_in_out | sine | step | custom · -
easing_p    = [0.25, 0.10, 0.25, 1.00] # bezier points for easing = custom; -; 4 x f; TODO(default): chosen here, spec silent
enabled     = true                    # run this effect at all; -; bool; -

# =========================================================================
# 5.23  a11y.* — accessibility (14)
#
# A floored length is TWO tokens: X and its companion X_min_px. There is no
# `min` operator (3.2), and px is legal ONLY on a *_min_px / *_max_px name.
#
# The lc_* row is ADVISORY. APCA Lc is computed for every text pair at load
# and reported when below the role minimum; WCAG is the metric that is
# actually enforced (4.4, CONFLICT 6). Both are computed; one is binding.
# =========================================================================
[a11y]
min_hit         = 4.8u     # the HIT rect, never the drawn one; -; u, 3u .. 10u; grown symmetrically, changing no drawn pixel
min_hit_min_px  = 24px     # absolute floor for min_hit; -; device px, 16px .. 64px; WCAG 2.5.5
hit_pad_mode    = grow     # how the hit rect reaches min_hit · - · enum: grow | none · grow keeps the console dense and the controls reachable
grab_pad        = 1.5u     # the invisible band that starts a resize/drag; -; u, 0.5u .. 4u; editor.rs's EDGE = 8.0, generalised
grab_pad_min_px = 6px      # absolute floor for grab_pad; -; device px, 3px .. 24px; companion of grab_pad (3.2)
drag_slop       = 1.5u     # travel between press and release under which the gesture is a CLICK, not a drag; -; u, 0u .. 6u; the companion of grab_pad on the other side of the gesture
reduced_motion  = system   # honour the platform's reduce-motion preference · - · enum: off | system | on · forces motion.scale to 0 when active — motion::reduce_motion reads the WORD (an index would freeze at whatever schema it was interned against), and `system` asks the host through motion::set_platform_reduce_motion (no preference known = animate)
contrast_floor  = false    # when true the contrast lint CORRECTS instead of reporting; -; bool; lifts OKLab L at constant hue and chroma
lc_term_fg      = 90       # advisory APCA minimum for terminal foreground vs term.background; -; f, 0 .. 108; 4.4 pass D 4
lc_primary      = 75       # advisory minimum for text.primary, data values, table cells; -; f, 0 .. 108; 4.4 pass D 4
lc_secondary    = 60       # advisory minimum for text.secondary, labels, table headings; -; f, 0 .. 108; 4.4 pass D 4
lc_hint         = 45       # advisory minimum for text.hint, captions, the tiny data dumps; image 9; f, 0 .. 108; 4.4 pass D 4
lc_display      = 45       # advisory minimum for display type and glyph strokes >= 1.5px; images 1,9; f, 0 .. 108; 4.4 pass D 4
lc_disabled     = 25       # advisory minimum for state.disabled.text; settings; f, 0 .. 108; bounded on BOTH sides - the band is 25..40
lc_edge         = 25       # advisory minimum for non-text edges, panel borders, chart grid; images 1-6; f, 0 .. 108; 4.4 pass D 4

# =========================================================================
# 5.23  [variant.hc] — the high-contrast variant is SIX SCALARS, not a colour
# table. The best idea in the libadwaita stack, adopted wholesale.
#
# EVERY KEY BELOW IS AN ABSOLUTE TOKEN PATH (3.2) and is merged into the root
# tree - `state.idle.text` here is state.idle.text, not
# variant.hc.state.idle.text. State channels use the eight ClassStyle names
# and the "base" keyword (5.21).
#
# This only works because default.theme writes every border, dim and disabled
# colour as an EXPRESSION over these scalars rather than as a hex. That
# constraint is binding on this whole file.
# =========================================================================
[variant.hc]
state.idle.text       = alpha(base, 0.88)  # resting text, was 0.70; -; 0..1; overrides state.idle.text
state.idle.edge       = alpha(base, 0.72)  # resting ring, was 0.40; -; 0..1; overrides state.idle.edge
state.idle.fill       = alpha(base, 0.00)  # no wash at all - edges do the work; -; 0..1; overrides state.idle.fill
state.disabled.text   = alpha(base, 0.40)  # inert text lifted to the top of its band, was 0.28; -; 0..1; overrides state.disabled.text
glow.alpha_scale      = 0.50               # halve every glow - glow costs edge acuity; -; f, 0 .. 4; overrides glow.alpha_scale (5.13)
border.edge.width     = @stroke.regular    # heavier global edge, was stroke.hair; -; device px; overrides border.edge.width (5.7)
focus.ring.width      = @stroke.bold       # heaviest focus ring; -; device px; overrides focus.ring.width
focus.unfocused_dim   = 0.85               # dimming an unfocused window must not hide it, was 0.62; -; f; overrides focus.unfocused_dim
elev.panel.glass.wash = @surface.panel     # opaque - no live backdrop behind text; -; colour; overrides elev.panel.glass.wash (5.12)
elev.panel.glass.rank = 0                  # and therefore no blur pass at all; -; n; overrides elev.panel.glass.rank (5.12)
decor.enabled         = false              # no traces, grids, scanlines, noise or ribbons; -; bool; overrides decor.enabled (5.15)
severity.mode         = hue                # never rely on a brightness ladder here; -; one of hue | brightness | pinned; overrides severity.mode (5.10)
a11y.contrast_floor   = true               # the lint now CORRECTS; -; bool; overrides a11y.contrast_floor

# =========================================================================
# 5.24  mood.* — global re-skins (per mood: 3 controls + a sparse overlay)
#
# Image 4 is not a different theme from image 6 - it is the same layout, the
# same widget set, the same geometry, with a handful of roles re-mapped.
# Moods are PRE-RESOLVED SIBLING THEMES selected by an index swap: ~47 KB per
# mood, and zero per-frame cost.
#
# THREE keys belong to the mood itself and are reserved inside the section:
#   inherit · wash · when
# EVERY OTHER KEY INSIDE [mood.<m>] IS AN ABSOLUTE TOKEN PATH and is merged
# into the root tree (3.2): palette.accent, not mood.alert.palette.accent.
# An author who follows the plain-section concatenation rule literally writes
# a mood that silently does nothing but emit unknown-key warnings.
#
# A mood MAY change: colour roles, severity roles and mode, glow and
# elevation values, decoration on/off and strength, motion enabled/duration/
# period/amplitude, glass wash strength, edge widths, and the visibility of
# elements the layout has already reserved room for.
#
# A mood MAY NOT change: geometry, typography, the motion catalogue's
# membership, component.image.photo.*, a11y.* minima, or which widgets exist.
# The first two would re-run layout and re-measure text on a mood change; the
# rest are safety or honesty properties, and an alarm is the worst possible
# time to relax them. An alarm must not recolour evidence.
#
# Triggers are HOST-side, three, in strict precedence: explicit API >
# external signal > the declarative `when` rule, which has exactly four fixed
# predicate forms, is parsed at load into an enum, is evaluated once per
# second against the 1 Hz telemetry snapshot, and is edge-triggered with a
# 5-second hysteresis on the falling edge. Among moods: lockdown > alert >
# normal - the master's declaration order, read backwards, which is how a
# host settles two rules holding at once.
#
# THE FOUR FORMS, AND NOTHING ELSE (theme/mood.rs parses exactly these):
#
#   severity >= <role>                 any panel reporting at least this rung
#   count(severity == <role>) >= <n>   how many are saying the same thing
#   battery < <n>                      charge, in percent
#   temp > <n>                         package temperature, in Celsius
#
# The comparator belongs to the FORM, not to a grammar: `battery > 10` is not
# a predicate, it is a typo, and it warns like one and leaves the mood
# host-selected. `<role>` is one of 5.10's seven, and `>=` is defined over
# the four that RISE - ok, info, warning, critical. The other three are
# states: `offline` is not worse than `critical`, and `unknown` is what a
# misspelled severity word resolves to, so ranking it above critical would
# let one typo in one widget strobe the whole interface. Whitespace carries
# nothing. There is no scripting here on purpose - a theme that could
# evaluate expressions could decide the machine is on fire.
# =========================================================================

# ---- normal · the resting mood. Image 6's calm azure console -------------
[mood.normal]
inherit = ""       # another mood to build on, depth 8; image 6; text; "" = build on the root theme
wash    = none     # the full-screen transition tint; image 6; colour or the sentinel none; nothing to wash to when nothing changed
when    = ""       # declarative trigger; image 6; text, one of the four predicate forms; "" = only the host may select this mood

# ---- alert · image 1's amber KRYTYCZNY ALARM top bar ---------------------
[mood.alert]
inherit                    = ""                    # build on the root theme; image 1; text; -
wash                       = @severity.critical.text / 0.18  # the wash quad's start colour and alpha; image 1; colour; fades to 0 over motion.mood_change
when                       = "severity >= critical"          # declarative trigger; image 1; text, a fixed predicate form; 5s falling-edge hysteresis
motion.alarm_blink.enabled = true                  # the alarm emphasis starts cycling; image 1; bool; absolute path - overrides motion.alarm_blink.enabled
component.alarm_bar.fill   = alpha(@severity.critical.text, 0.18)  # the top bar gets a body; image 1; colour; overrides component.alarm_bar.fill
glow.panel_edge.enabled    = true                  # panel edges light up screen-wide; image 4; bool; overrides glow.panel_edge.enabled
glow.panel_edge.alpha      = 0.7                   # how hard they light up — roughly double the resting master's own
                    # 0.34 (2026-08-23); image 4; 0..1; overrides glow.panel_edge.alpha. Alert
                    # has to outshout a master that now glows at rest, not merely glow.
                    # No radius override here: the resting master's own reach is 4u,
                    # the declared 0u..4u track's own ceiling (2026-08-23, "maximum by
                    # default") — alert cannot reach further than the wall, so it
                    # inherits the same 4u and carries its whole escalation on alpha.

# ---- lockdown · a CONVENTION, not engine code: alert plus palette.data ---
# 5.24 ships `normal` and `alert` in the engine and `lockdown` as a
# convention. Declaring it here documents the pattern and costs the engine
# nothing: it is `alert` plus a data hue plus one launcher entry. This is
# image 5 - red chrome, blue hologram.
[mood.lockdown]
inherit           = "alert"        # everything alert does, first; image 5; text; depth 8
wash              = #FF2A35 / 0.22 # a harder red wash than alert's; image 5; colour; fades to 0 over motion.mood_change
when              = ""             # host-selected only - image 5's SYSTEM LOCKDOWN button calls set_mood(); image 5; text; -
palette.data      = #35A7FF        # THE POINT OF IMAGE 5: chrome red, data blue; image 5; colour; overrides palette.data
border.edge.width = @stroke.thin   # every frame thickens one step; image 5; device px; overrides border.edge.width
decor.vignette.enabled  = true     # the heavy vignette closes in; image 5; bool; overrides decor.vignette.enabled
decor.vignette.strength = 0.55     # how far in; image 5; 0..1; overrides decor.vignette.strength

# =========================================================================
# 5.29  script.* — the Rhai element vocabulary (34)
#
# THE LARGEST SINGLE DRAWING SURFACE IN THE PROGRAM, AND IT HAD NO TOKENS AT
# ALL. Eight of the twelve shipped widgets draw exclusively through
# libnacelle/src/script.rs - clock, cpu, hardware, memory, network,
# processes, sysinfo, uptime. Its whole vocabulary was hard-coded: title
# block px*2.6, text px*1.5*size, line px*1.9, meter bar line*0.2 / line*0.6,
# columns px*2.6, dots vh(0.8)*panel_scale, everything drawn in
# ctx.theme.base at a hand-picked alpha, and text(content, align, size)
# taking a RAW SIZE MULTIPLIER - so type.<role>.size, .tracking, .case,
# .smallcaps_ratio and .tabular were unreachable from two thirds of the
# interface, including clock.rhai's 21:57:30.
#
# The element KINDS are closed and are not tokens (5.28): title, text, rows,
# meter, columns, dots, table, line, spacer, badge. Their metrics, their type
# roles and their colours are tokens. The colours live in component.script.*,
# component.columns.* and component.table.* (5.26); the metrics and the role
# bindings live here.
#
# A script never names a colour and never names a px size. That is what makes
# network.rhai's "STATE", "OFFLINE" row grey in every theme and amber in an
# alarmed one without touching the script.
#
# host.t is replaced by host.t_motion (the same clock scaled by motion.scale,
# frozen under reduced motion); host.t remains, deprecated, warned once per
# script at load. blink(id) resolves to motion.value_blink.
# =========================================================================
[script]

# ---- stack metrics: the numbers that used to be `px * k` -----------------
title_block        = 6.8u              # height of a `title` element's block; images 1-10; u, 3u .. 14u; replaces px*2.6
text_leading       = 1.50              # multiplier on the role's own leading for a `text` element; -; f, 1.0 .. 2.5; replaces the *1.5 in px*1.5*size
runs_gap           = @space.2          # gap between two neighbouring runs of a `runs` line; images 1,7; len (u); @space.2 = 1u = 5.4 px — the scripts used to fake this with literal spaces in their own text, which put a piece of the layout in the content at whatever width the font gave a space
row_h              = @rhythm.row       # height of one `rows` line; images 1,7,8; u; replaces line = px*1.9
element_gap        = @space.2          # the implicit gap between stack elements; images 1,7; u; -> space.2
pad_x              = @space.0          # horizontal inset inside a script panel; -; u; zero: the host's panel.content_pad already inset the box
stack_align        = middle            # where the content stack sits in a panel it does not resize; images 1,7; one of top | middle | bottom; ui.rs:16's centring — h2 F058 marks the scope AMBIGUOUS, so migrating this needs the lead's confirmation; middle reproduces today either way
meter_track_h      = 0.20x @script.row_h  # the meter's recessed track height; images 1,7; ratio of row_h; replaces line*0.2
meter_bar_h        = @progress.h       # the meter's filled bar height; images 1,7; u; replaces line*0.6, which 5.25 calls "not thin"
meter_gap          = @space.1          # gap between a meter and its neighbours; images 1,7; u; -> space.1
columns_block      = 6.8u              # height of a `columns` label-over-value block; images 1,9; u, 3u .. 14u; replaces px*2.6
dots_cell          = @dotmatrix.cell   # pitch of one cell in a `dots` element; image 1; u; replaces vh(0.8)*panel_scale
dots_cell_min_px   = 6px               # absolute floor for dots_cell; image 1; device px, 3px .. 16px; companion of dots_cell (3.2)
rule_width         = @stroke.hair      # width of a `line` element's horizontal rule; images 1-9; device px; -> stroke.hair
rule_block         = @space.4          # height a standalone `rule` element occupies in the stack (u2 3.1 #12); images 1,7; u; the line sits centred in it
rows_col_gap       = @space.4          # gap between the grid columns of a multi-column `rows` element (u2 2.3); images 1,7; u; -> space.4
group_gap          = @space.3          # gap above a `group` element's caption (u2 3.3); images 1,7; u; -> space.3
group_rule         = @stroke.hair      # the hairline under a `group` caption; images 1,7; str | none; none turns it off
spacer             = @space.4          # height of a `spacer` element; -; u; -> space.4
overflow           = scale             # policy for an overfull panel; -; one of scale | clip | scroll; scale keeps today's behaviour but stops at the floor below
overflow_min_scale = 0.62              # floor of the shrink-to-fit; below it, clip; -; f, 0.4 .. 1.0; stops role px drifting off the ladder (5.16). 0.62, NOT 5.29's 0.72: it matches the panel_font_scale clamp uptime and hardware sit on today — a 0.72 floor clips them under this very theme (u2 6.4). Raise to 0.72 only after u2 2.3/2.4's compact arrangements land

# ---- element role bindings -----------------------------------------------
# Every element kind maps to a type role (5.16, 24 names), and THESE KEYS ARE
# THE ONLY PLACE A SCRIPT'S TYPE SIZE IS CHOSEN. A call may not overrule one:
# `rows` and `columns` used to take label_role and value_role options, which
# is how the value half of four panels of the same kind came to be set at
# three different sizes — network at 1.87u, uptime at 3.25u, memory's headline
# figure at 1.77u UNDER its own swap readout. The options are gone; a widget
# says what an element IS and this block says how big that is.
# An unknown role name warns at load and draws NOTHING: there is no spare
# role, because a role is twelve tokens and a spare word would hide a whole
# ladder behind a name nobody wrote.
# TODO(default): the role bindings below are named tokens here; 5.29 states
# the bindings in its element table but does not spell the token names.
title_role         = title.panel   # role for a `title` element; images 1-10; type role; the in-body heading, not the host's panel band
text_role          = body          # role for a `text` element that names none; images 1,7; type role; the role of an element that states no role of its own — NOT a fallback for a role name that does not exist, which draws nothing
rows_label_role    = caption       # role for the PROCESOR: half of a `rows` line; images 1,7; type role; one label size for every widget on the screen
rows_value_role    = value         # role for the 74% half of a `rows` line; images 1,7; type role; ONE value size for every widget on the screen — steady figures come from type.value.tabular, never from dropping to a smaller role
meter_label_role   = caption       # role for a `meter`'s label; images 1,7; type role; = rows_label_role: a meter's label and a row's label are the same thing
meter_value_role   = value         # role for a `meter`'s numeric readout; images 1,7; type role; = rows_value_role: MEMORY's swap readout and its headline figure are one ladder
columns_label_role = caption       # role for a `columns` label; images 1,9; type role; = rows_label_role
columns_value_role = value         # role for a `columns` value; images 1,9; type role; = rows_value_role
table_head_role    = label.section # role for a `table` heading row; images 8,9; type role; -
table_cell_role    = data          # role for a `table` body cell; images 8,9; type role; mono, tabular — a table is a dense grid of its own, not a stack of rows lines, and one cell size holds across every table
badge_role         = badge         # role for the `badge` element's text; images 1,3,4; type role; the colours come from sev[i] at draw time
group_label_role   = label.section # role for a `group` element's caption (u2 3.1 #13); images 1,7; type role; the instrument label above a section

# ---- the kinds a script may name -----------------------------------------
# A `text` element and a `runs` item may say WHAT their string is —
# text(date, "center", #{ role: "date" }), #{ t: "0.42", role: "reading" } —
# and this closed list is what the word may be. It is a statement about the
# CONTENT, the same shape as severity: the script judges its data, the theme
# decides what that judgement looks like. A script may NOT name a type role
# here; that was the door through which `role: "data"` walked into
# network.rhai, and it took a 74% size cut with it because `data` was the only
# role that could be reached that also carried tabular figures.
#
# A word this block does not bind warns once and draws nothing — the same
# answer every missing binding gives. Adding a kind is one line here; it needs
# no code and no script rewrite anywhere else.
kind_clock_role    = display.clock # the running time itself, 21:57:30; images 1,2,9; type role; the one role large enough to read across a room, and tabular so the line does not shift when a 1 becomes a 2
kind_date_role     = display.date  # the date line under the clock; image 1; type role; a date is a number too — 14.11.2142 — and is set as one
kind_label_role    = caption       # a word naming the reading beside it: LOAD, STATE; images 1,7; type role; = rows_label_role, so a label is one size whether it stands in a row or on a line of runs
kind_reading_role  = value         # a measured quantity: a load average, a temperature, an address, a rate; images 1,7; type role; = rows_value_role. THIS is what network.rhai wanted when it reached for `data`: steady figures, which type.value.tabular now gives it at the size every other panel reads at
kind_text_role     = body          # running prose inside a line of runs; -; type role; = text_role, which is also what an item naming no kind gets

# ---- policy and remaining layout ----------------------------------------
severity_fallback  = unknown       # what an unrecognised severity: argument resolves to; -; severity role name; NEVER ok (5.10)
text_align         = left          # default alignment when a call omits it · images 1,7 · enum: left | center | right · script.rs caches these indices for the life of the process, so the list must be DECLARED and not discovered
table_zebra_every  = 2             # every Nth table row gets component.table.zebra; images 8,9; n, 0 .. 8; 0 disables striping
min_flex_h         = 5.2u          # minimum height a flexible element is given; -; u, 2u .. 12u; replaces script.rs:482's .max(px*2.0)
min_flex_h_min_px  = 12px          # absolute floor for min_flex_h; -; device px, 6px .. 32px; companion of min_flex_h (3.2)
dots_gap           = @space.1      # gap between the `dots` grid and its neighbours; image 1; u; -> space.1
dots_cols          = auto          # columns in a `dots` grid; image 1; n or the sentinel auto; auto fits the panel width to dots_cell
scroll_step        = @script.row_h # how far one wheel notch scrolls when overflow = scroll; -; u; -> script.row_h, so scrolling lands on rows


# ============================================================ 60-component

# #########################################################################
# 5.25 COMPONENT METRICS — the whole hard-coded-constant inventory.
#
# Everything below is a number the owner could not change before this
# engine existed: 214 geometric constants that lived in `draw.rs`,
# `winframe.rs`, `ui.rs`, `slider.rs`, `dropdown.rs` and the plugins.
# Lengths are `u`-multiples (metric.unit_pct_h is the root); `px` appears
# ONLY on a *_min_px / *_max_px companion (3.2); a ratio's right-hand side
# is always a reference (3.2). Comment format is the lint of 5.0b:
#   # <what it draws> · <reference image> · <unit / legal range> · <derivation>
#
# TODO(default): every VALUE below is the one 5.25 states. Where 5.25 gave
# a default word without naming the rest of its enum, the sibling words in
# the third comment field are inferred from the reference images and from
# the sibling family that already has a stated domain — they document the
# domain, they do not change any default. The inferred ones are:
# meter.bar_align, cycler.value_align, nodegraph.node_shape, donut.track,
# scrollbar.track, scrollbar.edge, dock.edge, keyboard.sub_corner,
# boards.tile.aspect, control.button.align, rhythm.snap_origin,
# rhythm.label_align, rhythm.value_align, topbar.sep (5.25 names its five),
# tile.shape (5.25 names its four). Lead to confirm or trim.
# #########################################################################

# =========================================================================
# titlebar — the shared root. ONE number makes window bars and panel title
# bands agree; before this, panel buttons were sized off winframe.title_h,
# a token belonging to the frame around a FOREIGN window.
# =========================================================================
[titlebar]
h = @size.md                        # generic title-bar height, the root of panel bands and window bars · images 1,7 · len (u) · @size.md = 5.2u = 28.1 px

# =========================================================================
# layout — the board's own spacing, outside every panel's border. One key,
# and it exists because [CONFLICT 4] resolved only half of itself: renaming
# panel.pad to panel.content_pad handed the OUTER dimension to the user's
# GridPadding= and then left nothing on the theme's side for that setting to
# override. The result is a flat 8 device px around every panel on every
# board, at every resolution and every density, which no theme can reach —
# the one length in the interface that is not a length in this file.
#
# A user's GridPadding= is a stage-5 override of THIS key, exactly as
# Density= is of metric.density: the user wins, and the theme still gets to
# say what the interface looks like before the user has said anything.
# =========================================================================
[layout]
panel_gutter = @space.3             # the band kept clear around EVERY panel on a board, outside its border; two neighbours are therefore twice this apart · images 1-10 · len (u) · @space.3 = 1.5u = 8.1 px, which is config.rs's flat 8 px at the 1080p reference — the same picture, now on the u ladder and under metric.density_space

# =========================================================================
# panel — the base container, drawn by the host (5.12). Parts, outside in:
# gutter (layout.panel_gutter, which a user's GridPadding= overrides at
# stage 5) → border → fill/glass → content pad → title band (left text,
# right text, rule) → body.
# =========================================================================
[panel]
title_right_color = @text.muted     # the right half of a panel heading: a cwd, a CPU model · 1 · col · @text.muted; draw.rs draws both halves one colour today
content_pad = 2.8u                  # inset from the panel border to its content · images 1-10 · len (u) · renamed from panel.pad, which collided with the user's GridPadding [CONFLICT 4]
# TODO(default): the 5.25 table spells the next two `inherit`; 5.0's
# sentinel table is authoritative, lists panel.content_pad_x/_y under
# `same_as_parent`, and reserves `inherit` for the mood/base chain alone.
content_pad_x = same_as_parent      # horizontal half of content_pad, split when a theme wants it · images 1-10 · sentinel | len (u) · same_as_parent = @panel.content_pad
content_pad_y = same_as_parent      # vertical half of content_pad · images 1-10 · sentinel | len (u) · same_as_parent = @panel.content_pad
corner = @corner.md                 # panel corner radius · images 1,7 ("~8 px at 1440p") · len (u) · @corner.md = 1.2u = 6.5 px
corner_mode = @corner.mode          # how that radius is cut · images 1,7 · enum: round | chamfer · @corner.mode, the one place this file states its corner language
border = @stroke.hair               # the resting panel ring · images 1-10, the brief's "thin glowing 1px border" · str · @stroke.hair
border_focused = @stroke.regular    # the ring when the panel is the focused container · image 7 · str · @stroke.regular
min_content_h = @rhythm.row         # the content box a short panel is never squeezed under; the container's degradation ladder (u2 §4.2) starts when the box would fall below it · images 1-10 · len (u) · @rhythm.row = 27.0 px
title.band_h = @titlebar.h          # height of the title band itself · images 1-10 · len (u) · was 4.6u; retargeted to the shared root, a 3.3 px change
title.band_h_min = @size.xs         # the collapsed band: step 2 of the degradation ladder shrinks the band to this before dropping it (u2 §4.2) · images 1-10 · len (u) · @size.xs = 3u = 16.2 px
title.block_h = 6.8u                # band + the gap below it, i.e. what the body starts after · images 1-10 · len (u) · today px*2.6 / title_px*2.8
title.inset_x = 1.6u                # left/right inset of the title text inside the band · images 1-10 · len (u) · today px*0.6
title.gap = 4.7u                    # minimum gap between the left title and the right title · images 1,7 · len (u) · today px*1.8
title.rule = @stroke.hair           # the hairline under the title band · images 1-6 · str | none · none turns it off
title.rule_inset = @space.0         # how far that rule is pulled in from the panel edges · images 1-6 · len (u) · @space.0 = 0u
title.role = title.panel            # the type role the title text is set in · images 1-10 · role · type.title.panel
glass.rect = border_box             # which rectangle the glass quad fills · image 7 · enum: border_box | content_box · -
glass.inset = @space.0              # shrink the glass quad inside the border · image 7 · len (u) · @space.0 = 0u
elev = panel                        # which Elev level a resting panel draws its material from · images 1-10 · elev ref · elev.panel (5.12)
# TODO(panel.button): the six `button.*` keys below have NO reader, and
#   batch 7 of the 2026-08-17 audit did not give them one although Z25
#   named them. They are not a wiring job: a panel draws no controls at
#   all today, so closing them means building the control row first — and
#   that row is the same row `[winframe]` already declares, which under
#   the one-window-model rule belongs in ONE place rather than being grown
#   twice. Carried OUT of batch 7 explicitly, not counted as closed.
button.size = 0.62x @titlebar.h     # drawn size of a panel's own window control · images 1,7 put `_ ✕` and `_ □ ✕` ON panels · rat of @titlebar.h · 17.4 px
button.pad = 0.30x @titlebar.h      # padding around that control · images 1,7 · rat of @titlebar.h · 8.4 px
button.gap = 0.22x @titlebar.h      # gap between two panel controls · images 1,7 · rat of @titlebar.h · 6.2 px
button.order = [minimise, maximise, close]   # right-to-left order of a panel's own controls · images 1,7 · list of one word per slot: minimise | maximise | close | none · read exactly as @winframe.button.order: three slots, a subset is spelled by writing `none` into a slot rather than by handing back a shorter row, which the cascade rejects outright
button.icon_stroke = @stroke.thin   # line weight of the glyph inside a panel control · images 1,7 · str · @stroke.thin
button.corner = @corner.none        # corner radius of a panel control's hit plate · images 1,7 · len (u) · @corner.none = 0u
button.corner_style = @button.corner_style  # which shape that plate's corners take · images 1,7 · enum: square | round | chamfer · follows the button: the plate is the control's whole hit target, and a hit target answers in the control language — the reason list.corner_style already gives for the row plate. The master's radius is 0u, so the cut is invisible until a theme states a radius

# =========================================================================
# topbar — NEW, and it was missing entirely. The full-width status bar of
# images 1, 2, 3, 4 and 6: three clusters (product+date+clock left, product
# + alarm centre, status glyphs + stamp right). It had colours and one
# state and NOT ONE metric. `alarm_bar` is not a separate object: it is
# topbar's alarmed state, and component.alarm_bar.* are that state's
# colours (5.26).
# =========================================================================
[topbar]
h = @size.md                        # height of the bar itself · images 1,2,3,4,6 · len (u) · @size.md = 5.2u = 28.1 px
pad_x = @space.5                    # left/right margin of the two outer clusters · images 1,2,3,4,6 · len (u) · @space.5 = 3u = 16.2 px
pad_y = @space.1                    # top/bottom padding inside the bar · images 1,2,3,4,6 · len (u) · @space.1 = 0.5u = 2.7 px
rule = @stroke.hair                 # the line under the bar · images 1,2,3,4,6 · str | none · none turns it off
rule_color = @border.subtle         # colour of that line · images 1,2,3,4,6 · col · @border.subtle
elev = panel                        # which Elev the bar's material comes from · images 1,2,3,4,6 · elev ref · elev.panel (5.12)
cluster_gap = @space.6              # minimum gap between the three clusters · images 1,2,3,4,6 · len (u) · @space.6 = 4u = 21.6 px
sep = pipe                          # the divider inside a cluster; geometry when `rule`, a glyph otherwise · images 1,2,3,4,6 show `|` · enum: pipe | bullet | slash | space | rule · -
sep_pad = @space.2                  # padding either side of that divider · images 1,2,3,4,6 · len (u) · @space.2 = 1u = 5.4 px
glyph = @icon.size.sm               # size of one glyph in the right-hand status run · images 1,2,3,4,6 · len (u) · @icon.size.sm = 11.9 px
glyph_gap = @space.2                # gap between those glyphs · images 1,2,3,4,6 · len (u) · @space.2 = 1u = 5.4 px
left.role = caption                 # type role of the left cluster (OS name, date, clock) · images 1,2,3,4,6 · role · type.caption
center.role = label.section         # type role of the centre cluster (product name) · images 1,2,3,4,6 · role · type.label.section
right.role = caption                # type role of the right cluster (glyph run, stamp) · images 1,2,3,4,6 · role · type.caption
alarm.role = alert.banner           # type role of the amber alarm half of the centre cluster · images 1,4 · role · type.alert.banner
alarm.pulse = true                  # whether the alarm half participates in motion.alarm_blink · image 6 sets false and gets the ordinary accent · bool · -

# =========================================================================
# render — NEW, and it was missing entirely. The central wireframe: the
# station, the planet, the orbit lines and the ship silhouette that fill
# the largest panel of images 1-6. The catalogue previously offered ONE
# colour (data.line) for something the brief paints in five separate
# parts; three of the six console images were unreproducible.
# =========================================================================
[render]
text_gamma = 0.72                   # exponent on atlas coverage before the alpha multiply · - · f, 0.45 .. 2.2 · measured on 1440p shots: 0.72 restores +13.5% stem width to light-on-dark text by fattening only pixels the glyph already owns; 0.55 and below spill into new pixels (bloom, not weight). 1.0 = raw coverage
vector = false                      # whether ring/ring_fill ride the SDF vector lane (one analytic quad, smooth corners) instead of the tessellated ring generator · - · bool · literal by rule: false until f3 K3d. THE TOKEN IS LIVE as of K3a — nacelle-desktop/src/vector.rs reads it at every frame boundary and arms the screen's list, so true and false now draw different pictures. R4 is CLOSED (bed, state wash and border are one record with one antialiased edge — draw.rs, Weld) and GLASS IS ONE RECORD TOO as of K3b (the frost's core rides GLASS_RANK_*, its perimeter rides SHAPE_GLASS_*, so the frost's corners are as analytic as the border over them, §3.3). THREE things still hold the switch down. Cost: measured in .gap-program/pomiar-wektor-k3c.md — one shape fragment is 87 compute instructions against 13 on the fill path, and the core cut that halves the field area costs TWO RUNS PER SHAPE (a board of 204 silhouettes goes from 1 draw call to 408). A FRACTIONAL glass.rank is two rungs, hence two records, whose outer edges blend twice (glass_fill says so at the code, and rank is a float, so a theme may write 1.5). A GRADIENT edge does not weld, which is ring_grad's own note from K3. Raising this is K3d and belongs to the owner, on those numbers
# `blur_clear` stood here and is GONE (2026-08-18). It promised "what the blur pyramid's
# borders resolve to where it samples past its own edge", and cited gfx.rs clearing to
# [0.0;4]. Measured on the shipped renderer, no part of that describes this program: the
# pyramid's downsample passes do clear to transparent black, but each then draws a quad
# covering the whole target through a CLAMP_TO_EDGE sampler, so the clear is overdrawn to
# the last pixel and nothing ever samples past an edge; and the pyramid's BASE level clears
# to the swapchain colour, which is `surface.void` through deco::clear_color and belongs to
# the screen's background, not to the blur. The key had no reader in libnacelle, in the
# desktop or in the renderer, and no reader it could honestly be given — a key that looks
# like it works is worse than a missing one (theme/edit.rs says so at its own head). What
# it was reaching for — a frost that comes up black — was a ground the standing frame never
# laid; that is fixed where it lives, in deco::board_ground's callers.
wire = @data.line                   # the wireframe lines themselves · images 1,2,5,6 · col · @data.line
wire_width = @stroke.chart          # their weight · images 1,2,5,6 · str · @stroke.chart
hull = sat(@data.line, 0.0)         # the body between the wires; images 4/5's greyscale hull IS this default, image 1's cyan hull is @data.line · images 1,3,4,5 · col · sat() desaturates the data hue in OKLab (6)
hull_alpha = 0.22                   # how solid that body reads · images 3,4,5 · frac 0..1 · -
rim = @accent.primary               # the rim light along the hull silhouette · image 3 green, image 4 red · col · @accent.primary
rim_width = @stroke.regular         # width of the rim light · images 3,4 · str · @stroke.regular
orbit = alpha(@data.line, 0.55)     # orbit lines around the station or planet · images 5,6 · col · @data.line at 0.55
orbit_width = @stroke.hair          # their weight · images 5,6 · str · @stroke.hair
orbit_dash = none                   # dashed orbits are N short quads, not a dash pattern · images 5,6 · none | len (u) · none draws a solid arc
planet = alpha(@data.line, 0.35)    # the disc behind the station · images 1,2,5 · col · @data.line at 0.35
planet_terminator = alpha(@palette.black, 0.55)   # the planet's night side · images 1,5 · col · @palette.black at 0.55
silhouette = alpha(@data.line, 0.75)              # image 1's small ship at the right of the render · image 1 · col · @data.line at 0.75
label_role = leader.label           # type role of callouts drawn on the render · images 1,5 · role · type.leader.label

# =========================================================================
# dot — NEW. The unread marker of `POWIADOMIENIA (4 NOWE)`, image 7's
# "red dot". badge.* is the CRITICAL/CONTAINED pill, list.glyph is a row's
# leading chip and dock.active_indicator is the taskbar; none of the three
# is a dot attached to a title, an icon or a dock item.
# =========================================================================
[dot]
r = 0.55u                           # radius of the dot · images 7,8,9,10 · len (u) · 3.0 px
offset_x = 0.6u                     # horizontal offset from the anchor point · images 7,8,9,10 · len (u) · -
offset_y = -0.6u                    # vertical offset; negative lifts it above the anchor · images 7,8,9,10 · len (u) · -
anchor = title_right                # what the dot attaches to · images 7,8,9,10 · enum: title_right | icon_tr | row_left | dock_item_tr · -
fill = @severity.critical.text      # the dot's colour; the drawn owner is component.dot.fill (5.26) · image 7 names it "a red dot" · col · @severity.critical.text
border = @stroke.hair               # the halo ring that separates it from the title behind · images 7,8,9,10 · str · @stroke.hair
count_role = badge                  # type role of the number inside a counting dot · images 7,9 (`4 NOWE`) · role · type.badge
count_min_w = 3.2u                  # minimum width so a two-digit count stays a lozenge · images 7,9 · len (u) · 17.3 px
count_pad = 0.6u                    # padding around that number · images 7,9 · len (u) · 3.2 px

# =========================================================================
# winframe — the frame around a window the toolkit does not own. Everything
# below the title bar is a RATIO of winframe.title_h, which is how the code
# already works and is the right shape: chunky window chrome is one number.
# =========================================================================
[winframe]
title_h = @titlebar.h               # the window title bar height · images 7,8 · len (u) · exactly today's vh(2.6); shared root
border = @stroke.regular            # the frame ring · images 7,8 · str · today (vh*0.18).max(1.5) = 1.94
corner = @corner.lg                 # frame corner radius · images 7,8 · len (u) · @corner.lg = 2.2u = 11.9 px
corner_mode = @corner.mode        # how that corner is cut · images 7,8 · enum: round | chamfer · @corner.mode, the one place this file states its corner language
# The grip band lies OVER the title bar at the top edge and resize wins
# over the title, so a band as deep as the bar leaves no title left to drag
# by: at 1.1x this was 30.9 px against a bar of border + title_h = 30.0, and
# the window could be resized from anywhere in its title bar and moved from
# nowhere at all. It has to stay a fraction of the bar, not a multiple.
grip = 0.3x @titlebar.h             # resize HIT band only, nothing is drawn · - · rat of @titlebar.h · 8.4 px, over the 8 px floor below and well inside the bar it overlaps
grip_min_px = 8px                   # absolute floor for grip · - · device px · companion of winframe.grip (3.2)
corner_zone = 1.0x @titlebar.h      # edge length counting as a corner for resize · - · rat of @titlebar.h · 28.1 px
button.size = 0.62x @titlebar.h     # drawn size of a window control; the hit rect grows to a11y.min_hit · images 7,8 · rat of @titlebar.h · 17.4 px
button.pad = 0.30x @titlebar.h      # padding around a window control · images 7,8 · rat of @titlebar.h · 8.4 px
button.gap = 0.22x @titlebar.h      # gap between window controls · images 7,8 · rat of @titlebar.h · 6.2 px
button.order = [minimise, maximise, close]   # right-to-left order of the window controls · images 7,8 · list of one word per slot: minimise | maximise | close | none · THREE slots, fixed by this line: a theme rewrites a slot, it cannot lengthen or shorten the row, and a slot reading `none` draws nothing — that is how a control is dropped. A consumer compares the WORD of each slot, never an index: an array declares its slots one at a time, so each slot's vocabulary is its own literal and index 0 means a different word in every slot
button.corner = @corner.none        # corner radius of a control's hit plate · images 7,8 · len (u) · @corner.none = 0u
button.corner_style = @button.corner_style  # which shape that plate's corners take · images 7,8 · enum: square | round | chamfer · follows the BUTTON, not the frame: a control standing on the chrome is still a control, and the frame's own cut is @winframe.corner_mode above
button.border = @stroke.hair        # ring around a control's hit plate · images 7,8 · str · @stroke.hair
icon.stroke = @stroke.thin          # line weight of the glyph inside a control · images 7,8 · str · today a flat 1.5
icon.inset = 0.27x @winframe.button.size   # inset of the glyph inside its plate · images 7,8 · rat of @winframe.button.size · unified from today's 0.26/0.28/0.26
icon.menu_rows = 3                  # number of hamburger lines · images 7,8 · n · -
icon.menu_pitch = 0.20x @winframe.button.size   # spacing between those lines · images 7,8 · rat of @winframe.button.size · 3.5 px
icon.minimise_y = 0.68x @winframe.button.size   # where the minimise bar sits inside the plate · images 7,8 · rat of @winframe.button.size · 11.8 px
title.role = title.window           # type role of the window title · images 7,8 · role · type.title.window
title.align = center                # where that title sits in the bar · images 7,8 · enum: left | center · -
title.room_pad = 1.2x @type.title.window.size   # room kept clear either side of a centred title · images 7,8 · rat of @type.title.window.size · 16.8 px
rule = @stroke.hair                 # the title bar's floor line · images 7,8 · str | none · @stroke.hair

# =========================================================================
# menu — the window menu (winframe.rs) and the settings drop-down
# (dropdown.rs) were the same object drawn twice with different numbers.
# UNIFIED here. The context menu (menu.rs) reads the same table plus the
# hint/chevron/rule/submenu keys below, which the two older menus ignore.
# =========================================================================
[menu]
row_h = 1.05x @titlebar.h           # one menu row · - · rat of @titlebar.h · 29.5 px; raised from 0.85x (23.9 px) at the owner's ask 2026-08-16 — the unfolded elements sat too tight
pad = 0.35x @menu.row_h             # padding inside the menu box · - · rat of @menu.row_h · 8.4 px
min_w = 7.0x @titlebar.h            # minimum menu width · - · rat of @titlebar.h · 196.6 px
corner = 0.5x @winframe.corner      # menu corner radius · - · rat of @winframe.corner · 5.9 px
corner_mode = @winframe.corner_mode # how that radius is cut · - · enum: round | chamfer · @winframe.corner_mode; the window menu and the context menu are ONE object drawn twice, so the cut is decided once, where the radius already is
border = @stroke.hair               # the ring around the menu BOX · - · str · @stroke.hair; a ROW's ring is not this: a row is an instance of the menu.item class, whose ladder states an edge_width per rung (5.27), and the drop-down used to borrow this key for it — which pinned every row to one width and left the selected rung's thicker ring unreachable
# TODO(default): 5.25 spells this `menu`, but `menu` is not one of 5.16's
# 20 named type roles and 5.25 itself glosses it "(→ body)". Written as the
# role that exists; if a `menu` role is added to 5.16, change this line.
item.role = body                    # type role of a menu row's label · - · role · type.body, which 5.25's gloss names as the target anyway
item_inset = 0.7x @menu.row_h       # left inset of a row's label · - · rat of @menu.row_h · 20.7 px; raised with row_h 2026-08-16, the same ask
item_text_threshold = 0.7x @menu.row_h   # below this height an unfolding row draws no text · - · rat of @menu.row_h · 16.7 px
anchor_gap = @space.1               # the air between a control that unfolds and every element it unfolds · - · len (u) · @space.1 = 0.5u = 2.7 px; the smallest step that leaves BACKGROUND between two rings
# ONE number, used twice over. A drop-down is no longer a box with rows
# inside it: it is the anchor plus N separate elements, each dressed as the
# anchor is — same plate, same ring, same corner, same class ladder. Two
# complete rounded frames flush against each other stroke their shared edge
# twice, and each one's corner curves into the other's so the rounding reads
# as cancelled; this is the air that stops that happening. The owner asked
# for every element of the list to be spaced exactly like the first, so the
# SAME token stands between the anchor and element 0 and between element i
# and element i+1. A list that took its outer gap from here and its inner
# gap from `[list].gap` could not answer that with one line, which is why
# the drop-down reads neither `[list].gap` nor `[list].rule` any more —
# those are the furniture of a list drawn as one body, and this one is not.
# The gap does not scale with the unfold: it is a distance between two
# finished objects, not a share of an animation.
anchor_width = anchor               # whether the menu takes its anchor's width or its own minimum · - · enum: anchor | min_w · -; context menus always size to content over the min_w floor
# THE FRAME of an unfolded body. A drop-down grows one pitch per element,
# and a list of forty themes or four hundred font families used to hang
# past the desktop's edge — pressable where it could not be seen. Past
# this share of the viewport's height the blind stops and the body
# SCROLLS inside its frame instead: the wheel moves it, the toolkit's
# scrollbar stands in the inset lane beside the slats, and an element
# outside the frame neither draws nor answers the mouse.
max_h_frac = 40%                    # the tallest unfolded body, from the anchor's underside down · - · % of the viewport height · 432 px @1080p ≈ 13 elements; a longer list scrolls (M8, 2026-08-16)
max_h_min_px = 96px                 # absolute floor for max_h_frac's result · - · device px · companion of menu.max_h_frac (3.2); a tiny window still shows a few elements
rule = @stroke.hair                 # the separator between menu groups · - · str | none · @stroke.hair
hint_role = caption                 # type role of the shortcut hint at a row's right edge · - · role · type.caption
hint_gap = @space.4                 # gap between the label column and the hint column · - · len (u) · @space.4 = 2u = 10.8 px
chevron_w = 2u                      # the submenu chevron's glyph box · - · len (u) · 10.8 px
chevron_stroke = @stroke.thin       # the chevron's line weight · - · str · @stroke.thin
rule_pad = 0.35x @menu.row_h        # vertical breathing around a separator rule · - · rat of @menu.row_h · 8.4 px
submenu_overlap = 1u                # how far a submenu tucks under its parent's edge · - · len (u) · 5.4 px

# =========================================================================
# button — the parallelogram. skew is UNIFIED: button.rs used 0.7 and the
# control plugin 0.55 for the same object, and 0.7 eats 32 px of label room
# on a 45 px button.
# =========================================================================
[button]
icon_skew_frac = 0.8                # where a glyph anchors along the skewed edge · - · frac · was ax = skew * 0.8 in settings.rs
h = @size.xl                        # button height · images 1,7 · len (u) · @size.xl = 8.4u = 45.4 px
skew = 0u                           # horizontal shear that makes a parallelogram · images 1,7 · len (u) · 0u: a button wears the FRAMES' corners now (below), and a shear on top of them would be two shapes at once; a theme that wants image 1's slant back gives this a width again
corner = @elev.panel.radius         # corner radius · images 1,7 · len (u) · the panel's own radius: a control inside a frame answers with the frame's shape, so the decision is made once
corner_style = @elev.panel.corner   # which shape those corners take · images 1,7 · enum: square | round | chamfer · follows the panel for the same reason as the radius; a theme may still pin the button alone
border = @stroke.hair               # the resting ring · images 1,7 · str · @stroke.hair
border_hover = @stroke.hair         # the hovered ring; brightness carries hover, not thickness · image 7 · str · @stroke.hair
pad_x = @space.5                    # left/right padding around the label · images 1,7 · len (u) · @space.5 = 3u = 16.2 px
role = button                       # type role of the label · images 1,7 · role · type.button
icon_size = 0.14x @button.h         # a leading glyph such as the BACK arrow · image 7 · rat of @button.h · 6.4 px
icon_size_min_px = 4px              # absolute floor for icon_size · - · device px · companion of button.icon_size (3.2)
icon_gap = @space.2                 # gap between that glyph and the label · image 7 · len (u) · @space.2 = 1u = 5.4 px
min_w = 14u                         # minimum width, so a two-letter label is still a button · images 1,7 · len (u) · 75.6 px
emphasis_from_severity = false      # whether a destructive caption's button (the control panel's EXIT) draws its ring, label and glyph in severity.critical · 5 (SYSTEM LOCKDOWN, larger and brighter than its neighbours) · bool · off: both control buttons rest on the class ladder alone, which is today's look (u2 §2.12 — the theme's decision, never the plugin's)

# =========================================================================
# iconbtn — image 1's row of five square icon buttons. No such object
# exists in code; it is built out of rect_outline by hand in three places.
# =========================================================================
[iconbtn]
size = @size.lg                     # the square's side · image 1 (PREFERENCJE SYSTEMOWE) · len (u) · @size.lg = 6.5u = 35.1 px
icon = 0.5x @iconbtn.size           # the glyph inside it · image 1 · rat of @iconbtn.size · 17.6 px
corner = @corner.sm                 # the square's corner radius · image 1 · len (u) · @corner.sm = 0.8u = 4.3 px
corner_style = @button.corner_style # which shape that radius is cut to · image 1 · enum: square | round | chamfer · follows the button, because that is what this is: a button whose label is a glyph
border = @stroke.hair               # its ring · image 1 · str · @stroke.hair
gap = @space.3                      # gap between two icon buttons in the row · image 1 · len (u) · @space.3 = 1.5u = 8.1 px
stroke = @stroke.thin               # line weight of the glyph · image 1 · str · @stroke.thin

# =========================================================================
# tile — a launcher tile: an icon over a wide-tracked caption.
# =========================================================================
[tile]
size = @size.2xl                    # the tile's side · images 1,8 · len (u) · @size.2xl = 12u = 64.8 px
shape = @corner.mode                # the plate the glyph sits on, and the cut of @tile.corner · images 1,8 · enum: round | hex | chamfer | square · @corner.mode, so a launcher tile is cut in the same language as everything around it; the vocabulary stays WIDER than a cut because `hex` is a plate this file can ask for and no corner word can say, and a theme reaching for it writes the word here and leaves the language behind on purpose
corner = @corner.md                 # radius when shape is round or chamfer · images 1,8 · len (u) · @corner.md = 1.2u = 6.5 px
icon = 0.5x @tile.size              # the glyph inside the plate · images 1,8 · rat of @tile.size · 32.4 px
border = @stroke.hair               # the resting ring · images 1,8 · str · @stroke.hair
border_active = @stroke.bold        # the ring of the active tile · image 5's larger, brighter SYSTEM LOCKDOWN · str · @stroke.bold = 4 px
caption_gap = @space.2              # gap between plate and caption · images 1,8 · len (u) · @space.2 = 1u = 5.4 px
caption_role = caption              # type role of the caption · images 1,8 · role · type.caption
caption_lines = 1                   # how many lines a caption may wrap to · images 1,8 · n · -
gap_x = @space.5                    # horizontal gap between tiles · images 1,8 · len (u) · @space.5 = 3u = 16.2 px
gap_y = @space.6                    # vertical gap; a caption needs more room below than beside · images 1,8 · len (u) · @space.6 = 4u = 21.6 px
cols = 3                            # tiles per row in the launcher grid · image 1 (two rows of three) · n · -
scale_active = 1.15                 # how much larger the active tile draws · image 5 · f · a multiplier, not a ratio

# =========================================================================
# checkbox
# =========================================================================
[checkbox]
size = 2.8u                         # the box itself · - · len (u) · 15.1 px; today 0.55x row_h
border = @stroke.thin               # its ring · - · str · today a flat 1.5
corner = @corner.none               # its corner radius · - · len (u) · @corner.none = 0u
corner_style = @button.corner_style # which shape that radius is cut to · - · enum: square | round | chamfer · follows the button: the box IS the control, and a rounded box beside a chamfered button is two corner languages in one row. The master's radius is 0u, so the cut is invisible until a theme states a radius — which is exactly when it has to be stated
tick_inset = 0.22x @checkbox.size   # inset of the mark inside the box · - · rat of @checkbox.size · 3.3 px
tick_shape = square                 # what the checked mark is · - · enum: square | check | cross · -
tick_stroke = @checkbox.border      # line weight of the check or the cross · - · str · @checkbox.border, which is the weight the mark borrowed while it had no key of its own; a theme wanting a thin tick inside a heavy ring can now say so
label_gap = @space.3                # gap between box and label · - · len (u) · today px*0.8
role = body                         # type role of the label beside the box · - · role · type.body, the size a line of prose reads at; the binding every sibling control already carries (segmented.role, tab.role, button.role)
row_h = @size.lg                    # the hit target, deliberately larger than the box · - · len (u) · @size.lg = 6.5u = 35.1 px

# =========================================================================
# slider — slider.rs has no hover, no drag and no disabled today; a
# dragging slider looks identical to a resting one. 5.27 closes that.
# =========================================================================
[slider]
track_color   = @surface.sunken     # the groove behind the knob · - · col · @surface.sunken; recessed like a trough but interactive (m1 §3.2)
fill_color    = @accent.primary     # the filled part of the groove · - · col · @accent.primary; slider.rs:14 was base at full alpha
knob_color    = @accent.primary     # the handle itself · - · col · @accent.primary; slider.rs:16
row_h = @size.xl                    # the whole slider row, i.e. the hit target · - · len (u) · @size.xl = 8.4u = 45.4 px
track_h = @stroke.bold              # the track's thickness · - · str · 4 px; today a flat 2.0
track_corner = @corner.pill         # the track's end caps · - · len (u) | pill · @corner.pill = h/2
track_corner_style = @button.corner_style   # which shape those caps are cut to · - · enum: square | round | chamfer · follows the button: @corner.pill is a CAPSULE only while the cut is round, and a chamfered interface asks for a bevelled groove instead
fill_h = same_as_parent             # the filled part's thickness · - · sentinel | str · same_as_parent = @slider.track_h
knob_w = 1u                         # the knob's width · - · len (u) · 5.4 px; today 0.28x track.h, which depended on the ROW height
knob_h = 3u                         # the knob's height · - · len (u) · 16.2 px
knob_corner = @corner.none          # the knob's corner radius · - · len (u) · @corner.none = 0u
knob_corner_style = @slider.track_corner_style  # which shape the knob's corners take · - · enum: square | round | chamfer · follows the track it rides in: a knob cut one way inside a groove cut another is two controls, not one
# TODO(default): 5.25 spells this `0`; a bare number on a stroke is a
# diagnostic (3.2), so the sentinel that means "draw nothing" is used —
# the same spelling list.rule already uses for the same idea.
knob_border = none                  # the knob's ring · - · str | none · none = draw no ring
tick_count = 0                      # discrete tick marks along the track; 0 draws none · - · n · -
tick_h = 1u                         # the height of one tick · - · len (u) · 5.4 px

# =========================================================================
# cycler — a value with a chevron either side.
# =========================================================================
[cycler]
h = @size.xl                        # the cycler's height · - · len (u) · @size.xl = 8.4u = 45.4 px
chevron_w = 3u                      # width of one chevron hit plate · - · len (u) · 16.2 px
chevron_stroke = @stroke.thin       # line weight of the chevron · - · str · @stroke.thin
gap = @space.3                      # gap between chevron and value · - · len (u) · @space.3 = 1.5u = 8.1 px
value_align = center                # where the value sits between the chevrons · - · enum: left | center | right · -
border = @stroke.hair               # the cycler's ring · - · str · @stroke.hair
corner = @button.corner             # the plate's corner radius · - · len (u) · @button.corner — a cycler is a plate on a settings row like the buttons above and below it, and the owner's report of 2026-08-18 was that this ONE row's corners differed from the whole page's. It was not a theme that differed: the drawing spelled a plain rect and no key here could say otherwise
corner_style = @button.corner_style # which shape that radius is cut to · - · enum: square | round | chamfer · follows the button for the same reason the radius does, and by the same reference the segmented cell and the checkbox already use. Pointed at the button rather than at @corner.mode so that a theme pinning its buttons alone moves this row with them — which is what "the same corners as the rest" means on a page made of buttons

# =========================================================================
# segmented — a row of mutually exclusive cells.
# =========================================================================
[segmented]
h = @size.xl                        # the control's height · - · len (u) · @size.xl = 8.4u = 45.4 px
gap = @space.5                      # gap between cells · - · len (u) · @space.5 = 3u = 16.2 px
corner = @corner.sm                 # a cell's corner radius · - · len (u) · @corner.sm = 0.8u = 4.3 px
corner_style = @button.corner_style # which shape those corners take · - · enum: square | round | chamfer · follows the button, whose class ladder this control already borrows (5.27); a cell that borrows the ladder and not the shape is a second button
border = @stroke.hair               # a resting cell's ring · - · str · @stroke.hair
border_active = @stroke.regular     # the selected cell's ring · - · str · @stroke.regular
pad_x = @space.3                    # left/right padding inside a cell · - · len (u) · @space.3 = 1.5u = 8.1 px
min_cell_w = 10u                    # minimum cell width · - · len (u) · 54.0 px
role = button                       # type role of a cell's label · - · role · type.button — the class matrix (5.27) already lends this control the button's ladder, and the label follows the ladder

# =========================================================================
# field — image 7's `browser` search box. Drawn by object/text_input.rs
# (F1 §3); nothing at boot contains one, so every key here is read only
# after a field exists on screen.
# =========================================================================
[field]
h = @size.lg                        # the field's height · image 7 (the search field) · len (u) · @size.lg = 6.5u = 35.1 px
pad_x = @space.4                    # left/right padding inside the field · image 7 · len (u) · @space.4 = 2u = 10.8 px
corner = @corner.sm                 # the field's corner radius · image 7 · len (u) · @corner.sm = 0.8u = 4.3 px
corner_style = @button.corner_style # which shape those corners take · image 7 · enum: square | round | chamfer · follows the button, which follows the panel: a theme that chamfers its controls must not leave the one control you type into rounded
border = @stroke.hair               # the resting ring · image 7 · str · @stroke.hair
border_focused = @stroke.regular    # the ring while the field has the caret · image 7 · str · @stroke.regular
icon = 3u                           # the leading search glyph · image 7 · len (u) · 16.2 px
icon_gap = @space.2                 # gap between that glyph and the text · image 7 · len (u) · @space.2 = 1u = 5.4 px
caret_w = @stroke.thin              # the caret's width · image 7 · str · @stroke.thin
caret_h = 1.2x @type.body.size      # the caret's height · image 7 · rat of @type.body.size · 16.8 px
caret_style = bar                   # what the caret is · image 7 · enum: bar | block | underline · -
role = field                        # type role of the typed text · image 7 · role · type.field — the role table's own "text typed into a field" row
scroll_margin = 2u                  # the caret's distance from either edge before the view slides · - · len (u) · 10.8 px
preedit_underline = @stroke.thin    # underline beneath IME composing text · - · str · @stroke.thin
mask_glyph = bullet                 # what a masked char draws as · - · enum: bullet | asterisk | block · bullet is the unknown-word fallback in code

# =========================================================================
# picker — the colour picker (object/color_picker.rs): a field of hue by
# saturation, a value bar beside it, the chosen colour as a patch, that
# colour written out in one of six notations, and two grids of
# ready-made colours. Everything the control is MADE of is here; what it
# is made of in COLOUR is in [component] under `picker.*`.
#
# It replaced three sliders per colour in the theme editor on 2026-08-18
# (owner's wish, after a picker he showed from another desktop). Nothing
# about its proportions is in Rust: the split between the field and the
# text side, how finely the hue circle is sampled, how many cells a grid
# is wide and which colours the first grid offers are all decisions a
# theme makes.
# =========================================================================
[picker]
gap = @space.3                      # between the field, the bar and the column beside them · - · len (u) · @space.3 = 1.5u = 8.1 px
pad_x = @space.3                    # inside the two plates, between the ring and the ink · - · len (u) · @space.3 = 1.5u = 8.1 px; the dense-readout inset, as [cell] uses, not the roomier @space.4 a text field wears
field_h = 26u                       # the hue-by-saturation field's height · - · len (u) · 140.4 px; tall enough to aim inside, short enough for a settings row
field_w_frac = 0.58                 # how much of the band the field and its bar take, the rest being the patch and the grids · - · frac, 0.1 .. 0.9 · a little over half: the field is the control, everything beside it is a shortcut to a colour
value_w = 4u                        # the value bar's width · - · len (u) · 21.6 px
patch_h = 6u                        # the chosen colour's patch · - · len (u) · 32.4 px
row_h = @size.md                    # the readout strip carrying the notation's name and the value · - · len (u) · @size.md
format_w = 11u                      # the plate that names the notation and steps to the next · - · len (u) · 59.4 px; OKLCH is the longest word it wears and measures 30.3 px at type.data, so this is that word, two pad_x and room for a theme that tracks its data role wider
swatch = 4u                         # one ready-made colour's cell · - · len (u) · 21.6 px
swatch_gap = @space.2               # between those cells · - · len (u) · @space.2 = 1u = 5.4 px
swatch_cols = 8                     # how many cells a grid row holds · - · n · eight is what fits the text side at field_w_frac without the cells shrinking under a fingertip
hue_stops = 24                      # how finely the circle is sampled across the field · - · n, 2 .. 64 · rounded up to a multiple of six and read as a wedge count for the hue/saturation wheel (2026-08-23), so this is the trade between a smooth wheel and the vertex count; 24 is 15 degrees a wedge, already a multiple of six
handle = 1.4u                       # half the marker that stands on a chosen point · - · len (u) · 7.6 px
handle_stroke = @stroke.regular     # that marker's line weight · - · str · @stroke.regular; it is a RING, so the colour it points at stays visible through it
checker = 1.6u                      # one square of the chequerboard a colour with alpha is shown against · - · len (u) · 8.6 px
corner = @corner.sm                 # the corner radius of every part of this control · - · len (u) · @corner.sm = 0.8u = 4.3 px
corner_style = @button.corner_style # which shape those corners take · - · enum: square | round | chamfer · follows the button, like every other control here: a picker rounded inside a chamfered interface is a second language
border = @stroke.hair               # the ring around each part · - · str · @stroke.hair
role = data                         # type role of the notation and the value · - · role · type.data — the monospace column role, because a hex value read digit by digit must not shift under the eye as it changes
# The ready-made grid. TOKENS and not a table in Rust: which colours a
# picker offers first is a look. The master points them at its own
# palette and severity roles, so a theme's picker opens on that theme's
# vocabulary instead of a wheel of primaries nobody chose. `base_count`
# says how many of the numbered keys are read; a numbered series is a
# promise about numbering that only a reader can keep ([glow] says the
# same), so the CEILING is however many `base.N` keys this file declares
# and not a round number written next to the count. Ask for more and you
# get what is here: a cell with no colour would still be laid out, drawn
# blank and pressed, which is what asking for 24 against these 16 used to
# produce.
base_count = 16                     # how many of the numbered cells below are offered · - · n, 0 .. 16 (as many as base.N below) · two rows of eight at swatch_cols = 8
base.1 = @palette.accent            # the seed the whole interface is derived from · - · col · @palette.accent
base.2 = @palette.accent_alt        # its secondary · - · col · @palette.accent_alt
base.3 = @accent.warm               # the warm counterpart · - · col · @accent.warm
base.4 = @palette.neutral           # the hue-free grey anchor · - · col · @palette.neutral
base.5 = @palette.white             # the tint target · - · col · @palette.white
base.6 = @palette.black             # the shade target · - · col · @palette.black
base.7 = @severity.ok.text          # the seven severity authors, in the model's own order · - · col · @severity.ok.text
base.8 = @severity.info.text        # · - · col · @severity.info.text
base.9 = @severity.warning.text     # · - · col · @severity.warning.text
base.10 = @severity.critical.text   # · - · col · @severity.critical.text
base.11 = @severity.contained.text  # · - · col · @severity.contained.text
base.12 = @severity.offline.text    # · - · col · @severity.offline.text
base.13 = @severity.unknown.text    # · - · col · @severity.unknown.text
base.14 = @surface.raised           # the three surfaces a theme is bedded on · - · col · @surface.raised
base.15 = @surface.sunken           # · - · col · @surface.sunken
base.16 = @text.primary             # the ink · - · col · @text.primary

# =========================================================================
# list — the task list, the notification list, the crew list.
# =========================================================================
[list]
row_h = @rhythm.row                 # one list row · images 1,7 (ZADANIA BIEŻĄCE) · len (u) · @rhythm.row = 27.0 px; today px*1.9 = 26.7
pad_x = @space.2                    # left/right padding inside a row · images 1,7 · len (u) · @space.2 = 1u = 5.4 px
gap = @space.0                      # gap between rows · images 1,7 · len (u) · @space.0 = 0u
rule = none                         # a hairline between rows · images 1,7 draw none · str | none · none = no rule
rule_every = 0                      # draw that rule every N rows; 0 means never · images 1,7 · n · -
glyph = 2.6u                        # the leading coloured chip of a row · image 1 (green chip, yellow lightning) · len (u) · 14.0 px
glyph_gap = @space.2                # gap between chip and label · images 1,7 · len (u) · @space.2 = 1u = 5.4 px
indent = 3u                         # indent of a nested row · images 1,7 · len (u) · 16.2 px
status_gap = @space.3               # gap before the trailing status, `(Zakończone)` · images 1,7 · len (u) · @space.3 = 1.5u = 8.1 px
bar_h = @progress.h                 # the thin bar a resource row carries · images 1,7 · len (u) · @progress.h = 1.2u
bar_gap = @space.2                  # gap between the label line and that bar · images 1,7 · len (u) · @space.2 = 1u = 5.4 px
label_role = body                   # type role of a row's label · images 1,7 · role · type.body, the size a row of prose reads at
status_role = caption               # type role of the trailing status word · images 1,7 · role · type.caption, a step under the label so the status reads as an aside
corner = @corner.sm                 # a row's corner radius, for the hover/selection plate behind it · images 1,7 · len (u) · @corner.sm = 0.8u = 4.3 px, the value the plugins borrowed from filetile.corner
corner_style = @button.corner_style # which shape that plate's corners take · images 1,7 · enum: square | round | chamfer · follows the button: the plate is the row's whole hit target, and a hit target answers in the control language
unfold_text_threshold = 0.7         # the share of a row's full height below which a row still unfolding draws no label · images 1,7 · frac · 0.7, the ratio [menu].item_text_threshold states against its own row height (0.7x @menu.row_h) — the drop-down reads it here because a drop-down element's LABEL is the list's (label_role above) even though its dress is the anchor's ([button]), and as a FRACTION because an element's height is the one its anchor hands it, never @list.row_h
wheel_px = 8u                       # scroll distance per wheel notch in a row list · images 1,7 · len (u) · 43.2 px, the value the plugins borrowed from filetile.wheel_px
scroll_gutter = 0u                  # width kept clear at the scrolling edge of a row so an overlay bar has its own lane · images 1,7 · len (u) · 0u = today's drawing, where scrollbar.mode = overlay lets the bar sit over the row's trailing status; a theme that wants the bar beside the text sets this to scrollbar.w plus twice scrollbar.margin

# =========================================================================
# tree — a tree is not a second view: it is a MODEL that flattens to the
# row list [list] above already draws (view::tree::FlatTree). What is left
# for a theme to say is the indent and the expander; everything else the
# row carries is a list row's business.
# =========================================================================
[tree]
indent = @list.indent               # how far one level of nesting shifts a row · images 1,7 · len (u) · @list.indent = 3u = 16.2 px, so a tree and a nested list agree
disclosure = 2u                     # the box the expander triangle is drawn in · - · len (u) · 10.8 px, a triangle that reads at a row's own size
disclosure_gap = @space.1           # gap between that triangle and what follows it · - · len (u) · @space.1 = 0.5u = 2.7 px
guides = none                       # a hairline down each ancestor's indent column, in component.tree.guide · - · str | none · none = the master draws no guides, so the indent alone carries the depth

# =========================================================================
# table — the shared primitive of ui.rs. Colours are component.table.*.
# =========================================================================
[table]
head_role = label.section           # type role of a header cell · images 1,9 · role · type.label.section
cell_role = data                    # type role of a body cell · images 1,9 · role · type.data
head_h = 4.2u                       # header row height · images 1,9 · len (u) · 22.7 px; today px*1.6
row_h = 4.2u                        # body row height, snapped to the baseline at bake · images 1,9 · len (u) · 22.7 px
col_gap = 2.4u                      # gap between two columns · images 1,9 · len (u) · 13.0 px
col_min_w = 2.6u                    # minimum column width · images 1,9 · len (u) · 14.0 px
elastic_min_w = 9u                  # width the elastic column is held to before the fixed columns yield — bar reservations first, then content measure back toward the heading (u2 2.7) · images 1,9 · len (u) · 48.6 px
cell_pad = 0.6u                     # padding inside a cell · images 1,9 · len (u) · 3.2 px
rule = @stroke.hair                 # the hairline under the header · images 1,9 · str | none · @stroke.hair
head_gap = 0.8x @table.row_h        # space above the header block · images 1,9 · rat of @table.row_h · 18.2 px
head_gap_below = 0.2x @table.row_h  # space between header and first body row · images 1,9 · rat of @table.row_h · 4.5 px
zebra_every = 0                     # tint every N rows with component.table.zebra; 0 disables · images 1,9 · n · -
min_rows = 1                        # rows kept before the table gives up its space · images 1,9 · n · -
bar_w = 6u                          # width of a `bar` cell's hairline track, drawn beside the number it re-reads (u2 2.7) · image 1's resource rows · len (u) · 32.4 px
sort_glyph = 1.6u                   # the box the ascending/descending marker is drawn in, beside the sorted heading; read only by an `interactive` table · images 1,9 · len (u) · 8.6 px, a marker that reads at the heading's own size
sort_glyph_gap = @space.1           # gap between that marker and the heading text it trims · images 1,9 · len (u) · @space.1 = 0.5u = 2.7 px
resize_grip = 1.2u                  # HALF the width of the hit zone straddling two headings, where a drag resizes the column; read only by an `interactive` table · - · len (u) · 6.5 px, so the zone is a11y.min_hit wide across the join

# =========================================================================
# columns — the key:value primitive of ui.rs. Colours: component.columns.*.
# =========================================================================
[columns]
label_role = caption                # type role of the key half · images 1,7 (`PROCESOR:`) · role · type.caption
value_role = value                  # type role of the value half · images 1,7 (`74% (Stabilny)`) · role · type.value
label_gap = 1.5x @type.caption.size # baseline step from the small label down to the large value — the distance IS the shape · images 1,7 · rat of @type.caption.size · ui.rs:285's lp*1.5
align = left                        # how each cell's label and value sit in the cell · images 1,7 align, today centres · enum: left | center | right · left since u2 §2.2 landed: the images align, they do not centre; center was today's look
divider = @stroke.hair              # the hairline between two cells, drawn only when the strip asks for dividers (u2 2.2) · image 7's pipe dividers · str | none · none turns it off
divider_inset = @space.1            # how far that divider is pulled in from the block's top and bottom · image 7 · len (u) · @space.1 = 0.5u = 2.7 px

# =========================================================================
# tab — the terminal session strip. skew stays at 0.7: tabs read as
# slanted, buttons do not.
# =========================================================================
[tab]
rule_color    = @border.subtle      # the line under the WHOLE session strip · - · col · @border.subtle; shell strip rule, not one tab's ring (m1 §3.3)
h = @size.md                        # tab height · - · len (u) · @size.md = 5.2u = 28.1 px; today vh(2.6)
skew = 0u                           # the shear that slants a tab · - · len (u) · 0u: a tab is a button and wears the FRAMES' corners below; a theme that wants image 1's slanted strip back gives this a width again
corner = @button.corner             # a tab's corner radius · - · len (u) · the button's, which is the panel's — one shape for every control
corner_style = @button.corner_style # which shape those corners take · - · enum: square | round | chamfer · follows the button for the same reason
pad = 1.5u                          # padding inside a tab · - · len (u) · 8.1 px; today vh(0.74)
gap = @space.0                      # gap between tabs · - · len (u) · @space.0 = 0u
rule = @stroke.thin                 # the line under the whole strip · - · str | none · @stroke.thin
rule_gap = 0.8x @tab.pad            # gap between a tab's baseline and that rule · - · rat of @tab.pad · 6.5 px
role = button                       # type role of a tab's label · - · role · type.button
underline_active = @stroke.bold     # the selected tab's underline · - · str · @stroke.bold = 4 px
min_w = 8u                          # the width a tab is never trimmed below when the strip runs out of room; read only by object::tabs, whose labels then ellipsise instead · - · len (u) · 43.2 px, a tab that still shows a word and its padding
count = 5                           # number of session tabs; READ-ONLY for themes · - · n · mirrors TAB_COUNT, the session array is sized from it

# =========================================================================
# badge — the CRITICAL / CONTAINED pill of images 1, 3 and 4.
# =========================================================================
[badge]
h = @size.xs                        # the pill's height · images 1,3,4 · len (u) · @size.xs = 3u = 16.2 px
pad_x = 1.2u                        # left/right padding inside the pill · images 1,3,4 · len (u) · 6.5 px
corner = @corner.pill               # the pill's radius · images 1,3,4 · len (u) | pill · @corner.pill = h/2; the CUT is the style half of @shape.badge.corners, which reads round — this key is the radius half of that pair, restated where a widget looks for it, and a badge is the only element in this file that states its shape in two places at once
border = @stroke.hair               # the pill's ring · images 1,3,4 · str · @stroke.hair
role = badge                        # type role of the pill's text · images 1,3,4 · role · type.badge
glyph = 2u                          # the small glyph that may lead the text · image 1 · len (u) · 10.8 px
glyph_gap = @space.1                # gap between that glyph and the text · image 1 · len (u) · @space.1 = 0.5u = 2.7 px
gap = @space.2                      # gap between two badges in a row · images 3,4 · len (u) · @space.2 = 1u = 5.4 px
style_from_severity = true          # whether a badge takes its four colours from sev[i] at draw time · images 3,4 · bool · false uses component.badge.* only

# =========================================================================
# progress / meter — image 1's "thin progress bar". Today ui::meter draws a
# line*0.6 ≈ 16 px bar, which is not thin.
# =========================================================================
[progress]
h = 1.2u                            # the bar's height · images 1,7 · len (u) · 6.5 px
border = @stroke.hair               # the track's ring · images 1,7 · str | none · @stroke.hair
inset = @stroke.hair                # gap between ring and fill, so the fill never touches the ring · images 1,7 · str · @stroke.hair
corner = @corner.none               # the bar's corner radius · images 1,7 · len (u) · @corner.none = 0u
corner_style = @button.corner_style # which shape that radius is cut to · images 1,7 · enum: square | round | chamfer · follows the button: a bar drawn inside a panel of controls answers in the control language. The master's radius is 0u, so the cut is invisible until a theme states a radius — which is exactly when it has to be stated
track_style = outline               # how the unfilled part reads · images 1,7 · enum: outline | fill | segments · -
segments = 0                        # number of segments when track_style is segments; 0 means continuous · images 1,7 · n · -
segment_gap = 0.3u                  # gap between two segments · images 1,7 · len (u) · 1.6 px

[meter]
label_gap = 0.6u                    # gap between a meter's label and its bar · images 1,7 · len (u) · 3.2 px
value_gap = 0.6u                    # gap between the bar and its trailing value · images 1,7 · len (u) · 3.2 px
row_h = @rhythm.row                 # a whole label+bar+value row · images 1,7 · len (u) · @rhythm.row = 27.0 px
bar_align = middle                  # where the bar sits in that row · images 1,7 · enum: top | middle | bottom | baseline · -

# =========================================================================
# gauge — image 1's CPU / GPU / NETWORK boxes of vertical bars.
# =========================================================================
[gauge]
h = @size.sm                        # the gauge body's height, and the CEILING of min_h_for_value below · image 1 · len (u) · @size.sm = 4u = 21.6 px; a gauge drawn at the height this file declares for it must keep its reading, so ui.rs caps the drop threshold here — the two numbers can no longer be set against each other
gap = @space.1                      # gap between two bars inside one gauge · image 1 · len (u) · @space.1 = 0.5u = 2.7 px
cols = 2                            # gauges per row when they are laid out in a grid · image 1 · n · -
style = row                         # what one gauge is drawn as (u2 2.5) · image 1's rows, image 9's donuts · enum: row | cell | bar | donut · row since u2 §2.5 landed: label + thin track + value, image 1's instrument row; cell is the old framed box; bar and donut degrade to row until they can carry their value labels
border = @stroke.hair               # the gauge's ring · image 1 · str · @stroke.hair
label_role = caption                # type role of the key half of a gauge row, `C0` · image 1 · role · type.caption, the role every other row label in the master is bound to (script.meter_label_role, columns.label_role)
value_role = value                  # type role of a gauge's numeric readout, `12%` / `33.1106` · image 1 · role · type.value, the role every other numeric readout in the master is bound to (script.meter_value_role, columns.value_role, donut.label_role); ui.rs used to read type.caption.size by name for the label AND the readout, which set a reading at its own label's size
value_inset = 0.6u                  # inset of that readout inside the gauge box · image 1 · len (u) · 3.2 px
value_clearance = 1.2u              # fill closer to the number than this flips the number's colour · image 1 · len (u) · ui.rs:138's real contrast decision, now named
min_h_for_value = 1.4x @type.value.size   # below this height the readout is dropped entirely, never above @gauge.h · image 1 · rat of @type.value.size · the readout's OWN resting size, because the threshold guards the readout: written against the caption it guarded a line 1.8x shorter than the one drawn. At the master's own numbers this asks for 4.55u while the body it guards is 4u — a gauge at its declared height throwing its number away — so ui.rs takes the smaller of the two. The reading's SIZE (type.value.size, 3.25u today, 1.77u before the type ladder was unified) is a separate question and still open

# =========================================================================
# dotmatrix — the dot grid a script widget draws. gap_min_px guarantees
# rows never fuse into bars.
# =========================================================================
[dotmatrix]
cell = 1.6u                         # one cell of the grid · image 9 · len (u) · 8.6 px; today vh(0.8)
cell_min_px = 6px                   # absolute floor for cell · image 9 · device px · companion of dotmatrix.cell (3.2)
fill_ratio = 0.6x @dotmatrix.cell   # the drawn dot inside that cell · image 9 · rat of @dotmatrix.cell · 5.2 px
fill_min_px = 2px                   # absolute floor for the drawn dot · image 9 · device px · companion of dotmatrix.fill_ratio (3.2)
gap_min_px = 2px                    # minimum gap between cells, so rows never fuse into bars · image 9 · device px · a floor with no u-sibling by design

# =========================================================================
# hex — the hexagon cell grid. Its APPEARANCE lives in ornament.hex.*.
# =========================================================================
[hex]
size = 5u                           # circumradius of one hexagon · images 1,3,4 (MONITOR ZASOBÓW) · len (u) · 27.0 px
gap = 1u                            # gap between two hexagons · images 1,3,4 · len (u) · 5.4 px
cols = 5                            # hexagons per row · image 1 draws five · n · -
stroke = @stroke.hair               # the hexagon's edge weight · images 1,3,4 · str · @stroke.hair

# =========================================================================
# chart — shared plot furniture. None of this exists in code today; every
# chart is quads and lines with hard-coded gutters.
# =========================================================================
[chart]
pad = @space.3                      # padding inside the plot panel · images 2,7,8,9 · len (u) · @space.3 = 1.5u = 8.1 px
gutter_left = 6u                    # room reserved for the y axis labels · images 2,8,9 · len (u) · 32.4 px
gutter_bottom = 4u                  # room reserved for the x axis labels · images 2,8,9 · len (u) · 21.6 px
axis.stroke = @stroke.thin          # the axis lines · images 2,8,9 · str · @stroke.thin
grid.stroke = @stroke.hair          # the faint grid behind the plot · image 2 ("a line chart over a faint grid") · str · @stroke.hair
grid.rows = 4                       # horizontal grid divisions · images 2,8 · n · -
grid.cols = 6                       # vertical grid divisions · images 2,8 · n · -
grid.style = solid                  # dashed grids are N short quads, not a dash pattern · images 2,8 · enum: solid | dashed · -
grid.dash = 0.6u                    # length of one dash when grid.style is dashed · images 2,8 · len (u) · 3.2 px
grid.gap = 0.6u                     # gap between two dashes · images 2,8 · len (u) · 3.2 px
tick_len = 0.8u                     # length of an axis tick · images 2,8,9 · len (u) · 4.3 px
label_role = caption                # type role of axis labels · images 2,8,9 · role · type.caption
legend.h = @size.xs                 # one legend row · image 2 ("with a legend and axis labels") · len (u) · @size.xs = 3u = 16.2 px
legend.swatch = 1.6u                # the colour chip in a legend row · image 2 · len (u) · 8.6 px
legend.gap = @space.3               # gap between chip and legend label · image 2 · len (u) · @space.3 = 1.5u = 8.1 px
line.stroke = @stroke.chart         # the plot line's weight · images 2,8 · str · @stroke.chart
line.point_r = 0.5u                 # radius of a data point marker · images 2,8 · len (u) · 2.7 px
line.point_every = 0                # draw a marker every N points; 0 draws none · images 2,8 · n · -
line.fill = none                    # the area under the line · images 2,8 · enum: none | flat | ramp · ramp is N horizontal quad bands
line.fill_bands = 8                 # how many bands a ramp fill uses · images 2,8 · n · -
line.smooth = 0                     # 0 is a polyline; n inserts n interpolated points per segment · images 2,8 · n · bounded, honest, triangles
bar.gap = 0.5u                      # gap between two bars · images 1,7,8 · len (u) · 2.7 px
bar.min_w = 1u                      # minimum bar width · images 1,7,8 · len (u) · 5.4 px
bar.corner = @corner.none           # a bar's corner radius · images 1,7,8 · len (u) · @corner.none = 0u
bar.corner_style = @progress.corner_style   # which shape that radius is cut to · images 1,7,8 · enum: square | round | chamfer · follows the progress bar, which follows the button: a bar is a bar wherever it is drawn, and two bars on one screen must not disagree
bar.baseline = @stroke.thin         # the zero line under the bars · images 1,7,8 · str | none · @stroke.thin
bar.group_gap = 1.5u                # gap between two groups of bars · images 1,7,8 · len (u) · 8.1 px

# =========================================================================
# donut — image 9's 92 / 84 / 95 gauges and the taskbar's 74 / 65.
# =========================================================================
[donut]
size = 12u                          # outer diameter · image 9 · len (u) · 64.8 px
thickness = 1.6u                    # the ring's radial thickness · image 9 · len (u) · 8.6 px
segments = 48                       # arc tessellation, 96 triangles — smooth at 65 px · image 9 · n · -
start_deg = -90deg                  # where the arc begins; -90 is twelve o'clock · image 9 · deg · -
sweep_deg = 360deg                  # how far a full value sweeps; 270 gives the open gauge · image 9 · deg · -
cap = butt                          # how the arc ends · image 9 · enum: butt | round · -
track = on                          # whether the unfilled remainder is drawn · image 9 · enum: on | off · -
label_role = value                  # type role of the percentage in the hole · image 9 · role · type.value
caption_role = caption              # type role of the caption under the donut · image 9 · role · type.caption
gap = @space.5                      # gap between two donuts · image 9 · len (u) · @space.5 = 3u = 16.2 px

# =========================================================================
# nodegraph — image 1's dots joined by thin lines, image 8's neural net.
# =========================================================================
[nodegraph]
node_r = 0.7u                       # radius of one node · images 1,8 · len (u) · 3.8 px
node_shape = square                 # what a node is drawn as · images 1,8 · enum: square | round | hex · -
edge = @stroke.hair                 # the line joining two nodes · images 1,8 · str · @stroke.hair
pad = @space.4                      # padding around the graph inside its panel · images 1,8 · len (u) · @space.4 = 2u = 10.8 px
label_role = caption                # type role of a node's label · images 1,8 · role · type.caption
label_gap = @space.1                # gap between node and label · images 1,8 · len (u) · @space.1 = 0.5u = 2.7 px

# =========================================================================
# leader — the callout lines that label features on the central render.
# =========================================================================
[leader]
stroke = @stroke.hair               # the leader line itself · images 1,5 (`DAMAGE BREACH`) · str · @stroke.hair
elbow = 2u                          # length of the horizontal run before the label · images 1,5 · len (u) · 10.8 px
dot_r = 0.5u                        # the dot that pins the line to the feature · images 1,5 · len (u) · 2.7 px
label_gap = @space.2                # gap between the elbow and the label · images 1,5 · len (u) · @space.2 = 1u = 5.4 px
label_role = leader.label           # type role of the callout label · images 1,5 · role · type.leader.label

# =========================================================================
# scale — image 7's vertical measuring rule down the left edge, purely
# instrumental decoration.
# =========================================================================
[scale]
pitch = 2u                          # distance between two minor ticks · image 7 · len (u) · 10.8 px
tick_minor = 1u                     # length of a minor tick · image 7 · len (u) · 5.4 px
tick_major = 2.4u                   # length of a major tick · image 7 · len (u) · 13.0 px
major_every = 5                     # every Nth tick is major · image 7 · n · -
stroke = @stroke.hair               # tick weight · image 7 · str · @stroke.hair
label_role = data                   # type role of the number beside a major tick · image 7 · role · type.data
label_gap = @space.2                # gap between tick and number · image 7 · len (u) · @space.2 = 1u = 5.4 px

# =========================================================================
# avatar / feed — image 1's STATUS ZAŁOGI rows and the LIVE FEED tile.
# =========================================================================
[avatar]
size = 6u                           # the avatar square · images 1,7 · len (u) · 32.4 px
corner = @corner.sm                 # its corner radius · images 1,7 · len (u) · @corner.sm = 0.8u = 4.3 px
corner_style = @corner.mode         # which shape that radius is cut to · images 1,7 · enum: square | round | chamfer · @corner.mode, the one place this file states its corner language: a portrait plate belongs to no control family, so it answers to the root
border = @stroke.hair               # its ring · images 1,7 · str · @stroke.hair
gap = @space.3                      # gap between avatar and name block · images 1,7 · len (u) · @space.3 = 1.5u = 8.1 px
row_h = @list.row_h                 # a whole crew row · images 1,7 · len (u) · @list.row_h
name_role = body                    # type role of the name line · images 1,7 · role · type.body
sub_role = caption                  # type role of the sub-line, e.g. `(Neuro-Inżynieria)` · images 1,7 · role · type.caption
sub_gap = @space.hair               # gap between name and sub-line · images 1,7 · len (u) · @space.hair = 0.25u = 1.4 px

[feed]
aspect = 0.5625                     # height / width of the video tile · images 1,3,7 (LIVE FEED) · frac · 16:9
corner = @corner.md                 # the tile's corner radius · images 1,3,7 · len (u) · @corner.md = 1.2u = 6.5 px
corner_style = @corner.mode         # which shape that radius is cut to · images 1,3,7 · enum: square | round | chamfer · @corner.mode, the one place this file states its corner language
caption_h = 4u                      # the caption strip under the tile · images 1,3,7 · len (u) · 21.6 px
caption_pad = @space.2              # padding inside that strip · images 1,3,7 · len (u) · @space.2 = 1u = 5.4 px

# =========================================================================
# dock / taskbar — image 7's chevron, image 8's centred icons, image 9's
# tall bordered buttons with a glyph above a caption.
# =========================================================================
[dock]
h = @size.2xl                       # the dock's height · images 7,8,9 · len (u) · @size.2xl = 12u = 64.8 px
pad = @space.3                      # padding inside the dock · images 7,8,9 · len (u) · @space.3 = 1.5u = 8.1 px
shape = rect                        # the dock's outline · image 7 is a stretched chevron · enum: rect | chevron · -
chevron_skew = 3u                   # the shear when shape is chevron · image 7 · len (u) · 16.2 px
corner = @corner.sm                 # the dock's corner radius · images 7,8,9 · len (u) · @corner.sm = 0.8u = 4.3 px
corner_mode = @corner.mode          # how that radius is cut · images 7,8,9 · enum: square | round | chamfer · @corner.mode, the one place this file states its corner language; dock.shape above is the OUTLINE (rect or chevron), which is a different decision about a different edge
border = @stroke.hair               # the dock's ring · images 7,8,9 · str · @stroke.hair
item_w = 12u                        # width of one dock item · image 9's large bordered buttons · len (u) · 64.8 px
item_gap = @space.3                 # gap between two dock items · images 7,8,9 · len (u) · @space.3 = 1.5u = 8.1 px
icon = 5u                           # the glyph inside a dock item · images 7,8,9 · len (u) · 27.0 px
caption_role = caption              # type role of a dock item's caption · image 9 (`START`, `SZUKAJ`) · role · type.caption
caption_gap = 0.6u                  # gap between glyph and caption · image 9 · len (u) · 3.2 px
chevron_w = 4u                      # the `<` `>` paging arrows at the ends · image 9 · len (u) · 21.6 px
align = left                        # how items distribute along the dock · image 8 centres, image 9 justifies · enum: left | center | justify · -
edge = bottom                       # which screen edge the dock sits on · images 7,8,9 · enum: bottom | top | left | right · -
active_indicator = border           # how the running/active item is marked · image 8's orange HOME · enum: border | underline | glow | none · -

# =========================================================================
# tooltip / chip
# =========================================================================
[tooltip]
h = 4.2u                            # the tooltip's height · - · len (u) · 22.7 px
pad_x = 1.6u                        # left/right padding · - · len (u) · 8.6 px
pad_y = 0.6u                        # top/bottom padding · - · len (u) · 3.2 px
corner = @corner.sm                 # its corner radius · - · len (u) · @corner.sm = 0.8u = 4.3 px
corner_mode = @menu.corner_mode     # how that radius is cut · - · enum: round | chamfer · @menu.corner_mode; a tooltip is the same floating chrome a menu is, and the two never appear far enough apart to justify two answers
border = @stroke.hair               # its ring · - · str · @stroke.hair
offset = @space.2                   # gap between the pointer and the tooltip · - · len (u) · @space.2 = 1u = 5.4 px
role = tooltip                      # type role of its text · - · role · type.tooltip
max_w = 60u                         # the width at which the text wraps · - · len (u) · 324.0 px
delay_ms = 600ms                    # how long the pointer must rest on a target before its tooltip appears · - · ms, 0ms .. 3000ms · no derivation; the pause between resting and explaining, long enough that crossing a control on the way somewhere else says nothing
linger_ms = 120ms                   # grace after a tooltip goes away in which the NEXT target skips the delay · - · ms, 0ms .. 1000ms · shorter than delay_ms by a factor of five: walking along a row of controls explains each one, a pause of a fifth of a second ends the walk

# =========================================================================
# scroll — how a scrolled area BEHAVES, as against how its bar looks
# (that is [scrollbar], below). Read by every scroll container through
# view::scroll::ScrollPhysics. Kinetics is OFF here: the master's wheel
# moves the offset and lands, exactly as the file panel's always has.
# =========================================================================
[scroll]
wheel_px = 3x @table.row_h          # how far one wheel notch scrolls · - · rat of @table.row_h · three rows, the same reading as terminal.wheel_lines = 3
fling_scale = 0.0                   # a notch's velocity in px/s is wheel_px x this; 0 turns kinetics off · - · f, 0 .. 20 · 0 = the direct, immediate move that exists today
glide_halflife_ms = 160ms           # how long a glide takes to lose half its speed; read only when fling_scale > 0 · - · ms, 0ms .. 2000ms · shorter than motion.scroll_settle, so the flick ends before the settle begins

# =========================================================================
# scrollbar — NEW and required. Nothing draws one today: the filesystem
# widget scrolls blind and the terminal has scrollback with no position
# indicator. A dense instrument interface that scrolls without saying
# where it is is a defect.
# =========================================================================
[scrollbar]
mode = inset                        # whether the bar takes layout space · - · enum: overlay | inset | none · inset since 2026-08-16, the owner's ask: the bar stands BESIDE the content, even widened under the pointer — a bar over the controls read as a defect
w = 1.2u                            # the resting bar width · - · len (u) · 6.5 px
w_hover = 2u                        # the width under the pointer · - · len (u) · 10.8 px
margin = @space.1                   # gap between bar and content edge · - · len (u) · @space.1 = 0.5u = 2.7 px
thumb_min = 6u                      # minimum thumb length, so a long document still shows one · - · len (u) · 32.4 px
corner = @corner.pill               # the thumb's radius · - · len (u) | pill · @corner.pill = w/2
corner_style = @corner.mode         # which shape that radius is cut to · - · enum: square | round | chamfer · @corner.mode, the one place this file states its corner language
track = off                         # whether the groove behind the thumb is drawn · - · enum: on | off · -
auto_hide = true                    # whether the bar fades out when idle · - · bool · -
fade_ms = 260ms                     # how long that fade takes, from the last movement · - · ms, 0ms .. 2000ms · read only when auto_hide = true; 0ms cuts the bar instead of fading it
edge = right                        # which side of the content the bar sits on · - · enum: right | left · -

# =========================================================================
# terminal
# =========================================================================
[terminal]
pad = 1.5u                          # padding between the terminal's border and the cell grid · image 3 · len (u) · 8.1 px; today vh(0.74)
cell_font = 2.9u                    # the cell font's size before the user's TermFontSize multiplier · image 3 · len (u) · 15.66 px at the 1080p reference, which is exactly what the ABI used to write as vh(1.45) — but only where u is unclamped: 2.9u is 11.6 px at 720p against vh's 10.44, and 29.0 px at 4K against vh's 31.32, because u floors at metric.unit_min_px and ceils at metric.unit_max_px. The cell also follows the SCREEN's u now rather than the WINDOW's height, which is what vh(1.45) read. Both differences are deliberate: the terminal's type now scales like every other size in this file. term::Grid::measure multiplies TermFontSize over it, so the user scales this rather than replacing it
# TODO(default): 5.25 spells this `terminal.min_px`; 3.2's px rule reads
# "ends _min_px". `terminal.cell_font_min_px` would obey the rule literally
# and be found by the same prefix search. Spec spelling kept — lead to pick.
# Until it is picked the bake cannot pair the two by name, so term::Grid
# applies this floor to cell_font by hand.
min_px = 8px                        # absolute floor for cell_font · image 3 · device px · companion of terminal.cell_font (3.2). This is the file asking ITSELF for a cell a person can read; the engine's own bound is on the CELL COUNT (term.rs GRID_CELLS_MAX), so 0px here is taken, and what it buys is an unreadable grid rather than a crash
line_height = 1.00                  # a multiplier on the FONT's own metrics, never a synthetic 1.3 · image 3 · f · 1.00 is the face's own line box, which is what a grid that must agree with the PTY wants; more opens the rows, and the extra is shared ABOVE and BELOW the glyph so the line keeps the middle of its row — an underline, a caret's rule and the glyph travel together
cursor.underline_h = @stroke.thin   # thickness of an underline cursor · image 3 · str · read when term.cursor.style = underline; was a flat 1.0
cursor.underline_gap = 0.3u         # gap between the floor of the GLYPH'S LINE BOX and that underline · image 3 · len (u) · 1.6 px. The line box is the cell itself while line_height is 1.00, and the middle band of a taller cell once it is not, so the rule stays under the character rather than sinking with the row. This line used to say baseline; it never was one — cell_underline_gap below is measured the same way and always said so
cursor.bar_w = @stroke.thin         # width of a bar cursor — the shape term.cursor.style calls `bar`, one word for one shape in both sections that name it (field.caret_style is the other) · image 3 · str · @stroke.thin
cell_underline_h = @stroke.thin     # thickness of an underlined CELL (SGR 4) — the cursor's underline is cursor.underline_h · image 3 · str · shell/lib.rs:316's flat 1.0; a theme that thickens its rules must thicken this one too
cell_underline_gap = 0.3u           # gap between the floor of the glyph's line box and that underline · image 3 · len (u) · 1.6 px; today a flat 1.5. Same anchor as cursor.underline_gap, so a caret's rule and an SGR-4 rule sit on one line at every line_height
wheel_lines = 3                     # lines scrolled per wheel notch · image 3 · n · -
indicator.role = caption            # type role of the scrollback position readout · image 3 · role · type.caption
indicator.inset = @space.3          # inset of that readout from the terminal's corner · image 3 · len (u) · @space.3 = 1.5u = 8.1 px
# TODO(default): 5.25 spells this `0`; units are mandatory on every
# length (3.2), so it is written `0u`.
selection_pad = 0u                  # bleed around a selection quad; 0 makes selection follow the cell grid exactly · image 3 · len (u) · -
follow_density = false              # whether metric.density touches the terminal; it must not by default · image 3 · bool · -

# =========================================================================
# keyboard — the on-screen keyboard. keyboard.rows and keyboard.key_units
# are LAYOUT DATA and stay in the keyboard layout file, not here.
# =========================================================================
[keyboard]
mod_dot_color = @accent.primary     # the dot marking a latched modifier · - · col · @accent.primary; had a size and no colour
gap = 0.9u                          # gap between two keys · images 3,5 · len (u) · 4.9 px; today vh(0.46)
pad = same_as_parent                # padding around the whole key field · images 3,5 · sentinel | len (u) · same_as_parent = @keyboard.gap
key_corner = @corner.sm             # a key cap's corner radius · images 3,5 · len (u) · @corner.sm = 0.8u = 4.3 px
key_corner_style = @button.corner_style # which shape a key cap's corners take · images 3,5 · enum: square | round | chamfer · follows the button: a key is a button with a legend on it, and a keyboard drawn in one language beside controls drawn in another is the split this section's root was written to end. NO READER YET — the key field is drawn in the addons and still spells `round`, under the clause [corner]'s header keeps open for exactly this key
key_border = @stroke.hair           # a key cap's ring · images 3,5 · str · @stroke.hair
key_h = @size.lg                    # a key cap's height · images 3,5 · len (u) · @size.lg = 6.5u = 35.1 px
label_role = body                   # type role of the main key legend · images 3,5 · role · today font_px(1.05)
sub_role = caption                  # type role of the shifted/alt legend · images 3,5 · role · type.caption
sub_inset_x = 0.4x @type.caption.size   # horizontal inset of that sub-legend · images 3,5 · rat of @type.caption.size · -
sub_inset_y = 0.3x @type.caption.size   # vertical inset of that sub-legend · images 3,5 · rat of @type.caption.size · -
sub_corner = top_right              # which corner the sub-legend sits in · images 3,5 · enum: top_left | top_right | bottom_left | bottom_right · -
mod_dot = 0.16x @keyboard.key_h     # the latched-modifier dot on a key · images 3,5 · rat of @keyboard.key_h · 5.6 px
mod_dot_min_px = 4px                # absolute floor for mod_dot · images 3,5 · device px · companion of keyboard.mod_dot (3.2)
arrow_size = 0.16x @keyboard.key_h  # half-size of the vector arrow on the four cursor keys · images 3,5 · rat of @keyboard.key_h · kbd/lib.rs:388; the ratio matches mod_dot but names a different mark
arrow_size_min_px = 4px             # absolute floor for arrow_size · images 3,5 · device px · companion of keyboard.arrow_size (3.2)

# =========================================================================
# editor overlay — the board editor's drag handles, proxies and hints.
# editor.grid.cols / .rows are USER settings, not theme tokens.
# =========================================================================
[editor]
spawn_w_frac  = 0.28                # a freshly added widget's width share of the screen · - · frac · was w * 0.20 in editor.rs
spawn_h_frac  = 0.32                # its height share · - · frac · was h * 0.25
add_hold_ms   = 1000ms              # how long ADD WIDGET is held before placement starts · - · ms · borrowed motion.hold.duration_ms until it did; adding a widget is undoable, so it needs none of the deliberation a destructive control does
proxy.close_max_w_frac = 0.20       # ceiling of the proxy close button as a share of proxy width · - · frac · was a hardcoded clamp
proxy.close_max_h_frac = 0.40       # and of its height · - · frac · was a hardcoded clamp
handle_color  = @accent.primary     # the corner grab squares on a widget proxy · - · col · @accent.primary; editor.rs:722
edge = 1.5u                         # the grab band along a proxy's edge · - · len (u) · 8.1 px
edge_min_px = 8px                   # absolute floor for edge · - · device px · today a raw 8.0 px
min_content = 6u                    # smallest a proxy may be dragged to · - · len (u) · 32.4 px
min_content_min_px = 30px           # absolute floor for min_content · - · device px · today a raw 30.0
handle = 1.2u                       # the corner handle's side · - · len (u) · 6.5 px
handle_min_px = 6px                 # absolute floor for handle · - · device px · today a raw 6.0
proxy.border = @stroke.hair         # a resting proxy's ring · - · str · @stroke.hair
proxy.border_hot = @stroke.regular  # the ring of the proxy under the pointer · - · str · @stroke.regular
proxy.close_size = 3.4u             # the ✕ that removes a panel proxy · - · len (u) · 18.4 px; editor.rs:282, mirrors boards.tile.close_size
proxy.close_size_min_px = 18px      # absolute floor for proxy.close_size · - · device px · companion of editor.proxy.close_size (3.2)
proxy.close_inset = @space.1        # inset of that ✕ from the proxy's top-right corner · - · len (u) · @space.1 = 0.5u = 2.7 px; editor.rs:283's flat 4.0
proxy.close_stroke = @stroke.thin   # that ✕'s line weight · - · str · editor.rs:757's flat 1.5
proxy.label_role = caption          # type role of a proxy's name tag · - · role · editor.rs:725/:846 set two sizes for one object; one role ends that
proxy.label_pad_x = 0.6x @type.caption.size   # left/right padding of the plate behind that tag, ON EACH SIDE as @button.pad_x is · - · rat of @type.caption.size · 5.7 px a side, which is the same plate editor.rs:729 drew: the key was written as 1.2x when its one reader spent it on BOTH sides together, so the file promised a theme twice the breathing room it got. Halved here rather than doubled in the code, because the number was calibrated against the drawn tag and the wording was what was wrong
proxy.label_h = 1.7x @type.caption.size       # that plate's height · - · rat of @type.caption.size · editor.rs:729
hint.role = tooltip                 # type role of the editor's hint text · - · role · type.tooltip
hint.inset_x = @space.6             # horizontal inset of that hint · - · len (u) · today w*0.012, a WIDTH-relative inset in a height-scaled interface
hint.inset_y = 2x @type.tooltip.size    # vertical inset of that hint · - · rat of @type.tooltip.size · -
list.head_h = 4u                    # the widget-picker list's header height · - · len (u) · 21.6 px
list.pad = 1.2u                     # padding inside that list · - · len (u) · 6.5 px
list.pad_min_px = 6px               # absolute floor for list.pad · - · device px · companion of editor.list.pad (3.2)
list.hold_slack = 5u                # how far the pointer may drift off a held ADD WIDGET entry before the hold is abandoned · - · len (u) · 27.0 px; editor.rs held a flat 30.0 — holding a control for a second is a still gesture, not a motionless one
list.hold_slack_min_px = 24px       # absolute floor for list.hold_slack · - · device px · companion of editor.list.hold_slack (3.2)
list.title_gap = 0.6x @type.body.size   # gap between a list entry's title and its sub-line · - · rat of @type.body.size · -
list.title_role = title.window      # type role of the ADD WIDGET window's own title · - · role · editor.rs:784's font_px(0.95)
list.w_frac = 30%                   # the picker window's width · - · % of the viewport width · editor.rs:256
list.w_min_px = 300px               # absolute floor for list.w_frac's result · - · device px · companion of editor.list.w_frac (3.2)
list.item_h = 26u                   # one widget miniature's height · - · len (u) · 140.4 px; editor.rs:261's h*0.14
list.item_h_min_px = 64px           # absolute floor for list.item_h · - · device px · companion of editor.list.item_h (3.2)
list.max_h_frac = 86%               # the screen fraction the list may fill before miniatures shrink · - · % of the viewport height · editor.rs:263
list.preview_head = 4u              # headroom above a live miniature, so a widget that draws its heading above its rect is not clipped · - · len (u) · 21.6 px; editor.rs:816 — a drawing correction, not layout
button.w_frac = 10%                 # the editor button stack's width · - · % of the viewport width · editor.rs:222
button.w_min_px = 110px             # absolute floor for button.w_frac's result · - · device px · companion of editor.button.w_frac (3.2)
button.inset_x = @space.6           # the stack's inset from the window's right edge · - · len (u) · @space.6 = 4u = 21.6 px; today w*0.012, a WIDTH-relative inset in a height-scaled interface
button.inset_y = @space.6           # the stack's inset from the window's bottom edge · - · len (u) · @space.6 = 4u = 21.6 px; today h*0.02
grid.stroke = @stroke.hair          # the editor's alignment grid · - · str · @stroke.hair

# =========================================================================
# boards / board switcher
# =========================================================================
[boards]
tile.max_w_frac = 26%               # a board thumbnail's maximum width · - · % of the switcher's width · -
tile.aspect = window                # the thumbnail's aspect ratio source · - · enum: window | square | 16_9 · window copies the real desktop
tile.gap = @space.5                 # gap between two thumbnails · - · len (u) · @space.5 = 3u = 16.2 px
tile.border = @stroke.hair          # a resting thumbnail's ring · - · str · @stroke.hair
tile.border_current = @stroke.regular   # the ring of the board you are on · - · str · @stroke.regular
tile.caption_h = 2.6u               # the caption strip under a thumbnail · - · len (u) · 14.0 px
tile.caption_gap = 0.6u             # gap between thumbnail and caption · - · len (u) · 3.2 px
tile.close_size = 2.2u              # the `✕` that removes a board · - · len (u) · 11.9 px
tile.close_inset = @space.1         # inset of that `✕` from the thumbnail's corner · - · len (u) · @space.1 = 0.5u = 2.7 px
tile.close_stroke = @stroke.thin    # that `✕`'s line weight · - · str · settings.rs:1151's flat 1.5
tile.caption_role = caption         # type role of the caption under a thumbnail · - · role · settings.rs:1045's font_px(0.85)
tile.proxy_min_px = 2px             # smallest a panel proxy may draw inside a thumbnail · - · device px · settings.rs:1094; without a floor a thin panel vanishes from its own preview
plus_size = 2.6u                    # the `+` that adds a board · - · len (u) · 14.0 px
plus_size_min_px = 14px             # absolute floor for plus_size · - · device px · companion of boards.plus_size (3.2)
plus_stroke = @stroke.thin          # the `+`'s line weight · - · str · @stroke.thin

[board]
swipe_edge = 4u                     # the screen-edge band that starts a board swipe · - · len (u) · 21.6 px
swipe_edge_min_px = 20px            # absolute floor for swipe_edge · - · device px · companion of board.swipe_edge (3.2)

[boardswitch]
shade_min = 0.35                    # how far the desktop dims behind the switcher at rest · - · frac 0..1 · -

# =========================================================================
# modal / settings
# =========================================================================
[modal]
w_frac = 75%                        # modal width · - · % of the viewport width · 3/4 ekranu od 2026-08-16, życzenie właściciela: okno ustawień rośnie do formularza, nie listy
h_frac = 75%                        # modal height · - · % of the viewport height · razem z w_frac — 3/4 w pionie i poziomie
min_w = 60u                         # minimum modal width · - · len (u) · 324.0 px
min_w_min_px = 320px                # absolute floor for min_w · - · device px · companion of modal.min_w (3.2)
min_h = 48u                         # minimum modal height · - · len (u) · 259.2 px
min_h_min_px = 260px                # absolute floor for min_h · - · device px · companion of modal.min_h (3.2)
pad = 2.8u                          # padding inside the modal · - · len (u) · 15.1 px
corner = @corner.lg                 # the modal's corner radius · - · len (u) · @corner.lg = 2.2u = 11.9 px
corner_mode = @corner.mode        # how that corner is cut · - · enum: round | chamfer · @corner.mode, the one place this file states its corner language
border = @stroke.regular            # the modal's ring · - · str · @stroke.regular
scrim_alpha = 0.55                  # how far the scrim darkens what is behind · - · frac 0..1 · the colour is component.modal.scrim
title.role = title.window           # type role of the modal title · - · role · type.title.window
title.band_h = 7.4u                 # the modal's title band · - · len (u) · 40.0 px
body_top = 14.4u                    # where the modal body starts · - · len (u) · 77.8 px; size.xl + 2 x space.5 in intent, written as one value because there is no arithmetic (3.2)
row_gap = @space.5                  # gap between two setting rows · - · len (u) · @space.5 = 3u = 16.2 px

[settings]
back_w_frac = 22%                   # width of the chrome button (BACK/CLOSE) where the window has FOLDED · - · % of the modal's width · since 2026-08-18 the unfolded window gives that button the rail's own width less band_pad_x, because it stands ON the rail's bed; folded there is no rail and this is the rule again
back_w_min = 13u                    # minimum width of that button · - · len (u) · 70.2 px
back_w_min_min_px = 70px            # absolute floor for back_w_min · - · device px · companion of settings.back_w_min (3.2)
list_w_frac = 60%                   # width of the settings list column · - · % of the modal's width · -
grid_cols = 3                       # columns in the settings icon grid · - · n · -
col_gap = @space.6                  # rynna między kolumnami pasa · - · len (u) · 4u = 21.6 px; settings.band_pad_x — the air INSIDE a column's bed — has to stay UNDER this number, or a button reads as no further from the next column than from its own bed's edge and the two columns fuse into one (2026-08-18)
zone_gap = @space.6                 # odstęp pionowy między pasami · - · len (u) · = section_gap, jeden rytm
col_min_w = 72u                     # próg: węższa kolumna = pas składa się do listy · - · len (u) · 388.8 px
col_min_w_min_px = 360px            # podłoga companion (3.2) · - · device px · dobrana pod UKŁAD DWUKOLUMNOWY (500 px składało, 720p+ trzymało kolumny). Od 2026-08-18 nawigacja to JEDNA kolumna — 22 % pudełka treści zamiast 44 % — więc przy tej liczbie okno trzyma dwa panele na każdej wysokości, pod którą program jest pisany; składa się dopiero okno naprawdę wąskie. Czy 500 px ma znowu się składać, decyduje ta liczba i nikt inny: próg leży dziś między 481 px (co strona dostaje przy 500 px) a 710 px (co dostaje przy 720p)
bar_gap = @space.4                  # odstęp przycisków paska akcji · - · len (u) · 2u = 10.8 px
rail_w_frac = 22%                   # szyna sekcji edytora (krok 3) · - · % szerokości treści · wzorem back_w_frac
rail_w_min = 13u                    # minimum szyny · - · len (u) · 70.2 px
rail_w_min_min_px = 70px            # podłoga companion (3.2) · - · device px · -
rail_row_gap = @space.2             # the break between two entries of the navigation rail · - · len (u) · @space.2 = 1u = 5.4 px, where modal.row_gap — the rhythm of a FORM — is 3u; a rail is a dense list of names and not a run of controls, and since 2026-08-18 it also carries the open section's own pages, so the rhythm it can afford and the rhythm a page can afford stopped being one question. The rail SCROLLS (settings.rs, Settings::draw_nav, on view::scroll like the page), so a rail this number makes too long is a wheel away and not a window that folds; what it really decides is how much of the navigation a short screen shows without touching the wheel — 440 px of rail against 418 px of column at 720p on this file's numbers
rail_indent = @space.5              # how far a section's OWN PAGES stand in from the section they belong to · - · len (u) · @space.5 = 3u = 16.2 px; the step is the whole of what the second navigation column used to say by standing somewhere else, so it has to be a step the eye reads as "these belong to the entry above" and not as a nudge (owner's mock-up, 2026-08-18)
rail_guide_w = @stroke.hair         # the vertical line those indented pages are propped against · - · len (u), stroke-scaled · @stroke.hair = 0.2u, 1 px at 1080p; a bracket around a group, not a border of one — anything heavier reads as a second column's edge, which is the shape this replaced
rail_guide_x = 50%                  # where in the indent step that line stands · - · % of settings.rail_indent · 0 % puts it against the section's own left edge, 100 % against its pages'; the master halves the gutter it brackets, and a Rust reader that picked the middle for itself would be a look decision written in Rust
hint.role = caption                 # type role of a setting's hint line · - · role · type.caption
hint_inset = 1.6x @type.caption.size    # inset of that hint under its control · - · rat of @type.caption.size · -
note.role = caption                 # type role of a section note · - · role · type.caption
row_label_role = body               # type role of every settings row label: COLUMNS, PADDING, VOLUME … · - · role · settings.rs:925 and four siblings, all font_px(1.0)
section_role = label.section        # type role of a section header inside a page: the FONT view's TERMINAL and INTERFACE · - · role · type.label.section, the role settings.rs spelled out for these two headers before a binding existed
section_gap = @space.6              # the break between the BACK row and the first setting · - · len (u) · @space.6 = 4u = 21.6 px; settings.rs:926's undeclared gap*2.0
preview_pulse_ms = 100ms            # how often a control HELD in the theme editor re-bakes the desktop behind it · - · ms, 16ms .. 1000ms · how fast the picture follows the hand, which is something a person watches, so it is the theme's; the editor's sliders and the picker's field both hold this pulse and were two copies of 100 in settings.rs until 2026-08-18. NOT in [motion], though it is a time: that catalogue is closed at eighteen effects plus two globals and counted by a test, and this is not an effect — it is a rate limiter, and motion.scale = 0 would take a limiter to "every frame", which is 76 KB a bake and ~4.5 MB for a second of dragging. Reduced motion is a promise about movement, not about heat
band_lift = 1.20                    # the navigation's bed against the window body it lies on, as a multiple of OKLab L · - · f, 0.5 .. 2.0 · read ONCE, by component.settings.rail_fill (5.26); there is ONE navigation column since 2026-08-18, so there is one bed and one lift — the second column this used to be shared with is gone and its token with it
band_pad_x = @space.4               # air between a navigation column's bed and the buttons standing on it, left and right · - · len (u) · @space.4 = 2u = 10.8 px; a control flush with the bed under it reads as a slice OF the bed, not as a thing lying on it (owner, 2026-08-18); MUST STAY UNDER settings.col_gap (4u), the gutter to the next column — the rule is written out there
band_pad_y = @space.4               # the same air at the top and the bottom of that bed · - · len (u) · @space.4 = 2u = 10.8 px; the same number as band_pad_x, because a plate with more air on one axis than the other reads as tilted
band_corner = @corner.md            # the corner a navigation column's bed wears · - · len (u) · @corner.md = 1.2u = 6.5 px; the panel/card radius, one step under the @corner.lg of the modal these columns stand inside — a nested box takes the smaller arc or it reads as the wider one
band_corner_mode = @corner.mode     # how that corner is cut · - · enum: square | round | chamfer · @corner.mode, the one place this file states its corner language
# WHY A COLUMN'S BED IS CUT ON ALL FOUR CORNERS — AND WHY THAT SURVIVED THE
# BANDS GROWING TO FULL HEIGHT. Since 2026-08-18 a navigation column's bed is
# its WHOLE column of `content_rect`, top edge to bottom edge: the corner
# button no longer stands in a notch bitten out of the bed, it stands ON the
# bed, `band_pad_y` down from its top edge. That closed a 61.6 px gap above
# each navigation band (button.h 45.4 + modal.row_gap 16.2) which the page
# column never had — the "islands" the owner photographed.
#
# It did NOT bring any corner to the frame, and the measurement is this file's
# own: `content_rect` insets the modal by `modal.pad` (2.8u = 15.1 px) on the
# left, the right and the bottom, and drops `modal.body_top` (14.4u = 77.8 px)
# from the top for the title band. A band filling that box therefore still
# stands 15.1 px clear of the frame on every side it could meet, and 77.8 px
# clear at the top. A corner that meets nothing has nothing to square itself
# against: the band is a plate lying ON the body, not a piece cut out of it,
# and a plate is cut the same on all four. The other case — a theme setting
# `modal.pad = 0`, where the outer corners WOULD meet the frame and would have
# to take `modal.corner` instead — is a theme this master does not ship and a
# rule no reader can guess; it is named here so the day it arrives it is
# recognised rather than rediscovered.

# =========================================================================
# toast / dialog / boot / empty state / control / filetile
# =========================================================================
[toast]
h = 16u                             # the toast's height · - · len (u) · 86.4 px
top = 20u                           # distance from the top of the screen · - · len (u) · 108.0 px
pad_x = 8u                          # left/right padding inside the toast · - · len (u) · 43.2 px; today vw(4.0), a WIDTH-relative pad
min_w_frac = 50%                    # minimum toast width · - · % of the viewport width · -
max_w_frac = 90%                    # maximum toast width · - · % of the viewport width · -
title_gap = 0.12x @toast.h          # gap above the toast title · - · rat of @toast.h · 10.4 px
msg_gap = 0.45x @toast.h            # gap between title and message · - · rat of @toast.h · 38.9 px
corner = @corner.lg                 # the toast's corner radius · - · len (u) · @corner.lg = 2.2u = 11.9 px
corner_mode = @modal.corner_mode    # how that radius is cut · - · enum: square | round | chamfer · @modal.corner_mode; a toast is the modal's sheet without the scrim, and the two are never far enough apart to justify two answers
dwell_ms = 8000ms                   # how long a toast stays up · - · ms, 500ms .. 30000ms · popup.rs:9's SHOW_SECS; the block sized and placed the toast but never said how long it lives
title.role = label.section          # type role of the toast's title word · - · role · popup.rs:50's font_px(0.95)
body.role = body                    # type role of the toast's message · - · role · popup.rs:49's font_px(1.1)
max_visible = 1                     # how many toasts stand on screen at once; the rest wait their turn in the queue · - · n, 1 .. 8 · 1 = the single warning box this master has always drawn, in the place it has always drawn it
gap = @space.4                      # vertical gap between two stacked toasts; read ONLY when max_visible > 1, and it is 1 here · - · len (u) · @space.4 = 2u = 10.8 px

[dialog]
inset_x = 4.4u                      # horizontal inset of the dialog's content · - · len (u) · 23.8 px
inset_y = 8u                        # vertical inset of the dialog's content · - · len (u) · 43.2 px
corner = 8u                         # the dialog's corner radius · - · len (u) · 43.2 px
corner_mode = @modal.corner_mode    # how that radius is cut · - · enum: square | round | chamfer · @modal.corner_mode; the dialog is a small modal, and the radius is the only thing it states for itself. NO READER YET — the warning sheet is drawn outside this toolkit, with a chamfer written into Rust that no rule of this file ever licensed; see [corner]'s header, which names this key as a hardcode reported rather than a debt owed
border = @stroke.regular            # the dialog's ring · - · str · @stroke.regular
title.role = title.window           # type role of the dialog title · - · role · type.title.window
body.role = body                    # type role of the dialog's message · - · role · type.body
button.w_frac = 22%                 # a dialog button's width · - · % of the dialog's width · -
button.h_frac = 17%                 # a dialog button's height · - · % of the dialog's height · -
button.y_frac = 66%                 # where that button's top sits · - · % of the dialog's height · -
h_frac = 16%                        # the SAVE AS prompt's height — modal.h_frac is the settings window, a different object · - · % of the viewport height · editor.rs:868
h_min_px = 110px                    # absolute floor for h_frac's result · - · device px · companion of dialog.h_frac (3.2)
title_y_frac = 13%                  # where the dialog title sits · - · % of the dialog's height · popup.rs:111; the button was placed by fraction and the title by nothing
body_y_frac = 29%                   # where the first body line sits · - · % of the dialog's height · popup.rs:120
body_line_gap = 15%                 # baseline distance between the two body lines · - · % of the dialog's height · popup.rs:131

[boot]
pad_top = 6u                        # space above the first boot line · - · len (u) · 32.4 px
pad_x = 7u                          # left/right padding of the boot log · - · len (u) · 37.8 px; today vw(2.0)
line_role = data                    # type role of one boot line · - · role · type.data: mono, tabular. A `[   0.0000] text` line is instrument data, and the binding has to AGREE with the face the line is drawn in: boot.rs drew every line in the monospace slot while this key said `body` (face `ui`), with a comment saying the face was the one part of a binding that could not be routed. It can (`Role::font`), so the key now says what the screen shows — and the stamps stop shivering, because `data` is tabular
logo_role = display.hero            # type role of the product logo on the boot screen · - · role · type.display.hero
sub_role = spare0                   # type role of the version sub-line · - · role · type.spare0, a role of its own: `caption` is shared by file tiles, the layout editor and the status bar, so the sub-line could not grow without dragging half the interface with it
duration_ms = 3000ms                # how long the boot screen is on screen at all · - · ms, 0ms .. 10000ms · boot.rs:32; a theme that ships no boot log wants 0ms
log_duration_ms = 1600ms            # how fast the log scrolls — all its lines inside this window · - · ms, 0ms .. 10000ms · boot.rs:38; the split between log and logo is the shape of the sequence
logo_y_frac = 44%                   # where the TOP OF THE LOGO'S LINE BOX sits — the baseline lies one ascent below it (draw.rs text_center_fig -> text_verts) · - · % of the viewport height · boot.rs:125. This key said "baseline" for a long time, and sub_gap was written to match that fiction. The owner asked for the PAIR to be centred rather than the logo alone, and at the sizes above 44% already does it: the ink runs 481..598 px of 1080 and its middle lands within a pixel of the screen's (0.6 px at 1080p, 0.8 px at 1440p, 4.4 px at 720p, 10.7 px at 4K where unit_max_px clamps the unit). Moving this key would UNCENTRE the pair
sub_gap = 1.25x @type.display.hero.size  # gap between the top of the logo's line box and the top of the sub-line's · - · rat of @type.display.hero.size · boot.rs:148. The two boxes part at 0.985x for the measured face and at 1.2x for the fallback metric, so 1.25x clears both and every real ascent up to ~1.36 em; it was 0.4x, and the sub-line was drawn THROUGH the logo

# =========================================================================
# emptystate — the line a panel draws when it has nothing to show. Its two
# keys sat at the tail of [boot] with no header of their own, so the only
# name that reached them was `boot.role` / `boot.y_frac`; every consumer
# asked for `emptystate.*` and got nothing. The header is the whole fix —
# the keys, their order and their values are unchanged, so no other token's
# declaration order moves.
# =========================================================================
[emptystate]
role = value                        # type role of the "nothing here" message · - · role · type.value
y_frac = 40%                        # where that message sits in the empty box · - · % of the box's height · -

[control]
button.h = @size.xl                 # a control-plugin button's height · - · len (u) · @size.xl; unified from win_h*0.045 = 48.6 px, a THIRD height for one object
button.gap = 0.35x @control.button.h    # gap between two of them · - · rat of @control.button.h · 15.9 px
button.w_frac = 86%                 # their width inside the control panel · - · % of the panel's width · -
button.align = bottom               # where the button stack sits in the panel · - · enum: top | middle | bottom · -

[filetile]
gap = 2u                            # gap between two file tiles · image 8 (ARCHIWUM DANYCH) · len (u) · 10.8 px
cell = 17u                          # preferred tile edge; the auto fit packs as many as fit · 1, 8 · len (u), 0u = size from rows instead · ~92 px at 1440p, the pre-migration grid
rows = 3                            # rows of tiles per page when cell = 0u · image 8 · n · image 8's WIDE panel; a tall column with cell = 0u gets three giants, which is why cell exists
cols = auto                         # columns per row; auto fits as many as the width allows · image 8 · auto | n · sentinel auto (5.0)
cell_min_px = 20px                  # absolute floor for one cell · image 8 · device px · a floor with no u-sibling by design
corner = @corner.sm                 # a tile's corner radius · image 8 · len (u) · @corner.sm = 0.8u = 4.3 px
corner_style = @button.corner_style # which shape that radius is cut to · image 8 · enum: square | round | chamfer · follows the button: a tile is the cell's whole hit target, and a hit target answers in the control language. NO READER YET — the file grid and the launcher grid are drawn in the addons and still spell `round`, under the clause [corner]'s header keeps open for exactly this key
icon.inset_x = 22%                  # horizontal inset of the file glyph in its cell · image 8 · % of the cell's width · -
icon.inset_y = 12%                  # vertical inset of the file glyph in its cell · image 8 · % of the cell's height · -
icon.w = 56%                        # the glyph's width · image 8 · % of the cell's width · -
icon.h = 50%                        # the glyph's height · image 8 · % of the cell's height · -
icon.stroke = @stroke.thin          # the glyph's line weight · image 8 · str · @stroke.thin
caption_role = tooltip              # type role of a file name · image 8 · role · type.tooltip
error_role = alert.banner           # type role of the I/O error the panel shows instead of its tiles · image 8 · role · type.alert.banner, the role topbar.alarm.role already names for the same kind of sentence; fs/lib.rs spelled `type.alert.banner.*` out by name, which is a second binding nobody can edit
caption_gap = 70%                   # gap between glyph and file name · image 8 · % of the caption block's height (3.2) · -
wheel_px = 8u                       # scroll distance per wheel notch · image 8 · len (u) · 43.2 px
row_justify = fill                  # fill stretches row pitch so the last visible row ends on the panel's floor; pack sits rows on filetile.gap · image 8 · enum: pack | fill · fs/lib.rs:266 — why the tiles do not sit on filetile.gap today

# =========================================================================
# search — the search panel: one query box from [field] over one answer
# list from [list], and the two things NEITHER of those families can say,
# because both belong to the pair rather than to either half. Everything
# else the panel draws — the box, its caret, a row, its scrollbar, the
# line it shows when it has nothing to show — is already declared above
# and is deliberately not restated here.
# =========================================================================
[search]
gap = @space.2                      # between the query box and the first answer under it · image 7 (the search field) · len (u) · @space.2 = 1u = 5.4 px, the same step icon-to-label takes; neutral by reference rather than a length chosen here
debounce_ms = 200ms                 # how long after the last keystroke the search actually runs · - · ms, 0ms .. 3000ms · literal by rule, and deliberately NOT @tooltip.delay_ms: coupling a walk of the home directory to the pause before a tooltip would make one of the two wrong whenever the other moved. 0ms searches on every keystroke, which is the thing this token exists to prevent

# =========================================================================
# rhythm — alignment and vertical rhythm. This family replaces the 27 call
# sites doing y + (h - px*1.3)/2.0, which centre a SYNTHETIC box rather
# than the font's real metrics and park all-caps runs visibly low.
# baseline = box.y + (box.h + cap_height(font, px))/2 + bias*px.
# =========================================================================
[rhythm]
label_col_frac = 0.34               # label-column share of a settings row until auto measurement lands · 1 · frac · was content.w * 0.34 in settings.rs
baseline = 1u                       # the vertical grid text baselines snap to · images 1-10 · len (u) · 5.4 px
snap_baseline = false               # whether that snapping happens at all · images 1-6 · bool · false for family B, where cards float over a live background and the grid has nothing to lock to
# TODO(rhythm): shipped OFF as of 2026-08-17, and the value is the only
#   thing here that is provisional — the grid itself now has a reader
#   (view/paint.rs snap_baseline, which lays a line's BASELINE on it and
#   measures it from snap_origin). It is off because A GRID ONLY HOLDS
#   WHEN EVERY ROW PITCH IS A MULTIPLE OF IT, and this file's are not:
#   `row` is 4.8u and `row_compact` 3.6u against a `baseline` of 1u, and
#   `list.row_h`, `menu.row_h` and the rest never asked. Switched on as
#   the file stands, consecutive rows land 5u and then 4u apart — the
#   text jitters inside boxes of one height instead of marching down them.
#   Both keys already SAY "snapped at bake"; nothing snaps them. Deciding
#   the pitch is a decision about the whole toolkit's rhythm, so it waits
#   for the owner, and this switch honours it the moment the numbers line up.
#   SAY IT PLAINLY: `baseline` and `snap_origin` are read only INSIDE this
#   switch, so under the file as shipped their live readers are the tests
#   and nothing else. They have a reader; they do not yet have a picture.
snap_origin = panel_content_top     # what the grid is measured from · images 1-10 · enum: panel_content_top | screen_top · -
row = 4.8u                          # the standard row height, snapped at bake · images 1,7 · len (u) · 27.0 px; today px*1.9
row_compact = 3.6u                  # the dense row height, snapped at bake · image 9 · len (u) · 19.4 px
label_col = auto                    # the label column's width; auto is the widest label IN THE BLOCK · images 1,7 · auto | len (u) | % of the block's width · sentinel auto (5.0)
label_min = 8u                      # minimum label column width · images 1,7 · len (u) · 43.2 px
label_max = 45%                     # maximum label column width · images 1,7 · % of the block's width · -
label_pad = @space.4                # gap between the label column and the value column · images 1,7 · len (u) · @space.4 = 2u = 10.8 px
label_align = left                  # how a label sits in its column · images 1,7 · enum: left | right · -
value_col = auto                    # reserve a value column so unit suffixes line up · images 1,7,9 · auto | len (u) | % of the block's width · sentinel auto (5.0)
value_gutter = @space.2             # gap kept to the right of the value column · images 1,7,9 · len (u) · @space.2 = 1u = 5.4 px
value_align = right                 # how a value sits in its column; `decimal` is explicitly NOT offered on pre-formatted strings · images 1,7,9 · enum: left | right · -
center_mode = optical               # optical uses the font's cap height, geometric uses the box · images 1-10 · enum: optical | geometric · optical applies when the run's case transform is upper or smallcaps
cap_center_bias = -0.055            # the nudge added to an optically centred baseline · images 1-10 · f, a fraction of the run's px · -


# #########################################################################
# 5.26 COMPONENT COLOURS — the layer that makes "one palette re-skins
# everything" true. A widget NEVER names a literal: every key below is an
# expression over a semantic role, so changing palette.accent moves all of
# them. New colours added later belong HERE, defaulting to an existing
# semantic role — never as a new semantic role, never as a literal in a
# widget (5.0).
# #########################################################################
[component]

# ---------------------------------------------------------------- module title
# The two-part heading over a panel's content and its rule, drawn by the
# draw list itself (module_title) — the one text path with no Ctx, which is
# why its five constants survived the first migration wave.
module.leading = 1.75em             # title block height as a multiple of its px · 1-10 · em · was px*1.75 in draw.rs
module.tracking = 0.06em            # letter spacing of both halves · 1-10 · em · was px*0.06
module.pad = 0.6em                  # horizontal inset of either half · 1-10 · em · was px*0.6
module.gap = 1.8em                  # minimum gap between the two halves · 1 · em · was px*1.8
module.rule = @stroke.hair          # the underline's width · 1-10 · str · was a hardcoded 1.0
module.rule_color = @border.subtle  # the underline's colour · 1-10 · col · was alpha(title, 0.3); border.subtle is the same idea with a name


# ---------------------------------------------------------------- panel
panel.fill = @surface.panel         # the panel's interior · images 1-10 · col · @surface.panel
panel.border = @border.default      # the panel's ring · images 1-10 · col · @border.default
panel.title = @text.title           # the panel title text · images 1-10 · col · @text.title
panel.glow = @accent.glow           # the soft outer glow on the panel edge · images 1,2 (bloom on the wall) · col · @accent.glow
panel.header_underline = alpha(@border.default, 0.30)   # the rule under the title band · images 1-6 · col · draw.rs:302

# ---------------------------------------------------------------- titlebar
titlebar.fill = @surface.inset      # the title bar's material · images 7,8 · col · @surface.inset
titlebar.text = @text.title         # the window title · images 7,8 · col · @text.title
titlebar.rule = alpha(@border.subtle, 0.30)   # the title bar's floor line · images 7,8 · col · winframe.rs:322
window_control.idle = @text.muted   # a resting `_ □ ✕` glyph · images 1,7 · col · @text.muted
window_control.hover = @accent.hover            # that glyph under the pointer · images 1,7 · col · @accent.hover
window_control.close_hover = @severity.critical.text   # the close glyph under the pointer · images 1,7 · col · @severity.critical.text

# ---------------------------------------------------------------- hexcell
hexcell.fill = alpha(@accent.primary, 0.22)   # a filled hexagon's body · images 1,3,4 · col · @accent.primary at 0.22
hexcell.fill_top = alpha(@accent.hover, 0.38) # the gradient end of that body · image 1's mint gradient · col · image 3 fills solid instead
hexcell.border = @accent.border     # the hexagon's edge · images 1,3,4 · col · @accent.border
hexcell.empty = @surface.sunken     # an unfilled hexagon · images 1,3,4 · col · @surface.sunken

# ---------------------------------------------------------------- bar / meter
bar.track = @surface.sunken         # the unfilled part of a progress bar · images 1,7 · col · @surface.sunken
bar.fill = @data.line               # the filled part · images 1,5,7 · col · a meter DISPLAYS A VALUE, so it is data, not chrome — image 5 is the proof the two split, and the aurora seed's cyan lived or died on this line
bar.fill_warn = @severity.warning.text   # the filled part in a warning band · image 1's ENERGIA · col · @severity.warning.text
bar.fill_crit = @severity.critical.text  # the filled part in a critical band · images 1,4 · col · @severity.critical.text
bar.text = @text.primary            # the readout beside the bar · images 1,7 · col · @text.primary
bar.text_on_fill = @accent.on       # that readout when it lands ON the fill · images 1,7 · col · ui.rs:138, the contrast flip gauge.value_clearance triggers

# ---------------------------------------------------------------- chart
chart.line = @data.line             # the plot line · images 2,8 · col · @data.line
chart.fill = @data.fill             # the area under it · images 2,8 · col · @data.fill
chart.grid = @data.grid             # the faint grid behind the plot · image 2 · col · @data.grid
chart.axis = @data.axis             # the axis lines · images 2,8,9 · col · @data.axis
chart.legend = @text.muted          # legend labels · image 2 · col · @text.muted
chart.bg = @surface.sunken          # the plot area's own background · images 2,8,9 · col · @surface.sunken
chart.series[0] = @data.series[0]   # categorical series 0 · images 8,9 · col · @data.series[0]
chart.series[1] = @data.series[1]   # categorical series 1 · images 8,9 · col · @data.series[1]
chart.series[2] = @data.series[2]   # categorical series 2 · images 8,9 · col · @data.series[2]
chart.series[3] = @data.series[3]   # categorical series 3 · images 8,9 · col · @data.series[3]
chart.series[4] = @data.series[4]   # categorical series 4 · images 8,9 · col · @data.series[4]
chart.series[5] = @data.series[5]   # categorical series 5 · images 8,9 · col · @data.series[5]
chart.series[6] = @data.series[6]   # categorical series 6 · images 8,9 · col · @data.series[6]
chart.series[7] = @data.series[7]   # categorical series 7 · images 8,9 · col · @data.series[7]

# ---------------------------------------------------------------- gauge / donut
gauge.track = @surface.sunken       # a gauge's unfilled body · image 1 · col · @surface.sunken
gauge.value = @data.line            # a gauge's filled body · image 1 · col · @data.line
gauge.text = @text.primary          # a gauge's numeric readout · image 1 · col · @text.primary
donut.track = @surface.sunken       # the donut's unfilled remainder · image 9 · col · @surface.sunken
donut.arc = @data.line              # the donut's filled arc · image 9 · col · @data.line

# ---------------------------------------------------------------- nodegraph
nodegraph.node = @accent.primary    # a node · images 1,8 · col · @accent.primary
nodegraph.edge = alpha(@accent.primary, 0.40)   # the line between two nodes · images 1,8 · col · @accent.primary at 0.40

# ---------------------------------------------------------------- badge
# A badge WITH a severity takes its four colours from sev[i] AT DRAW TIME,
# indexed by the u32 the producer passed (5.10, 5.17, 7.4). There is no
# `<r>` metavariable in this language: `@severity.<r>.fill` is not an
# expression an author can write. The five rows below are the NON-severity
# defaults — what a badge with no severity looks like.
badge.fill = @surface.inset         # a plain badge's body · images 1,3,4 · col · @surface.inset
badge.edge = @border.default        # a plain badge's ring · images 1,3,4 · col · @border.default
badge.text = @text.primary          # a plain badge's text · images 1,3,4 · col · @text.primary
badge.solid_fill = @accent.primary  # a solid badge's body · images 1,3,4 · col · @accent.primary
badge.solid_text = @accent.on       # a solid badge's text · images 1,3,4 · col · @accent.on

# ---------------------------------------------------------------- launcher
launcher.tile = @surface.inset      # the plate a launcher glyph sits on · images 1,8 · col · @surface.inset
launcher.border = @border.subtle    # that plate's ring · images 1,8 · col · @border.subtle
launcher.glyph = @accent.primary    # the glyph itself · images 1,8 · col · @accent.primary
launcher.caption = @text.muted      # the wide-tracked caption under it · images 1,8 · col · @text.muted
launcher.active_glyph = @accent.warm     # the glyph of the running/active tile · image 8's orange HOME · col · nothing derived from cyan produces orange (5.21a)
launcher.active_border = @accent.warm    # that tile's ring · image 8 · col · @accent.warm

# ---------------------------------------------------------------- menu / control marks
menu.fill = @surface.raised         # the opaque bed of a drop-down or window menu · images 1,7 · col · @surface.raised; [menu] carries geometry only, so a menu could not take a material distinct from the panel behind it
menu.border = @elev.panel.edge.color # the menu's chamfered ring · images 1,7 · col · reads the SAME edge colour the settings window frame wears (elev.panel.edge.color -> @component.panel.border -> @border.default), so BASIC's border-colour control (which writes the shared root border.default) moves the menu ring with every other frame; [menu].border is a stroke WIDTH
menu.hint = @text.muted             # a row's shortcut hint ink · - · col · @text.muted; secondary to the row label by design
button.fill = @surface.raised       # the ONE button interior, worn by every button in every window regardless of the elevation or bed beneath it · images 1,7 · col · @surface.raised; a dedicated token so a theme sets the button colour ONCE (shape.button.fill reads this), and no window's own surface can shade its buttons differently
checkbox.tick = @accent.primary     # the filled mark inside a checked box · - · col · @accent.primary; [checkbox] sets the mark's shape and inset and never its colour

# ---------------------------------------------------------------- field
field.fill = @surface.sunken        # the search box's interior · image 7 · col · @surface.sunken
field.border = @border.subtle       # its ring · image 7 · col · @border.subtle
field.text = @text.primary          # typed text · image 7 · col · @text.primary
field.placeholder = @text.muted     # the `browser` placeholder · image 7 · col · @text.muted
field.caret = @accent.primary       # the caret · image 7 · col · @accent.primary
field.selection = alpha(@accent.primary, 0.28)   # wash behind selected text · - · col · mirrors term.selection
field.selection_text = contrast_on(over(@component.field.selection, @component.field.fill), @surface.void, @text.primary)   # ink inside the wash · - · col · the term.selection_fg idiom, resolved over the composited wash
field.preedit = @text.primary       # IME composing text ink · - · col · @text.primary; the underline is what marks it

# ---------------------------------------------------------------- picker
picker.edge = @border.subtle        # the ring around the field, the bar, the patch and every swatch · - · col · @border.subtle; one ring for the whole control, so its parts read as one object
picker.text = @text.primary         # the notation's name and the value written in it · - · col · @text.primary
picker.handle = @palette.white      # the ring marking the chosen point in the field and on the bar · - · col · @palette.white; a mark that took the accent would vanish the moment the accent was the colour being picked, which is the one moment it is needed
picker.checker_a = @surface.raised  # the lighter square of the chequerboard behind a colour with alpha · - · col · @surface.raised
picker.checker_b = @surface.sunken  # its darker neighbour · - · col · @surface.sunken; the PAIR is what makes transparency visible, so a theme that sets them equal turns the chequer off deliberately
picker.rest = @palette.neutral      # what a picker holds before anything seeds it · - · col · @palette.neutral; a picker is built long before its owner knows what to point it at, and whatever it shows meanwhile is on the screen — so it is a look, and the neutral a theme nominates rather than a grey chosen in Rust

# ---------------------------------------------------------------- chrome bits
taskbar.fill = @surface.raised      # the dock's material · images 7,8,9 · col · @surface.raised
taskbar.border = @border.default    # the dock's ring · images 7,8,9 · col · @border.default
avatar.ring = @accent.border        # the ring around a crew avatar · images 1,7 · col · @accent.border
leader_line = alpha(@accent.primary, 0.70)   # a callout line on the render · images 1,5 · col · @accent.primary at 0.70
leader_label = @text.muted          # that callout's label · images 1,5 · col · @text.muted
scale_tick = @text.instrument       # a tick on image 7's measuring rule · image 7 · col · @text.instrument
datadump = @text.instrument         # image 9's hexadecimal margin columns · image 9 · col · @text.instrument
trace = alpha(@accent.primary, 0.08)         # the PCB traces in the background · images 1,4 · col · @accent.primary at 0.08
vignette = alpha(@palette.black, 0.55)       # the corner darkening · image 4's heavy vignette · col · @palette.black at 0.55
scanline = alpha(@palette.black, 0.10)       # the CRT scanline overlay · images 1-6 · col · @palette.black at 0.10
modal.scrim = @surface.scrim        # what darkens the desktop behind a modal · - · col · window.rs:10 hard-codes BLACK today
editor.grid_line = alpha(@border.subtle, 0.16)   # the board editor's alignment grid · - · col · @border.subtle at 0.16
editor.proxy_fill = alpha(@accent.primary, 0.08) # a widget proxy's body while editing · - · col · @accent.primary at 0.08
editor.hold_fill = alpha(@accent.primary, 0.25)  # the hold-to-place progress wash sweeping an ADD WIDGET entry · - · col · editor.rs:832; neither hover nor press — state.press.fill at 0.45 would swamp the live miniature underneath
nameplate.fill = alpha(@surface.raised, 0.90)    # the plate behind a floating name label · images 1,7 · col · @surface.raised at 0.90

# ---------------------------------------------------------------- settings bands
# ONE BED FOR THE NAVIGATION, AND THE PAGE IS THE BODY. The settings window
# stands in TWO columns — the navigation rail and the page — and the rail is
# one bed one step off the window body, which the page keeps as it is.
#
# WHAT THIS REPLACED, in two moves and not one. Until 2026-08-18 the window had
# THREE columns: a section rail, a second column of that section's own pages
# beside it, and the page. They were three SHADES of one hue, `band_lift`
# applied twice off the body — L 0.232 / 0.278 / 0.334, a staircase climbing
# outward — and the owner rejected that on sight: three shades across two
# adjacent strips of one navigation reads as a seam through one object, not as
# depth. So the two navigation columns became one colour said twice. Then the
# columns themselves became ONE (owner's mock-up, same day): a section's pages
# unfold UNDER it, indented and bracketed by `settings.rail_guide`, instead of
# standing in a column of their own. `component.settings.sub_fill` was the
# second column's bed and has gone with the column — a token nothing can ever
# paint again is worse than no token, because it reads as a knob.
#
# `band_lift` is still the knob and still decides direction as well as size
# (below 1.0 the navigation sits UNDER the page, the escape a LIGHT theme
# takes; at exactly 1.0 the whole interior is one colour). It is simply applied
# ONCE, off the body, by the one expression the one bed is written with.
#
# WHAT WAS WRONG WITH THE FIRST ANSWER (owner, from a screenshot, 2026-08-17:
# "both navigation columns are BLACK"). The two bands were pointed straight
# at rungs of the surface ladder — @surface.void and @surface.base — and the
# arithmetic was defensible: L 0.115 / 0.178 / 0.232, two even steps of about
# 0.06. What the arithmetic missed is that OKLab L and the SCREEN part company
# at the bottom of the ladder. Encoded to the 8-bit swapchain those three beds
# reach the codes 6, 19 and 32 of 255 on their BRIGHTEST channel, and code 6 is
# not a dark shade of anything — it is black. Worse, §5.5 says in its own
# words what the
# first rung is FOR: "the absolute bed … THE SWAPCHAIN CLEAR COLOUR", the
# nothing behind the picture. A column of interface is not the nothing behind
# the picture. The rung was wrong, not the idea.
#
# AND THE SECOND FAULT THE SAME SCREENSHOT SHOWED. The navigation's bands were
# pinned to rungs and the page's was not: the page's bed is the window body,
# `component.panel.fill`, which the theme editor's BACKGROUND section writes as
# a LITERAL colour off its own sliders (theme/edit.rs, `glass_edits`). So the
# page followed the sliders and the two columns did not, and the window came
# apart down the middle. A ladder whose rungs are anchored to three different
# things is not a ladder.
#
# THE ANSWER: THE BED IS MEASURED FROM THE BODY, NOT FROM THE FLOOR. The page's
# bed is `component.panel.fill` and the navigation's is that same bed lifted
# once by `settings.band_lift` (1.20). On this master's own numbers that lands
# it at OKLab L 0.232 -> 0.278 — within 0.005 of the ladder's own `inset`
# (0.283) rung, so the surface ladder is still what the eye sees, while the
# ANCHOR is the one thing every author and every slider already moves. Encoded,
# the two reach the codes 32 and 44: neither is black, and the step is a dozen
# codes wide. As WCAG contrast against pure black — the ruler that does not
# flatten down there — 1.26 and 1.44, where the old pair read 1.03 and 1.12.
#
# WHY THE NAVIGATION STANDS ABOVE THE PAGE AND NOT BELOW IT. The page is the
# well and the navigation is the rim: the chrome you steer with lies ON the
# thing you are steering. That also puts the navigation on the material
# `@surface.inset` describes — "a bordered box nested inside a panel" — which
# is what a navigation column is. A menu opened over the rail lands one rung
# further up; what keeps the two apart is the menu's own ring
# (`component.menu.edge`), not its bed, which is how every float on that rung
# has always been separated from what it floats over.
#
# `band_lift` DECIDES THE DIRECTION AS WELL AS THE SIZE, and that is deliberate.
# Above 1.0 the chrome stands above the page, which is right for a dark theme
# where there is no room below. A LIGHT theme sets it under 1.0 — `0.85`, say —
# and the same expression runs the step downward instead, with no other edit
# and no second token. At exactly 1.0 the whole interior is one colour, which is
# the honest way to say "no bands at all".
#
# THE PAGE'S OWN NAME IS HERE TOO, AND IT IS THE SENTINEL. Both columns are
# named, so a theme may bed either of them; the master leaves the page's
# at `none` — "there is nothing to draw here" — because the page's bed is
# ALREADY on the screen. The window body is it, laid by window::frame over the
# page's whole area, and `panel.fill` is TRANSLUCENT (alpha 0.82): a second
# coat of the same colour composes that alpha twice and comes out somewhere
# else (#131E19 against #15201B over this master's own field, an OKLab dE of
# 0.0078). Where `elev.panel.glass.rank` lifts the body off its fill it is
# worse still — the body is a blur there, and any opaque bed laid over it is
# the end of the blur the BACKGROUND section just put down. So the master
# declines to paint it, and the rail, which IS painted, inherits the body's
# own alpha through the expression, which is what keeps a blurred or
# translucent window blurred and translucent across both columns.
#
# AND THE GUIDE IS NOT A THIRD BED. `settings.rail_guide` is the hairline a
# section's unfolded pages are propped against, drawn ON the rail's own bed at
# `settings.rail_guide_w` and `settings.rail_guide_x`. It is a border colour
# and not a surface one on purpose: a group of rows bracketed by a line is one
# object with a mark beside it, while a group of rows on a bed of its own is a
# second column — and a second column is exactly what unfolding the rail
# replaced.
#
# WHEN THE WINDOW FOLDS — content narrower than settings.col_min_w, which one
# navigation column instead of two makes a rare shape rather than the small
# screen's normal one — there are no columns: the rail's rows become the first
# bands of the one vertical flow. A band's fill is a COLUMN's fill, so a folded window paints none of
# these and the body stands alone over the whole interior — which is the rung
# the page was on all along, so a folded window looks exactly as it does
# today. No stripes, and no special case in Rust to keep them away.
settings.page_fill = none             # the page column's bed · - · col | none · sentinel none = draw nothing; the window body (@component.panel.fill) is already standing there, and it is the rung the navigation is measured from
settings.rail_fill = lum(@component.panel.fill, @settings.band_lift)
                    # the navigation rail's bed: the body, one lift up · - · col · L 0.232 x 1.20 = 0.278, beside the ladder's own @surface.inset (0.283); the body's alpha rides through lum() untouched
settings.rail_guide = @border.subtle
                    # the vertical line an expanded section's pages are propped against · - · col · @border.subtle — the hairline every table rule and grid line in this file already uses, one step quieter than the plates it brackets

# ---------------------------------------------------------------- toast / terminal chrome
toast.title = @severity.warning.text    # the WARNING word at the top of a toast · - · col · popup.rs:65 draws it in the chrome accent; the toast says "warning" and [severity] exists for exactly this
toast.text = @text.primary          # the toast's message body · - · col · popup.rs:75
terminal.indicator = @text.muted    # the SCROLL +n scrollback readout · image 3 · col · shell/lib.rs:361 draws it at full base, as loud as the shell's own output

# ---------------------------------------------------------------- tooltip
# The tooltip is a raised sliver of the interface explaining the thing
# under the pointer, so it takes the raised surface and the ordinary
# border rather than a colour of its own — the menu's material one
# elevation lower. Its class in the matrix is `badge`: one state, idle.
tooltip.fill = @surface.raised      # the tooltip's body · - · col · @surface.raised, the same bed component.menu.fill sits on
tooltip.edge = @border.default      # its hairline ring · - · col · @border.default, the ring every raised sliver carries
tooltip.text = @text.primary        # its text · - · col · @text.primary; type.tooltip.fg says the same, and the component token is what a theme reaches for first

# ---------------------------------------------------------------- topbar / alarm
# The alarm bar's TEXT is sev[highest_live].text, indexed AT DRAW TIME by
# the host, which is the only thing that knows which severities are live.
# `@severity.<highest live>.fg` was a runtime query written as a load-time
# expression, against 6's rule that every expression is pure. The theme's
# knobs are the three below plus topbar.alarm.* (5.25).
alarm_bar.fill = none               # the alarmed bar's own body; none leaves topbar.fill showing · images 1,4 · col | none · sentinel none = draw nothing
alarm_bar.text_alpha = 1.00         # how strongly the alarm text is drawn over that body · images 1,4 · frac 0..1 · -
alarm_bar.edge = @severity.critical.edge   # the alarmed bar's ring · images 1,4 · col · @severity.critical.edge
topbar.fill = @surface.panel        # the resting bar's material · images 1,2,3,4,6 · col · @surface.panel
topbar.text = @accent.primary       # the bar's ordinary text · image 6 ("the bar text is the ordinary accent") · col · @accent.primary
topbar.sep = alpha(@accent.primary, 0.45)   # the `|` divider between cluster items · images 1,2,3,4,6 · col · @accent.primary at 0.45
topbar.glyph = @accent.dim          # the right-hand status glyph run · images 1,2,3,4,6 · col · @accent.dim
topbar.rule = @border.subtle        # the line under the bar · images 1,2,3,4,6 · col · @border.subtle

# ---------------------------------------------------------------- render
render.wire = @render.wire          # the wireframe · images 1,2,5,6 · col · @render.wire (5.25)
render.hull = @render.hull          # the hull between the wires · images 3,4,5 · col · @render.hull (5.25)
render.rim = @render.rim            # the rim light · images 3,4 · col · @render.rim (5.25)
render.orbit = @render.orbit        # the orbit lines · images 5,6 · col · @render.orbit (5.25)
render.planet = @render.planet      # the planet disc · images 1,2,5 · col · @render.planet (5.25)
render.silhouette = @render.silhouette   # the small ship at the right · image 1 · col · @render.silhouette (5.25)

# ---------------------------------------------------------------- dot
dot.fill = @severity.critical.text  # the unread dot · image 7's "red dot" · col · @severity.critical.text
dot.border = @surface.panel         # the halo that separates it from the title behind · images 7,8,9,10 · col · @surface.panel
dot.count_text = @severity.critical.on   # the number inside a counting dot · images 7,9 · col · @severity.critical.on

# ---------------------------------------------------------------- scrollbar
scrollbar.track = alpha(@surface.inset, 0.5)  # the groove behind the thumb; read ONLY when scrollbar.track = on, and that is off in the master, so nothing draws it here · - · col · @surface.inset at half, the same recess a meter's track sits in

# ---------------------------------------------------------------- tree
tree.guide = @border.subtle         # the hairline down an ancestor's indent column; read ONLY when tree.guides is not none, and it is none in the master · - · col · @border.subtle, the quietest line the palette has

# ---------------------------------------------------------------- table / columns
table.head = @text.secondary        # a header cell · images 1,9 · col · ui.rs:163, was base/0.5
table.rule = alpha(@border.subtle, 0.70)     # the hairline under the header · images 1,9 · col · ui.rs:257, was base/0.35
table.row = @text.primary           # a body cell · images 1,9 · col · was base/0.9
table.zebra = alpha(@surface.inset, 0.35)    # what table.zebra_every alternates · images 1,9 · col · @surface.inset at 0.35
columns.label = @text.secondary     # the key half of a key:value row · images 1,7 · col · ui.rs:267, was base/0.5
columns.value = @text.primary       # the value half · images 1,7 · col · was base
columns.divider = @border.subtle    # the hairline between two cells of a `columns` strip (u2 2.2) · image 7's pipe dividers · col · @border.subtle

# ---------------------------------------------------------------- script widgets
script.title = @text.title          # a Rhai widget's `title` element · images 1,7 · col · @text.title (5.29)
script.label = @text.secondary      # the label half of a `rows` or `columns` element · images 1,7 · col · @text.secondary
script.value = @text.primary        # the value half of those elements · images 1,7 · col · @text.primary
script.rule = @border.subtle        # a `line` element · images 1,7 · col · @border.subtle
script.meter_track = @component.bar.track    # a `meter` element's unfilled part · images 1,7 · col · @component.bar.track
script.meter_fill = @component.bar.fill      # a `meter` element's filled part · images 1,7 · col · @component.bar.fill
script.dot_on = @component.matrix.cell_on    # a lit dot in a `dots` element · image 9 · col · @component.matrix.cell_on
script.dot_off = @component.matrix.cell_off  # an unlit dot in a `dots` element · image 9 · col · @component.matrix.cell_off

# ---------------------------------------------------------------- file / log / matrix
file.glyph_dir = @accent.primary    # a directory glyph in the filesystem widget · image 8 · col · @accent.primary
file.glyph_file = alpha(@accent.primary, 0.75)   # a plain file glyph · image 8 · col · @accent.primary at 0.75
file.glyph_link = @accent.secondary # a symlink glyph · image 8 · col · @accent.secondary
file.glyph_detail = alpha(@accent.primary, 0.70) # the secondary strokes inside an icon: the file sheet's fold lines · image 8 · col · fs/lib.rs:405 — one number applied twice with no name
log.line_current = @text.primary    # the newest log line · images 2,5 (MISSION LOGS) · col · @text.primary
log.line_past = alpha(@text.primary, 0.60)   # older log lines · images 2,5 · col · @text.primary at 0.60
matrix.cell_on = @accent.primary    # a lit cell of a dot matrix · image 9 · col · @accent.primary
matrix.cell_off = alpha(@accent.primary, 0.20)   # an unlit cell · image 9 · col · @accent.primary at 0.20

# ---------------------------------------------------------------- imagery
# A ceiling, not a lock. Image 3's LIVE FEED is "desaturated toward green"
# and 6 cites that exact image as why sat() survives the function cull; a
# rule forbidding the effect while another section justifies a function by
# it cannot both be right. So a THEME may grade its own feed within these
# ceilings (tint_strength <= 0.35, saturation >= 0.35) and a MOOD may set
# neither, ever (4.4 pass D 3) — an alarm must not recolour evidence.
# Values past the ceiling are clamped and logged with both numbers.
image.photo.tint_strength = 0.0     # how far a photograph is pulled toward the tint · image 3 grades to 0.30 · frac 0..0.35 for a theme, 0.0 for a mood · off by default
image.photo.tint = @accent.primary  # the hue a graded photograph is pulled toward · image 3's green feed · col · @accent.primary
image.photo.saturation = 1.0        # how much of a photograph's own colour survives · image 4 keeps 1.0, image 3 drops to 0.45 · frac 0.35..1.0 for a theme, 1.0 for a mood · untouched by default
image.render.tint_strength = 1.0    # a wireframe IS a drawing, so it is fully themeable · images 1,5 · frac 0..1 · no ceiling; it carries no evidence


# #########################################################################
# 5.27 THE CLASS × STATE MATRIX — 49 classes × 7 states.
#
# NOT A TOKEN FAMILY. The class × state product (CLASS_COUNT 64 × 7 = 448
# ClassStyle cells) is DERIVED, not authored: a theme writes the seven-row
# state ladder of 5.21 ONCE and every class inherits it. Nothing in this
# block is a key, which is why this block is entirely comment — but the
# matrix belongs in the file that is documentation, because it is the only
# statement of which per-class overrides are legal to write.
#
# `•` the class enters that state, `default` defines it through the global
#     ladder, and it is authorable as `<class>.state.<state>.<channel>`
# `–` the class NEVER enters that state; a theme defining the cell is
#     warned and the cell is ignored — the theme file is documentation and
#     a typo must be caught.
#
# The eight channels (5.21, named exactly as ClassStyle spells them):
#     fill · edge · text · glyph · edge_width · glow_radius · glow_alpha ·
#     elevation
#
# The `focus` column is an ENGINE CONSTANT, not a token. It records which
# focus treatment the class receives — focus is an orthogonal bool on
# containers, not a state slot (5.21) — and there is no `button.focus =
# ring` to write. The focus.* family has six global tokens and no per-class
# member; that is a deliberate scope decision, labelled here rather than
# left looking like a token family with no names.
#
# One worked cell, so the syntax the warning polices appears at least once:
#
#     [tab]
#     state.selected.edge       = @accent.primary   # a "•" cell: legal
#     state.dragging.fill       = alpha(base, 0.2)  # a "–" cell: warned
#
# class                Idle Hover Press Sel SelHov Drag Disab   focus
# ------------------------------------------------------------------------
# button                •    •     •     •    •     –    •      ring
# icon_button           •    •     •     –    –     –    •      ring
# chip                  •    •     •     •    •     –    •      ring
# tab                   •    •     •     •    •     –    •      ring
# menu.item             •    •     •     •    •     –    •      ring
# field                 •    •     –     –    –     –    •      ring
# checkbox              •    •     •     •    •     –    •      ring
# slider.track          •    •     –     –    –     •    •      ring
# slider.knob           •    •     •     –    –     •    •      –
# list.item             •    •     •     •    •     •    •      ring*
# tile                  •    •     •     •    •     •    •      –
# launcher.icon         •    •     •     •    •     •    –      –
# key                   •    •     •     •    •     –    •      –
# window                •    •     –     –    –     •    –      container
# panel                 •    •     –     •    •     •    –      container
# dialog                •    –     –     –    –     –    –      container
# taskbar.button        •    •     •     •    •     –    •      ring
# titlebar              •    –     –     –    –     •    –      inherits window
# scrollbar.thumb       •    •     –     –    –     •    •      –
# resize.grip           •    •     –     –    –     •    –      –
# meter                 •    –     –     –    –     –    •      –
# gauge.donut           •    –     –     –    –     –    •      –
# chart.line            •    •     –     •    •     –    –      –
# chart.bar             •    •     –     •    •     –    –      –
# chart.grid            •    •     –     •    •     –    –      –
# chart.axis            •    •     –     •    •     –    –      –
# chart.legend          •    •     –     •    •     –    –      –
# hexcell               •    •     –     •    •     –    –      –
# badge                 •    –     –     –    –     –    –      –
# node                  •    •     –     •    •     –    –      –
# avatar.tile           •    •     –     •    •     –    –      –
# table.head            •    •     •     •    •     –    –      –
# table.row             •    •     –     •    •     –    –      –
# log.line              •    •     –     •    •     –    –      –
# term.cell             •    –     –     • (selection)  –    –      –
# leader.line           •    –     –     –    –     –    –      –
# scale.tick            •    –     –     –    –     –    –      –
# datadump              •    –     –     –    –     –    –      –
# topbar                •    –     –     –    –     –    –      –
# alarm_bar             •    –     –     –    –     –    –      –
# render                •    –     –     –    –     –    –      –
# dot                   •    –     –     –    –     –    –      –
# script.row            •    •     –     •    •     –    –      –
#
# The remaining classes take the row of the closest analogy above:
#   cycler, segmented   → button        tooltip, toast    → badge
#   boot.line           → log.line      filetile          → tile
#   boards.tile         → tile          dock              → taskbar.button
#   editor.proxy        → panel         nameplate         → badge
#
# The chart / hexcell / node hover and selected slots exist because image
# 1's leader lines label features and image 9's gauges sit in a bar the
# pointer travels over: a data element the user can point at must be able
# to answer.
#
# table.head gained hover / press / selected when the table learned to
# sort (F2 §2.1): the heading is a control now, and `selected` is the
# SORTED column. A table that was never told it is interactive never asks
# for those rungs, which is why the master's own tables look untouched.
#
# list.item's `selected` is the row ALREADY IN FORCE in an open
# drop-down — the theme now applied, the layout now loaded. Once the
# anchor was ruled to wear the list's own name rather than the choice,
# an unmarked list left the standing choice unstated everywhere in the
# window. What carries it is `fill`: the row's PLATE, cut to
# `list.corner_style`. A drop-down row draws no ring at all, so `edge`
# and `edge_width` reach nothing on it — that ring was what made an open
# list read as a column of loose boxes, each with its own hairline and
# two hairlines in every seam.
#
# `menu.item`'s own `selected` is the menu's checked row (menu.rs), and
# that is now the only thing it is: a drop-down is not a menu.
#
# * list.item's focus cell reads `ring` where the class first went in
#   with `–`. A list row in a panel is not in the focus chain and takes
#   no ring; a drop-down's rows ARE registered in it (`AccordionStyle::
#   focus`), and a chain member the ring skips is a keyboard user with
#   no cursor. Focus is orthogonal to the ladder either way (5.21) — no
#   rung moves for it.
#
# Two gaps the inventory exposed, which this table closes: slider.rs has no
# hover, no drag and no disabled — a dragging slider looks identical to an
# idle one; and dropdown.rs:41 changes the fill on hover but not the edge.
# #########################################################################

# ---------------------------------------------------------------- responsive
# The container-query font scale: how a widget's type answers its panel's
# size. Three numbers that were hardcoded twice in main.rs.
[responsive]
panel_ref_frac = 0.30               # reference panel width as a share of screen height · - · frac · was h * 0.30
scale_min = 0.62                    # floor of the per-panel font scale · - · f · was clamp lo
scale_max = 3.0                     # ceiling of the per-panel font scale · - · f · was clamp hi
