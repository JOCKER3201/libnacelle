border_width          = @border.edge.width    # stroke weight of the ring · 1 · str (device px, never panel-scaled) or same_as_parent · @border.edge.width -> @stroke.hair, i.e. the "solid 1x" of 5.18's table
border_color          = @component.launcher.border
                                              # colour of the ring · 1 · colour or same_as_parent · -> @border.default -> alpha(@accent.primary, 0.78)
border_alpha          = 1.0                   # alpha multiplier on border_color · 1 · frac, 0..1 · opaque
fill                  = @surface.inset        # the interior · 1 · colour, none, or same_as_parent · 5.18's table
fill_alpha            = 1.0                   # alpha multiplier on fill · 1 · frac, 0..1 · opaque
fill_to               = @shape.tile.fill      # the far stop of the interior gradient · 1 · colour · == fill, so the fill is flat
fill_angle            = 90deg                 # direction of the interior gradient · 1 · deg, 0..360 · ignored while fill_to == fill
round_segments        = @corner.segments      # arc tessellation of a round corner · 1 · n, 3 .. 16 · @corner.segments = 6, a 0.4px chord error at an 8px radius: invisible, and 6 quads instead of 16
glow                  = none                  # which glow class this preset's edge wears · 1 · @glow.<class> or none · no glow class fits this preset
dash                  = @border.edge.dash     # dash length along the ring · 1 · len · @border.edge.dash = 1.6u; used only when border_style = segmented
gap                   = @border.edge.gap      # gap length along the ring · 1 · len · @border.edge.gap = 0.8u; used only when border_style = segmented
phase                 = @border.edge.phase    # where the dash pattern starts on the ring · 1 · len · @border.edge.phase = 0u; used only when border_style = segmented
bracket_len           = @border.edge.bracket_len
                                              # length of each corner bracket · 1 · frac of the SHORTER SIDE of the host rect, clamped [0.8u, 4.0u] · @border.edge.bracket_len = 18%; used only when border_style = brackets
bracket_inset         = @border.edge.bracket_inset
                                              # how far the brackets sit inside the ring · 1 · len · @border.edge.bracket_inset = 0u; used only when border_style = brackets

# ---------------------------------------------------------------- shape.key
# an on-screen keyboard key
[shape.key]
corners               = [ round, @corner.sm ] # all four corners of the key ring · 3 · [ style, len ] · enum: square | round | chamfer | chevron | hexagon · the ladder's small step
corners_tl            = [ same_as_parent, same_as_parent ]
                                              # the top-left corner alone · 3 · [ style, len ] · a slot left same_as_parent copies @shape.key.corners
corners_tr            = [ same_as_parent, same_as_parent ]
                                              # the top-right corner alone · 3 · [ style, len ] · a slot left same_as_parent copies @shape.key.corners
