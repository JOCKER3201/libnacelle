# nacelle default theme — THE MASTER
#
# Every token the engine knows is declared here. A theme that omits a
# setting inherits it from this file, so this is both the fallback and
# the documentation: an author learns what exists by reading it.
#
# Assembled from the specification in docs/theme-engine.md. Values trace
# back to the ten reference images the themes were designed from.



# ============================================================ 10-core

# =========================================================================
# nacelle master theme — CORE (5.1 meta · 5.2 palette · 5.3 metric ·
# 5.4 ladders · 5.5 surface · 5.6 text · 5.7 border · 5.8 accent · 5.9 data)
#
# READ THIS FIRST, then never again: every key in this file carries exactly
# one comment, in one order, `·`-separated (5.0b):
#
#     # <what it draws> · <reference image> · <unit / legal range> · <derivation when omitted>
#
# `cargo test theme_default_is_documented` parses this file and fails on any
# key whose comment is missing a field. A key with a literal value says so in
# the fourth field ("literal by rule"); a key with a derivation repeats where
# the derivation comes from. NOTHING in this file is the resolved hex of an
# expression stated elsewhere — that is the libadwaita footgun the whole
# cascade exists to avoid (4.1).
#
# Reference images: 1-6 are family A ("console", one flat screen of bordered
# panels, one dominant hue per image); 7-10 are family B ("holographic",
# translucent glass over a live backdrop). "all" means every image.
# =========================================================================


# =========================================================================
# 5.1 meta — identity. The one string-bearing part of a theme, published as
# Arc<ThemeDiagnostics> beside the POD struct: no draw path can reach it and
# no locale count can move ResolvedTheme's size (3.3, 7.1).
#
# name and description take a locale suffix: name[pl], description[pt_BR].
# The key is `name[<ll>]` or `name[<ll>_<CC>]` (3.2). This master file is
# English-only by project rule; a shipped translation adds the suffixed keys
# beside the base ones, at the TOP of the file, never at the bottom (3.3).
# =========================================================================
[meta]
schema      = 1
                    # engine schema this file speaks · - · integer · a mismatch runs a migration, never fails
name        = "Default"
                    # shown in settings; the name `Theme=` matches · - · text, quoted (3.2) · literal
description = ""
                    # one line shown under the name in settings · - · text, quoted (3.2) · literal, empty by rule (5.1)
                    # TODO(default): spec fixes the default at ""; the lead may want the master to describe itself
author      = ""
                    # credit shown in settings · - · text, quoted (3.2) · literal, empty by rule (5.1)
family      = console
                    # advisory grouping in settings · 1-6 vs 7-10 · one of console | holographic · literal, unquoted enum (3.2)
base        = "default"
                    # inherit chain: resolve THIS theme on top of the named one · - · text, quoted; chain depth 8 · literal
                    # TODO(default): the master IS "default"; the root's own base is a no-op at stage 2 (4.1)
strict      = false
                    # true reports unknown keys at error level (the theme still loads) · - · true | false · literal
watch       = false
                    # inotify reload; never polls. Set true while hand-editing, ship it false · - · true | false · literal


# =========================================================================
# 5.2 palette — the raw layer. THE FIVE SEEDS PLUS ONE. LITERALS.
# The whole authored identity of a console theme lives in these six lines;
# every other colour in the ~2 190-token catalogue derives from them, which
# is why images 2/3/4/6 are one layout in four hues (reference brief, req 1).
#
# black and white MUST stay literals: they are the targets of shade() and
# tint(), and a literal target makes those two functions structurally
# incapable of introducing a cycle (5.2).
#
# A theme may add any number of extra palette.<ident> entries; unreferenced
# ones are dropped at load (each costs a [f32;4] otherwise).
# =========================================================================
[palette]
black      = #0A100E
                    # shade() target; the bed every surface is pulled toward · all · sRGB hex · literal by rule (5.2)
white      = #EAF6F1
                    # tint() target; the ceiling every highlight is pulled toward · all · sRGB hex · literal by rule (5.2)
accent     = #3FE3AE
                    # the ONE hue that re-skins the UI: borders, titles, glyphs, charts · 1-6 · sRGB hex · literal by rule (5.2)
accent_alt = hue(@palette.accent, 32)
                    # secondary chrome hue · 1 (cyan beside mint) · degrees of OKLCh rotation · rotation of palette.accent
data       = @palette.accent
                    # hue of plots, renders and holograms · 5 (overridden to blue there) · colour · follows the accent until a theme separates them
neutral    = #6B7A74
                    # hue-free grey anchor for offline / disabled · 1-6 · sRGB hex · literal by rule (5.2)


# =========================================================================
# 5.3 metric — the one scalar that drives everything. Every length in this
# file is a multiple of `u`, and `u` is this:
#
#   u = clamp(screen_h * metric.unit_pct_h / 100,
#             metric.unit_min_px, metric.unit_max_px) * metric.ui_scale
#
#   1280x720  raw 3.60 ->  4.00 px  (floored)
#   1920x1080 raw 5.40 ->  5.40 px  (THE REFERENCE — every px in this file)
#   2560x1440 raw 7.20 ->  7.20 px
#   3840x2160 raw 10.80 -> 10.00 px (ceiled)
#
# Height, not width: a console is a stack of rows, and a vmin base would
# shrink type on ultra-wide monitors for no reason.
# =========================================================================
[metric]
unit_pct_h    = 0.5
                    # u as a percentage of viewport HEIGHT · all · f, 0.2 .. 2.0 · no derivation — this is the root of every length
unit_min_px   = 4px
                    # the 720p defence: unclamped, size.md falls to 18.7 px · - · device px, 1 .. 32 · companion floor of unit_pct_h (3.2)
unit_max_px   = 10px
                    # the 4K defence: unclamped 4K is the 1080p interface at 2x · - · device px, 4 .. 64 · companion ceiling of unit_pct_h (3.2)
ui_scale      = 1.0
                    # the user's UIFontSize= / 100, applied after the clamp · - · f, 0.5 .. 3.0 · no derivation — a user setting, not a theme one
                    # The host overwrites it per frame (theme::set_viewport), so 1.0 here is the value for a host that never says:
                    # the interface at the size the file was authored at. Because u is the root of every length, this one number is
                    # how the setting reaches type, gaps, row heights and control sizes alike — there is no second route, and a
                    # consumer that multiplies a token by the setting as well applies it twice.
ramp_span     = 0.62
                    # how far the top rung of a `ramp()` ladder stands from the bottom, in OKLCh lightness · 2, 3, 8, 9 · f, 0.0 .. 1.0 · the spacing every data series and every chart ladder is built on; an author states the number of rungs and which rung a series sits on, and this is the third number that decides what they look like
density       = compact
                    # spacing/type multiplier level · 1 (compact), 6 (airy), 7 (comfortable), 8 (dense), 9 (instrument) ·
                    # one of airy | comfortable | compact | dense | instrument · GENERATES both floats below:
                    # airy 1.30/1.06 · comfortable 1.15/1.00 · compact 1.00/1.00 · dense 0.85/0.96 · instrument 0.72/0.90.
                    # An explicit density_space or density_type replaces the generated value FOR THAT AXIS ONLY, in any
                    # cascade stage, regardless of which line comes first: density = airy + density_space = 0.9 is
                    # spacing 0.90, type 1.06 (5.3). Density= in the user .conf is a stage-5 override of THIS key and
                    # therefore loses to an explicit float in the theme.
density_space = 1.00
                    # multiplies space.* and size.*, every *.pad/*.gap/*.inset/*.row_h/*.band_h/*.block_h, rhythm.* ·
                    # 1 · f, 0.5 .. 2.0 · generated by metric.density; setting it pins the spacing axis (5.3)
density_type  = 1.00
                    # multiplies every type.<role>.size · 1 · f, 0.5 .. 2.0 · generated by metric.density; setting it pins the type axis (5.3)
# What each level of metric.density GENERATES. These ten numbers used to
# live in the binary with a copy of them written above as prose: an author
# who set `density = airy` got multipliers out of the engine and had no way
# to say what `airy` means. They are here now, and `metric.density` reads
# the pair named by its word.
level.airy.space        = 1.30
                    # spacing multiplier at density = airy · 6 · f, 0.5 .. 2.0 · generated pair of metric.density = airy
level.airy.type         = 1.06
                    # type multiplier at density = airy · 6 · f, 0.5 .. 2.0 · likewise
level.comfortable.space = 1.15
                    # spacing multiplier at density = comfortable · 7 · f, 0.5 .. 2.0 · -
level.comfortable.type  = 1.00
                    # type multiplier at density = comfortable · 7 · f, 0.5 .. 2.0 · -
level.compact.space     = 1.00
                    # spacing multiplier at density = compact · 1 · f, 0.5 .. 2.0 · the shipped level, so both of its numbers are the identity
level.compact.type      = 1.00
                    # type multiplier at density = compact · 1 · f, 0.5 .. 2.0 · -
level.dense.space       = 0.85
                    # spacing multiplier at density = dense · 8 · f, 0.5 .. 2.0 · -
level.dense.type        = 0.96
                    # type multiplier at density = dense · 8 · f, 0.5 .. 2.0 · type shrinks less than spacing: a denser screen loses air before it loses legibility
level.instrument.space  = 0.72
                    # spacing multiplier at density = instrument · 9 · f, 0.5 .. 2.0 · -
level.instrument.type   = 0.90
                    # type multiplier at density = instrument · 9 · f, 0.5 .. 2.0 · -
# Density NEVER touches stroke.*, corner.*, any *.border / *.rule / *.stroke,
# icon stroke widths, metric.unit_*, type.min_px, any *_min_px floor, any %
# fraction, or chart.grid.rows/cols. A 0.72x hairline is not a line, and
# corners are the theme's identity rather than its density (5.3).


# =========================================================================
# 5.4a space — 12 steps, non-linear (~x1.4 after space.3) so an author picks
# a STEP rather than a number. Multiplied by metric.density_space.
# px columns throughout 5.4 are 1920x1080, u = 5.4 px.
#
# TODO(default): 3.2's `ident` production is lower { lower | digit | "_" },
# which does not admit the digit-leading step names the catalogue uses
# (space.0, size.2xl). Written as the catalogue names them; the parser needs
# to allow a digit-leading ident segment, or the ladder needs renaming.
# =========================================================================
[space]
0    = 0u
                    # flush; no gap at all · all · u · literal step (5.4)
hair = 0.25u
                    # optical nudges, icon-to-glyph kerning · 1 · u = 1.4 px · literal step (5.4)
1    = 0.5u
                    # inside a badge; bar to rule · 1 · u = 2.7 px · literal step (5.4)
2    = 1u
                    # icon-to-label, cell padding · 1, 7 · u = 5.4 px · literal step (5.4)
3    = 1.5u
                    # dense list padding · 1, 9 · u = 8.1 px · literal step (5.4)
4    = 2u
                    # between rows in a dense list · 1, 2 · u = 10.8 px · literal step (5.4)
5    = 3u
                    # between controls in a form (today's vh(1.2)) · settings · u = 16.2 px · literal step (5.4)
6    = 4u
                    # between groups · 1, 7 · u = 21.6 px · literal step (5.4)
7    = 6u
                    # between sections · 7 · u = 32.4 px · literal step (5.4)
8    = 8u
                    # around a modal's content · settings modal · u = 43.2 px · literal step (5.4)
9    = 12u
                    # major separation, dock margins · 8, 9 · u = 64.8 px · literal step (5.4)
10   = 16u
                    # full-bleed hero gaps · 7, 10 (family B) · u = 86.4 px · literal step (5.4)


# =========================================================================
# 5.4b size — 7 control heights. Multiplied by metric.density_space.
# control.button.h used to be win_h * 0.045 = 48.6 px, a THIRD height for the
# same visual object; unified to size.xl. Two button heights differing by
# 3 px are a bug wearing a constant's clothing (5.4).
# =========================================================================
[size]
xs  = 3u
                    # badge / pill, chart legend row · 1, 4 · u = 16.2 px · literal step (5.4)
sm  = 4u
                    # dense list row, chip · 8 · u = 21.6 px · literal step (5.4)
md  = 5.2u
                    # TITLE BAR, tab strip (exactly today's vh(2.6)) · 1, 7 · u = 28.1 px · literal step (5.4)
lg  = 6.5u
                    # text field, icon-button row · 7 (the `browser` search field) · u = 35.1 px · literal step (5.4)
xl  = 8.4u
                    # PRIMARY BUTTON (today's vh(4.2)) · 9 (taskbar buttons) · u = 45.4 px · literal step (5.4)
2xl = 12u
                    # dock item, launcher tile · 1, 8 · u = 64.8 px · literal step (5.4)
3xl = 18u
                    # hero / clock block · 1 (21:57:30), 2 · u = 97.2 px · literal step (5.4)


# =========================================================================
# 5.4c stroke — 5 weights. stroke(x) = max(1, round(x * u_global)), in
# PHYSICAL pixels, computed from the GLOBAL u: never panel-scaled, never
# density-scaled. Stroke positions are snapped so an odd width sits on a
# half-pixel and an even width on a whole pixel — without that the 1 px panel
# borders blur to 2 px grey during a resize animation, and that hairline is
# the signature stroke of family A (5.4).
#
# These are LENGTHS in u, on the stroke path of the baker: every token whose
# name says it is a stroke bakes as max(1, round(x * u)), so a hairline is
# one whole physical pixel on every screen and never a 0.2 px ghost. The
# earlier unit-less spelling made @stroke.thin resolve to the bare number
# 0.3 — and every glyph drawn with it vanished. A ladder that means pixels
# must say so.
# =========================================================================
[stroke]
hair    = 0.2u
                    # panel borders, grid lines, rules — the brief's "thin glowing 1px border" · 1-6 · len (u), stroke-scaled; 1/1/1/2 px at 720p/1080p/1440p/4K · literal weight (5.4)
thin    = 0.3u
                    # chart axes, separators, checkbox, icon strokes · 2, 8 · len (u), stroke-scaled; 1/2/2/3 px · literal weight (5.4)
regular = 0.4u
                    # focused borders, window frame · 7 · len (u), stroke-scaled; 2/2/3/4 px · literal weight (5.4)
bold    = 0.7u
                    # active tab underline, emphasis edge · 8 (the active HOME icon) · len (u), stroke-scaled; 3/4/5/7 px · literal weight (5.4)
chart   = 0.45u
                    # plot line width · 2, 8, 9 · len (u), stroke-scaled; 2/2/3/5 px · literal weight (5.4)


# =========================================================================
# 5.4d corner — 5 sizes plus the tessellation count. A true antialiased
# radius cannot exist in a triangle-only pipeline; `round` is a tessellated
# arc. Corners are DENSITY-INVARIANT: making a dense theme change its corner
# language would make it a different theme, not a denser one (5.4).
#
# A LENGTH IS NOT A SHAPE. Every `*_corner` / `*.corner` key below states the
# radius alone; HOW that radius is cut is stated by a `*_corner_style` or
# `*_corner_mode` key beside it, and EVERY radius in this file now has one.
# It did not: of the twenty-nine radii this file states, SIXTEEN stood
# without a sibling on 2026-08-17 — thirteen had one — and this header
# used to close that hole by ruling that a radius with no
# sibling is cut `round`. A rule stated here and nowhere else is a rule the
# drawing code has to remember, and it did not remember it — it wrote
# `CornerStyle::Round` into Rust and cited this paragraph, so a theme
# writing `mode = chamfer` got a chamfered panel beside a rounded slider,
# a rounded checkbox and rounded window-frame buttons, on one screen. The
# siblings are here now, and the sibling is what a theme edits.
#
# THE RULE IS NOT REPEALED YET, and striking it before its last reader was
# gone would have been the worse half of the trade: the code that cited it
# would not have changed, it would only have stopped being licensed. A
# sibling changes a picture only where something READS it, and two of the
# new ones are read by nobody here, because the radii they belong to are
# drawn OUTSIDE this toolkit — `filetile.corner` by the file grid and the
# launcher grid, `keyboard.key_corner` by the key field, three drawings in
# the addons. Every one of them still spells the cut `round` in its source,
# each citing the sentence above. So the rule survives for exactly those
# two radii, by name and for nothing else, until `filetile.corner_style`
# and `keyboard.key_corner_style` have a reader; the day each does, its
# name leaves this paragraph. A debt is written where its creditor looks,
# not deleted because the ledger reads better without it.
#
# `dialog.corner_mode` is a third sibling with no reader, and it is NOT on
# that list: the warning sheet is drawn outside this toolkit too, but with
# a chamfer nailed into Rust, which no wording here ever licensed. It is a
# hardcode reported, not a debt owed.
#
# TWO keys below still look like a bare radius and are not. `badge.corner`
# takes its cut from the style half of @shape.badge.corners — the one element
# in this file that states its shape in two places, and it says so where it
# stands. And `keyboard.sub_corner` is not a radius at all: it names WHICH
# corner a sub-legend sits in. `tile.corner` was a third until `tile.shape`
# was chained to @corner.mode below: that key is a whole SHAPE and not only
# a cut — `hex` is in its vocabulary — so it can carry the corner language
# and still be the place a theme leaves it.
# =========================================================================
[corner]
none     = 0u
                    # terminal, keyboard keys, table cells · 3, 9 · u · literal step (5.4)
sm       = 0.8u
                    # badges, chips, icon buttons, checkboxes · 1, 4 · u = 4.3 px · literal step (5.4)
md       = 1.2u
                    # panels, cards (the brief's "~8 px at 1440p" -> 8.6 px here) · 1-10 · u = 6.5 px · literal step (5.4)
lg       = 2.2u
                    # modal windows, window frames (today's vh(1.1)) · 7 · u = 11.9 px · literal step (5.4)
pill     = pill
                    # pill badges, scrollbar thumbs · 1, 3, 4 (CRITICAL / CONTAINED badges) · sentinel, bakes to -2.0 = half the shorter side · sentinel by rule (5.0)
segments = 6
                    # arc tessellation quads per corner; 6 at an 8 px radius is a 0.4 px chord error · - · n, 3 .. 16 · literal count (5.4)
mode     = round
                    # THE CUT, for the whole interface: how every radius above is taken off a box · 1-10 · enum: square | round | chamfer · no derivation; this is the one place a theme states its corner language
# The cut lives beside the radii ON PURPOSE. Twelve presets used to state it
# for themselves — eight elevations, panel, winframe, scrollbar, modal — with
# "no derivation" written against each, so a file could say `round` in ten of
# them and `chamfer` in two and be internally consistent by its own lights.
# The shipped file did exactly that: the window frame, the context menu (which
# follows the frame), the tooltip and the modal were cut, and everything
# hanging off the panel was rounded. Family A's language in four places and
# family B's in the rest of one file.
# A radius without its cut is half a decision — the same reason every `*.corner`
# in this file carries a `*_corner_mode` sibling rather than a bare length. The
# twelve presets keep their sibling keys and a theme may still pin any one of
# them; what changed is that they DERIVE, so a theme that wants the console
# language writes `chamfer` once, here, and the whole interface answers.


# =========================================================================
# 5.5 surface — six depth levels and a scrim. Six because some element in
# images 1-6 sits at each depth and nothing else does. Placed at fixed OKLab
# lightness with the ACCENT hue at low chroma, so a theme that moves
# palette.accent moves its whole background with it:
#
#   L      void 0.115 · sunken 0.152 · base 0.178 · panel 0.232 · inset 0.283 · raised 0.330
#   C      0.22 * C_accent * [0.35, 0.40, 0.45, 0.55, 0.60, 0.62]
#
# The chroma coefficients below are those two factors already multiplied
# together (0.22*0.35 = 0.077, and so on): the language has no arithmetic
# (3.2), so the product is written out.
# =========================================================================
[surface]
hue    = @hue.accent                # the hue every surface level sits on · 7,9,10 · deg · reads @hue.accent (m3 M1 — written as a reference, not hue(@palette.accent), so the token's kind settles to a number and a theme may override it with plain degrees); a navy bed under a cyan edge is one line here instead of six longhand oklch()
lift   = 0.0                        # OKLab L added to all six levels · 3,4 · f, -0.09 .. 0.09 · 0 = the ladder as derived; image 4's true black is lift -0.065, family B's lit bed +0.045 (m3)
chroma = 1.00                       # scale over the six levels' chroma coefficients · 8,9 · f, 0.0 .. 4.0 · 1 = as derived; a near-black needs C >= 0.030 to read as tinted at all
void   = oklch(0.115, 0.0770x@chroma.accent, @surface.hue)
                    # the absolute bed: terminal background, letterbox, THE SWAPCHAIN CLEAR COLOUR (alpha forced to 1.0), and the opaque fallback when a family-B theme sets base to alpha 0 · 1-10 · OKLCh, L fixed by the ladder in 5.5 · L 0.115, C 0.22*0.35*C_accent
sunken = oklch(0.152, 0.0880x@chroma.accent, @surface.hue)
                    # recessed beds: progress troughs, chart beds, search-field interiors · 1, 2, 7 · OKLCh · L 0.152, C 0.22*0.40*C_accent
base   = oklch(0.178, 0.0990x@chroma.accent, @surface.hue)
                    # the screen background, where the PCB traces and the vignette live · 1, 4 · OKLCh · L 0.178, C 0.22*0.45*C_accent
panel  = oklch(0.232, 0.1210x@chroma.accent, @surface.hue / 0.82)
                    # the bordered panel fill — TRANSLUCENT BY DEFAULT; the GPU composite over base is the pixel enforcement measures (4.4), over() is the authoring one · 1-6 · OKLCh with straight alpha · L 0.232, C 0.22*0.55*C_accent, a 0.82
inset  = oklch(0.283, 0.1320x@chroma.accent, @surface.hue)
                    # a bordered box nested inside a panel: icon buttons, the CPU/GPU/NETWORK boxes, badge fills, table headers · 1 · OKLCh · L 0.283, C 0.22*0.60*C_accent
raised = oklch(0.330, 0.1364x@chroma.accent, @surface.hue)
                    # floats above panels: menus, tooltips, popovers, taskbar · 9 · OKLCh · L 0.330, C 0.22*0.62*C_accent
scrim  = alpha(@palette.black, 0.66)
                    # NOT A LEVEL — the modal dimmer, composited over whatever level is underneath · settings modal · colour with straight alpha 0..1 · palette.black at 0.66


# =========================================================================
# 5.6 text — seven roles: a five-step legibility ladder plus two off-ladder.
# NOT ONE OF THESE IS A HEX. Change palette.accent and every line below
# re-derives — that is the whole cascade (5.0b).
#
#   L      title 0.870 · primary 0.905 · secondary 0.755 · muted 0.590 ·
#          disabled 0.435 · instrument 0.372
#   C      C_accent * [0.55, 0.15, 0.24, 0.30, 0.22, 0.34]
#
# Contrast floors are enforced by 4.4 pass D against the composited surface,
# and lifted in OKLab L at constant hue when a11y.contrast_floor = true.
# =========================================================================
[text]
hue    = @hue.accent                # the hue every text role sits on · 1-10 · deg · reads @hue.accent (written as a reference so the kind settles to a number and a theme — or the editor's FONT picker — may override it with plain degrees); symmetric with surface.hue, so a font colour leads its whole ladder the way the accent leads the beds
lift   = 0.0                        # OKLab L added to the ladder roles · 3 · f, -0.10 .. 0.10 · 0 = as derived; image 3's look needs -0.07 to put text.title on its own green
chroma = 1.00                       # scale over the text roles' chroma coefficients · 3,4 · f, 0.0 .. 3.0 · 1 = as derived; seven of the eight original seeds resolved text.primary to the same near-white without this
title      = oklch(0.870, 0.55x@chroma.accent, @text.hue)
                    # panel titles: small caps, wide tracking (every panel heading in the images) · 1-10 · OKLCh, L fixed by the ladder in 5.6 · floor 4.5 on surface.panel (4.4); resolves 11.90 for the mint seed
primary    = oklch(0.905, 0.15x@chroma.accent, @text.hue)
                    # the value half of key:value, and terminal output: `74%`, `21:57:30` · all · OKLCh · floor 7.0 AAA — this program is a terminal (4.4); resolves 12.96
secondary  = oklch(0.755, 0.24x@chroma.accent, @text.hue)
                    # the key half of key:value — `PROCESOR:` before `74%` · 1, 7 · OKLCh · floor 4.5 (4.4); resolves 7.93
muted      = oklch(0.590, 0.30x@chroma.accent, @text.hue)
                    # dim captions, axis labels, legends, leader labels and photo captions · 1, 2 · OKLCh · floor 3.0 for non-essential text (4.4); resolves 4.24
disabled   = oklch(0.435, 0.22x@chroma.accent, @text.hue)
                    # inert controls · settings · OKLCh · no floor — being unreadable is the message; resolves 2.19
inverse    = contrast_on(@accent.primary, @surface.void, @text.primary)
                    # text ON a filled accent or severity chip (`SYSTEM LOCKDOWN`) · 5 · colour · whichever of surface.void / text.primary contrasts better against accent.primary; >= 4.5 vs the fill
instrument = oklch(0.372, 0.34x@chroma.accent, @text.hue)
                    # hex and coordinate dumps in image 9's margins and image 1's panel footer. CARRIES NO INFORMATION · 1, 9 · OKLCh · exempt from every contrast floor by rule (4.4); resolves 1.87


# =========================================================================
# 5.7a border.<role> — the five COLOURS. The 1 px glowing edge is family A's
# signature; its colour is here and its glow radius is in glow.* (5.13).
# =========================================================================
[border]
subtle   = alpha(@accent.primary, 0.30)
                    # hairlines, table rules, the chart grid frame · 2 · colour with straight alpha 0..1 · accent.primary at 0.30
                    # (m3 M5: was 0.22; raised with border.default so the two-stroke double edge still reads as one halo)
default  = alpha(@accent.primary, 0.78)
                    # THE 1 px GLOWING PANEL EDGE — family A's signature · 1-6 · colour with straight alpha 0..1 · accent.primary at 0.78
                    # (m3 M5: was 0.55. Every image calls the edge the brightest line in the picture; the raise predates P7,
                    # when no glow primitive existed and the edge carried the whole signature alone. Since P7 glow.panel_edge
                    # RENDERS and rides this colour, and the raised value still measures right under it.
                    # Measured on the original seeds: crimson's panel ring 3.00 -> 4.60, aurora's 6.17 -> 8.33, pure's 5.61 -> 9.18)
strong   = @accent.primary
                    # emphasised and alarmed frames · 4 (the all-red console) · colour · accent.primary at full alpha
focus    = @accent.focus
                    # the keyboard focus ring · 7 (the magenta-framed task panel) · colour · follows accent.focus, which family B re-points at @grad.focus
disabled = alpha(@text.disabled, 0.55)
                    # inert controls · settings · colour with straight alpha 0..1 · text.disabled at 0.55

# =========================================================================
# 5.7b border.edge.* — the seven GEOMETRY keys. The old flat spellings
# border.width / .style / .dash / .gap / .phase / .bracket_len /
# .bracket_inset remain as aliases (4.2), because [variant.hc] writes
# border.width — as the original shipped themes did — and a rename with no
# alias is a silent regression.
#
# `segmented` is a PANEL-CLASS style only: a 300 px edge at 1440p is ~13
# dashes/side ~52 quads, fine for a handful of panels and wrong for a list of
# rows. The resolver rejects it on shape.badge and shape.icon_tile with a
# warning. Corner brackets are a BORDER STYLE, not a separate ornament, so
# any shape preset can wear them.
# =========================================================================
[border.edge]
width         = @stroke.hair
                    # the global default edge width every container inherits · all · str, device px after stroke(x) · stroke.hair = 0.2x global u
                    # THE BORDER'S OWN THICKNESS, and the one the theme editor's BORDER WIDTH writes (BASIC, 2026-08-18). A reference by default on purpose: a theme
                    # that has said nothing about its frames follows the kerf, and only a file whose author moved that slider carries a literal here. THIS SECTION HAS
                    # NO RADIUS — seven keys of geometry and not one of them is one; the only radius a border has is the REACH of its light, [glow] panel_edge.radius.
style         = solid
                    # how the ring is drawn · 9 (brackets) · one of solid | segmented | brackets | none · literal enum
dash          = 1.6u
                    # `segmented` only: dash length along the ring · - · u = 8.6 px · literal length (5.7)
gap           = 0.8u
                    # `segmented` only: gap length between dashes · - · u = 4.3 px · literal length (5.7)
phase         = 0u
                    # `segmented` only: start offset around the ring · - · u · literal length (5.7)
bracket_len   = 18%
                    # `brackets` only: arm length, OF THE SHORTER SIDE of the host rect, clamped to [0.8u, 4.0u] · 9 · frac 0..1, `%` accepted (3.2) · literal fraction (5.7)
bracket_inset = 0u
                    # `brackets` only: how far the bracket sits inside the rect · 9 · u · literal length (5.7)


# =========================================================================
# 5.8 accent — CHROME. Borders, titles, glyphs, cursors: everything the UI
# draws about itself. The colour of DATA is a separate family (5.9), and
# image 5 is the proof that they must be separable.
# =========================================================================
[accent]
primary   = @palette.accent
                    # borders, titles, glyphs, cursors, node dots · 1-6 · colour · palette.accent unchanged
secondary = @palette.accent_alt
                    # the second chrome hue · 1 (cyan beside mint) · colour · palette.accent_alt, itself a 32 deg rotation
hover     = tint(@accent.primary, 0.18)
                    # hover edges and glyphs; lands the azure seed on #4FC3F7, the literal highlight of image 6 · 6 · OKLab mix toward palette.white, t 0..1 · accent.primary tinted 0.18
active    = lum(@accent.primary, 0.84)
                    # pressed · 1, 7 · OKLCh L multiplier · accent.primary at 0.84 of its lightness, same hue and chroma
dim       = lum(@accent.primary, 0.62)
                    # secondary chrome, icon duotone layer 2 · 3 (the dimmer CONTAINED badge) · OKLCh L multiplier · accent.primary at 0.62 of its lightness
border    = alpha(@accent.primary, 0.55)
                    # avatar rings, tile edges · 1 · colour with straight alpha 0..1 · accent.primary at 0.55
glow      = alpha(@accent.primary, 0.30)
                    # the COLOUR input to every glow; the radius lives in glow.* (5.13) · 2 (the bloom on the wall) · colour with straight alpha 0..1 · accent.primary at 0.30
on        = contrast_on(@accent.primary, @surface.void, @text.primary)
                    # text on a solid accent fill · 5 · colour · whichever of surface.void / text.primary contrasts better against accent.primary
focus     = @accent.primary
                    # the focused container's edge; family B re-points this at #C04CFF / @grad.focus · 7 (the magenta frame) · colour · accent.primary
warm      = @severity.warning.text
                    # image 8's ORANGE active HOME icon: the one warm chrome colour · 8 · colour · forward reference to severity.warning.text, legal by 6.3


# =========================================================================
# 5.9 data — SEPARATE FROM CHROME. The single most load-bearing structural
# point from image 5: panel borders red, hologram blue, one theme, no
# per-widget editing. Deviating from chrome costs a theme exactly one line —
# `palette.data = #35A7FF`.
#
# The eight-entry series ramp is GENERATED: hue h_d + 40 deg * i, lightness
# cycling [0.800, 0.655, 0.730], chroma cycling [1.00, 0.92, 0.82] * C_d.
# It is written out slot by slot below so an author can read the rule and
# pin one slot without losing the rest (3.2).
#
# TODO(default): the catalogue caps the ramp's chroma at min(C_d, 0.155) to
# keep every hue inside sRGB at those lightnesses. The language has no `min`
# and no arithmetic (3.2), so the cap is not written here; it is applied by
# the generator, and 6.2's mandatory chroma-reducing gamut map catches the
# rest. If the lead wants the cap authorable it needs a token of its own.
# TODO(default): @chroma.data / @hue.data are spelled C_d / h_d in 5.9 prose;
# written here in the @chroma.* / @hue.* form 5.0b uses for the accent.
# =========================================================================
[data]
line = ensure(@palette.data, @surface.panel, 3.0)
                    # plot lines, wireframes, gauge arcs, orbit lines · 2, 5, 8 · colour · palette.data walked in OKLCh L until it hits 3.0:1 against surface.panel
fill = alpha(@palette.data, 0.22)
                    # the area fill under a plot line · 2 · colour with straight alpha 0..1 · palette.data at 0.22
grid = alpha(oklch(0.45, 0.30x@chroma.data, @hue.data), 0.35)
                    # the faint chart grid · 2, 8 · colour with straight alpha 0..1 · L 0.45, C 0.30*C_d, then alpha 0.35
axis = alpha(oklch(0.55, 0.25x@chroma.data, @hue.data), 0.60)
                    # chart axes and ticks · 2 · colour with straight alpha 0..1 · L 0.55, C 0.25*C_d, then alpha 0.60
series[0] = oklch(0.800, 1.00x@chroma.data, @hue.data)
                    # categorical series 0, node class 0 · 2, 8, 9 · OKLCh · ramp step 0: h_d + 0 deg, L 0.800, C 1.00*C_d
series[1] = hue(oklch(0.655, 0.92x@chroma.data, @hue.data), 40)
                    # categorical series 1 · 2, 8, 9 · OKLCh, rotation in degrees · ramp step 1: h_d + 40 deg, L 0.655, C 0.92*C_d
series[2] = hue(oklch(0.730, 0.82x@chroma.data, @hue.data), 80)
                    # categorical series 2 · 2, 8, 9 · OKLCh, rotation in degrees · ramp step 2: h_d + 80 deg, L 0.730, C 0.82*C_d
series[3] = hue(oklch(0.800, 1.00x@chroma.data, @hue.data), 120)
                    # categorical series 3 · 1 (the violet ribbon), 8 · OKLCh, rotation in degrees · ramp step 3: h_d + 120 deg, L 0.800, C 1.00*C_d
series[4] = hue(oklch(0.655, 0.92x@chroma.data, @hue.data), 160)
                    # categorical series 4 · 1 (the magenta ribbon), 10 · OKLCh, rotation in degrees · ramp step 4: h_d + 160 deg, L 0.655, C 0.92*C_d
series[5] = hue(oklch(0.730, 0.82x@chroma.data, @hue.data), 200)
                    # categorical series 5 · 8, 9 · OKLCh, rotation in degrees · ramp step 5: h_d + 200 deg, L 0.730, C 0.82*C_d
series[6] = hue(oklch(0.800, 1.00x@chroma.data, @hue.data), 240)
                    # categorical series 6 · 8, 9 · OKLCh, rotation in degrees · ramp step 6: h_d + 240 deg, L 0.800, C 1.00*C_d
series[7] = hue(oklch(0.655, 0.92x@chroma.data, @hue.data), 280)
                    # categorical series 7 · 8, 9 · OKLCh, rotation in degrees · ramp step 7: h_d + 280 deg, L 0.655, C 0.92*C_d




# ---------------------------------------------------------------- derived seeds
# The chroma and hue of the two seed colours, read back out of them so a
# tinted near-neutral can be written as "the accent's hue at 8% of its
# chroma" and FOLLOW the seed when a theme moves it. Fifty-two surfaces,
# borders and glass fills in this file depend on these four numbers; a theme
# that changes palette.accent gets all of them for free and need not restate
# a single one. sat() and hue() with one argument read rather than modify.

[chroma]
accent = sat(@palette.accent)         # chroma of the chrome seed · all images · OKLCh C · reads @palette.accent
data   = sat(@palette.data)           # chroma of the data seed · image 5 splits them · OKLCh C · reads @palette.data

[hue]
accent = hue(@palette.accent)         # hue of the chrome seed · all images · degrees · reads @palette.accent
data   = hue(@palette.data)           # hue of the data seed · image 5 splits them · degrees · reads @palette.data

# ============================================================ 20-color

# =========================================================================
# severity — seven roles x eight members, plus four controls (5.10).
#
# A role is a MEANING, not a colour: `ok` says the thing is doing its job,
# `offline` says nobody is talking, `unknown` says somebody is talking and we
# do not understand. Conflating the last two is the classic dashboard lie
# ("0 %" for "no reading"), so both exist and both are coloured.
#
# Each role authors ONE colour — `.text` — and the four other colour members
# are generated from it by the fixed derivation of 5.10, written out here
# seven times so an author can see and edit any single link:
#
#     glyph = @severity.<r>.text
#     edge  = alpha(@severity.<r>.text, 0.60)
#     fill  = alpha(shade(@severity.<r>.text, 0.78), 0.88)
#     on    = contrast_on(@severity.<r>.text, @surface.void, @text.primary)
#
# `.fill` + `.text` is the OUTLINED badge — dark pill, coloured hairline edge,
# coloured text — which is what images 1-6 actually show. `.on` is the text on
# a SOLID `.text` chip, which is image 5's SYSTEM LOCKDOWN button. Both forms
# are needed and both are here.
#
# The `.text` values below are the CANONICAL severity hues, each wrapped in
# `toward(...)`: the canonical colour leans toward `@palette.accent` by
# `severity.pull`, capped at `severity.pull_clamp`, so a red theme's `ok`
# leans warm without ever becoming red. A THEME that writes its own
# `severity.<r>.text` pins that role and the pull no longer touches it — that
# is exactly image 4, everything red by derivation with an amber `contained`
# written out on one line — and it works BY CONSTRUCTION now, because writing
# the token replaces the whole expression, `toward()` and all.
#
# UNTIL 2026-08-18 THE SENTENCE ABOVE WAS A PROMISE ABOUT A MACHINE THAT DID
# NOT EXIST. `severity.pull` and `severity.pull_clamp` were read by nothing —
# they sat on `theme::edit`'s DEAD_CONTROLS list "until someone writes their
# reader" — so the roles were six frozen literals, and the theme editor's
# BASIC page moved them the only way it could: by rotating each of them the
# FULL distance the accent had moved. Measured on mint -> red (dh = -137.5
# deg) that turned green `ok` to red (148 -> 10.5) and red `critical` to blue
# (27 -> 249.5): the roles kept their spacing and lost their meaning. The
# reader is `toward()` (expr.rs), it lives here in the file where the colour
# is written, and the numbers stayed where they were.
# =========================================================================
[severity]

# ---- controls ------------------------------------------------------------
mode = hue
                    # how the seven role colours are generated; images 1-6;
                    # one of hue | mono | mono_plus_warning | mono_strict;
                    # hue keeps canonical hues, mono separates roles by OKLab
                    # lightness alone (image 3), mono_plus_warning is image 4
                    # NO READER (2026-08-18). `hue` is what the six `.text`
                    # expressions below spell out for themselves; the three
                    # mono words name GENERATIONS, which an expression cannot
                    # select between, and no code chooses among them. Left
                    # declared rather than deleted because the three modes are
                    # a real request of 5.10's — see `theme::edit`'s
                    # DEAD_CONTROLS, where this token stays until a generator
                    # exists to read it
pull = 0.20
                    # how far a canonical severity hue is dragged toward the
                    # accent hue; images 1-6; f, 0.0 .. 1.0; 0 = never move;
                    # read as the third argument of `toward()` on each of the
                    # six chromatic `.text` values below
                    # (m3 M6: was 0.16 — the pull may lean harder now that the
                    # 7deg clamp below stops it from ever leaving the hue)
pull_clamp = 7deg
                    # HARD cap on that drag; -; deg, 0deg .. 60deg; read as
                    # the fourth argument of `toward()`
                    # (m3 M6: was 14deg — 14 sends canonical red to orange in
                    # the green themes (#FC5C00) and pink in the cyan ones
                    # (#FE4F73), which cockpit and instrument each spent a
                    # pinned critical.text escaping. At 7deg critical derives
                    # to #FF5160 for everyone and the pins are deleted)
chroma = 1.00
                    # global chroma scale for the mono modes; image 3 ships
                    # 0.92; f, 0.0 .. 2.0; 1.00 = canonical chroma
                    # NO READER (2026-08-18), and it cannot have one before
                    # `mode` does: this scale is declared to govern the MONO
                    # generations, and `hue` — the one generation that exists
                    # — leaves chroma alone on purpose. A role's chroma is its
                    # author's

# ---- ok — nominal, doing its job ----------------------------------------
# `(Zakonczone)` green, `TRYB: PRACA (Optymalny)`, the green PROCESOR/PAMIEC
# glyphs of the resource rows.
ok.text = toward(oklch(0.795, 0.170, 148), @palette.accent, @severity.pull, @severity.pull_clamp)
                    # the label, the value, the trailing status word;
                    # images 1, 7; OKLCh, canonical green;
                    # LEANING toward the accent by severity.pull, capped at
                    # severity.pull_clamp - the canonical hue stays whose it is
                    # TODO(default): canonical L/C/H chosen here, spec silent
ok.glyph = @severity.ok.text
                    # the leader-line dot / row glyph; images 1, 7; colour;
                    # own member because 4.4 pass D resets a failing role's
                    # glyph independently of its text
ok.edge = alpha(@severity.ok.text, 0.60)
                    # the outlined badge's hairline ring; images 1-6; colour
ok.fill = alpha(shade(@severity.ok.text, 0.78), 0.88)
                    # the outlined badge's dark pill interior; images 1-6;
                    # colour
ok.on = contrast_on(@severity.ok.text, @surface.void, @text.primary)
                    # text drawn ON a solid ok chip; image 5; colour;
                    # picks whichever of void/primary has more contrast
ok.glyph_shape = dot_filled
                    # the mark beside the label, legible at 8px and in
                    # greyscale; image 1; one of dot_filled | dot_hollow |
                    # tri_up | tri_barred | box_barred | dot_slash | dash
                    # TODO(default): 5.10 names this member `glyph`, which
                    # collides with the colour member `glyph`; renamed here
ok.badge_style = hollow
                    # how a badge carrying this severity is filled; image 1;
                    # one of solid | hollow | hatched | hollow_dashed
ok.pulse = false
                    # participates in motion.alarm_blink; image 4; bool;
                    # only critical pulses by default

# ---- info — notable, not a problem --------------------------------------
# `POWIADOMIENIA (4 NOWE)`, `(W toku, 72%)`, the blue half of `git diff`.
info.text = toward(oklch(0.740, 0.140, 233), @palette.accent, @severity.pull, @severity.pull_clamp)
                    # the label, the value, the trailing status word;
                    # images 7, 9; OKLCh, canonical azure;
                    # LEANING toward the accent by severity.pull, capped at
                    # severity.pull_clamp - the canonical hue stays whose it is
                    # TODO(default): canonical L/C/H chosen here, spec silent
info.glyph = @severity.info.text
                    # the notification dot; image 7; colour
info.edge = alpha(@severity.info.text, 0.60)
                    # the outlined badge's hairline ring; images 7, 9; colour
info.fill = alpha(shade(@severity.info.text, 0.78), 0.88)
                    # the outlined badge's dark pill interior; images 7, 9;
                    # colour
info.on = contrast_on(@severity.info.text, @surface.void, @text.primary)
                    # text drawn ON a solid info chip; -; colour
info.glyph_shape = dot_hollow
                    # the mark beside the label; image 7; one of dot_filled |
                    # dot_hollow | tri_up | tri_barred | box_barred |
                    # dot_slash | dash
info.badge_style = hollow
                    # how an info badge is filled; image 7; one of solid |
                    # hollow | hatched | hollow_dashed
info.pulse = false
                    # participates in motion.alarm_blink; -; bool

# ---- warning — degraded, will become a problem --------------------------
# Image 1's YELLOW lightning glyph on `ENERGIA: 85%`, and the amber half of
# the top bar's alarm line.
warning.text = toward(oklch(0.800, 0.165, 75), @palette.accent, @severity.pull, @severity.pull_clamp)
                    # the label, the value, the amber alarm half of the top
                    # bar; images 1, 7; OKLCh, canonical amber;
                    # LEANING toward the accent by severity.pull, capped at
                    # severity.pull_clamp - the canonical hue stays whose it is
                    # TODO(default): canonical L/C/H chosen here, spec silent
warning.glyph = @severity.warning.text
                    # the lightning / temperature glyph; image 1; colour
warning.edge = alpha(@severity.warning.text, 0.60)
                    # the outlined badge's hairline ring; image 1; colour
warning.fill = alpha(shade(@severity.warning.text, 0.78), 0.88)
                    # the outlined badge's dark pill interior; image 1; colour
warning.on = contrast_on(@severity.warning.text, @surface.void, @text.primary)
                    # text drawn ON a solid warning chip; -; colour
warning.glyph_shape = tri_up
                    # filled triangle, apex up; image 1; one of dot_filled |
                    # dot_hollow | tri_up | tri_barred | box_barred |
                    # dot_slash | dash
warning.badge_style = solid
                    # warnings read as filled so they carry at a glance;
                    # image 1; one of solid | hollow | hatched | hollow_dashed
warning.pulse = false
                    # participates in motion.alarm_blink; -; bool; a warning
                    # that blinks becomes noise long before it becomes useful

# ---- critical — failed or failing, act now ------------------------------
# `KRYTYCZNY ALARM`, `DAMAGE BREACH`, image 1/2/3's `CRITICAL` crew badges,
# and the whole of image 4.
critical.text = toward(oklch(0.680, 0.210, 27), @palette.accent, @severity.pull, @severity.pull_clamp)
                    # the alarm line, the CRITICAL badge, the DAMAGE BREACH
                    # leader label; images 1-5; OKLCh, canonical red;
                    # LEANING toward the accent by severity.pull, capped at
                    # severity.pull_clamp - the canonical hue stays whose it is
                    # TODO(default): canonical L/C/H chosen here, spec silent
critical.glyph = @severity.critical.text
                    # the alarm triangle and the leader-line dot; images 1-5;
                    # colour
critical.edge = alpha(@severity.critical.text, 0.60)
                    # the outlined badge's hairline ring; images 1-4; colour
critical.fill = alpha(shade(@severity.critical.text, 0.78), 0.88)
                    # the outlined badge's dark pill interior; images 1-4;
                    # colour
critical.on = contrast_on(@severity.critical.text, @surface.void, @text.primary)
                    # text drawn ON a solid critical chip — image 5's SYSTEM
                    # LOCKDOWN button; image 5; colour
critical.glyph_shape = tri_barred
                    # filled triangle with a bar, distinct from tri_up at
                    # 8px and in greyscale; images 1-4; one of dot_filled |
                    # dot_hollow | tri_up | tri_barred | box_barred |
                    # dot_slash | dash
critical.badge_style = solid
                    # the loudest badge in the system; images 1-4; one of
                    # solid | hollow | hatched | hollow_dashed
critical.pulse = true
                    # the ONE role that participates in motion.alarm_blink;
                    # image 4; bool

# ---- contained — a critical condition that has been bounded -------------
# Image 3's dimmer green `CONTAINED` beside a bright green `CRITICAL`;
# image 4's AMBER `CONTAINED` inside an all-red screen. The role exists
# because "handled, but do not forget it" is not the same as ok.
contained.text = toward(oklch(0.700, 0.105, 92), @palette.accent, @severity.pull, @severity.pull_clamp)
                    # the CONTAINED crew badge; images 3, 4; OKLCh, canonical
                    # dim amber, deliberately apart from warning's hue;
                    # LEANING toward the accent by severity.pull, capped at
                    # severity.pull_clamp - the canonical hue stays whose it is
                    # (m3 M6: was oklch(0.760, 0.120, 88), which sat dE 0.068
                    # from warning — two indistinguishable ambers, under the
                    # engine's own 0.115 floor before any theme touched them.
                    # 0.700/0.105/92 is dE 0.123 from warning and is literally
                    # "dimmer", which is the role's meaning and image 3's
                    # encoding of it)
                    # TODO(default): canonical L/C/H chosen here, spec silent
contained.glyph = @severity.contained.text
                    # the shut-box mark beside the badge; images 3, 4; colour
contained.edge = alpha(@severity.contained.text, 0.60)
                    # the badge ring — drawn at 2px for this role; images 3, 4;
                    # colour
contained.fill = alpha(shade(@severity.contained.text, 0.78), 0.88)
                    # the badge's dark pill interior; images 3, 4; colour
contained.on = contrast_on(@severity.contained.text, @surface.void, @text.primary)
                    # text drawn ON a solid contained chip; -; colour
contained.glyph_shape = box_barred
                    # a hollow square with a bar — a shut box; images 3, 4;
                    # one of dot_filled | dot_hollow | tri_up | tri_barred |
                    # box_barred | dot_slash | dash
contained.badge_style = hollow
                    # hollow with a heavier edge, so it reads quieter than
                    # critical without reading as ok; images 3, 4; one of
                    # solid | hollow | hatched | hollow_dashed
contained.pulse = false
                    # participates in motion.alarm_blink; -; bool; a contained
                    # condition is by definition no longer urgent

# ---- offline — not reporting; absent, not zero --------------------------
# The shell's empty tab slot, a crew member with no telemetry. Hue-free by
# construction so it can never be mistaken for a live reading.
offline.text = ensure(@palette.neutral, @surface.void, 4.5)
                    # the greyed label of a thing that is not talking;
                    # images 1, 6; colour, derived from the palette's
                    # hue-free grey anchor and lifted to AA on the void
offline.glyph = @severity.offline.text
                    # the slashed-circle mark; image 1; colour
offline.edge = alpha(@severity.offline.text, 0.60)
                    # the outlined badge's hairline ring; image 1; colour
offline.fill = alpha(shade(@severity.offline.text, 0.78), 0.88)
                    # the outlined badge's dark pill interior; image 1; colour
offline.on = contrast_on(@severity.offline.text, @surface.void, @text.primary)
                    # text drawn ON a solid offline chip; -; colour
offline.glyph_shape = dot_slash
                    # a hollow circle with a slash; image 1; one of dot_filled
                    # | dot_hollow | tri_up | tri_barred | box_barred |
                    # dot_slash | dash
offline.badge_style = hollow_dashed
                    # a dashed ring reads as "nothing here" in greyscale;
                    # image 1; one of solid | hollow | hatched | hollow_dashed
offline.pulse = false
                    # participates in motion.alarm_blink; -; bool

# ---- unknown — a value we cannot classify -------------------------------
# The ABI's safety valve: any severity index past the end of the enum lands
# here rather than on `ok`, so a producer bug can never read as nominal.
unknown.text = toward(oklch(0.700, 0.140, 310), @palette.accent, @severity.pull, @severity.pull_clamp)
                    # the label of an unreadable filesystem entry, a value
                    # with no classification; -; OKLCh, canonical violet —
                    # a hue no other role uses, so it cannot be misread;
                    # LEANING toward the accent by severity.pull, capped at
                    # severity.pull_clamp - the canonical hue stays whose it is
                    # TODO(default): canonical L/C/H chosen here, spec silent
unknown.glyph = @severity.unknown.text
                    # the dash mark; -; colour
unknown.edge = alpha(@severity.unknown.text, 0.60)
                    # the outlined badge's hairline ring; -; colour
unknown.fill = alpha(shade(@severity.unknown.text, 0.78), 0.88)
                    # the outlined badge's dark pill interior; -; colour
unknown.on = contrast_on(@severity.unknown.text, @surface.void, @text.primary)
                    # text drawn ON a solid unknown chip; -; colour
unknown.glyph_shape = dash
                    # a bare dash — the honest "no answer"; -; one of
                    # dot_filled | dot_hollow | tri_up | tri_barred |
                    # box_barred | dot_slash | dash
unknown.badge_style = hatched
                    # hatching reads as "not a real reading" even in
                    # greyscale; -; one of solid | hollow | hatched |
                    # hollow_dashed
unknown.pulse = false
                    # participates in motion.alarm_blink; -; bool


# =========================================================================
# term — the terminal (5.11).
#
# A monochrome UI is a style choice; a monochrome TERMINAL PALETTE breaks
# `ls`, `git diff` and `vim`. So even image 3's pure-green screen ships a
# chromatic ANSI row: its identity comes from slots 0/7/8/15, a strong hue
# pull on the six chromatic slots, and a global chroma scale.
#
# The sixteen below are written as the GENERATION RULE of 5.11, not as
# sixteen hexes: fixed OKLab lightness per slot, canonical sRGB-primary hue,
# and a per-hue drift cap on how far that hue may be pulled toward the
# accent. Pin one slot with `term.ansi[4] = ...` and the other fifteen stay
# generated; write the whole 16-value array and you own all sixteen and the
# generation rules switch off entirely (3.2).
#
# The theme NEVER overrides a program's explicit truecolour. The 256-colour
# cube and `term.dim_factor` are the only theme-controlled parts of terminal
# colour.
# =========================================================================
[term]

# ---- the five non-indexed colours ---------------------------------------
fg = @text.primary
                    # default glyph colour for text with no SGR colour;
                    # images 1-3 (terminal panel); colour
bg = @surface.void
                    # the terminal bed — the absolute bottom of the surface
                    # ladder, so nothing shows through it; images 1-3; colour
cursor = @accent.primary
                    # the cell caret; images 1-3; colour
cursor_text = contrast_on(@accent.primary, @surface.void, @text.primary)
                    # the glyph UNDER the caret when cursor.mode = tint; -;
                    # colour. The cursor is exactly where the user is looking,
                    # so this must never be left to chance
                    # TODO(default): token chosen here, 5.11 counts 22 colours
                    # but tabulates 21
selection = alpha(@accent.primary, 0.28)
                    # the selection wash behind selected cells; -; colour
selection_fg = contrast_on(over(@term.selection, @term.bg), @surface.void, @text.primary)
                    # glyphs inside the selection; -; colour; resolved over
                    # the composited selection because selection is
                    # translucent and contrast on it is otherwise undefined

# ---- the ANSI sixteen ----------------------------------------------------
# Slots 0/7/8/15 carry the theme's identity; slots 1-6 and 9-14 are the
# canonical sRGB primaries rotated toward the accent and clamped per hue.
ansi.drift_clamp = 6deg             # HARD ceiling on any slot's hue walk toward the accent · 3 · deg, 0 .. 90 · read by the ANSI generation when it lands
                    # (m3 M6: the exact counterpart of severity.pull_clamp,
                    # which the ANSI generator lacked — the asymmetry was the
                    # defect. With it, ANSI red survives a mint accent
                    # (#DC441B, still red) and ANSI green survives a red
                    # accent (#6CBA3E, still green); without it they land on
                    # #DB4601 and #8DB302 and `git diff` stops reading)
ansi[0] = oklch(0.150, 0.30x@chroma.accent, @hue.accent)
                    # ANSI black: the tinted near-black a shell paints as
                    # "background"; images 1-3; OKLCh, L fixed by 5.11
ansi[1] = ensure(oklch(0.600, 0.195x@term.ansi.chroma, 29), @term.bg, @term.ansi.contrast)
                    # ANSI red: errors, `git diff` deletions, failing tests;
                    # images 4, 5; OKLCh; hue pulled by term.ansi.pull and
                    # clamped by term.ansi.drift.red — the tightest cap in the
                    # row, because red that drifts orange stops meaning error
ansi[2] = ensure(oklch(0.712, 0.175x@term.ansi.chroma, 142), @term.bg, @term.ansi.contrast)
                    # ANSI green: success, `git diff` additions, executables;
                    # images 2, 3; OKLCh; drift cap term.ansi.drift.green
ansi[3] = ensure(oklch(0.848, 0.158x@term.ansi.chroma, 110), @term.bg, @term.ansi.contrast)
                    # ANSI yellow: warnings, `ls` device files; image 1;
                    # OKLCh; drift cap term.ansi.drift.yellow
ansi[4] = ensure(oklch(0.545, 0.175x@term.ansi.chroma, 264), @term.bg, @term.ansi.contrast)
                    # ANSI blue: info, `git diff` hunks, `ls` directories;
                    # images 5, 9; OKLCh; drift cap term.ansi.drift.blue —
                    # tied with red for the tightest cap in the row
ansi[5] = ensure(oklch(0.658, 0.190x@term.ansi.chroma, 328), @term.bg, @term.ansi.contrast)
                    # ANSI magenta: prompts, `ls` archives; images 7, 10;
                    # OKLCh; drift cap term.ansi.drift.magenta
ansi[6] = ensure(oklch(0.782, 0.115x@term.ansi.chroma, 195), @term.bg, @term.ansi.contrast)
                    # ANSI cyan: links, `ls` symlinks; images 7-10; OKLCh;
                    # drift cap term.ansi.drift.cyan
ansi[7] = @text.secondary
                    # ANSI white: ordinary shell output — deliberately the
                    # UI's secondary text, which is what ties the terminal to
                    # the rest of the screen; images 1-3; colour
ansi[8] = oklch(0.470, 0.26x@chroma.accent, @hue.accent)
                    # ANSI bright black: comments, dim chrome, `ls` sockets;
                    # images 1-3; OKLCh, L fixed by 5.11
ansi[9] = ensure(oklch(0.710, 0.172x@term.ansi.chroma, 29), @term.bg, @term.ansi.contrast_bright)
                    # ANSI bright red; images 4, 5; OKLCh; chroma is
                    # 0.88x the normal row's per 5.11, folded into the literal
                    # so one global scale still governs the whole row
ansi[10] = ensure(oklch(0.815, 0.154x@term.ansi.chroma, 142), @term.bg, @term.ansi.contrast_bright)
                    # ANSI bright green; images 2, 3; OKLCh; 0.88x chroma
ansi[11] = ensure(oklch(0.910, 0.139x@term.ansi.chroma, 110), @term.bg, @term.ansi.contrast_bright)
                    # ANSI bright yellow; image 1; OKLCh; 0.88x chroma
ansi[12] = ensure(oklch(0.665, 0.154x@term.ansi.chroma, 264), @term.bg, @term.ansi.contrast_bright)
                    # ANSI bright blue; images 5, 9; OKLCh; 0.88x chroma
ansi[13] = ensure(oklch(0.762, 0.167x@term.ansi.chroma, 328), @term.bg, @term.ansi.contrast_bright)
                    # ANSI bright magenta; images 7, 10; OKLCh; 0.88x chroma
ansi[14] = ensure(oklch(0.870, 0.101x@term.ansi.chroma, 195), @term.bg, @term.ansi.contrast_bright)
                    # ANSI bright cyan; images 7-10; OKLCh; 0.88x chroma
ansi[15] = oklch(0.960, 0.10x@chroma.accent, @hue.accent)
                    # ANSI bright white: emphasised output; images 1-3;
                    # OKLCh, L fixed by 5.11

# ---- ANSI generation controls -------------------------------------------
# These govern slots 1-6 and 9-14. They are inert once a theme writes the
# whole `term.ansi = [ ... ]` array, which takes ownership of all sixteen.
ansi.pull = 0.24
                    # how far each canonical primary hue rotates toward the
                    # accent hue; image 3 ships 0.34; f, 0.0 .. 1.0
                    # (m3 M6: was 0.16 — too weak to make the terminal part
                    # of the theme; the six chromatic slots barely moved, so
                    # `ls` looked identical under every theme. Safe at 0.24
                    # because ansi.drift_clamp now caps the walk in degrees)
                    # TODO(default): value chosen here, 5.11 names the token
                    # but states no default
ansi.chroma = 1.00
                    # global chroma scale over the whole chromatic row; image
                    # 3 ships 0.92; f, 0.0 .. 2.0
                    # TODO(default): value chosen here, spec states only that
                    # image 3 uses 0.92
ansi.contrast = 4.5
                    # WCAG floor `ensure()` holds for slots 1-6 against
                    # term.bg; -; f, 1.0 .. 21.0 (4.4)
ansi.contrast_bright = 7.0
                    # WCAG floor for slots 9-14 — brights are what a program
                    # reaches for when it wants to be read; -; f, 1.0 .. 21.0
ansi.drift.red = 0.60
                    # multiplier on ansi.pull for the red slots; -;
                    # f, 0.0 .. 1.0
                    # (m3 M6: was 0.42, tuned tight because a multiplier was
                    # the only guard against red drifting orange. The degree
                    # clamp now does the protecting, so red may lean further
                    # and still stay red)
ansi.drift.green = 1.00
                    # multiplier on ansi.pull for the green slots; image 3;
                    # f, 0.0 .. 1.0
ansi.drift.yellow = 1.00
                    # multiplier on ansi.pull for the yellow slots; image 1;
                    # f, 0.0 .. 1.0
                    # (m3 M6: was 0.90 — "yellow turns green quickly" is what
                    # ansi.drift_clamp now prevents in degrees)
ansi.drift.blue = 0.60
                    # multiplier on ansi.pull for the blue slots — blue is
                    # the `git diff` / diagnostics anchor; image 5;
                    # f, 0.0 .. 1.0
                    # (m3 M6: was 0.42; the degree clamp now does the
                    # protecting, same as red)
ansi.drift.magenta = 1.00
                    # multiplier on ansi.pull for the magenta slots; images 7,
                    # 10; f, 0.0 .. 1.0
ansi.drift.cyan = 1.00
                    # multiplier on ansi.pull for the cyan slots; images 7-10;
                    # f, 0.0 .. 1.0
ansi.cube_tint = 0.0
                    # how far the GENERATED 6x6x6 cube (indices 16-231) is
                    # pulled toward @hue.accent, the way ansi.pull moves the
                    # sixteen; -; f, 0.0 .. 1.0; 0.0 keeps xterm's own sRGB
                    # arithmetic — without this knob a theme's tint stops dead
                    # at index 15 and a modern TUI snaps back to foreign colour
ansi.grey_tint = 0.0
                    # the same pull for the 24-step grey ramp (indices
                    # 232-255); images 1-6 show tinted near-blacks, never
                    # neutral greys; f, 0.0 .. 1.0; 0.0 reproduces today's
                    # pure-neutral ramp on a tinted bed

# ---- terminal behaviour controls ----------------------------------------
dim_factor = 0.60
                    # SGR 2 (dim) multiplier on the cell's lightness; -;
                    # f, 0.0 .. 1.0; replaces the literal in term.rs:47
dim_factor_floor = 0.45
                    # hard floor for dim_factor, below which dim output stops
                    # being output; -; f, 0.0 .. 1.0; companion of dim_factor
bold_is_bright = true
                    # SGR 1 on slots 0-7 selects 8-15 — the classic terminal
                    # behaviour, named rather than hidden in `index += 8`; -;
                    # bool
inverse_mode = swap # enum: swap | tint
                    # what SGR 7 does; -; the vocabulary is declared on the
                    # key's own line above, where the parser reads it: term.rs
                    # caches `tint`'s index for the life of the process, and a
                    # DISCOVERED list would never contain a word the master
                    # itself does not write; swap exchanges fg and bg, tint
                    # washes the cell instead
cursor.style = block # enum: block | bar | underline
                    # the caret's shape; images 1-3; the vocabulary is on
                    # the key's own line for the reason term.inverse_mode
                    # gives: a DISCOVERED list holds only the words some
                    # theme has already written, so `bar` had no index at
                    # all under the master and the theme editor's live
                    # preview of it answered `block` (measured
                    # 2026-08-17). `block` covers the cell and the glyph
                    # is laid back over it; the other two stand beside the
                    # glyph and are cut from terminal.cursor.bar_w and
                    # terminal.cursor.underline_h / .underline_gap, one
                    # section down with the rest of the grid's geometry.
                    # The three words are field.caret_style's three, and
                    # the same shape carries the same name in both: a
                    # vertical caret is a `bar` here as it is there, and
                    # as terminal.cursor.bar_w has always spelled it
cursor.mode = invert
                    # how the caret combines with the glyph under it; -;
                    # one of invert | tint. A tinted cursor over a glyph can
                    # make that glyph unreadable, and the cursor is exactly
                    # where the user is looking — hence invert by default
selection.mode = invert
                    # how the selection combines with the glyphs under it; -;
                    # one of invert | tint
follow_density = false
                    # whether metric.density moves terminal cell metrics;
                    # -; bool; off because the PTY's idea of the grid must
                    # not move when the UI gets denser (5.3)


# =========================================================================
# glow — fifteen element classes x seven tokens, plus two globals (5.13).
#
# Glow is NOT a global switch. Each class carries its own enable, colour,
# radius, falloff, technique and two magnitudes, because "make it glow" is a
# different decision for a panel edge (wide, soft, always on in family A)
# than for a chart line (tight, or the data stops being readable).
#
# EVERYTHING IS OFF IN DEFAULT. A theme that wants image 2's bloom turns on
# `glow.panel_edge` and gives it a radius; nothing else changes. The bloom on
# the wall behind the monitor in image 2 is the MONITOR blooming, not per-glyph
# work — the same look comes from the panel-edge glow plus the overlay plate.
#
# `color = element` is an enum word meaning "the colour of the thing being
# glowed". It is baked as an explicit inherit flag, never as a negative alpha:
# a negative alpha reaching a vertex under SRC_ALPHA/ONE_MINUS_SRC_ALPHA is
# undefined output, not a wrong colour (5.0, 5.13).
#
# `mode = auto` resolves to `shell` at radius <= 0.85u and `sprite` above
# (DECISION M4). `text4` is allowed only on display.clock, display.hero,
# alert.banner and severity-critical badges, and only for strings no longer
# than glow.text_max_chars (DECISION M5). `bloom_pass` does not exist in the
# renderer; a theme that names it is warned and gets `auto`.
#
# Falloff per class is a real visual decision: gauss for the wide soft halo of
# panel edges and focus rings, quad for chart lines and gauge arcs so the data
# stays readable, halo (a plateau core then a Gaussian shoulder) for icons and
# node dots so the sprite core stays saturated, linear for separators and
# leader lines.
#
# `tube` joins that list on panel_edge alone (2026-08-18). It is the only
# falloff word with a reader, and the only one that brings keys of its own: a
# lit glass tube is not a spread of the same light but a different spend of it
# — a core driven past what the display can show, a saturated band against the
# glass, and light that stops instead of fading. See panel_edge.falloff below.
#
# `boost` IS NOT ONE KEY WITH ONE MEANING, and every class below says so in
# one line where it should say so in this paragraph. Fifteen classes declare
# it; ONE of them is read — `panel_edge`, and only under falloff = tube, where
# it drives the tube's CORE and is clipped per channel on the CPU. The other
# fourteen have no reader at all, so their line ("HDR overdrive ... survives
# only on the HDR path with no LUT") states an INTENT for a path that is not
# built: nothing carries a channel above 1 out of this toolkit today. Read
# panel_edge.boost for what the one live reader does; read the rest as a
# reservation of the name.
# =========================================================================
[glow]

# ---- panel_edge — the 1px glowing panel border, family A's signature ----
panel_edge.enabled = true
                    # draw a glow around every panel's edge; images 1-6, 7-10;
                    # bool; ON in default (2026-08-23: the shipped look is
                    # NEON, the lit glass tube, not a bare line) — a theme
                    # opts out
panel_edge.color = element
                    # glow tint; images 1-6; colour or the word `element`,
                    # which means the panel edge's own resolved colour
panel_edge.radius = 4u
                    # how far the glow reaches past the edge; images 1-6;
                    # u, 0u .. 4u; 0u is the `none` sentinel — draw nothing
                    # The theme editor's GLOW REACH writes this (BASIC,
                    # 2026-08-18) and the declared 0u..4u above is the
                    # track's two ends — the wall is the FILE's, not the
                    # editor's. 4u (2026-08-23) is that wall's TOP: the
                    # owner asked for the reach at its maximum by default,
                    # not at border_edits()'s own undressed-theme seed of
                    # 1.6u, which is now only where a theme's own first
                    # lit pick still lands.
panel_edge.falloff = tube # enum: linear | quad | gauss | halo | tube
                    # how the light is spent across the radius; images 1-6,
                    # 7-10. `gauss` is the wide soft halo of images 7 and 10
                    # and it is what this key has always meant.
                    # `tube` is the LIT GLASS TUBE of a neon sign: the same
                    # soft disk with its distance re-mapped by tube_decay so
                    # the light stops instead of fading, its core burned by
                    # `boost` and its colour carried by tube_aura. The four
                    # `tube_*` keys below are read only under this word.
                    # THE `enum:` DECLARATION IS LOAD-BEARING. Without it a
                    # token's vocabulary grows from use, `gauss` is the only
                    # word in it, and the one word a theme could never
                    # deliver is the one this key now exists for — the same
                    # trap `[elev.*] edge.mode = solid` records against
                    # `gradient`. The other fourteen glow classes still grow
                    # theirs from use: they have no reader, and a list is a
                    # promise about numbering that only a reader can keep.
panel_edge.mode = auto
                    # rendering technique; -; one of off | shell | sprite |
                    # text4 | auto; auto picks shell at radius <= 0.85u
panel_edge.alpha = 0.34
                    # glow opacity — the ONLY 0..1 magnitude; images 1-6;
                    # 0.34 is `border_edits`'s own seed for a lit kind
                    # picked on an undressed theme, applied to the master
                    # itself (2026-08-23, the NEON-by-default change);
                    # frac, 0.0 .. 1.0; state channel is glow_alpha
panel_edge.boost = 2.6
                    # how hard the edge's light is DRIVEN, as a multiple of
                    # what the display can show; -; f, >= 1.0. THE CLIP IS
                    # THE PICTURE: a channel driven past 1 shows as 1, so a
                    # saturated colour loses its strongest channel first and
                    # its weakest last, and the core of a tube goes pale and
                    # then white while the light around it keeps the hue.
                    # That is why a photograph of a neon sign has a white
                    # core whatever colour the sign is.
                    # THE CLIP HAPPENS HERE, ON THE CPU, per channel, before
                    # the colour leaves the toolkit — one picture on every
                    # display, and nothing downstream has to be asked. So the
                    # overdrive does NOT reach an HDR swapchain as overdrive,
                    # whatever the older wording on the other fourteen glow
                    # classes says; a tube that stays bright on an R16F
                    # target is a real request and an unanswered one (it
                    # needs the clip lifted here AND a `grade()` that takes a
                    # sample above 1, which is the renderer's repository).
                    # Read ONLY under falloff = tube: a `gauss` halo is
                    # spill, and spill is not driven — which is also what
                    # keeps every theme written before this key had a reader
                    # drawing exactly the picture it drew.
                    # 2.6 clips the two strong channels of a mid-lightness
                    # saturated edge and leaves the weakest one short: a
                    # pale core with the hue still in it, not a white line.
                    # 1.0 is no drive and a core of the tube's own colour.
panel_edge.tube_decay = 3.0
                    # how much faster than the gauss halo the light falls,
                    # as the exponent the distance is raised to; -; f,
                    # >= 1.0; read only under falloff = tube. 1.0 IS the
                    # gauss halo. 3.0 cubes it: what the halo shows at a
                    # third of the radius the tube shows at a twenty-seventh
                    # of it — near the glass everything, past it nothing,
                    # which is the difference between a lit tube and a
                    # blurred copy of a line.
panel_edge.tube_aura = 2.0
                    # how much stronger than `alpha` the colour is laid
                    # immediately outside the tube; -; f, >= 1.0; read only
                    # under falloff = tube. The core has given its colour up
                    # to `boost`, so this band is where the sign's identity
                    # lives and it has to out-shout the edge itself or the
                    # tube reads as a white line with a smudge. 2.0 doubles
                    # it; 1.0 is no aura and `alpha` all the way out. The
                    # product is clipped at 1.0 whatever it comes to,
                    # because a blend factor outside 0..1 is not a brighter
                    # pixel — it is undefined output (5.0, 5.13).
panel_edge.tube_aura_reach = 0.25
                    # how far that stronger colour reaches, as a fraction of
                    # `radius`; -; frac, 0.0 .. 1.0; read only under
                    # falloff = tube. It ramps from tube_aura at the glass
                    # to 1.0 here and stays there. 0.25 is derived from
                    # tube_decay: a decay of 3 has spent nearly all the
                    # light inside the first quarter of the radius, so the
                    # aura colours the light that IS there instead of
                    # lifting a tail that is not. 0.0 is no aura at all.
                    # The number is EXACT on screen whatever tube_bands
                    # says: the reach is always one of the rings the light
                    # is cut at, or the picture would let go wherever the
                    # even cut happened to have one.
panel_edge.tube_bands = 5
                    # how many rings the reach is cut into — the resolution
                    # of tube_decay's re-map; -; n, 1 .. 16; read only under
                    # falloff = tube. IT LOOKS LIKE A QUALITY KNOB AND IT IS
                    # NOT ONE. The mask is sampled continuously inside a
                    # ring, but the ring BOUNDARIES are where the re-map is
                    # applied and the picture is a straight line between
                    # them, so a coarser cut is not a rougher drawing of the
                    # same curve — it is a different curve. At 1 the re-map
                    # has nowhere to land and the tube IS the gauss halo,
                    # whatever tube_decay says. 5 puts a ring every fifth of
                    # the reach: at decay 3 that is enough to bend the first
                    # fifth down onto the glass, and it keeps a sprite ring
                    # cheaper than the maskless shell it replaces. Raise it
                    # for a steeper decay, at one ring stroke each.

# ---- focus_ring — the keyboard focus ring -------------------------------
focus_ring.enabled = false
                    # draw a glow around the focused container's ring;
                    # image 7 (the magenta-framed task panel); bool
focus_ring.color = element
                    # glow tint; image 7; colour or `element` — here the focus
                    # ring's own colour, which family B makes a gradient
focus_ring.radius = 0u
                    # reach past the ring; image 7; u, 0u .. 4u
focus_ring.falloff = gauss
                    # soft, so focus reads as a lit frame rather than a
                    # second border; image 7; one of linear | quad | gauss |
                    # halo
focus_ring.mode = auto
                    # rendering technique; -; one of off | shell | sprite |
                    # text4 | auto
focus_ring.alpha = 0.0
                    # glow opacity; image 7; frac, 0.0 .. 1.0
focus_ring.boost = 1.0
                    # HDR overdrive; -; f, >= 1.0

# ---- text_display — the big clock and hero numerals ---------------------
text_display.enabled = false
                    # glow the display face — the 21:57:30 clock, the donut
                    # gauge numerals; images 1, 2, 9; bool
text_display.color = element
                    # glow tint; images 1, 2; colour or `element`
text_display.radius = 0u
                    # reach past the glyph; images 1, 2; u, 0u .. 4u
text_display.falloff = gauss
                    # soft bloom around large numerals; images 1, 2; one of
                    # linear | quad | gauss | halo
                    # TODO(default): falloff chosen here, 5.13 assigns falloff
                    # only to edges/rings, data, icons/dots and lines
text_display.mode = auto
                    # rendering technique; images 1, 2; one of off | shell |
                    # sprite | text4 | auto; text4 is the only way to glow
                    # text without per-glyph blur, at 5x the glyph quads
text_display.alpha = 0.0
                    # glow opacity; images 1, 2; frac, 0.0 .. 1.0
text_display.boost = 1.0
                    # HDR overdrive; -; f, >= 1.0

# ---- text_alert — the top bar's alarm line ------------------------------
text_alert.enabled = false
                    # glow `KRYTYCZNY ALARM` / `ALERT: SECURITY PROTOCOL
                    # ACTIVATED`; images 1, 2, 4, 5; bool
text_alert.color = element
                    # glow tint; images 1, 4; colour or `element` — here the
                    # live severity's text colour
text_alert.radius = 0u
                    # reach past the glyph; images 1, 4; u, 0u .. 4u
text_alert.falloff = gauss
                    # soft, matching text_display; images 1, 4; one of linear
                    # | quad | gauss | halo
                    # TODO(default): falloff chosen here, spec silent
text_alert.mode = auto
                    # rendering technique; images 1, 4; one of off | shell |
                    # sprite | text4 | auto
text_alert.alpha = 0.0
                    # glow opacity; images 1, 4; frac, 0.0 .. 1.0
text_alert.boost = 1.0
                    # HDR overdrive; -; f, >= 1.0

# ---- icon_active — the highlighted launcher / taskbar icon --------------
icon_active.enabled = false
                    # glow image 8's ORANGE active HOME glyph and image 5's
                    # oversized SYSTEM LOCKDOWN icon; images 5, 8; bool
icon_active.color = element
                    # glow tint; images 5, 8; colour or `element`
icon_active.radius = 0u
                    # reach past the glyph box; images 5, 8; u, 0u .. 4u
icon_active.falloff = halo
                    # a plateau core then a Gaussian shoulder, so the sprite
                    # core stays saturated; images 5, 8; one of linear | quad
                    # | gauss | halo
icon_active.mode = auto
                    # rendering technique; -; one of off | shell | sprite |
                    # text4 | auto
icon_active.alpha = 0.0
                    # glow opacity; images 5, 8; frac, 0.0 .. 1.0
icon_active.boost = 1.0
                    # HDR overdrive; -; f, >= 1.0

# ---- icon_idle — every other launcher / status glyph --------------------
icon_idle.enabled = false
                    # glow the resting icons of the launcher grid and the
                    # top bar's status cluster; images 1, 8; bool
icon_idle.color = element
                    # glow tint; images 1, 8; colour or `element`
icon_idle.radius = 0u
                    # reach past the glyph box; images 1, 8; u, 0u .. 4u
icon_idle.falloff = halo
                    # matches icon_active so the two differ in magnitude, not
                    # in kind; images 1, 8; one of linear | quad | gauss | halo
icon_idle.mode = auto
                    # rendering technique; -; one of off | shell | sprite |
                    # text4 | auto
icon_idle.alpha = 0.0
                    # glow opacity; images 1, 8; frac, 0.0 .. 1.0
icon_idle.boost = 1.0
                    # HDR overdrive; -; f, >= 1.0

# ---- chart_line — plot strokes in ANALYTICS FEED and SYMULACJE AI -------
chart_line.enabled = false
                    # glow the line-chart stroke; images 2, 4, 8; bool
chart_line.color = element
                    # glow tint; images 2, 8; colour or `element` — here
                    # data.line or the series colour, NOT the chrome accent
chart_line.radius = 0u
                    # reach past the stroke; images 2, 8; u, 0u .. 4u
chart_line.falloff = quad
                    # tight, so the plot stays readable under its own glow;
                    # images 2, 8; one of linear | quad | gauss | halo
chart_line.mode = auto
                    # rendering technique; -; one of off | shell | sprite |
                    # text4 | auto
chart_line.alpha = 0.0
                    # glow opacity; images 2, 8; frac, 0.0 .. 1.0
chart_line.boost = 1.0
                    # HDR overdrive; -; f, >= 1.0

# ---- gauge_arc — the donut gauges and progress arcs ---------------------
gauge_arc.enabled = false
                    # glow image 9's 92% / 84% / 95% donuts and the taskbar's
                    # 74% / 65% pair; image 9; bool
gauge_arc.color = element
                    # glow tint; image 9; colour or `element`
gauge_arc.radius = 0u
                    # reach past the arc; image 9; u, 0u .. 4u
gauge_arc.falloff = quad
                    # tight, so the arc's value edge stays legible; image 9;
                    # one of linear | quad | gauss | halo
gauge_arc.mode = auto
                    # rendering technique; -; one of off | shell | sprite |
                    # text4 | auto
gauge_arc.alpha = 0.0
                    # glow opacity; image 9; frac, 0.0 .. 1.0
gauge_arc.boost = 1.0
                    # HDR overdrive; -; f, >= 1.0

# ---- badge_critical — the CRITICAL pill only ----------------------------
badge_critical.enabled = false
                    # glow a badge carrying severity critical, and only that
                    # one; images 1-4; bool
badge_critical.color = element
                    # glow tint; images 1-4; colour or `element` — here
                    # severity.critical.text
badge_critical.radius = 0u
                    # reach past the pill; images 1-4; u, 0u .. 4u
badge_critical.falloff = halo
                    # a saturated core with a shoulder, so a small pill still
                    # reads as lit; images 1-4; one of linear | quad | gauss |
                    # halo
                    # TODO(default): falloff chosen here, spec silent
badge_critical.mode = auto
                    # rendering technique; -; one of off | shell | sprite |
                    # text4 | auto; the one badge allowed text4 (DECISION M5)
badge_critical.alpha = 0.0
                    # glow opacity; images 1-4; frac, 0.0 .. 1.0
badge_critical.boost = 1.0
                    # HDR overdrive; -; f, >= 1.0

# ---- hexagon — the RESOURCE MONITOR cells -------------------------------
hexagon.enabled = false
                    # glow the hexagon cells — gradient-filled in image 1,
                    # solid in image 3; images 1, 3, 4; bool
hexagon.color = element
                    # glow tint; images 1, 3; colour or `element`
hexagon.radius = 0u
                    # reach past the cell; images 1, 3; u, 0u .. 4u
hexagon.falloff = halo
                    # keeps the cell's own fill saturated while the shoulder
                    # spreads; images 1, 3; one of linear | quad | gauss | halo
                    # TODO(default): falloff chosen here, spec silent
hexagon.mode = auto
                    # rendering technique; -; one of off | shell | sprite |
                    # text4 | auto
hexagon.alpha = 0.0
                    # glow opacity; images 1, 3; frac, 0.0 .. 1.0
hexagon.boost = 1.0
                    # HDR overdrive; -; f, >= 1.0

# ---- node_dot — the NETWORK STATUS graph vertices -----------------------
node_dot.enabled = false
                    # glow the dots of the node graph and image 8's neural
                    # network; images 1, 8; bool
node_dot.color = element
                    # glow tint; images 1, 8; colour or `element`
node_dot.radius = 0u
                    # reach past the dot; images 1, 8; u, 0u .. 4u
node_dot.falloff = halo
                    # plateau core then Gaussian shoulder, so a 2px dot does
                    # not dissolve into its own glow; images 1, 8; one of
                    # linear | quad | gauss | halo
node_dot.mode = auto
                    # rendering technique; -; one of off | shell | sprite |
                    # text4 | auto
node_dot.alpha = 0.0
                    # glow opacity; images 1, 8; frac, 0.0 .. 1.0
node_dot.boost = 1.0
                    # HDR overdrive; -; f, >= 1.0

# ---- leader_line — the render's callout lines ---------------------------
leader_line.enabled = false
                    # glow the thin lines pointing at DAMAGE BREACH and
                    # UNIDENTIFIED UNIT (I45); images 1, 5; bool
leader_line.color = element
                    # glow tint; images 1, 5; colour or `element` — the leader
                    # takes the severity of the thing it points at
leader_line.radius = 0u
                    # reach past the line; images 1, 5; u, 0u .. 4u
leader_line.falloff = linear
                    # linear for lines, per 5.13 — anything softer turns a
                    # 1px callout into a smear; images 1, 5; one of linear |
                    # quad | gauss | halo
leader_line.mode = auto
                    # rendering technique; -; one of off | shell | sprite |
                    # text4 | auto
leader_line.alpha = 0.0
                    # glow opacity; images 1, 5; frac, 0.0 .. 1.0
leader_line.boost = 1.0
                    # HDR overdrive; -; f, >= 1.0

# ---- taskbar_active — the running/active taskbar item -------------------
taskbar_active.enabled = false
                    # glow the active item in the chevron taskbar; images 7-9;
                    # bool
taskbar_active.color = element
                    # glow tint; images 7-9; colour or `element`
taskbar_active.radius = 0u
                    # reach past the item; images 7-9; u, 0u .. 4u
taskbar_active.falloff = gauss
                    # a wide soft lift under the active item, matching the
                    # glass panels around it; images 7-9; one of linear | quad
                    # | gauss | halo
                    # TODO(default): falloff chosen here, spec silent
taskbar_active.mode = auto
                    # rendering technique; -; one of off | shell | sprite |
                    # text4 | auto
taskbar_active.alpha = 0.0
                    # glow opacity; images 7-9; frac, 0.0 .. 1.0
taskbar_active.boost = 1.0
                    # HDR overdrive; -; f, >= 1.0

# ---- cursor — the terminal caret and text carets ------------------------
cursor.enabled = false
                    # glow the caret; images 1-3; bool
cursor.color = element
                    # glow tint; images 1-3; colour or `element` — term.cursor
cursor.radius = 0u
                    # reach past the cell; images 1-3; u, 0u .. 4u
cursor.falloff = quad
                    # tight, so the glyph under an inverted caret survives;
                    # images 1-3; one of linear | quad | gauss | halo
                    # TODO(default): falloff chosen here, spec silent
cursor.mode = auto
                    # rendering technique; -; one of off | shell | sprite |
                    # text4 | auto
cursor.alpha = 0.0
                    # glow opacity; images 1-3; frac, 0.0 .. 1.0
cursor.boost = 1.0
                    # HDR overdrive; -; f, >= 1.0

# ---- separator — rules between rows and sections ------------------------
separator.enabled = false
                    # glow the hairline rules inside panels and lists;
                    # images 1, 9; bool
separator.color = element
                    # glow tint; images 1, 9; colour or `element`
separator.radius = 0u
                    # reach past the rule; images 1, 9; u, 0u .. 4u
separator.falloff = linear
                    # linear for separators, per 5.13; images 1, 9; one of
                    # linear | quad | gauss | halo
separator.mode = auto
                    # rendering technique; -; one of off | shell | sprite |
                    # text4 | auto
separator.alpha = 0.0
                    # glow opacity; images 1, 9; frac, 0.0 .. 1.0
separator.boost = 1.0
                    # HDR overdrive; -; f, >= 1.0

# ---- glow globals --------------------------------------------------------
text_max_chars = 48
                    # longer strings silently drop to no glow, because text4
                    # costs 5x the glyph quads of the string it draws; -;
                    # n, 1 .. 512 (DECISION M5)
alpha_scale = 1.0
                    # global multiplier applied to every glow.<C>.alpha — the
                    # single knob [variant.hc] turns down; -; f, 0.0 .. 2.0


# =========================================================================
# grad — eight named gradient slots x three tokens, plus one global (5.14).
#
# Gradients are free: Vertex already carries color[4] and the rasteriser
# already interpolates it. A gradient border is continuous around a frame at
# the same 24 verts a solid border costs; a gradient hexagon is a 18-vert fan.
# Interpolation is authored in OKLab and pre-resolved at load into
# `grad.samples` evenly spaced RGBA stops.
#
# GRAD_COUNT = 8, so there are exactly eight slots and they are named here.
# Four are named by 5.14 (spectrum, focus, deck, hex); the other four are
# chosen below to cover the gradients the reference images actually contain.
#
# Refused, by name: radial gradients with more than two colours, conic fills
# (a swept donut is N wedge quads with per-wedge vertex colours), mesh and
# multi-axis gradients, and per-pixel dithering. Gradients on TEXT exist but
# are per-glyph and are forbidden on body text and the terminal.
# =========================================================================
[grad]

# ---- spectrum — the flowing ribbon waves --------------------------------
spectrum.stops = [ [0.0, @data.series[4]], [0.34, @data.series[3]], [0.67, @data.series[2]], [1.0, @data.series[0]] ]
                    # the magenta -> violet -> cyan -> green ribbons behind
                    # the station render and the task panel; images 1, 7, 9,
                    # 10; 2..8 [position 0..1, colour] pairs; alpha is a stop
                    # channel, so alpha gradients cost nothing extra
                    # TODO(default): stop list written as nested arrays; 5.14
                    # spells pairs with parentheses, which 3.2 has no
                    # production for
spectrum.axis = x
                    # the ribbons travel across the panel; images 1, 7; one of
                    # x | y | diag_down | diag_up | angle(deg)
spectrum.space = oklab
                    # interpolation space; images 1, 7; one of oklab | srgb;
                    # srgb exists only to reproduce an existing palette
                    # exactly and the master does not use it

# ---- focus — the focused container's frame ------------------------------
focus.stops = [ [0.0, @data.series[4]], [0.5, @data.series[3]], [1.0, @accent.primary] ]
                    # image 7's MAGENTA/VIOLET frame around ZADANIA BIEZACE,
                    # the one focused window on a screen of cyan panels;
                    # image 7; 2..8 [position, colour] pairs
                    # TODO(default): stops chosen here, spec states no default
focus.axis = diag_down
                    # the frame's hue travels corner to corner, which is what
                    # makes it read as lit rather than striped; image 7; one
                    # of x | y | diag_down | diag_up | angle(deg)
focus.space = oklab
                    # interpolation space; image 7; one of oklab | srgb; the
                    # magenta->violet->blue arc is the most hue-travelled
                    # gradient in the brief and srgb visibly greys its middle

# ---- deck — the taskbar / instrument deck plate -------------------------
deck.stops = [ [0.0, alpha(@accent.primary, 0.10)], [1.0, alpha(@accent.primary, 0.00)] ]
                    # the sheen down image 9's elaborate bottom deck and
                    # image 7's chevron taskbar; images 7, 8, 9; 2..8
                    # [position, colour] pairs
                    # TODO(default): stops chosen here, spec states no default
deck.axis = y
                    # top-lit, like every glass plate in family B; images 7-9;
                    # one of x | y | diag_down | diag_up | angle(deg)
deck.space = oklab
                    # interpolation space; images 7-9; one of oklab | srgb

# ---- hex — the RESOURCE MONITOR hexagon fill ----------------------------
hex.stops = [ [0.0, @accent.primary], [1.0, alpha(@accent.dim, 0.35)] ]
                    # image 1's mint-gradient hexagons, drawn as an 18-vert
                    # fan_c: 1 centre + 6 rim colours; images 1, 4; 2..8
                    # [position, colour] pairs
                    # TODO(default): stops chosen here, spec states no default
hex.axis = diag_down
                    # the cell reads as lit from the top left; image 1; one of
                    # x | y | diag_down | diag_up | angle(deg)
hex.space = oklab
                    # interpolation space; image 1; one of oklab | srgb

# ---- glass — the family-B pane fill -------------------------------------
glass.stops = [ [0.0, alpha(@palette.white, 0.10)], [1.0, alpha(@palette.white, 0.02)] ]
                    # the top-to-bottom sheen across a translucent glass
                    # panel, over whatever the backdrop supplies; images 7, 8,
                    # 10; 2..8 [position, colour] pairs
                    # TODO(default): slot name and stops chosen here; 5.14
                    # names only four of its eight slots
glass.axis = y
                    # glass is lit from above in every family-B image;
                    # images 7, 8, 10; one of x | y | diag_down | diag_up |
                    # angle(deg)
glass.space = oklab
                    # interpolation space; images 7, 8, 10; one of oklab | srgb

# ---- gauge — the donut gauge sweep --------------------------------------
gauge.stops = [ [0.0, @data.line], [1.0, @accent.primary] ]
                    # the value arc of image 9's 92% / 84% / 95% donuts, drawn
                    # as 48 wedge quads with per-wedge vertex colours; image 9;
                    # 2..8 [position, colour] pairs
                    # TODO(default): slot name and stops chosen here, spec
                    # names only four slots
gauge.axis = x
                    # sampled along the sweep's progress, not across the
                    # screen; image 9; one of x | y | diag_down | diag_up |
                    # angle(deg)
gauge.space = oklab
                    # interpolation space; image 9; one of oklab | srgb

# ---- bar — progress and meter fills -------------------------------------
bar.stops = [ [0.0, @accent.dim], [1.0, @accent.primary] ]
                    # the thin filled bars on PROCESOR / PAMIEC / SIEC /
                    # ENERGIA rows and the bar charts under them; images 1, 7,
                    # 8; 2..8 [position, colour] pairs
                    # TODO(default): slot name and stops chosen here, spec
                    # names only four slots
bar.axis = x
                    # the fill brightens toward its own leading edge, so the
                    # value's end is the brightest pixel; images 1, 7; one of
                    # x | y | diag_down | diag_up | angle(deg)
bar.space = oklab
                    # interpolation space; images 1, 7; one of oklab | srgb

# ---- scrim — the vertical fade under the top bar ------------------------
scrim.stops = [ [0.0, alpha(@palette.black, 0.55)], [1.0, alpha(@palette.black, 0.00)] ]
                    # the fade that keeps the top bar's text legible over a
                    # live family-B backdrop, and the letterbox fade in
                    # family A; images 1, 7, 10; 2..8 [position, colour] pairs
                    # TODO(default): slot name and stops chosen here, spec
                    # names only four slots
scrim.axis = y
                    # a vertical fade by definition; images 1, 7; one of x | y
                    # | diag_down | diag_up | angle(deg)
scrim.space = oklab
                    # interpolation space; images 1, 7; one of oklab | srgb

# ---- gradient global -----------------------------------------------------
samples = 8
                    # how many evenly spaced RGBA stops the resolver bakes
                    # each gradient into; -; n, 2 .. 16; at 8 the deviation
                    # from true OKLab across a 400px panel is under 1/255,
                    # measured on image 7's magenta->violet->blue arc


# ============================================================ 30-material

# =========================================================================
# elev — THE MATERIAL LADDER (5.12). Nine fixed levels, thirty keys each.
# A widget names a level; the theme colours it. The enum IS the widget
# contract, so `fixture` is appended at 8 and nothing is ever inserted.
#
# default ships EVERY level flat: glass.rank 0, no glow, no shadow, no
# reflection. A silent theme therefore emits no blur() run at all and skips
# two to five offscreen passes per frame (5.12, 8).
#
# Glass is always TWO quads and a single "glass colour" token would be a bug:
#   dl.blur(rect, glass.tint)   multiply — can only darken and hue-shift
#   dl.rect(rect, glass.wash)   alpha over — the only knob that can brighten
#
# Every `corner` below spells its three words as §3.2's `enum:` declaration,
# and that spelling is load-bearing rather than tidy: a consumer resolves
# `enum_index(id, "chamfer")` ONCE and keeps it, so a list left to grow from
# whatever words a cascade happens to intern answers None for a word the
# master never wrote, and keeps answering None after the theme that writes it
# has loaded. Undeclared, `elev.panel.corner` cached "chamfer" as no index at
# all and drew every family-A panel square — the shape a theme cannot ask for.
# =========================================================================

[elev]
glass.generations    = 1                      # how many times glass may re-blur an already blurred pane · - · n, 1..2 · no derivation; >1 costs +1 blit and +4 passes per generation (~0.35ms @1440p)

# -------------------------------------------------------------------------
# elev.backdrop — (Elev 0) the plate behind everything: wallpaper, solid colour, compositor view. Never glass.
# -------------------------------------------------------------------------
[elev.backdrop]
# glass — two quads; skipped entirely while rank is 0
glass.rank           = 0                      # frost rank of the backdrop plate: 0 emits no blur() run at all · 7,8,10 · n, 0..3 (softness rank, NOT a mip index) · no derivation — this level is NEVER glass (M1/M2) — leave at 0; clamped by Gfx::glass_ranks()
glass.tint           = #FFFFFF / 1.0          # multiply tint of the blur quad; its alpha is the frost coverage · 7,8,10 · colour, straight alpha 0..1 · no derivation — white at 1.0 is an identity multiply
glass.wash           = none                   # alpha-over wash on the frost; the theme's own light · 7,8,10 · colour or none · none = the second quad is not drawn; user BlurOpacity scales this alpha
# body, shape
fill                 = @surface.void          # the backdrop bed when backdrop.source paints nothing over it (used INSTEAD of the glass pair while rank = 0) · 7,8,10 · colour or none · @surface.void — the opaque bed and the swapchain clear (5.5)
corner               = @corner.mode           # corner treatment of the backdrop plate rect · 7,8,10 · enum: square | round | chamfer · @corner.mode, the one place this file states its corner language
radius               = @corner.md             # corner radius, or the chamfer cut length · 7,8,10 · len (u) · @corner.md = 1.2u ~ 8.6px @1440p (5.4)
# edge — one ring, one winner: a named edge.gradient beats the color2 sugar
edge.color           = @component.panel.border # the backdrop plate has no ring in a silent theme · 7,8,10 · colour or none · @component.panel.border -> @border.default -> alpha(@accent.primary, 0.78)
edge.color2          = same_as_parent         # far end of a two-stop edge; SUGAR, bakes to an anonymous gradient · 7,8,10 · colour or same_as_parent · same_as_parent = copy edge.color, i.e. a flat ring
edge.mode            = solid                  # how the ring is coloured · 7,8,10 · enum: solid | gradient · no derivation; `gradient` takes the edge.color/color2 pair along edge.axis. The `enum:` declaration is what makes `gradient` a WORD THIS FILE OWNS: without it the vocabulary grows from use, `solid` is the only word in it, and the one word a theme could never deliver was the one the key exists for
edge.gradient        = none                   # named multi-stop ring; image 7's magenta->violet->blue focused frame · 7 · @grad.<name> with 2..8 stops, or none · none = no named gradient, so edge.color2 sugar (if set) wins. NO READER as of 2026-08-17, and leave it at none: [grad].<name>.stops is an array, arrays are dropped by the bake, and ResolvedTheme has no stop list to answer with — a value here would change nothing on screen. The sugar pair IS read
edge.axis            = x                      # direction the edge gradient is projected along · 7 · enum: x | y | diag_down | diag_up · no derivation; ignored while edge.mode = solid. angle(deg) is NOT in the list: 3.2's `enum:` takes bare words, and an angle is a second token (a scalar) rather than a member of this one — write it when a reader for it exists
edge.width           = @stroke.hair           # thickness of the ring; a stroke, never panel-scaled, never density-scaled · 7,8,10 · str (stroke ladder) · @stroke.hair = 1 device px at 1080p and 1440p (5.4)
# inner glow — one R8 mask x a vertex colour; radii are resolution-independent
glow.inner.color     = none                   # colour of the inner glow, painted INSIDE the rect (family B's soft pane light) · 7,8,10 · colour or none · none = the glow quad is not emitted at all; default is flat (8)
glow.inner.radius    = 0u                     # reach of the inner glow measured from the edge · 7,8,10 · len (u), 0u = off · no derivation; every radius is legal, masks are stretched by the quad
glow.inner.falloff   = gauss                  # alpha profile of the inner glow from the edge outward · 7,8,10 · linear | quad | gauss | halo · no derivation; gauss is the photographic bloom the brief shows
glow.inner.mode      = auto                   # how the inner glow is realised · 7,8,10 · off | shell | sprite | auto · auto (-1.0) = the engine picks shell or sprite by the stated rule (5.0)
glow.inner.boost     = 1.0                    # HDR overdrive of the inner glow beyond white · 7,8,10 · f, >= 1.0 · no derivation; >1 survives only on the HDR path with no LUT
# outer glow — one R8 mask x a vertex colour; radii are resolution-independent
glow.outer.color     = none                   # colour of the outer glow, painted OUTSIDE the rect (image 2's bloom on the wall) · 2 · colour or none · none = the glow quad is not emitted at all; default is flat (8)
glow.outer.radius    = 0u                     # reach of the outer glow measured from the edge · 2 · len (u), 0u = off · no derivation; every radius is legal, masks are stretched by the quad
glow.outer.falloff   = gauss                  # alpha profile of the outer glow from the edge outward · 2 · linear | quad | gauss | halo · no derivation; gauss is the photographic bloom the brief shows
glow.outer.mode      = auto                   # how the outer glow is realised · 2 · off | shell | sprite | auto · auto (-1.0) = the engine picks shell or sprite by the stated rule (5.0)
glow.outer.boost     = 1.0                    # HDR overdrive of the outer glow beyond white · 2 · f, >= 1.0 · no derivation; >1 survives only on the HDR path with no LUT
# drop shadow — the same soft_box() 9-slice as the glows
shadow.color         = none                   # drop shadow cast by the backdrop plate · 7,8 · colour or none · none (0.0) = no shadow quad; default ships shadowless (8)
shadow.radius        = 0u                     # blur radius of the drop shadow · 7,8 · len (u), 0u = off · no derivation; cockpit ran 3.9u..6.4u up the ladder (8)
shadow.dx            = 0u                     # horizontal offset of the drop shadow · 7,8 · len (u), may be negative · no derivation
shadow.dy            = 0u                     # vertical offset of the drop shadow · 7,8 · len (u), may be negative · no derivation
shadow.spread        = 0u                     # outward dilation of the shadow rect before blurring · 7,8 · len (u) · no derivation
# reflection — mirrors the MATERIAL, never the content; 12 verts. NOT legal on this level — must stay 0u (5.12)
reflect.height       = 0u                     # how far the mirrored smear reaches below the rect; a board's reflection suppresses its panels' · 8 · len (u), 0u = off · no derivation; NOT legal on this level — must stay 0u (5.12)
reflect.alpha        = 0.0                    # opacity of the mirrored smear where it meets the rect · 8 · frac 0..1 · no derivation; ignored while reflect.height = 0u
reflect.fade         = 2.0                    # exponent of the reflection's alpha ramp toward 0 · 8 · f, > 0 · no derivation; 2.0 is the quadratic falloff image 8's desk shows

# -------------------------------------------------------------------------
# elev.board — (Elev 1) the desktop field itself — family A an opaque field, family B nothing. Never glass.
# -------------------------------------------------------------------------
[elev.board]
# glass — two quads; skipped entirely while rank is 0
glass.rank           = 0                      # frost rank of the board: 0 emits no blur() run at all · 1-6 · n, 0..3 (softness rank, NOT a mip index) · no derivation — this level is NEVER glass (M1/M2) — leave at 0; clamped by Gfx::glass_ranks()
glass.tint           = #FFFFFF / 1.0          # multiply tint of the blur quad; its alpha is the frost coverage · 7,8,10 · colour, straight alpha 0..1 · no derivation — white at 1.0 is an identity multiply
glass.wash           = none                   # alpha-over wash on the frost; the theme's own light · 7,8,10 · colour or none · none = the second quad is not drawn; user BlurOpacity scales this alpha
# body, shape
fill                 = @surface.base          # the desktop field behind every panel (used INSTEAD of the glass pair while rank = 0) · 1-6 · colour or none · @surface.base — the screen background traces and vignette live on (5.5)
corner               = @corner.mode           # corner treatment of the board rect · 1-6 · enum: square | round | chamfer · @corner.mode, the one place this file states its corner language
radius               = @corner.md             # corner radius, or the chamfer cut length · 1-6 · len (u) · @corner.md = 1.2u ~ 8.6px @1440p (5.4)
# edge — one ring, one winner: a named edge.gradient beats the color2 sugar
edge.color           = @component.panel.border # ring around the board field · 1-6 · colour or none · @component.panel.border -> @border.default -> alpha(@accent.primary, 0.78)
edge.color2          = same_as_parent         # far end of a two-stop edge; SUGAR, bakes to an anonymous gradient · 1-6 · colour or same_as_parent · same_as_parent = copy edge.color, i.e. a flat ring
edge.mode            = solid                  # how the ring is coloured · 1-6 · enum: solid | gradient · no derivation; `gradient` takes the edge.color/color2 pair along edge.axis. The `enum:` declaration is what makes `gradient` a WORD THIS FILE OWNS: without it the vocabulary grows from use, `solid` is the only word in it, and the one word a theme could never deliver was the one the key exists for
edge.gradient        = none                   # named multi-stop ring; image 7's magenta->violet->blue focused frame · 7 · @grad.<name> with 2..8 stops, or none · none = no named gradient, so edge.color2 sugar (if set) wins. NO READER as of 2026-08-17, and leave it at none: [grad].<name>.stops is an array, arrays are dropped by the bake, and ResolvedTheme has no stop list to answer with — a value here would change nothing on screen. The sugar pair IS read
edge.axis            = x                      # direction the edge gradient is projected along · 7 · enum: x | y | diag_down | diag_up · no derivation; ignored while edge.mode = solid. angle(deg) is NOT in the list: 3.2's `enum:` takes bare words, and an angle is a second token (a scalar) rather than a member of this one — write it when a reader for it exists
edge.width           = @stroke.hair           # thickness of the ring; a stroke, never panel-scaled, never density-scaled · 1-6 · str (stroke ladder) · @stroke.hair = 1 device px at 1080p and 1440p (5.4)
# inner glow — one R8 mask x a vertex colour; radii are resolution-independent
glow.inner.color     = none                   # colour of the inner glow, painted INSIDE the rect (family B's soft pane light) · 7,8,10 · colour or none · none = the glow quad is not emitted at all; default is flat (8)
glow.inner.radius    = 0u                     # reach of the inner glow measured from the edge · 7,8,10 · len (u), 0u = off · no derivation; every radius is legal, masks are stretched by the quad
glow.inner.falloff   = gauss                  # alpha profile of the inner glow from the edge outward · 7,8,10 · linear | quad | gauss | halo · no derivation; gauss is the photographic bloom the brief shows
glow.inner.mode      = auto                   # how the inner glow is realised · 7,8,10 · off | shell | sprite | auto · auto (-1.0) = the engine picks shell or sprite by the stated rule (5.0)
glow.inner.boost     = 1.0                    # HDR overdrive of the inner glow beyond white · 7,8,10 · f, >= 1.0 · no derivation; >1 survives only on the HDR path with no LUT
# outer glow — one R8 mask x a vertex colour; radii are resolution-independent
glow.outer.color     = none                   # colour of the outer glow, painted OUTSIDE the rect (image 2's bloom on the wall) · 2 · colour or none · none = the glow quad is not emitted at all; default is flat (8)
glow.outer.radius    = 0u                     # reach of the outer glow measured from the edge · 2 · len (u), 0u = off · no derivation; every radius is legal, masks are stretched by the quad
glow.outer.falloff   = gauss                  # alpha profile of the outer glow from the edge outward · 2 · linear | quad | gauss | halo · no derivation; gauss is the photographic bloom the brief shows
glow.outer.mode      = auto                   # how the outer glow is realised · 2 · off | shell | sprite | auto · auto (-1.0) = the engine picks shell or sprite by the stated rule (5.0)
glow.outer.boost     = 1.0                    # HDR overdrive of the outer glow beyond white · 2 · f, >= 1.0 · no derivation; >1 survives only on the HDR path with no LUT
# drop shadow — the same soft_box() 9-slice as the glows
shadow.color         = none                   # drop shadow cast by the board · 7,8 · colour or none · none (0.0) = no shadow quad; default ships shadowless (8)
shadow.radius        = 0u                     # blur radius of the drop shadow · 7,8 · len (u), 0u = off · no derivation; cockpit ran 3.9u..6.4u up the ladder (8)
shadow.dx            = 0u                     # horizontal offset of the drop shadow · 7,8 · len (u), may be negative · no derivation
shadow.dy            = 0u                     # vertical offset of the drop shadow · 7,8 · len (u), may be negative · no derivation
shadow.spread        = 0u                     # outward dilation of the shadow rect before blurring · 7,8 · len (u) · no derivation
# reflection — mirrors the MATERIAL, never the content; 12 verts. legal on this level (board, panel, focused, fixture only)
reflect.height       = 0u                     # how far the mirrored smear reaches below the rect; a board's reflection suppresses its panels' · 8 · len (u), 0u = off · no derivation; legal on this level (board, panel, focused, fixture only)
reflect.alpha        = 0.0                    # opacity of the mirrored smear where it meets the rect · 8 · frac 0..1 · no derivation; ignored while reflect.height = 0u
reflect.fade         = 2.0                    # exponent of the reflection's alpha ramp toward 0 · 8 · f, > 0 · no derivation; 2.0 is the quadratic falloff image 8's desk shows

# -------------------------------------------------------------------------
# elev.panel — (Elev 2) a resting panel, card or taskbar — the most repeated element in the whole brief.
# -------------------------------------------------------------------------
[elev.panel]
# glass — two quads; skipped entirely while rank is 0
glass.rank           = 0                      # frost rank of the panel: 0 emits no blur() run at all · 1-9 · n, 0..3 (softness rank, NOT a mip index) · no derivation — raise to 1..3 for a family-B glass sheet; clamped by Gfx::glass_ranks()
glass.tint           = #FFFFFF / 1.0          # multiply tint of the blur quad; its alpha is the frost coverage · 7,8,10 · colour, straight alpha 0..1 · no derivation — white at 1.0 is an identity multiply
glass.wash           = none                   # alpha-over wash on the frost; the theme's own light · 7,8,10 · colour or none · none = the second quad is not drawn; user BlurOpacity scales this alpha
# body, shape
fill                 = @component.panel.fill  # the bordered panel body when glass.rank = 0 (used INSTEAD of the glass pair while rank = 0) · 1-9 · colour or none · @component.panel.fill -> @surface.panel (5.0 owner chain)
corner               = @panel.corner_mode     # corner treatment of the panel rect · 1-9 · enum: square | round | chamfer · @panel.corner_mode -> round (5.0 owner chain); family A may say chamfer
radius               = @panel.corner          # corner radius, or the chamfer cut length · 1-9 · len (u) · @panel.corner -> @corner.md = 1.2u ~ 8.6px @1440p (5.0 owner chain)
# edge — one ring, one winner: a named edge.gradient beats the color2 sugar
edge.color           = @component.panel.border # the thin glowing 1px panel edge — family A's signature · 1-9 · colour or none · @component.panel.border -> @border.default -> alpha(@accent.primary, 0.78)
edge.color2          = same_as_parent         # far end of a two-stop edge; SUGAR, bakes to an anonymous gradient · 1-9 · colour or same_as_parent · same_as_parent = copy edge.color, i.e. a flat ring
edge.mode            = solid                  # how the ring is coloured · 1-9 · enum: solid | gradient · no derivation; `gradient` takes the edge.color/color2 pair along edge.axis. The `enum:` declaration is what makes `gradient` a WORD THIS FILE OWNS: without it the vocabulary grows from use, `solid` is the only word in it, and the one word a theme could never deliver was the one the key exists for
edge.gradient        = none                   # named multi-stop ring; image 7's magenta->violet->blue focused frame · 7 · @grad.<name> with 2..8 stops, or none · none = no named gradient, so edge.color2 sugar (if set) wins. NO READER as of 2026-08-17, and leave it at none: [grad].<name>.stops is an array, arrays are dropped by the bake, and ResolvedTheme has no stop list to answer with — a value here would change nothing on screen. The sugar pair IS read
edge.axis            = x                      # direction the edge gradient is projected along · 7 · enum: x | y | diag_down | diag_up · no derivation; ignored while edge.mode = solid. angle(deg) is NOT in the list: 3.2's `enum:` takes bare words, and an angle is a second token (a scalar) rather than a member of this one — write it when a reader for it exists
edge.width           = @panel.border          # thickness of the ring; a stroke, never panel-scaled, never density-scaled · 1-9 · str (stroke ladder) · @panel.border -> @border.edge.width -> @stroke.hair (5.0 owner chain)
# inner glow — one R8 mask x a vertex colour; radii are resolution-independent
glow.inner.color     = none                   # colour of the inner glow, painted INSIDE the rect (family B's soft pane light) · 7,8,10 · colour or none · none = the glow quad is not emitted at all; default is flat (8)
glow.inner.radius    = 0u                     # reach of the inner glow measured from the edge · 7,8,10 · len (u), 0u = off · no derivation; every radius is legal, masks are stretched by the quad
glow.inner.falloff   = gauss                  # alpha profile of the inner glow from the edge outward · 7,8,10 · linear | quad | gauss | halo · no derivation; gauss is the photographic bloom the brief shows
glow.inner.mode      = auto                   # how the inner glow is realised · 7,8,10 · off | shell | sprite | auto · auto (-1.0) = the engine picks shell or sprite by the stated rule (5.0)
glow.inner.boost     = 1.0                    # HDR overdrive of the inner glow beyond white · 7,8,10 · f, >= 1.0 · no derivation; >1 survives only on the HDR path with no LUT
# outer glow — one R8 mask x a vertex colour; radii are resolution-independent
glow.outer.color     = none                   # colour of the outer glow, painted OUTSIDE the rect (image 2's bloom on the wall) · 2 · colour or none · none = the glow quad is not emitted at all; default is flat (8)
glow.outer.radius    = 0u                     # reach of the outer glow measured from the edge · 2 · len (u), 0u = off · no derivation; every radius is legal, masks are stretched by the quad
glow.outer.falloff   = gauss                  # alpha profile of the outer glow from the edge outward · 2 · linear | quad | gauss | halo · no derivation; gauss is the photographic bloom the brief shows
glow.outer.mode      = auto                   # how the outer glow is realised · 2 · off | shell | sprite | auto · auto (-1.0) = the engine picks shell or sprite by the stated rule (5.0)
glow.outer.boost     = 1.0                    # HDR overdrive of the outer glow beyond white · 2 · f, >= 1.0 · no derivation; >1 survives only on the HDR path with no LUT
# drop shadow — the same soft_box() 9-slice as the glows
shadow.color         = none                   # drop shadow cast by the panel · 7,8 · colour or none · none (0.0) = no shadow quad; default ships shadowless (8)
shadow.radius        = 0u                     # blur radius of the drop shadow · 7,8 · len (u), 0u = off · no derivation; cockpit ran 3.9u..6.4u up the ladder (8)
shadow.dx            = 0u                     # horizontal offset of the drop shadow · 7,8 · len (u), may be negative · no derivation
shadow.dy            = 0u                     # vertical offset of the drop shadow · 7,8 · len (u), may be negative · no derivation
shadow.spread        = 0u                     # outward dilation of the shadow rect before blurring · 7,8 · len (u) · no derivation
# reflection — mirrors the MATERIAL, never the content; 12 verts. legal on this level (board, panel, focused, fixture only)
reflect.height       = 0u                     # how far the mirrored smear reaches below the rect; a board's reflection suppresses its panels' · 8 · len (u), 0u = off · no derivation; legal on this level (board, panel, focused, fixture only)
reflect.alpha        = 0.0                    # opacity of the mirrored smear where it meets the rect · 8 · frac 0..1 · no derivation; ignored while reflect.height = 0u
reflect.fade         = 2.0                    # exponent of the reflection's alpha ramp toward 0 · 8 · f, > 0 · no derivation; 2.0 is the quadratic falloff image 8's desk shows

# -------------------------------------------------------------------------
# elev.raised — (Elev 3) hovered panel, dragged card, active launcher tile.
# -------------------------------------------------------------------------
[elev.raised]
# glass — two quads; skipped entirely while rank is 0
glass.rank           = 0                      # frost rank of the raised container: 0 emits no blur() run at all · 3,8 · n, 0..3 (softness rank, NOT a mip index) · no derivation — raise to 1..3 for a family-B glass sheet; clamped by Gfx::glass_ranks()
