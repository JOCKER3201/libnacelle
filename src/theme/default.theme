# -------------------------------------------------------------------------
# elev.fixture — (Elev 8) a full-screen sheet riding over a still board: the APPGRID and SEARCH AND AI boards.
# -------------------------------------------------------------------------
[elev.fixture]
# glass — two quads; skipped entirely while rank is 0
glass.rank           = 1                      # frost rank of the fixture sheet: 0 emits no blur() run at all, and lays `fill` instead · - · n, 0..3 (softness rank, NOT a mip index) · 1 and not 0 because the shipped fixture IS frosted: until 2026-08-17 deco::fixture_glass blurred whatever this key said, so the key said one thing and the screen showed another. The key decides now, and it has to say what the picture already showed. On this path 1..3 are one picture — a full-screen sheet takes the flat blur() run, whose softness is the renderer's single blur target, while the pyramid's three ranks are glass_fill's; clamped by Gfx::glass_ranks()
glass.tint           = #FFFFFF / 1.0          # multiply tint of the blur quad; its alpha is the frost coverage · 7,8,10 · colour, straight alpha 0..1 · no derivation — white at 1.0 is an identity multiply
glass.wash           = none                   # alpha-over wash on the frost; the theme's own light · 7,8,10 · colour or none · none = the second quad is not drawn; user BlurOpacity scales this alpha
# body, shape
# TODO(default): 5.12's Elev table gives fill = alpha(@surface.base, 0.0) while
# 5.12's prose says default gives fixture rank 0 and alpha(@surface.base, 0.92).
# The prose is the one that speaks about default.theme, so 0.92 is written here.
fill                 = alpha(@surface.base, 0.92) # the full-screen sheet over the frozen board; legible with no offscreen pass (used INSTEAD of the glass pair while rank = 0) · - · colour or none · stated for default in 5.12's prose; its table row says alpha at 0.0 instead
corner               = @corner.mode           # corner treatment of the fixture sheet rect · - · enum: square | round | chamfer · @corner.mode, the one place this file states its corner language
radius               = @corner.md             # corner radius, or the chamfer cut length · - · len (u) · @corner.md = 1.2u ~ 8.6px @1440p (5.4)
# edge — one ring, one winner: a named edge.gradient beats the color2 sugar
edge.color           = @component.panel.border # ring around the full-screen sheet · - · colour or none · @component.panel.border -> @border.default -> alpha(@accent.primary, 0.78)
edge.color2          = same_as_parent         # far end of a two-stop edge; SUGAR, bakes to an anonymous gradient · - · colour or same_as_parent · same_as_parent = copy edge.color, i.e. a flat ring
edge.mode            = solid                  # how the ring is coloured · - · enum: solid | gradient · no derivation; `gradient` takes the edge.color/color2 pair along edge.axis. The `enum:` declaration is what makes `gradient` a WORD THIS FILE OWNS: without it the vocabulary grows from use, `solid` is the only word in it, and the one word a theme could never deliver was the one the key exists for
edge.gradient        = none                   # named multi-stop ring; image 7's magenta->violet->blue focused frame · 7 · @grad.<name> with 2..8 stops, or none · none = no named gradient, so edge.color2 sugar (if set) wins. NO READER as of 2026-08-17, and leave it at none: [grad].<name>.stops is an array, arrays are dropped by the bake, and ResolvedTheme has no stop list to answer with — a value here would change nothing on screen. The sugar pair IS read
edge.axis            = x                      # direction the edge gradient is projected along · 7 · enum: x | y | diag_down | diag_up · no derivation; ignored while edge.mode = solid. angle(deg) is NOT in the list: 3.2's `enum:` takes bare words, and an angle is a second token (a scalar) rather than a member of this one — write it when a reader for it exists
edge.width           = @stroke.hair           # thickness of the ring; a stroke, never panel-scaled, never density-scaled · - · str (stroke ladder) · @stroke.hair = 1 device px at 1080p and 1440p (5.4)
# inner glow — one R8 mask x a vertex colour; radii are resolution-independent
glow.inner.color     = none                   # colour of the inner glow, painted INSIDE the rect (family B's soft pane light) · 7,8,10 · colour or none · none = the glow quad is not emitted at all; default is flat (8)
glow.inner.radius    = 0u                     # reach of the inner glow measured from the edge · 7,8,10 · len (u), 0u = off · no derivation; every radius is legal, masks are stretched by the quad
glow.inner.falloff   = gauss                  # alpha profile of the inner glow from the edge outward · 7,8,10 · linear | quad | gauss | halo · no derivation; gauss is the photographic bloom the brief shows
glow.inner.mode      = auto                   # how the inner glow is realised · 7,8,10 · off | shell | sprite | auto · auto (-1.0) = the engine picks shell or sprite by the stated rule (5.0)
glow.inner.boost     = 1.0                    # HDR overdrive of the inner glow beyond white · 7,8,10 · f, >= 1.0 · no derivation; >1 survives only on the HDR path with no LUT
# outer glow — one R8 mask x a vertex colour; radii are resolution-independent
glow.outer.color     = none                   # colour of the outer glow, painted OUTSIDE the rect (image 2's bloom on the wall) · 2 · colour or none · none = the glow quad is not emitted at all; default is flat (8)
glow.outer.radius    = 0u                     # reach of the outer glow measured from the edge · 2 · len (u), 0u = off · no derivation; every radius is legal, masks are stretched by the quad
glow.outer.falloff   = gauss                  # alpha profile of the outer glow from the edge outward · 2 · linear | quad | gauss | halo · no derivation; gauss is the photographic bloom the brief shows
glow.outer.mode      = auto                   # how the outer glow is realised · 2 · off | shell | sprite | auto · auto (-1.0) = the engine picks shell or sprite by the stated rule (5.0)
glow.outer.boost     = 1.0                    # HDR overdrive of the outer glow beyond white · 2 · f, >= 1.0 · no derivation; >1 survives only on the HDR path with no LUT
# drop shadow — the same soft_box() 9-slice as the glows
shadow.color         = none                   # drop shadow cast by the fixture sheet · 7,8 · colour or none · none (0.0) = no shadow quad; default ships shadowless (8)
shadow.radius        = 0u                     # blur radius of the drop shadow · 7,8 · len (u), 0u = off · no derivation; cockpit ran 3.9u..6.4u up the ladder (8)
shadow.dx            = 0u                     # horizontal offset of the drop shadow · 7,8 · len (u), may be negative · no derivation
shadow.dy            = 0u                     # vertical offset of the drop shadow · 7,8 · len (u), may be negative · no derivation
shadow.spread        = 0u                     # outward dilation of the shadow rect before blurring · 7,8 · len (u) · no derivation
# reflection — mirrors the MATERIAL, never the content; 12 verts. legal on this level (board, panel, focused, fixture only)
reflect.height       = 0u                     # how far the mirrored smear reaches below the rect; a board's reflection suppresses its panels' · 8 · len (u), 0u = off · no derivation; legal on this level (board, panel, focused, fixture only)
reflect.alpha        = 0.0                    # opacity of the mirrored smear where it meets the rect · 8 · frac 0..1 · no derivation; ignored while reflect.height = 0u
reflect.fade         = 2.0                    # exponent of the reflection's alpha ramp toward 0 · 8 · f, > 0 · no derivation; 2.0 is the quadratic falloff image 8's desk shows

# =========================================================================
# backdrop — THE LAYER BEHIND EVERYTHING (5.15). The central family-B
# observation, made expressible: images 7, 8 and 10 prove that THE
# BACKGROUND IS NOT THE THEME'S. The theme supplies glass, edges, glow and
# text; a wallpaper, a camera or a compositor supplies what shows through.
# So `backdrop` is a SOURCE, and every theme must be able to say "not mine".
#
# `passthrough` needs composite_alpha = PRE_MULTIPLIED and an alpha-capable
# surface; the swapchain is hard-coded OPAQUE, so passthrough RESOLVES TO
# `solid` TODAY with a load warning. It is written down here so nobody ships
# a theme that silently differs from what its author saw.
# =========================================================================

[backdrop]
source               = solid                  # where the pixels behind the board come from · 7,8,10 · plate | image | solid | passthrough · no derivation; default is flat and cheap (8). passthrough -> solid + warning
solid                = @surface.base          # the flat colour used when source = solid · 1-6 · colour · @surface.base — the screen background traces and the vignette live on (5.5)
image                = ""                     # wallpaper file, relative to the theme directory or absolute · 7,8,10 · text (quoted; the bytes ARE the value) · "" = no image; only read when source = image
fit                  = cover                  # how the wallpaper is fitted to the screen rect · 7,8,10 · cover | contain | stretch | centre · no derivation; cover never letterboxes
treat.dim            = 0.0                    # darkening of the backdrop toward black, applied at bake · 10 · frac 0..1 · 0.0 = untouched; baked once, costs nothing per frame
treat.saturation     = 1.0                    # chroma multiplier of the backdrop, applied at bake · 10 · f, 0..2 · 1.0 = untouched; 0 gives a greyscale wallpaper
treat.blur           = 0u                     # CPU blur of the backdrop at bake — INDEPENDENT of glass · 7,10 · len (u), 0u = off · 0u = untouched; this is a baked picture, not an offscreen pass
treat.tint           = none                   # colour washed over the backdrop at bake · 10 · colour or none · none = no wash; use it to pull a photo toward the accent hue
plate.layers         = []                     # order of the baked decoration layers on the backdrop plate · 1,4,9 · list of layer names; source = plate only · [] = the engine's stated order (traces, grid, starfield, vignette)

# =========================================================================
# decor — THE OPTIONAL DECORATION (5.15, DECISION M10). All static
# decoration is CPU-baked ONCE into two screen-sized RGBA plates:
#   backdrop plate — z 0, before everything, INSIDE the glass snapshot
#   overlay  plate — z 70, after everything
# Cost is 2 quads = 12 verts per frame for arbitrarily complex decoration;
# the price is 33 MB at 1440p / 66 MB at 4K, because the one shared sampler
# is LINEAR / CLAMP_TO_EDGE with mip_levels = 1 and TILING IS IMPOSSIBLE.
#
# Ribbons are the ONLY animated decoration and the only per-frame geometry.
#
# Opt-out at three levels: per layer (`enabled = false`, and that IS the
# value here, so a theme that says nothing gets nothing), per theme
# (`decor.enabled = false`), per user (`performance.decor`).
# =========================================================================

[decor]
enabled              = false                  # master switch; false suppresses every layer below AND both plates · 1,4,9 · bool · no derivation; default renders nothing decorative (8)

# ---------------------------------------------------------------- traces
# The PCB traces on the dark field behind the panels. Backdrop plate.
[decor.traces]
enabled              = false                  # draw baked PCB traces on the backdrop plate · 1,4,9 · bool · no derivation; aurora and crimson turn this on
cell                 = 6.7u                   # grid cell the trace walk steps along · 1,4,9 · len (u) · no derivation; ~36px @1440p, the pitch the images show
density              = 0.18                   # fraction of cells that actually carry a trace · 1,4,9 · frac 0..1 · no derivation; sparse enough to read as texture, not as pattern
width                = @stroke.hair           # trace line width · 1,4,9 · str (stroke ladder) · @stroke.hair = 1 device px at 1080p and 1440p (5.4)
color                = @accent.primary        # trace colour — image 4's traces are red because its accent is · 1,4,9 · colour · @accent.primary, so traces re-skin with the palette (image 4)
alpha                = 0.10                   # trace opacity over the backdrop · 1,4,9 · frac 0..1 · no derivation; barely there is the point
via_radius           = 0.28u                  # radius of the dot drawn where traces meet · 1,4,9 · len (u) · no derivation; ~1.5px @1440p
via_alpha            = 0.18                   # opacity of the via dots; brighter than the trace itself · 1,4,9 · frac 0..1 · no derivation
seed                 = 0                      # RNG seed of the trace walk; a theme pins its own pattern · 1,4,9 · n · 0 = derived from the theme name, so two themes differ
run_min              = 3                      # shortest run of one trace, in cells · 1,4,9 · n, 1 .. 64 · a run's length is drawn between this and run_max; short runs read as stitching, long ones as bus lines
run_max              = 14                     # longest run of one trace, in cells · 1,4,9 · n, 1 .. 64 · run_min = run_max pins every trace to one length
turn_chance          = 0.36                   # chance that one step of the walk bends 45 degrees · 1,4,9 · frac 0..1 · the bend density of the pattern; 0 draws straight runs, and a U-turn is never possible because the walk turns by one eighth at a time
turn_bias            = 0.50                   # of the bends that happen, the share that goes clockwise · 1,4,9 · frac 0..1 · 0.5 is even-handed, which is the pattern as drawn; a bias makes the walk spiral

# ---------------------------------------------------------------- grid
# The faint measuring grid of image 9's instrument deck. Backdrop plate.
[decor.grid]
enabled              = false                  # draw a baked measuring grid on the backdrop plate · 9 · bool · no derivation; the instrument theme turns this on
spacing              = 4.4u                   # distance between minor grid lines · 9 · len (u) · no derivation; ~24px @1440p
width                = @stroke.hair           # grid line width · 9 · str (stroke ladder) · @stroke.hair = 1 device px at 1080p and 1440p (5.4)
color                = @text.primary          # grid line colour; minor and major share it, only the alphas differ · 9 · colour · @text.primary, so the grid is ruled in the theme's own ink (r1's table omits this token — adopted, see notes)
alpha                = 0.05                   # minor grid line opacity · 9 · frac 0..1 · no derivation; a hint of a grid, not a graph
major_every          = 4                      # every Nth line is drawn as a major line · 9 · n, >= 2 · no derivation; 4 minor cells per major cell
major_alpha          = 0.09                   # major grid line opacity · 9 · frac 0..1 · no derivation; roughly twice the minor lines

# ---------------------------------------------------------------- starfield
# Image 6's calm blue console shows stars and orbital paths instead of
# traces: "more empty space reading as depth". Backdrop plate.
[decor.starfield]
enabled              = false                  # draw a baked starfield on the backdrop plate · 6 · bool · no derivation; the azure theme turns this on
count                = 400                    # how many stars are baked into the plate · 6 · n · no derivation; baked once, so the count is free per frame
size_min             = 0.14u                  # smallest star diameter · 6 · len (u) · no derivation; below a device pixel it becomes alpha alone
size_max             = 0.28u                  # largest star diameter · 6 · len (u) · no derivation; the near stars of image 6
alpha_min            = 0.20                   # dimmest star opacity · 6 · frac 0..1 · no derivation
alpha_max            = 0.80                   # brightest star opacity · 6 · frac 0..1 · no derivation
color                = @text.primary          # star colour · 6 · colour · @text.primary, so stars carry the theme's own white
seed                 = 0                      # RNG seed of the star placement · 6 · n · 0 = derived from the theme name

# ---------------------------------------------------------------- vignette
# Image 4's crimson alert console has a heavy vignette; image 6 has none.
# It may be baked into either plate: behind the panels or over them.
[decor.vignette]
enabled              = false                  # draw a baked vignette · 4 heavy, 6 none · bool · no derivation; crimson and lockdown turn this on
layer                = overlay                # which plate the vignette is baked into · 4 · backdrop | overlay · no derivation; overlay darkens the panels too, backdrop only the field
strength             = 0.55                   # vignette alpha at the corners · 4 · frac 0..1 (55% is the same value) · no derivation; the value image 4's corners measure
radius               = 0.75                   # fraction of the half-diagonal where the darkening starts · 4 · frac 0..1 · no derivation; inside this the screen is untouched
color                = @palette.black         # what the vignette darkens toward · 4 · colour · @palette.black — the theme's own black, not #000
shape                = cos2                   # falloff curve from radius to the corner · 4 · cos2 | linear | quad · no derivation; cos2 is the photographic falloff

# ---------------------------------------------------------------- scanlines
# CRT scanlines. Overlay plate, so they cross panels and content alike.
[decor.scanlines]
enabled              = false                  # draw baked scanlines on the overlay plate · - · bool · no derivation; the master ships it off
period               = 0.42u                  # distance from one dark band to the next · - · len (u) · no derivation; ~2.3px @1080p
duty                 = 0.34                   # fraction of the period that is dark · - · frac 0..1 · no derivation; a thin dark band, a wide gap
alpha                = 0.05                   # scanline opacity · - · frac 0..1 · no derivation; texture, not a filter
color                = @palette.black         # scanline colour · - · colour · @palette.black — the theme's own black
drift                = 0.0                    # vertical crawl of the scanline pattern · - · f, u/s; cyclic · 0.0 = still. QUANTISED TO WHOLE TEXELS per frame: the step is invisible below ~0.5 texel/frame (~30 u/s @1080p) and a strobe above it

# ---------------------------------------------------------------- noise
# Film grain. Overlay plate.
[decor.noise]
enabled              = false                  # draw baked grain on the overlay plate · - · bool · no derivation; the master ships it off
alpha                = 0.02                   # grain opacity · - · frac 0..1 · no derivation; at 0.02 it kills 8-bit banding and is otherwise invisible
grain                = 0.14u                  # size of one grain cell · - · len (u) · no derivation; ~0.75px @1440p
chroma               = 0.0                    # how coloured the grain is · - · frac 0..1 · 0 = monochrome grain, 1 = independent per channel
seed                 = 0                      # RNG seed of the grain field · - · n · 0 = derived from the theme name

# ---------------------------------------------------------------- ribbons
# The flowing multi-coloured waves behind image 1's station panel and
# image 7's task panel. THE ONLY ANIMATED DECORATION and the only piece of
# decor that is real geometry every frame: segments*6 verts per ribbon,
# 5 x 64 x 6 = 1 920 verts + 325 sine evaluations PER HOST, plus one clip
# push/pop and two pipeline rebinds per host. They live at z 29: above the
# panel's glass and wash, below its content, exactly as image 7 shows.
# Hence max_hosts = 1 — image 7 shows ONE panel with waves, not twelve.
[decor.ribbons]
enabled              = false                  # draw flowing ribbon waves · 1,7,9 · bool · no derivation; aurora and cockpit turn this on
count                = 5                      # how many ribbons in one host · 1,7,9 · n · no derivation; 5 is the count image 1's station panel shows
segments             = 64                     # quads along one ribbon; the sine resolution · 1,7,9 · n · no derivation; 64 is smooth at panel width, 6 verts each
amplitude            = 0.18                   # wave height as a fraction of the host rect's HEIGHT · 1,7,9 · frac 0..1 · no derivation
wavelength           = 0.55                   # wave length as a fraction of the host rect's WIDTH · 1,7,9 · frac 0..1 · no derivation; just under two full waves across a panel
speed                = 0.06                   # how fast the waves travel · 1,7,9 · f, cycles per second; cyclic · no derivation; slow enough to read as ambience
phase_step           = 0.37                   # phase offset between one ribbon and the next · 1,7,9 · f, cycles · no derivation; deliberately not 1/count, so they never re-align
thickness            = 0.35u                  # ribbon band thickness · 1,7,9 · len (u) · no derivation; ~1.9px @1440p
gradient             = @grad.spectrum         # hue travelled along the ribbon: magenta -> violet -> cyan -> green · 1,7 · @grad.<name>, 2..8 stops · @grad.spectrum — the reserved name the original shipped themes used (5.14)
alpha                = 0.55                   # ribbon opacity, before the taper to 0 at both ends · 1,7,9 · frac 0..1 · no derivation; alpha is a vertex channel, so the taper is free
host                 = panel                  # what the ribbons are drawn inside · 1,7,9 · panel | board; cyclic · no derivation; image 7 puts them inside one panel
max_hosts            = 1                      # how many hosts actually get ribbons · 7 · n; 0 = unlimited · no derivation; 26 panels would cost 49 920 verts and 26 scissor changes per frame. --check-theme prints the arithmetic
host_pick            = focused_else_largest   # which panels win the max_hosts slots · 7 · focused_else_largest | largest | first · no derivation; image 7's ribbons are on the focused panel

# ---------------------------------------------------------------- dump
# Image 9's hexadecimal margins: "BAZA DANYCH" and "STATUS", pure
# instrument decoration filling otherwise dead margin. Its appearance
# (alphabet, columns, colour) lives in ornament.dump.* (5.20).
[decor.dump]
enabled              = false                  # draw the instrument hex/coordinate dumps in the margins · 9 · bool · no derivation; the instrument theme turns this on

# =========================================================================
# performance — THE USER'S CEILING OVER THE THEME (5.15, 9.3). Not a theme
# token in spirit: the user sits over the theme, and the direction is
# always toward less work, never more. It is declared here because 5.15's
# table declares it, and an undeclared key is one nobody can discover.
# =========================================================================

[performance]
decor                = all                    # user ceiling on decoration · 1,4,9 · none (no plates at all) | static (plates but no ribbons) | all · no derivation; the resolver defaults this to `static` above 2560x1440 so the 4K path never re-uploads a plate mid-resize


# ============================================================ 40-type

# =========================================================================
# 5.16 - 5.20   TYPOGRAPHY, NUMERALS, SHAPE, ICON, ORNAMENT
#
# Comment format is a lint, not a style suggestion (5.0b). Every key below
# carries exactly one comment of the form
#     <what it draws> · <reference image> · <unit / legal range> · <derivation>
# and a key with a missing field fails `cargo test theme_default_is_documented`.
# `-` in the image field means the token is traceable to no single image.
# =========================================================================

# =========================================================================
# face - eight font slots. The first two keep their engine ids so no plugin
# and no CellC.font value changes meaning:
#   FACE_UI = 0  FACE_MONO = 1  FACE_UI_MEDIUM = 2  FACE_UI_BOLD = 3
#   FACE_DISPLAY = 4  FACE_MONO_BOLD = 5  FACE_ICON = 6  FACE_RESERVED = 7
# Resolution when a family is missing is deterministic and runs once at load
# (5.16): requested weight -> Regular (+ synthetic bold if >=600) -> fallback
# chain (cycles broken at depth 8) -> FACE_UI (FACE_MONO for mono*) -> if
# FACE_MONO itself is unresolvable the LOAD FAILS and the previous theme stays
# live. Every substitution warns; silent substitution is forbidden.
# =========================================================================

[face.ui]
family                = ["Rajdhani", "Saira", "Exo 2", "United Sans"]
                                              # ordered candidate families for FACE_UI = 0 · 1-10 · list of text · matched by find_font/load_variant_for; first hit wins
weight                = 400                   # requested weight for the ui slot · 1-10 · n, 100..900 · maps to the filename word: 300 Light 400 Regular 500 Medium 600 SemiBold 700 Bold
file                  = ""                    # theme-shipped binary font for this slot · - · text, path relative to the theme directory · empty = use the system font dirs; the ONLY path allowed to escape them
fallback              = mono                  # next slot tried when every family above fails · 1-10 · enum: ui | mono | ui_medium | ui_bold | display | mono_bold | icon | reserved | builtin | none · no further UI family exists; step 5 aliases FACE_UI to FACE_MONO
synthetic_bold        = 0.028em               # x-offset of the second pass that fakes weight · - · em, 0.0em .. 0.10em · auto-enabled when a >=600 request fell back to Regular (5.16)
codepoints            = ""                    # name = U+XXXX map; meaningful ONLY on face.icon · - · text, path relative to the theme directory · empty on every non-icon slot
                    # TODO(default): chosen here, spec silent. 5.16 counts 8 faces x 6
                    # tokens = 48 but lists `codepoints` once, under face.icon. Declaring
                    # it on all eight is what makes the arithmetic true; a non-icon slot
                    # ignores it. Lead: drop the seven empties and restate the count as 41
                    # if you prefer the honest shape.

[face.mono]
family                = ["JetBrains Mono", "Fira Mono"]
                                              # ordered candidate families for FACE_MONO = 1 · 1, 9 · list of text · matched by find_font/load_variant_for; first hit wins
weight                = 400                   # requested weight for the mono slot · 1, 9 · n, 100..900 · maps to the filename word: 300 Light 400 Regular 500 Medium 600 SemiBold 700 Bold
file                  = ""                    # theme-shipped binary font for this slot · - · text, path relative to the theme directory · empty = use the system font dirs; the ONLY path allowed to escape them
fallback              = none                  # next slot tried when every family above fails · 1, 9 · enum: ui | mono | ui_medium | ui_bold | display | mono_bold | icon | reserved | builtin | none · end of the chain: an unresolvable FACE_MONO fails the load (5.16)
synthetic_bold        = 0.028em               # x-offset of the second pass that fakes weight · - · em, 0.0em .. 0.10em · auto-enabled when a >=600 request fell back to Regular (5.16)
codepoints            = ""                    # name = U+XXXX map; meaningful ONLY on face.icon · - · text, path relative to the theme directory · empty on every non-icon slot

[face.ui_medium]
family                = ["Rajdhani", "Saira", "Exo 2", "United Sans"]
                                              # ordered candidate families for FACE_UI_MEDIUM = 2 · 1-10 · list of text · matched by find_font/load_variant_for; first hit wins
weight                = 500                   # requested weight for the ui_medium slot · 1-10 · n, 100..900 · maps to the filename word: 300 Light 400 Regular 500 Medium 600 SemiBold 700 Bold
file                  = ""                    # theme-shipped binary font for this slot · - · text, path relative to the theme directory · empty = use the system font dirs; the ONLY path allowed to escape them
fallback              = ui                    # next slot tried when every family above fails · 1-10 · enum: ui | mono | ui_medium | ui_bold | display | mono_bold | icon | reserved | builtin | none · same families one weight down
synthetic_bold        = 0.028em               # x-offset of the second pass that fakes weight · - · em, 0.0em .. 0.10em · auto-enabled when a >=600 request fell back to Regular (5.16)
codepoints            = ""                    # name = U+XXXX map; meaningful ONLY on face.icon · - · text, path relative to the theme directory · empty on every non-icon slot

[face.ui_bold]
family                = ["Rajdhani", "Saira", "Exo 2", "United Sans"]
                                              # ordered candidate families for FACE_UI_BOLD = 3 · - · list of text · matched by find_font/load_variant_for; first hit wins
weight                = 700                   # requested weight for the ui_bold slot · - · n, 100..900 · maps to the filename word: 300 Light 400 Regular 500 Medium 600 SemiBold 700 Bold
file                  = ""                    # theme-shipped binary font for this slot · - · text, path relative to the theme directory · empty = use the system font dirs; the ONLY path allowed to escape them
fallback              = ui_medium             # next slot tried when every family above fails · - · enum: ui | mono | ui_medium | ui_bold | display | mono_bold | icon | reserved | builtin | none · same families one weight down
synthetic_bold        = 0.028em               # x-offset of the second pass that fakes weight · - · em, 0.0em .. 0.10em · auto-enabled when a >=600 request fell back to Regular (5.16)
codepoints            = ""                    # name = U+XXXX map; meaningful ONLY on face.icon · - · text, path relative to the theme directory · empty on every non-icon slot

[face.display]
family                = ["Orbitron"]          # ordered candidate families for FACE_DISPLAY = 4 · 1, 9 · list of text · matched by find_font/load_variant_for; first hit wins
weight                = 600                   # requested weight for the display slot · 1, 9 · n, 100..900 · maps to the filename word: 300 Light 400 Regular 500 Medium 600 SemiBold 700 Bold
file                  = ""                    # theme-shipped binary font for this slot · - · text, path relative to the theme directory · empty = use the system font dirs; the ONLY path allowed to escape them
fallback              = ui_bold               # next slot tried when every family above fails · 1, 9 · enum: ui | mono | ui_medium | ui_bold | display | mono_bold | icon | reserved | builtin | none · a display face is optional; the UI bold weight stands in
synthetic_bold        = 0.028em               # x-offset of the second pass that fakes weight · - · em, 0.0em .. 0.10em · auto-enabled when a >=600 request fell back to Regular (5.16)
codepoints            = ""                    # name = U+XXXX map; meaningful ONLY on face.icon · - · text, path relative to the theme directory · empty on every non-icon slot

[face.mono_bold]
family                = ["JetBrains Mono", "Fira Mono"]
                                              # ordered candidate families for FACE_MONO_BOLD = 5 · 1 · list of text · matched by find_font/load_variant_for; first hit wins
weight                = 700                   # requested weight for the mono_bold slot · 1 · n, 100..900 · maps to the filename word: 300 Light 400 Regular 500 Medium 600 SemiBold 700 Bold
file                  = ""                    # theme-shipped binary font for this slot · - · text, path relative to the theme directory · empty = use the system font dirs; the ONLY path allowed to escape them
fallback              = mono                  # next slot tried when every family above fails · 1 · enum: ui | mono | ui_medium | ui_bold | display | mono_bold | icon | reserved | builtin | none · same families at Regular, synthetic bold applied
synthetic_bold        = 0.028em               # x-offset of the second pass that fakes weight · - · em, 0.0em .. 0.10em · auto-enabled when a >=600 request fell back to Regular (5.16)
codepoints            = ""                    # name = U+XXXX map; meaningful ONLY on face.icon · - · text, path relative to the theme directory · empty on every non-icon slot

[face.icon]
family                = []                    # ordered candidate families for FACE_ICON = 6 · 1, 8, 9 · list of text · matched by find_font/load_variant_for; first hit wins
weight                = 400                   # requested weight for the icon slot · 1, 8, 9 · n, 100..900 · maps to the filename word: 300 Light 400 Regular 500 Medium 600 SemiBold 700 Bold
file                  = ""                    # theme-shipped binary font for this slot · - · text, path relative to the theme directory · empty = use the system font dirs; the ONLY path allowed to escape them
fallback              = builtin               # next slot tried when every family above fails · 1, 8, 9 · enum: ui | mono | ui_medium | ui_bold | display | mono_bold | icon | reserved | builtin | none · no family: the compiled-in polyline set draws all 40 names
synthetic_bold        = 0.028em               # x-offset of the second pass that fakes weight · - · em, 0.0em .. 0.10em · auto-enabled when a >=600 request fell back to Regular (5.16)
codepoints            = "icons/icons.map"     # name = U+XXXX map consulted once at load · 1, 8, 9 · text, path relative to the theme directory · no derivation; unmapped names fall back to the built-in vector set

[face.reserved]
family                = []                    # ordered candidate families for FACE_RESERVED = 7 · - · list of text · matched by find_font/load_variant_for; first hit wins
weight                = 400                   # requested weight for the reserved slot · - · n, 100..900 · maps to the filename word: 300 Light 400 Regular 500 Medium 600 SemiBold 700 Bold
file                  = ""                    # theme-shipped binary font for this slot · - · text, path relative to the theme directory · empty = use the system font dirs; the ONLY path allowed to escape them
fallback              = ui                    # next slot tried when every family above fails · - · enum: ui | mono | ui_medium | ui_bold | display | mono_bold | icon | reserved | builtin | none · unused in default; aliases to FACE_UI
synthetic_bold        = 0.028em               # x-offset of the second pass that fakes weight · - · em, 0.0em .. 0.10em · auto-enabled when a >=600 request fell back to Regular (5.16)
codepoints            = ""                    # name = U+XXXX map; meaningful ONLY on face.icon · - · text, path relative to the theme directory · empty on every non-icon slot

# =========================================================================
# type - 24 roles (20 named, 4 spare). ROLE_COUNT = 24, an append-only u32
# enum indexing [TypeRole; 24]. Sizes are authored in u so type and space
# scale together; the conversion from the old unit is size_u = size_vh x 2.6
# (2 for vh->u times UI_FONT_BASE 1.3 - the multiplier is folded into every
# size value below, NOT carried as a token; the live global type knob is
# metric.density_type), i.e. type.body = 2.47u is today's font_px(1.0).
# 
# Every role carries the SAME twelve tokens - face, size, min_px, max_px,
# tracking, case, smallcaps_ratio, leading, tabular, fg, alpha,
# synthetic_bold - because case, tracking, smallcaps_ratio, synthetic_bold
# and tabular are implemented INSIDE FontSystem::text/measure and are
# therefore reachable only by naming a ROLE (5.16). A caller that folds case
# on its own side allocates a String per label per frame behind an ABI whose
# stated rule is zero per-draw allocation.
#
# THERE IS NO FALLBACK ROLE, AND THIS FILE WILL NEVER DECLARE ONE. Some fifty
# `*_role` keys below bind a drawn thing to one of these roles, and every one
# of them is declared here — this file is stage 1 of the cascade, so a binding
# that answers with no word means the consumer asked for a key that does not
# exist, or a theme named a role that does not exist. Both are faults to
# report, not looks to choose, and `body` is the worst possible thing to
# choose: it is a real role of a plausible size, so the mistake renders as an
# almost-right interface and ships. A binding that resolves to nothing draws
# NOTHING and says so once, which is the same answer the empty state already
# gives when its own role is missing.
#
# A `type.fallback_role` key would not fix this, it would move it: the key can
# itself be absent or misspelt, so the code would need a fallback for the
# fallback, and the chain has to end on a rule rather than on another key.
# A role is also not one value but twelve, so one word standing in for a
# missing binding hides a whole ladder — face, case, tracking, leading —
# behind a name nobody typed.
# =========================================================================

[type]
min_px                        = 8px           # absolute floor under every role's resolved px · 9 · device px, 6px .. 24px · no derivation; the last defence against unreadable type
smallcaps_ratio               = 0.78          # default px multiplier for source-lowercase glyphs · 1-10 · f, 0.5 .. 1.0 · at 1.0 a smallcaps role degrades to plain upper and the second atlas size is never rasterised
snap_px                       = true          # round each role's px to a whole pixel before rasterisation · - · bool · collapses four atlas entries per visual size to one and stops 1px text jitter; the terminal is exempt
ellipsis                      = "…"           # the character appended to trimmed text · 1-10 · text · read by every trim in the toolkit (ui::ellipsis for base.rs/draw.rs/panel.rs, view::paint::trim_marker for the Surface path) and across the ABI by HostApi::theme_text, which the launcher tile and the file browser call; empty or absent trims with NO marker, since the character a cut ends on is typography. A console theme may prefer "..." or ">"

# ---------------------------------------------------------------- type.display.clock
# the big clock, 21:57:30
display.clock.face            = display       # which face slot draws the big clock, 21:57:30 · 1, 2, 9 · enum: ui | mono | ui_medium | ui_bold | display | mono_bold | icon | reserved · no derivation; 5.16's role table
display.clock.size            = 8.32u         # type size for the big clock, 21:57:30 · 1, 2, 9 · u · 45 px at 1080p, 60 px at 1440p; size_u = size_vh x 2.6
display.clock.min_px          = @type.min_px  # px floor for this role · 1, 2, 9 · device px · the global floor
display.clock.max_px          = 0px           # px ceiling for this role · 1, 2, 9 · device px, 0px = uncapped · uncapped
display.clock.tracking        = 0.020em       # letter spacing added to every advance · 1, 2, 9 · em, -0.05em .. 0.30em · no derivation; 5.16's role table
display.clock.case            = none          # case transform applied inside FontSystem::text · 1, 2, 9 · enum: none | upper | lower | smallcaps · no derivation; 5.16's role table
display.clock.smallcaps_ratio = @type.smallcaps_ratio
                                              # px multiplier for glyphs that were lowercase in the source · 1, 2, 9 · f, 0.5 .. 1.0 · the global ratio; smallcaps has no OpenType path (fontdue exposes no features)
display.clock.leading         = 1.00          # line height as a multiple of the resolved px · 1, 2, 9 · f, 1.0 .. 2.0 · no derivation; 5.16's role table
display.clock.tabular         = true          # advance every figure by figure_advance and centre it in that box · 1, 2, 9 · bool · makes an all-figure string len x figure_advance wide without touching the atlas (5.17)
display.clock.fg              = @text.primary # the colour this role draws in · 1, 2, 9 · colour · may name any colour token including @data.series[n] and @term.ansi[n] (5.19)
display.clock.alpha           = 1.0           # constant alpha multiplier on fg · 1, 2, 9 · frac, 0..1 · opaque
display.clock.synthetic_bold  = auto          # per-role override of the face's fake-bold x-offset · 1, 2, 9 · em, or auto · auto = @face.<this role's face>.synthetic_bold, applied only when a >=600 request fell back to Regular

# ---------------------------------------------------------------- type.display.date
# the date under the clock, 14.11.2142
display.date.face             = ui            # which face slot draws the date under the clock, 14.11.2142 · 1 · enum: ui | mono | ui_medium | ui_bold | display | mono_bold | icon | reserved · no derivation; 5.16's role table
display.date.size             = 2.21u         # type size for the date under the clock, 14.11.2142 · 1 · u · 12 px at 1080p, 16 px at 1440p; size_u = size_vh x 2.6
display.date.min_px           = @type.min_px  # px floor for this role · 1 · device px · the global floor
display.date.max_px           = 0px           # px ceiling for this role · 1 · device px, 0px = uncapped · uncapped
display.date.tracking         = 0.160em       # letter spacing added to every advance · 1 · em, -0.05em .. 0.30em · no derivation; 5.16's role table
display.date.case             = upper         # case transform applied inside FontSystem::text · 1 · enum: none | upper | lower | smallcaps · no derivation; 5.16's role table
display.date.smallcaps_ratio  = @type.smallcaps_ratio
                                              # px multiplier for glyphs that were lowercase in the source · 1 · f, 0.5 .. 1.0 · the global ratio; smallcaps has no OpenType path (fontdue exposes no features)
display.date.leading          = 1.30          # line height as a multiple of the resolved px · 1 · f, 1.0 .. 2.0 · no derivation; 5.16's role table
display.date.tabular          = true          # advance every figure by figure_advance and centre it in that box · 1 · bool · makes an all-figure string len x figure_advance wide without touching the atlas (5.17)
display.date.fg               = @text.muted   # the colour this role draws in · 1 · colour · may name any colour token including @data.series[n] and @term.ansi[n] (5.19)
display.date.alpha            = 1.0           # constant alpha multiplier on fg · 1 · frac, 0..1 · opaque
display.date.synthetic_bold   = auto          # per-role override of the face's fake-bold x-offset · 1 · em, or auto · auto = @face.<this role's face>.synthetic_bold, applied only when a >=600 request fell back to Regular

# ---------------------------------------------------------------- type.display.hero
# the one oversized string on a screen
display.hero.face             = display       # which face slot draws the one oversized string on a screen · 7, 9 · enum: ui | mono | ui_medium | ui_bold | display | mono_bold | icon | reserved · no derivation; 5.16's role table
display.hero.size             = 16u           # type size for the one oversized string on a screen · 7, 9 · u · 86 px at 1080p, 115 px at 1440p, 160 px at 4K (unit_max_px), 64 px at the smallest window; the boot logo was 31 px — smaller than the sub-line under it
display.hero.min_px           = @type.min_px  # px floor for this role · 7, 9 · device px · the global floor
display.hero.max_px           = 0px           # px ceiling for this role · 7, 9 · device px, 0px = uncapped · uncapped
display.hero.tracking         = 0.040em       # letter spacing added to every advance · 7, 9 · em, -0.05em .. 0.30em · no derivation; 5.16's role table
display.hero.case             = upper         # case transform applied inside FontSystem::text · 7, 9 · enum: none | upper | lower | smallcaps · no derivation; 5.16's role table
display.hero.smallcaps_ratio  = @type.smallcaps_ratio
                                              # px multiplier for glyphs that were lowercase in the source · 7, 9 · f, 0.5 .. 1.0 · the global ratio; smallcaps has no OpenType path (fontdue exposes no features)
display.hero.leading          = 1.10          # line height as a multiple of the resolved px · 7, 9 · f, 1.0 .. 2.0 · no derivation; 5.16's role table
display.hero.tabular          = false         # advance every figure by figure_advance and centre it in that box · 7, 9 · bool · makes an all-figure string len x figure_advance wide without touching the atlas (5.17)
display.hero.fg               = @text.title   # the colour this role draws in · 7, 9 · colour · may name any colour token including @data.series[n] and @term.ansi[n] (5.19)
display.hero.alpha            = 1.0           # constant alpha multiplier on fg · 7, 9 · frac, 0..1 · opaque
display.hero.synthetic_bold   = auto          # per-role override of the face's fake-bold x-offset · 7, 9 · em, or auto · auto = @face.<this role's face>.synthetic_bold, applied only when a >=600 request fell back to Regular

# ---------------------------------------------------------------- type.title.window
# a window frame's title
title.window.face             = ui_medium     # which face slot draws a window frame's title · 1, 7 · enum: ui | mono | ui_medium | ui_bold | display | mono_bold | icon | reserved · no derivation; 5.16's role table
title.window.size             = 2.99u         # type size for a window frame's title · 1, 7 · u · 16 px at 1080p, 22 px at 1440p; size_u = size_vh x 2.6
title.window.min_px           = @type.min_px  # px floor for this role · 1, 7 · device px · the global floor
