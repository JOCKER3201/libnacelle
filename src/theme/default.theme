# glass — two quads; skipped entirely while rank is 0
glass.rank           = 0                      # frost rank of the focused window: 0 emits no blur() run at all · 7 · n, 0..3 (softness rank, NOT a mip index) · no derivation — raise to 1..3 for a family-B glass sheet; clamped by Gfx::glass_ranks()
