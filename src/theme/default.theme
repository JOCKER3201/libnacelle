data.min_px                   = @type.min_px  # px floor for this role · 1, 2 · device px · the global floor
data.max_px                   = 0px           # px ceiling for this role · 1, 2 · device px, 0px = uncapped · uncapped
data.tracking                 = 0.000em       # letter spacing added to every advance · 1, 2 · em, -0.05em .. 0.30em · no derivation; 5.16's role table
data.case                     = none          # case transform applied inside FontSystem::text · 1, 2 · enum: none | upper | lower | smallcaps · no derivation; 5.16's role table
data.smallcaps_ratio          = @type.smallcaps_ratio
                                              # px multiplier for glyphs that were lowercase in the source · 1, 2 · f, 0.5 .. 1.0 · the global ratio; smallcaps has no OpenType path (fontdue exposes no features)
data.leading                  = 1.25          # line height as a multiple of the resolved px · 1, 2 · f, 1.0 .. 2.0 · no derivation; 5.16's role table
data.tabular                  = true          # advance every figure by figure_advance and centre it in that box · 1, 2 · bool · makes an all-figure string len x figure_advance wide without touching the atlas (5.17)
data.fg                       = @text.secondary
                                              # the colour this role draws in · 1, 2 · colour · may name any colour token including @data.series[n] and @term.ansi[n] (5.19)
data.alpha                    = 1.0           # constant alpha multiplier on fg · 1, 2 · frac, 0..1 · opaque
data.synthetic_bold           = auto          # per-role override of the face's fake-bold x-offset · 1, 2 · em, or auto · auto = @face.<this role's face>.synthetic_bold, applied only when a >=600 request fell back to Regular

# ---------------------------------------------------------------- type.data.dump
# image 9's hexadecimal margins
# the densest thing on screen: glyphs touch at -0.020em, leading 1.05
# compresses a mono face's natural ~1.30 by 19%, and upper puts hex digits
# and labels on one cap height so the block reads as a solid texture
data.dump.face                = mono          # which face slot draws image 9's hexadecimal margins · 9 · enum: ui | mono | ui_medium | ui_bold | display | mono_bold | icon | reserved · no derivation; 5.16's role table
data.dump.size                = 1.35u         # type size for image 9's hexadecimal margins · 9 · u · 8* px at 1080p, 10 px at 1440p; size_u = size_vh x 2.6
data.dump.min_px              = 8px           # px floor for this role · 9 · device px · pinned: below this the dump stops being a texture
data.dump.max_px              = 13px          # px ceiling for this role · 9 · device px, 0px = uncapped · stops the instrument decoration becoming readable body text on a 4K panel
data.dump.tracking            = -0.020em      # letter spacing added to every advance · 9 · em, -0.05em .. 0.30em · no derivation; 5.16's role table
data.dump.case                = upper         # case transform applied inside FontSystem::text · 9 · enum: none | upper | lower | smallcaps · no derivation; 5.16's role table
data.dump.smallcaps_ratio     = @type.smallcaps_ratio
                                              # px multiplier for glyphs that were lowercase in the source · 9 · f, 0.5 .. 1.0 · the global ratio; smallcaps has no OpenType path (fontdue exposes no features)
data.dump.leading             = 1.05          # line height as a multiple of the resolved px · 9 · f, 1.0 .. 2.0 · no derivation; 5.16's role table
data.dump.tabular             = true          # advance every figure by figure_advance and centre it in that box · 9 · bool · makes an all-figure string len x figure_advance wide without touching the atlas (5.17)
data.dump.fg                  = @text.instrument
                                              # the colour this role draws in · 9 · colour · may name any colour token including @data.series[n] and @term.ansi[n] (5.19)
data.dump.alpha               = 0.45          # constant alpha multiplier on fg · 9 · frac, 0..1 · 5.16 pins 0.45: the dump is non-informational and contrast-exempt
data.dump.synthetic_bold      = auto          # per-role override of the face's fake-bold x-offset · 9 · em, or auto · auto = @face.<this role's face>.synthetic_bold, applied only when a >=600 request fell back to Regular

# ---------------------------------------------------------------- type.leader.label
# a leader line's label, DAMAGE BREACH
leader.label.face             = ui            # which face slot draws a leader line's label, DAMAGE BREACH · 1 · enum: ui | mono | ui_medium | ui_bold | display | mono_bold | icon | reserved · no derivation; 5.16's role table
leader.label.size             = 1.82u         # type size for a leader line's label, DAMAGE BREACH · 1 · u · 10 px at 1080p, 13 px at 1440p; size_u = size_vh x 2.6
leader.label.min_px           = @type.min_px  # px floor for this role · 1 · device px · the global floor
leader.label.max_px           = 0px           # px ceiling for this role · 1 · device px, 0px = uncapped · uncapped
leader.label.tracking         = 0.150em       # letter spacing added to every advance · 1 · em, -0.05em .. 0.30em · no derivation; 5.16's role table
leader.label.case             = upper         # case transform applied inside FontSystem::text · 1 · enum: none | upper | lower | smallcaps · no derivation; 5.16's role table
leader.label.smallcaps_ratio  = @type.smallcaps_ratio
                                              # px multiplier for glyphs that were lowercase in the source · 1 · f, 0.5 .. 1.0 · the global ratio; smallcaps has no OpenType path (fontdue exposes no features)
leader.label.leading          = 1.20          # line height as a multiple of the resolved px · 1 · f, 1.0 .. 2.0 · no derivation; 5.16's role table
leader.label.tabular          = false         # advance every figure by figure_advance and centre it in that box · 1 · bool · makes an all-figure string len x figure_advance wide without touching the atlas (5.17)
leader.label.fg               = @text.muted   # the colour this role draws in · 1 · colour · may name any colour token including @data.series[n] and @term.ansi[n] (5.19)
leader.label.alpha            = 1.0           # constant alpha multiplier on fg · 1 · frac, 0..1 · opaque
leader.label.synthetic_bold   = auto          # per-role override of the face's fake-bold x-offset · 1 · em, or auto · auto = @face.<this role's face>.synthetic_bold, applied only when a >=600 request fell back to Regular

# ---------------------------------------------------------------- type.terminal
# terminal cells
terminal.face                 = mono          # which face slot draws terminal cells · 1 · enum: ui | mono | ui_medium | ui_bold | display | mono_bold | icon | reserved · no derivation; 5.16's role table
terminal.size                 = 2.9u          # type size for terminal cells · 1 · u · 15.7 px at 1080p, 20.9 px at 1440p; size_u = size_vh x 2.6
terminal.min_px               = @type.min_px  # px floor for this role · 1 · device px · the global floor
terminal.max_px               = 0px           # px ceiling for this role · 1 · device px, 0px = uncapped · uncapped
terminal.tracking             = 0em           # letter spacing added to every advance · 1 · em, -0.05em .. 0.30em · HARD-PINNED to 0 and not themeable: tracking desynchronises the cell grid from the PTY (5.11)
terminal.case                 = none          # case transform applied inside FontSystem::text · 1 · enum: none | upper | lower | smallcaps · HARD-PINNED to none and not themeable: the terminal draws bytes, not typography
terminal.smallcaps_ratio      = @type.smallcaps_ratio
                                              # px multiplier for glyphs that were lowercase in the source · 1 · f, 0.5 .. 1.0 · the global ratio; smallcaps has no OpenType path (fontdue exposes no features)
terminal.leading              = auto          # line height as a multiple of the resolved px · 1 · auto · taken from the font's own metrics so the cell grid matches the PTY
terminal.tabular              = false         # advance every figure by figure_advance and centre it in that box · 1 · bool · makes an all-figure string len x figure_advance wide without touching the atlas (5.17)
terminal.fg                   = @term.fg      # the colour this role draws in · 1 · colour · may name any colour token including @data.series[n] and @term.ansi[n] (5.19)
terminal.alpha                = 1.0           # constant alpha multiplier on fg · 1 · frac, 0..1 · opaque
terminal.synthetic_bold       = auto          # per-role override of the face's fake-bold x-offset · 1 · em, or auto · auto = @face.<this role's face>.synthetic_bold, applied only when a >=600 request fell back to Regular

# ---------------------------------------------------------------- type.spare0
# reserved role slot 0
spare0.face                   = ui            # which face slot draws reserved role slot 0 · - · enum: ui | mono | ui_medium | ui_bold | display | mono_bold | icon | reserved · no derivation; 5.16's role table
spare0.size                   = 3.5u          # type size for reserved role slot 0 · - · u · 19 px at 1080p, 25 px at 1440p; the boot sub-line, at 0.22 of the logo above it
spare0.min_px                 = @type.min_px  # px floor for this role · - · device px · the global floor
spare0.max_px                 = 0px           # px ceiling for this role · - · device px, 0px = uncapped · uncapped
spare0.tracking               = 0.200em       # letter spacing added to every advance · - · em, -0.05em .. 0.30em · the width `caption` gave the boot sub-line before it moved here
spare0.case                   = none          # case transform applied inside FontSystem::text · - · enum: none | upper | lower | smallcaps · no derivation; 5.16's role table
spare0.smallcaps_ratio        = @type.smallcaps_ratio
                                              # px multiplier for glyphs that were lowercase in the source · - · f, 0.5 .. 1.0 · the global ratio; smallcaps has no OpenType path (fontdue exposes no features)
spare0.leading                = 1.35          # line height as a multiple of the resolved px · - · f, 1.0 .. 2.0 · `caption`'s, carried across with the sub-line
spare0.tabular                = false         # advance every figure by figure_advance and centre it in that box · - · bool · makes an all-figure string len x figure_advance wide without touching the atlas (5.17)
spare0.fg                     = @text.muted   # the colour this role draws in · - · colour · subordinate to the logo's @text.title above it
spare0.alpha                  = 1.0           # constant alpha multiplier on fg · - · frac, 0..1 · opaque
spare0.synthetic_bold         = auto          # per-role override of the face's fake-bold x-offset · - · em, or auto · auto = @face.<this role's face>.synthetic_bold, applied only when a >=600 request fell back to Regular

# ---------------------------------------------------------------- type.spare1
# reserved role slot 1
spare1.face                   = ui            # which face slot draws reserved role slot 1 · - · enum: ui | mono | ui_medium | ui_bold | display | mono_bold | icon | reserved · no derivation; 5.16's role table
spare1.size                   = 2.47u         # type size for reserved role slot 1 · - · u · 13 px at 1080p, 18 px at 1440p; size_u = size_vh x 2.6
spare1.min_px                 = @type.min_px  # px floor for this role · - · device px · the global floor
spare1.max_px                 = 0px           # px ceiling for this role · - · device px, 0px = uncapped · uncapped
spare1.tracking               = 0.020em       # letter spacing added to every advance · - · em, -0.05em .. 0.30em · no derivation; 5.16's role table
spare1.case                   = none          # case transform applied inside FontSystem::text · - · enum: none | upper | lower | smallcaps · no derivation; 5.16's role table
spare1.smallcaps_ratio        = @type.smallcaps_ratio
                                              # px multiplier for glyphs that were lowercase in the source · - · f, 0.5 .. 1.0 · the global ratio; smallcaps has no OpenType path (fontdue exposes no features)
spare1.leading                = 1.45          # line height as a multiple of the resolved px · - · f, 1.0 .. 2.0 · no derivation; 5.16's role table
spare1.tabular                = false         # advance every figure by figure_advance and centre it in that box · - · bool · makes an all-figure string len x figure_advance wide without touching the atlas (5.17)
spare1.fg                     = @text.primary # the colour this role draws in · - · colour · may name any colour token including @data.series[n] and @term.ansi[n] (5.19)
spare1.alpha                  = 1.0           # constant alpha multiplier on fg · - · frac, 0..1 · opaque
spare1.synthetic_bold         = auto          # per-role override of the face's fake-bold x-offset · - · em, or auto · auto = @face.<this role's face>.synthetic_bold, applied only when a >=600 request fell back to Regular

# ---------------------------------------------------------------- type.spare2
# reserved role slot 2
spare2.face                   = ui            # which face slot draws reserved role slot 2 · - · enum: ui | mono | ui_medium | ui_bold | display | mono_bold | icon | reserved · no derivation; 5.16's role table
spare2.size                   = 2.47u         # type size for reserved role slot 2 · - · u · 13 px at 1080p, 18 px at 1440p; size_u = size_vh x 2.6
spare2.min_px                 = @type.min_px  # px floor for this role · - · device px · the global floor
spare2.max_px                 = 0px           # px ceiling for this role · - · device px, 0px = uncapped · uncapped
spare2.tracking               = 0.020em       # letter spacing added to every advance · - · em, -0.05em .. 0.30em · no derivation; 5.16's role table
spare2.case                   = none          # case transform applied inside FontSystem::text · - · enum: none | upper | lower | smallcaps · no derivation; 5.16's role table
spare2.smallcaps_ratio        = @type.smallcaps_ratio
                                              # px multiplier for glyphs that were lowercase in the source · - · f, 0.5 .. 1.0 · the global ratio; smallcaps has no OpenType path (fontdue exposes no features)
spare2.leading                = 1.45          # line height as a multiple of the resolved px · - · f, 1.0 .. 2.0 · no derivation; 5.16's role table
spare2.tabular                = false         # advance every figure by figure_advance and centre it in that box · - · bool · makes an all-figure string len x figure_advance wide without touching the atlas (5.17)
spare2.fg                     = @text.primary # the colour this role draws in · - · colour · may name any colour token including @data.series[n] and @term.ansi[n] (5.19)
spare2.alpha                  = 1.0           # constant alpha multiplier on fg · - · frac, 0..1 · opaque
spare2.synthetic_bold         = auto          # per-role override of the face's fake-bold x-offset · - · em, or auto · auto = @face.<this role's face>.synthetic_bold, applied only when a >=600 request fell back to Regular

# ---------------------------------------------------------------- type.spare3
# reserved role slot 3
spare3.face                   = ui            # which face slot draws reserved role slot 3 · - · enum: ui | mono | ui_medium | ui_bold | display | mono_bold | icon | reserved · no derivation; 5.16's role table
spare3.size                   = 2.47u         # type size for reserved role slot 3 · - · u · 13 px at 1080p, 18 px at 1440p; size_u = size_vh x 2.6
spare3.min_px                 = @type.min_px  # px floor for this role · - · device px · the global floor
spare3.max_px                 = 0px           # px ceiling for this role · - · device px, 0px = uncapped · uncapped
spare3.tracking               = 0.020em       # letter spacing added to every advance · - · em, -0.05em .. 0.30em · no derivation; 5.16's role table
spare3.case                   = none          # case transform applied inside FontSystem::text · - · enum: none | upper | lower | smallcaps · no derivation; 5.16's role table
spare3.smallcaps_ratio        = @type.smallcaps_ratio
                                              # px multiplier for glyphs that were lowercase in the source · - · f, 0.5 .. 1.0 · the global ratio; smallcaps has no OpenType path (fontdue exposes no features)
spare3.leading                = 1.45          # line height as a multiple of the resolved px · - · f, 1.0 .. 2.0 · no derivation; 5.16's role table
spare3.tabular                = false         # advance every figure by figure_advance and centre it in that box · - · bool · makes an all-figure string len x figure_advance wide without touching the atlas (5.17)
spare3.fg                     = @text.primary # the colour this role draws in · - · colour · may name any colour token including @data.series[n] and @term.ansi[n] (5.19)
spare3.alpha                  = 1.0           # constant alpha multiplier on fg · - · frac, 0..1 · opaque
spare3.synthetic_bold         = auto          # per-role override of the face's fake-bold x-offset · - · em, or auto · auto = @face.<this role's face>.synthetic_bold, applied only when a >=600 request fell back to Regular

# TODO(default): chosen here, spec silent - four items in the block above.
#   1. The four spare roles are spelled type.spare0 .. type.spare3. 5.16 says
#      "20 named, 4 spare" and names none of them; spareN is a legal ident
#      (3.2) where a dotted spare.0 would not be.
#   2. Per-role min_px defaults to @type.min_px and max_px to 0px meaning
#      uncapped. 5.16 states the pair only for data.dump.
#   3. Per-role synthetic_bold defaults to the `auto` sentinel (-1.0, 5.0)
#      so the face's value and the face-resolution rule stay in one place.
#   4. type.terminal.leading = auto for the same reason 5.16 writes "from
#      font metrics": a cell grid derived from a theme number would drift
#      from the PTY's idea of a row.

# =========================================================================
# num - numerals and units. Tabular figures are implemented in the toolkit,
# not demanded of the font: figure_advance(face, px) is the widest advance
# among '0'..'9', ten glyph lookups once, cached beside the glyph cache. That
# is why image 1's clock stops shivering on every tick, and why the width of
# an all-figure string is len x figure_advance - computable without touching
# the atlas, which makes right-aligned numeric columns free.
# =========================================================================

[num]
tabular_set               = "0123456789"      # the characters a tabular role advances by figure_advance · 1, 9 · text · no derivation; add glyphs here to widen the set
tabular_punct             = true              # also fix the advance of . , : + - space % · 1 · bool · no derivation; without it 21:57:30 still shivers on the colon
align                     = decimal           # how a numeric column lines its rows up · 1, 9 · enum: decimal | right | left · decimal uses ui::column_numeric, which right-aligns the integer part to digits x figure_advance with no measuring
decimal_sep               = "."               # the character between integer and fraction · 1, 7 · text, one character · THE THEME DECIDES, not a locale guess - a theme must render identically on every machine
group_sep                 = " "               # the character between thousands groups · 1, 7 · text, one character (this is U+2009 thin space) · NO substitution: the character named here is the character drawn, and a face without U+2009 draws its notdef inside the number. That is the governing principle's raw look and the theme's own doing - this line used to promise "validated at load, falls back to ' ' with a warning" and nothing anywhere did either
group                     = 3                 # digits per group · 1 · n, 2 .. 4 · no derivation
group_min                 = 5                 # shortest integer that gets grouped at all · 1 · n, 3 .. 9 · 1234 is not grouped; 12 345 is
decimals                  = 2                 # decimal places a value carries · 1, 7 · n, 0 .. 6 · cpu.rhai:2's round(load1, 2); precision is typography and the rest of this block already owns it
decimals_compact          = 0                 # decimal places where room is tight: temperatures, gauge readouts · 1 · n, 0 .. 6 · cpu.rhai:6's round(temp, 0)
unit.scale                = 0.72              # the unit suffix's px as a fraction of the value's px · 1, 7 · f, 0.4 .. 1.0 · x the value's resolved px
unit.gap                  = 0.18em            # space between the number and its unit · 1, 7 · em, 0em .. 1em · no derivation
unit.text_gap             = " "               # what stands between value and unit where the two are ONE STRING · 1, 7 · text · unit.gap is a DISTANCE and a string carries none; a script's cell, a table value and a tooltip are characters only, so the same joint needs a character here. Set it empty to close the gap up everywhere at once
unit.tracking             = 0.060em           # letter spacing inside the unit suffix · 1, 7 · em · no derivation
unit.case                 = none              # case transform applied to the unit suffix · 1, 7 · enum: none | upper | lower | smallcaps · none, because a unit SYMBOL is not a label: the small i of GiB is what makes it the IEC binary prefix, and the small s of MB/s is the second. Upper-casing them writes GIB and MB/S, which name nothing. This key shipped `upper` on the strength of "TB, GBPS, PS all read as instrument units" while the whole block was dead; the moment it got a reader (2026-08-17) the byte and rate formatters started printing those two. A theme that wants shouty units still writes `upper` and gets it everywhere at once
unit.color                = @text.muted       # the unit suffix's colour · 1, 7 · colour · a step back from @text.primary so the number reads first
unit.baseline_shift       = 0.0em             # vertical offset of the unit suffix · 1, 7 · em · units sit on the baseline, NEVER superscript
unit.percent_attached     = true              # suppress unit.gap before a percent sign · 1, 7, 9 · bool · 85% with no gap; 60 / 89ps keeps its gap

# =========================================================================
# type.suffix - the parenthesised status after a value: (Zakonczone),
# (W toku, 72%), (Stabilny), (Czysta, Odnawialna). ITS COLOUR IS NOT HERE.
# A suffix is coloured by a severity index the value's PRODUCER supplies as a
# u32 (5.10, 5.17, 7.4) and the theme maps index -> colour; a keyword table
# consulted per row per frame is a string lookup on a hot path that silently
# mis-colours in any language the table does not know. These six tokens own
# the suffix's TYPOGRAPHY and nothing else.
# =========================================================================

[type.suffix]
role                      = body              # the type role the suffix word is set in · 1, 7 · role, one of the 24 in 5.16 · no derivation
brackets                  = "()"              # the opening and closing bracket characters · 1, 7 · text, exactly two characters · no derivation; "[]" and "<>" are equally legal
paren_alpha               = 0.55              # alpha of the brackets alone, not the word · 1, 7 · frac, 0..1 · the brackets read dimmer than the word - the detail that makes it look drawn rather than typed
gap                       = 0.35em            # space between the value and the opening bracket · 1, 7 · em · no derivation
case                      = none              # case transform applied to the suffix word · 1, 7 · enum: none | upper | lower | smallcaps · none, because (Zakonczone) is a word and not a label
face                      = ui_medium         # face slot for the suffix word, overriding the role's own · 1, 7 · enum: ui | mono | ui_medium | ui_bold | display | mono_bold | icon | reserved · one weight up from body so a status reads at a glance

# TODO(default): chosen here, spec silent. 5.17 spells the face value
#   "ui-medium"; a hyphen is not a legal ident (3.2) and 5.0's naming law 2
#   underscores variants, so every face id in this file is ui_medium /
#   ui_bold / mono_bold.

# =========================================================================
# shape - sixteen presets, one ring generator. chamfer_frame/chamfer_fill are
# a special case of it and survive only as thin wrappers:
#   enum CornerStyle { Square, Round, Chamfer }
#   struct Corner { style: CornerStyle, size: f32 }
#   fn ring(rect, &[Corner; 4], segments, out)
# Fill is a triangle fan from the centroid over the ring; sizes are clamped to
# min(w, h) * 0.5 inside ring(), so bad data cannot invert the shape, and the
# chamfer_fill_stays_inside_the_frame test becomes a ring test and is kept.
# 
# A corner value is [ <style>, <size> ] - two things, one token, because a
# Corner is two things. corners sets all four; corners_tl/tr/br/bl override one
# and are written as the SAME PAIR, each slot defaulting to the
# `same_as_parent` sentinel (-3.0), whose parent here is this preset's own
# `corners`. Two slots and not one, because the two halves are independent: a
# theme may chamfer one corner at the radius the rest of the preset already
# carries, or keep the style and shorten the cut, and neither is expressible
# in a token that can hold only a word or only a length. K6 gave these keys
# their first reader (view::paint::preset).
# 
# SHAPE AND ELEV DO NOT COMPETE FOR THE SAME PIXEL (5.0). Twelve presets name
# something with no elevation and shape.* is the sole owner of their fill,
# border colour and border width. The four that name an elevated container -
# panel, card, window, modal - take `same_as_parent` for those three and read
# them from elev.*. Setting one anyway is legal and useful (a card whose ring
# differs from its material) and produces a NOTE, never a silent second
# opinion. default.theme therefore sets none of them.
# =========================================================================

# ---------------------------------------------------------------- shape.panel
# the bordered panel of family A: the 1px glowing edge that is the
# signature of images 1-6
[shape.panel]
corners               = [ round, @corner.md ] # all four corners of the panel ring · 1-6 · [ style, len ] · enum: square | round | chamfer | chevron | hexagon · 8.6px at 1440p, which is the brief's "~8px at 1440p" measured off image 1
corners_tl            = [ same_as_parent, same_as_parent ]
                                              # the top-left corner alone · 1-6 · [ style, len ] · a slot left same_as_parent copies @shape.panel.corners
corners_tr            = [ same_as_parent, same_as_parent ]
                                              # the top-right corner alone · 1-6 · [ style, len ] · a slot left same_as_parent copies @shape.panel.corners
corners_br            = [ same_as_parent, same_as_parent ]
                                              # the bottom-right corner alone · 1-6 · [ style, len ] · a slot left same_as_parent copies @shape.panel.corners
corners_bl            = [ same_as_parent, same_as_parent ]
                                              # the bottom-left corner alone · 1-6 · [ style, len ] · a slot left same_as_parent copies @shape.panel.corners
border_style          = solid                 # how the ring is stroked · 1-6 · enum: solid | segmented | brackets | none · @border.edge.style; brackets draw only the corners and any preset may wear them (5.7)
border_width          = same_as_parent        # stroke weight of the ring · 1-6 · str (device px, never panel-scaled) or same_as_parent · reads elev.panel.edge.width
border_color          = same_as_parent        # colour of the ring · 1-6 · colour or same_as_parent · reads elev.panel.edge.color
border_alpha          = 1.0                   # alpha multiplier on border_color · 1-6 · frac, 0..1 · opaque
fill                  = same_as_parent        # the interior · 1-6 · colour, none, or same_as_parent · @elev.panel.fill -> @component.panel.fill -> @surface.panel
fill_alpha            = 1.0                   # alpha multiplier on fill · 1-6 · frac, 0..1 · opaque
fill_to               = @shape.panel.fill     # the far stop of the interior gradient · 1-6 · colour · == fill, so the fill is flat
fill_angle            = 90deg                 # direction of the interior gradient · 1-6 · deg, 0..360 · ignored while fill_to == fill
round_segments        = @corner.segments      # arc tessellation of a round corner · 1-6 · n, 3 .. 16 · @corner.segments = 6, a 0.4px chord error at an 8px radius: invisible, and 6 quads instead of 16
glow                  = @glow.panel_edge      # which glow class this preset's edge wears · 1-6 · @glow.<class> or none · every glow.*.enabled is false in default, so this reference costs nothing until a theme turns it on
dash                  = @border.edge.dash     # dash length along the ring · 1-6 · len · @border.edge.dash = 1.6u; used only when border_style = segmented
gap                   = @border.edge.gap      # gap length along the ring · 1-6 · len · @border.edge.gap = 0.8u; used only when border_style = segmented
phase                 = @border.edge.phase    # where the dash pattern starts on the ring · 1-6 · len · @border.edge.phase = 0u; used only when border_style = segmented
bracket_len           = @border.edge.bracket_len
                                              # length of each corner bracket · 1-6 · frac of the SHORTER SIDE of the host rect, clamped [0.8u, 4.0u] · @border.edge.bracket_len = 18%; used only when border_style = brackets
bracket_inset         = @border.edge.bracket_inset
                                              # how far the brackets sit inside the ring · 1-6 · len · @border.edge.bracket_inset = 0u; used only when border_style = brackets

# ---------------------------------------------------------------- shape.card
# family B's rounded glass card
[shape.card]
corners               = [ round, 1.8u ]       # all four corners of the card ring · 7, 8, 10 · [ style, len ] · enum: square | round | chamfer | chevron | hexagon · softer than a family-A panel; a card is held, a panel is mounted
corners_tl            = [ same_as_parent, same_as_parent ]
                                              # the top-left corner alone · 7, 8, 10 · [ style, len ] · a slot left same_as_parent copies @shape.card.corners
corners_tr            = [ same_as_parent, same_as_parent ]
                                              # the top-right corner alone · 7, 8, 10 · [ style, len ] · a slot left same_as_parent copies @shape.card.corners
corners_br            = [ same_as_parent, same_as_parent ]
                                              # the bottom-right corner alone · 7, 8, 10 · [ style, len ] · a slot left same_as_parent copies @shape.card.corners
corners_bl            = [ same_as_parent, same_as_parent ]
                                              # the bottom-left corner alone · 7, 8, 10 · [ style, len ] · a slot left same_as_parent copies @shape.card.corners
border_style          = solid                 # how the ring is stroked · 7, 8, 10 · enum: solid | segmented | brackets | none · @border.edge.style; brackets draw only the corners and any preset may wear them (5.7)
border_width          = same_as_parent        # stroke weight of the ring · 7, 8, 10 · str (device px, never panel-scaled) or same_as_parent · reads elev.panel.edge.width
border_color          = same_as_parent        # colour of the ring · 7, 8, 10 · colour or same_as_parent · reads elev.panel.edge.color
border_alpha          = 1.0                   # alpha multiplier on border_color · 7, 8, 10 · frac, 0..1 · opaque
fill                  = same_as_parent        # the interior · 7, 8, 10 · colour, none, or same_as_parent · @elev.panel.glass.wash
fill_alpha            = 1.0                   # alpha multiplier on fill · 7, 8, 10 · frac, 0..1 · opaque
fill_to               = @shape.card.fill      # the far stop of the interior gradient · 7, 8, 10 · colour · == fill, so the fill is flat
fill_angle            = 90deg                 # direction of the interior gradient · 7, 8, 10 · deg, 0..360 · ignored while fill_to == fill
round_segments        = @corner.segments      # arc tessellation of a round corner · 7, 8, 10 · n, 3 .. 16 · @corner.segments = 6, a 0.4px chord error at an 8px radius: invisible, and 6 quads instead of 16
glow                  = @glow.panel_edge      # which glow class this preset's edge wears · 7, 8, 10 · @glow.<class> or none · every glow.*.enabled is false in default, so this reference costs nothing until a theme turns it on
dash                  = @border.edge.dash     # dash length along the ring · 7, 8, 10 · len · @border.edge.dash = 1.6u; used only when border_style = segmented
gap                   = @border.edge.gap      # gap length along the ring · 7, 8, 10 · len · @border.edge.gap = 0.8u; used only when border_style = segmented
phase                 = @border.edge.phase    # where the dash pattern starts on the ring · 7, 8, 10 · len · @border.edge.phase = 0u; used only when border_style = segmented
bracket_len           = @border.edge.bracket_len
                                              # length of each corner bracket · 7, 8, 10 · frac of the SHORTER SIDE of the host rect, clamped [0.8u, 4.0u] · @border.edge.bracket_len = 18%; used only when border_style = brackets
bracket_inset         = @border.edge.bracket_inset
                                              # how far the brackets sit inside the ring · 7, 8, 10 · len · @border.edge.bracket_inset = 0u; used only when border_style = brackets

# ---------------------------------------------------------------- shape.window
# a window frame
[shape.window]
corners               = [ chamfer, @corner.lg ]
                                              # all four corners of the window ring · 1, 2, 7 · [ style, len ] · enum: square | round | chamfer | chevron | hexagon · today's winframe.rs cut = vh*1.1, now a ladder step
corners_tl            = [ same_as_parent, same_as_parent ]
                                              # the top-left corner alone · 1, 2, 7 · [ style, len ] · a slot left same_as_parent copies @shape.window.corners
corners_tr            = [ same_as_parent, same_as_parent ]
                                              # the top-right corner alone · 1, 2, 7 · [ style, len ] · a slot left same_as_parent copies @shape.window.corners
corners_br            = [ same_as_parent, same_as_parent ]
                                              # the bottom-right corner alone · 1, 2, 7 · [ style, len ] · a slot left same_as_parent copies @shape.window.corners
corners_bl            = [ same_as_parent, same_as_parent ]
                                              # the bottom-left corner alone · 1, 2, 7 · [ style, len ] · a slot left same_as_parent copies @shape.window.corners
border_style          = solid                 # how the ring is stroked · 1, 2, 7 · enum: solid | segmented | brackets | none · @border.edge.style; brackets draw only the corners and any preset may wear them (5.7)
border_width          = same_as_parent        # stroke weight of the ring · 1, 2, 7 · str (device px, never panel-scaled) or same_as_parent · reads elev.window.edge.width
border_color          = same_as_parent        # colour of the ring · 1, 2, 7 · colour or same_as_parent · reads elev.window.edge.color
border_alpha          = 1.0                   # alpha multiplier on border_color · 1, 2, 7 · frac, 0..1 · opaque
fill                  = same_as_parent        # the interior · 1, 2, 7 · colour, none, or same_as_parent · @elev.window.fill -> @surface.panel
fill_alpha            = 1.0                   # alpha multiplier on fill · 1, 2, 7 · frac, 0..1 · opaque
fill_to               = @shape.window.fill    # the far stop of the interior gradient · 1, 2, 7 · colour · == fill, so the fill is flat
fill_angle            = 90deg                 # direction of the interior gradient · 1, 2, 7 · deg, 0..360 · ignored while fill_to == fill
round_segments        = @corner.segments      # arc tessellation of a round corner · 1, 2, 7 · n, 3 .. 16 · @corner.segments = 6, a 0.4px chord error at an 8px radius: invisible, and 6 quads instead of 16
glow                  = @glow.panel_edge      # which glow class this preset's edge wears · 1, 2, 7 · @glow.<class> or none · every glow.*.enabled is false in default, so this reference costs nothing until a theme turns it on
dash                  = @border.edge.dash     # dash length along the ring · 1, 2, 7 · len · @border.edge.dash = 1.6u; used only when border_style = segmented
gap                   = @border.edge.gap      # gap length along the ring · 1, 2, 7 · len · @border.edge.gap = 0.8u; used only when border_style = segmented
phase                 = @border.edge.phase    # where the dash pattern starts on the ring · 1, 2, 7 · len · @border.edge.phase = 0u; used only when border_style = segmented
bracket_len           = @border.edge.bracket_len
                                              # length of each corner bracket · 1, 2, 7 · frac of the SHORTER SIDE of the host rect, clamped [0.8u, 4.0u] · @border.edge.bracket_len = 18%; used only when border_style = brackets
bracket_inset         = @border.edge.bracket_inset
                                              # how far the brackets sit inside the ring · 1, 2, 7 · len · @border.edge.bracket_inset = 0u; used only when border_style = brackets

# ---------------------------------------------------------------- shape.button
# a taskbar button: START, SZUKAJ, NAWIG., KADLUB
[shape.button]
corners               = [ chamfer, 0.7u ]     # all four corners of the button ring · 9 · [ style, len ] · enum: square | round | chamfer | chevron | hexagon · a small cut reads as machined rather than rounded
corners_tl            = [ same_as_parent, same_as_parent ]
                                              # the top-left corner alone · 9 · [ style, len ] · a slot left same_as_parent copies @shape.button.corners
corners_tr            = [ same_as_parent, same_as_parent ]
                                              # the top-right corner alone · 9 · [ style, len ] · a slot left same_as_parent copies @shape.button.corners
corners_br            = [ same_as_parent, same_as_parent ]
                                              # the bottom-right corner alone · 9 · [ style, len ] · a slot left same_as_parent copies @shape.button.corners
corners_bl            = [ same_as_parent, same_as_parent ]
                                              # the bottom-left corner alone · 9 · [ style, len ] · a slot left same_as_parent copies @shape.button.corners
border_style          = solid                 # how the ring is stroked · 9 · enum: solid | segmented | brackets | none · @border.edge.style; brackets draw only the corners and any preset may wear them (5.7)
border_width          = @border.edge.width    # stroke weight of the ring · 9 · str (device px, never panel-scaled) or same_as_parent · @border.edge.width -> @stroke.hair, i.e. the "solid 1x" of 5.18's table
border_color          = @border.default       # colour of the ring · 9 · colour or same_as_parent · -> @border.default -> alpha(@accent.primary, 0.78)
border_alpha          = 1.0                   # alpha multiplier on border_color · 9 · frac, 0..1 · opaque
fill                  = @component.button.fill # the interior · 9 · colour, none, or same_as_parent · @component.button.fill, the ONE dedicated button colour every button reads instead of the surface ladder it sits on
fill_alpha            = 1.0                   # alpha multiplier on fill · 9 · frac, 0..1 · opaque
fill_to               = @shape.button.fill    # the far stop of the interior gradient · 9 · colour · == fill, so the fill is flat
fill_angle            = 90deg                 # direction of the interior gradient · 9 · deg, 0..360 · ignored while fill_to == fill
round_segments        = @corner.segments      # arc tessellation of a round corner · 9 · n, 3 .. 16 · @corner.segments = 6, a 0.4px chord error at an 8px radius: invisible, and 6 quads instead of 16
glow                  = none                  # which glow class this preset's edge wears · 9 · @glow.<class> or none · no glow class fits this preset
dash                  = @border.edge.dash     # dash length along the ring · 9 · len · @border.edge.dash = 1.6u; used only when border_style = segmented
gap                   = @border.edge.gap      # gap length along the ring · 9 · len · @border.edge.gap = 0.8u; used only when border_style = segmented
phase                 = @border.edge.phase    # where the dash pattern starts on the ring · 9 · len · @border.edge.phase = 0u; used only when border_style = segmented
bracket_len           = @border.edge.bracket_len
                                              # length of each corner bracket · 9 · frac of the SHORTER SIDE of the host rect, clamped [0.8u, 4.0u] · @border.edge.bracket_len = 18%; used only when border_style = brackets
bracket_inset         = @border.edge.bracket_inset
                                              # how far the brackets sit inside the ring · 9 · len · @border.edge.bracket_inset = 0u; used only when border_style = brackets

# ---------------------------------------------------------------- shape.button_alt
# the asymmetric button variant
[shape.button_alt]
corners               = [ chamfer, 0.9u ]     # all four corners of the button_alt ring · 9 · [ style, len ] · enum: square | round | chamfer | chevron | hexagon · applied to tl and br only
corners_tl            = [ same_as_parent, same_as_parent ]
                                              # the top-left corner alone · 9 · [ style, len ] · a slot left same_as_parent copies @shape.button_alt.corners
corners_tr            = [ square, 0u ]        # the top-right corner alone · 9 · [ style, len ] · pinned square so the preset is asymmetric on purpose
corners_br            = [ same_as_parent, same_as_parent ]
                                              # the bottom-right corner alone · 9 · [ style, len ] · a slot left same_as_parent copies @shape.button_alt.corners
corners_bl            = [ square, 0u ]        # the bottom-left corner alone · 9 · [ style, len ] · pinned square so the preset is asymmetric on purpose
border_style          = solid                 # how the ring is stroked · 9 · enum: solid | segmented | brackets | none · @border.edge.style; brackets draw only the corners and any preset may wear them (5.7)
border_width          = @border.edge.width    # stroke weight of the ring · 9 · str (device px, never panel-scaled) or same_as_parent · @border.edge.width -> @stroke.hair, i.e. the "solid 1x" of 5.18's table
border_color          = @border.default       # colour of the ring · 9 · colour or same_as_parent · -> @border.default -> alpha(@accent.primary, 0.78)
border_alpha          = 1.0                   # alpha multiplier on border_color · 9 · frac, 0..1 · opaque
fill                  = @component.button.fill # the interior · 9 · colour, none, or same_as_parent · @component.button.fill, the ONE dedicated button colour every button reads instead of the surface ladder it sits on
fill_alpha            = 1.0                   # alpha multiplier on fill · 9 · frac, 0..1 · opaque
fill_to               = @shape.button_alt.fill
                                              # the far stop of the interior gradient · 9 · colour · == fill, so the fill is flat
fill_angle            = 90deg                 # direction of the interior gradient · 9 · deg, 0..360 · ignored while fill_to == fill
round_segments        = @corner.segments      # arc tessellation of a round corner · 9 · n, 3 .. 16 · @corner.segments = 6, a 0.4px chord error at an 8px radius: invisible, and 6 quads instead of 16
glow                  = none                  # which glow class this preset's edge wears · 9 · @glow.<class> or none · no glow class fits this preset
dash                  = @border.edge.dash     # dash length along the ring · 9 · len · @border.edge.dash = 1.6u; used only when border_style = segmented
gap                   = @border.edge.gap      # gap length along the ring · 9 · len · @border.edge.gap = 0.8u; used only when border_style = segmented
phase                 = @border.edge.phase    # where the dash pattern starts on the ring · 9 · len · @border.edge.phase = 0u; used only when border_style = segmented
bracket_len           = @border.edge.bracket_len
                                              # length of each corner bracket · 9 · frac of the SHORTER SIDE of the host rect, clamped [0.8u, 4.0u] · @border.edge.bracket_len = 18%; used only when border_style = brackets
bracket_inset         = @border.edge.bracket_inset
                                              # how far the brackets sit inside the ring · 9 · len · @border.edge.bracket_inset = 0u; used only when border_style = brackets

# ---------------------------------------------------------------- shape.icon_tile
# image 1's "each icon in its own bordered square"
[shape.icon_tile]
corners               = [ round, 0.7u ]       # all four corners of the icon_tile ring · 1 · [ style, len ] · enum: square | round | chamfer | chevron | hexagon · just enough radius to stop the square reading as a table cell
corners_tl            = [ same_as_parent, same_as_parent ]
                                              # the top-left corner alone · 1 · [ style, len ] · a slot left same_as_parent copies @shape.icon_tile.corners
corners_tr            = [ same_as_parent, same_as_parent ]
                                              # the top-right corner alone · 1 · [ style, len ] · a slot left same_as_parent copies @shape.icon_tile.corners
corners_br            = [ same_as_parent, same_as_parent ]
                                              # the bottom-right corner alone · 1 · [ style, len ] · a slot left same_as_parent copies @shape.icon_tile.corners
corners_bl            = [ same_as_parent, same_as_parent ]
                                              # the bottom-left corner alone · 1 · [ style, len ] · a slot left same_as_parent copies @shape.icon_tile.corners
border_style          = solid                 # how the ring is stroked · 1 · enum: solid | segmented | brackets | none · a segmented border is rejected on this preset with a warning (5.7): 13 dashes per side per icon is a quad storm
border_width          = @border.edge.width    # stroke weight of the ring · 1 · str (device px, never panel-scaled) or same_as_parent · @border.edge.width -> @stroke.hair, i.e. the "solid 1x" of 5.18's table
border_color          = @component.launcher.border
                                              # colour of the ring · 1 · colour or same_as_parent · -> @border.default -> alpha(@accent.primary, 0.78)
border_alpha          = 0.45                  # alpha multiplier on border_color · 1 · frac, 0..1 · 5.18's table: the ring reads back from the fill
fill                  = @surface.raised       # the interior · 1 · colour, none, or same_as_parent · 5.18's table
fill_alpha            = 1.0                   # alpha multiplier on fill · 1 · frac, 0..1 · opaque
fill_to               = @shape.icon_tile.fill # the far stop of the interior gradient · 1 · colour · == fill, so the fill is flat
fill_angle            = 90deg                 # direction of the interior gradient · 1 · deg, 0..360 · ignored while fill_to == fill
round_segments        = @corner.segments      # arc tessellation of a round corner · 1 · n, 3 .. 16 · @corner.segments = 6, a 0.4px chord error at an 8px radius: invisible, and 6 quads instead of 16
glow                  = @glow.icon_idle       # which glow class this preset's edge wears · 1 · @glow.<class> or none · every glow.*.enabled is false in default, so this reference costs nothing until a theme turns it on
dash                  = @border.edge.dash     # dash length along the ring · 1 · len · @border.edge.dash = 1.6u; used only when border_style = segmented
gap                   = @border.edge.gap      # gap length along the ring · 1 · len · @border.edge.gap = 0.8u; used only when border_style = segmented
phase                 = @border.edge.phase    # where the dash pattern starts on the ring · 1 · len · @border.edge.phase = 0u; used only when border_style = segmented
bracket_len           = @border.edge.bracket_len
                                              # length of each corner bracket · 1 · frac of the SHORTER SIDE of the host rect, clamped [0.8u, 4.0u] · @border.edge.bracket_len = 18%; used only when border_style = brackets
bracket_inset         = @border.edge.bracket_inset
                                              # how far the brackets sit inside the ring · 1 · len · @border.edge.bracket_inset = 0u; used only when border_style = brackets

# ---------------------------------------------------------------- shape.badge
# the CRITICAL / CONTAINED pill
# a badge WITH a severity takes fill/edge/text from sev[i] at draw time,
# indexed by the u32 its producer passed (5.26); these are the no-severity
# defaults
[shape.badge]
corners               = [ round, @corner.pill ]
                                              # all four corners of the badge ring · 1, 3, 4 · [ style, len ] · enum: square | round | chamfer | chevron | hexagon · the pill sentinel (-2.0, 5.0): radius = half the shorter side
corners_tl            = [ same_as_parent, same_as_parent ]
                                              # the top-left corner alone · 1, 3, 4 · [ style, len ] · a slot left same_as_parent copies @shape.badge.corners
corners_tr            = [ same_as_parent, same_as_parent ]
                                              # the top-right corner alone · 1, 3, 4 · [ style, len ] · a slot left same_as_parent copies @shape.badge.corners
corners_br            = [ same_as_parent, same_as_parent ]
                                              # the bottom-right corner alone · 1, 3, 4 · [ style, len ] · a slot left same_as_parent copies @shape.badge.corners
corners_bl            = [ same_as_parent, same_as_parent ]
                                              # the bottom-left corner alone · 1, 3, 4 · [ style, len ] · a slot left same_as_parent copies @shape.badge.corners
border_style          = none                  # how the ring is stroked · 1, 3, 4 · enum: solid | segmented | brackets | none · a segmented border is rejected on this preset with a warning (5.7)
border_width          = @border.edge.width    # stroke weight of the ring · 1, 3, 4 · str (device px, never panel-scaled) or same_as_parent · @border.edge.width -> @stroke.hair, i.e. the "solid 1x" of 5.18's table
border_color          = @component.badge.edge # colour of the ring · 1, 3, 4 · colour or same_as_parent · -> @border.default -> alpha(@accent.primary, 0.78)
border_alpha          = 1.0                   # alpha multiplier on border_color · 1, 3, 4 · frac, 0..1 · opaque
fill                  = @component.badge.fill # the interior · 1, 3, 4 · colour, none, or same_as_parent · 5.18's table
fill_alpha            = 1.0                   # alpha multiplier on fill · 1, 3, 4 · frac, 0..1 · opaque
fill_to               = @shape.badge.fill     # the far stop of the interior gradient · 1, 3, 4 · colour · == fill, so the fill is flat
fill_angle            = 90deg                 # direction of the interior gradient · 1, 3, 4 · deg, 0..360 · ignored while fill_to == fill
round_segments        = @corner.segments      # arc tessellation of a round corner · 1, 3, 4 · n, 3 .. 16 · @corner.segments = 6, a 0.4px chord error at an 8px radius: invisible, and 6 quads instead of 16
glow                  = @glow.badge_critical  # which glow class this preset's edge wears · 1, 3, 4 · @glow.<class> or none · every glow.*.enabled is false in default, so this reference costs nothing until a theme turns it on
dash                  = @border.edge.dash     # dash length along the ring · 1, 3, 4 · len · @border.edge.dash = 1.6u; used only when border_style = segmented
gap                   = @border.edge.gap      # gap length along the ring · 1, 3, 4 · len · @border.edge.gap = 0.8u; used only when border_style = segmented
phase                 = @border.edge.phase    # where the dash pattern starts on the ring · 1, 3, 4 · len · @border.edge.phase = 0u; used only when border_style = segmented
bracket_len           = @border.edge.bracket_len
                                              # length of each corner bracket · 1, 3, 4 · frac of the SHORTER SIDE of the host rect, clamped [0.8u, 4.0u] · @border.edge.bracket_len = 18%; used only when border_style = brackets
bracket_inset         = @border.edge.bracket_inset
                                              # how far the brackets sit inside the ring · 1, 3, 4 · len · @border.edge.bracket_inset = 0u; used only when border_style = brackets

# ---------------------------------------------------------------- shape.chip
# image 8's DFS / SDN chips
[shape.chip]
corners               = [ round, 0.5u ]       # all four corners of the chip ring · 8 · [ style, len ] · enum: square | round | chamfer | chevron | hexagon · tighter than a badge: a chip is square-ish, a badge is a pill
corners_tl            = [ same_as_parent, same_as_parent ]
                                              # the top-left corner alone · 8 · [ style, len ] · a slot left same_as_parent copies @shape.chip.corners
corners_tr            = [ same_as_parent, same_as_parent ]
                                              # the top-right corner alone · 8 · [ style, len ] · a slot left same_as_parent copies @shape.chip.corners
corners_br            = [ same_as_parent, same_as_parent ]
                                              # the bottom-right corner alone · 8 · [ style, len ] · a slot left same_as_parent copies @shape.chip.corners
corners_bl            = [ same_as_parent, same_as_parent ]
                                              # the bottom-left corner alone · 8 · [ style, len ] · a slot left same_as_parent copies @shape.chip.corners
border_style          = solid                 # how the ring is stroked · 8 · enum: solid | segmented | brackets | none · @border.edge.style; brackets draw only the corners and any preset may wear them (5.7)
border_width          = @border.edge.width    # stroke weight of the ring · 8 · str (device px, never panel-scaled) or same_as_parent · @border.edge.width -> @stroke.hair, i.e. the "solid 1x" of 5.18's table
border_color          = @border.default       # colour of the ring · 8 · colour or same_as_parent · -> @border.default -> alpha(@accent.primary, 0.78)
border_alpha          = 0.6                   # alpha multiplier on border_color · 8 · frac, 0..1 · 5.18's table: the ring reads back from the fill
fill                  = none                  # the interior · 8 · colour, none, or same_as_parent · no fill: a chip is an outline
fill_alpha            = 1.0                   # alpha multiplier on fill · 8 · frac, 0..1 · opaque
fill_to               = @shape.chip.fill      # the far stop of the interior gradient · 8 · colour · == fill, so the fill is flat
fill_angle            = 90deg                 # direction of the interior gradient · 8 · deg, 0..360 · ignored while fill_to == fill
round_segments        = @corner.segments      # arc tessellation of a round corner · 8 · n, 3 .. 16 · @corner.segments = 6, a 0.4px chord error at an 8px radius: invisible, and 6 quads instead of 16
glow                  = none                  # which glow class this preset's edge wears · 8 · @glow.<class> or none · no glow class fits this preset
dash                  = @border.edge.dash     # dash length along the ring · 8 · len · @border.edge.dash = 1.6u; used only when border_style = segmented
gap                   = @border.edge.gap      # gap length along the ring · 8 · len · @border.edge.gap = 0.8u; used only when border_style = segmented
phase                 = @border.edge.phase    # where the dash pattern starts on the ring · 8 · len · @border.edge.phase = 0u; used only when border_style = segmented
bracket_len           = @border.edge.bracket_len
                                              # length of each corner bracket · 8 · frac of the SHORTER SIDE of the host rect, clamped [0.8u, 4.0u] · @border.edge.bracket_len = 18%; used only when border_style = brackets
bracket_inset         = @border.edge.bracket_inset
                                              # how far the brackets sit inside the ring · 8 · len · @border.edge.bracket_inset = 0u; used only when border_style = brackets

# ---------------------------------------------------------------- shape.field
# image 7's search field holding the placeholder `browser`
[shape.field]
corners               = [ round, @corner.sm ] # all four corners of the field ring · 7 · [ style, len ] · enum: square | round | chamfer | chevron | hexagon · the ladder's small step
corners_tl            = [ same_as_parent, same_as_parent ]
                                              # the top-left corner alone · 7 · [ style, len ] · a slot left same_as_parent copies @shape.field.corners
corners_tr            = [ same_as_parent, same_as_parent ]
                                              # the top-right corner alone · 7 · [ style, len ] · a slot left same_as_parent copies @shape.field.corners
corners_br            = [ same_as_parent, same_as_parent ]
                                              # the bottom-right corner alone · 7 · [ style, len ] · a slot left same_as_parent copies @shape.field.corners
corners_bl            = [ same_as_parent, same_as_parent ]
                                              # the bottom-left corner alone · 7 · [ style, len ] · a slot left same_as_parent copies @shape.field.corners
border_style          = solid                 # how the ring is stroked · 7 · enum: solid | segmented | brackets | none · @border.edge.style; brackets draw only the corners and any preset may wear them (5.7)
border_width          = @border.edge.width    # stroke weight of the ring · 7 · str (device px, never panel-scaled) or same_as_parent · @border.edge.width -> @stroke.hair, i.e. the "solid 1x" of 5.18's table
border_color          = @component.field.border
                                              # colour of the ring · 7 · colour or same_as_parent · -> @border.default -> alpha(@accent.primary, 0.78)
border_alpha          = 0.55                  # alpha multiplier on border_color · 7 · frac, 0..1 · 5.18's table: the ring reads back from the fill
fill                  = @surface.sunken       # the interior · 7 · colour, none, or same_as_parent · 5.18's table
fill_alpha            = 1.0                   # alpha multiplier on fill · 7 · frac, 0..1 · opaque
fill_to               = @shape.field.fill     # the far stop of the interior gradient · 7 · colour · == fill, so the fill is flat
fill_angle            = 90deg                 # direction of the interior gradient · 7 · deg, 0..360 · ignored while fill_to == fill
round_segments        = @corner.segments      # arc tessellation of a round corner · 7 · n, 3 .. 16 · @corner.segments = 6, a 0.4px chord error at an 8px radius: invisible, and 6 quads instead of 16
glow                  = @glow.focus_ring      # which glow class this preset's edge wears · 7 · @glow.<class> or none · every glow.*.enabled is false in default, so this reference costs nothing until a theme turns it on
dash                  = @border.edge.dash     # dash length along the ring · 7 · len · @border.edge.dash = 1.6u; used only when border_style = segmented
gap                   = @border.edge.gap      # gap length along the ring · 7 · len · @border.edge.gap = 0.8u; used only when border_style = segmented
phase                 = @border.edge.phase    # where the dash pattern starts on the ring · 7 · len · @border.edge.phase = 0u; used only when border_style = segmented
bracket_len           = @border.edge.bracket_len
                                              # length of each corner bracket · 7 · frac of the SHORTER SIDE of the host rect, clamped [0.8u, 4.0u] · @border.edge.bracket_len = 18%; used only when border_style = brackets
bracket_inset         = @border.edge.bracket_inset
                                              # how far the brackets sit inside the ring · 7 · len · @border.edge.bracket_inset = 0u; used only when border_style = brackets

# ---------------------------------------------------------------- shape.tab
# a terminal session tab
[shape.tab]
corners               = [ chamfer, 1.0u ]     # all four corners of the tab ring · 1, 2 · [ style, len ] · enum: square | round | chamfer | chevron | hexagon · applied to tl and tr only; the bottom corners stay square so the tab meets its strip
corners_tl            = [ same_as_parent, same_as_parent ]
                                              # the top-left corner alone · 1, 2 · [ style, len ] · a slot left same_as_parent copies @shape.tab.corners
corners_tr            = [ same_as_parent, same_as_parent ]
                                              # the top-right corner alone · 1, 2 · [ style, len ] · a slot left same_as_parent copies @shape.tab.corners
corners_br            = [ square, 0u ]        # the bottom-right corner alone · 1, 2 · [ style, len ] · pinned square so the preset is asymmetric on purpose
corners_bl            = [ square, 0u ]        # the bottom-left corner alone · 1, 2 · [ style, len ] · pinned square so the preset is asymmetric on purpose
border_style          = solid                 # how the ring is stroked · 1, 2 · enum: solid | segmented | brackets | none · @border.edge.style; brackets draw only the corners and any preset may wear them (5.7)
border_width          = @border.edge.width    # stroke weight of the ring · 1, 2 · str (device px, never panel-scaled) or same_as_parent · @border.edge.width -> @stroke.hair, i.e. the "solid 1x" of 5.18's table
border_color          = @border.default       # colour of the ring · 1, 2 · colour or same_as_parent · -> @border.default -> alpha(@accent.primary, 0.78)
border_alpha          = 1.0                   # alpha multiplier on border_color · 1, 2 · frac, 0..1 · opaque
fill                  = @surface.raised       # the interior · 1, 2 · colour, none, or same_as_parent · 5.18's table
fill_alpha            = 1.0                   # alpha multiplier on fill · 1, 2 · frac, 0..1 · opaque
fill_to               = @shape.tab.fill       # the far stop of the interior gradient · 1, 2 · colour · == fill, so the fill is flat
fill_angle            = 90deg                 # direction of the interior gradient · 1, 2 · deg, 0..360 · ignored while fill_to == fill
round_segments        = @corner.segments      # arc tessellation of a round corner · 1, 2 · n, 3 .. 16 · @corner.segments = 6, a 0.4px chord error at an 8px radius: invisible, and 6 quads instead of 16
glow                  = none                  # which glow class this preset's edge wears · 1, 2 · @glow.<class> or none · no glow class fits this preset
dash                  = @border.edge.dash     # dash length along the ring · 1, 2 · len · @border.edge.dash = 1.6u; used only when border_style = segmented
gap                   = @border.edge.gap      # gap length along the ring · 1, 2 · len · @border.edge.gap = 0.8u; used only when border_style = segmented
phase                 = @border.edge.phase    # where the dash pattern starts on the ring · 1, 2 · len · @border.edge.phase = 0u; used only when border_style = segmented
bracket_len           = @border.edge.bracket_len
                                              # length of each corner bracket · 1, 2 · frac of the SHORTER SIDE of the host rect, clamped [0.8u, 4.0u] · @border.edge.bracket_len = 18%; used only when border_style = brackets
bracket_inset         = @border.edge.bracket_inset
                                              # how far the brackets sit inside the ring · 1, 2 · len · @border.edge.bracket_inset = 0u; used only when border_style = brackets

# ---------------------------------------------------------------- shape.taskbar
# image 7's taskbar, "a stretched chevron/arrow"
[shape.taskbar]
corners               = [ chevron, 0u ]       # all four corners of the taskbar ring · 7 · [ style, len ] · enum: square | round | chamfer | chevron | hexagon · a shape word, not a corner: the ring generator collapses one or both vertical ends to a point at mid-height. The size term is unused; depth is chevron_depth
corners_tl            = [ same_as_parent, same_as_parent ]
                                              # the top-left corner alone · 7 · [ style, len ] · a slot left same_as_parent copies @shape.taskbar.corners
corners_tr            = [ same_as_parent, same_as_parent ]
                                              # the top-right corner alone · 7 · [ style, len ] · a slot left same_as_parent copies @shape.taskbar.corners
corners_br            = [ same_as_parent, same_as_parent ]
                                              # the bottom-right corner alone · 7 · [ style, len ] · a slot left same_as_parent copies @shape.taskbar.corners
corners_bl            = [ same_as_parent, same_as_parent ]
                                              # the bottom-left corner alone · 7 · [ style, len ] · a slot left same_as_parent copies @shape.taskbar.corners
border_style          = solid                 # how the ring is stroked · 7 · enum: solid | segmented | brackets | none · @border.edge.style; brackets draw only the corners and any preset may wear them (5.7)
border_width          = @border.edge.width    # stroke weight of the ring · 7 · str (device px, never panel-scaled) or same_as_parent · @border.edge.width -> @stroke.hair, i.e. the "solid 1x" of 5.18's table
border_color          = @component.taskbar.border
                                              # colour of the ring · 7 · colour or same_as_parent · -> @border.default -> alpha(@accent.primary, 0.78)
border_alpha          = 1.0                   # alpha multiplier on border_color · 7 · frac, 0..1 · opaque
fill                  = @surface.raised       # the interior · 7 · colour, none, or same_as_parent · 5.18's table
fill_alpha            = 1.0                   # alpha multiplier on fill · 7 · frac, 0..1 · opaque
fill_to               = @shape.taskbar.fill   # the far stop of the interior gradient · 7 · colour · == fill, so the fill is flat
fill_angle            = 90deg                 # direction of the interior gradient · 7 · deg, 0..360 · ignored while fill_to == fill
round_segments        = @corner.segments      # arc tessellation of a round corner · 7 · n, 3 .. 16 · @corner.segments = 6, a 0.4px chord error at an 8px radius: invisible, and 6 quads instead of 16
glow                  = @glow.taskbar_active  # which glow class this preset's edge wears · 7 · @glow.<class> or none · every glow.*.enabled is false in default, so this reference costs nothing until a theme turns it on
dash                  = @border.edge.dash     # dash length along the ring · 7 · len · @border.edge.dash = 1.6u; used only when border_style = segmented
gap                   = @border.edge.gap      # gap length along the ring · 7 · len · @border.edge.gap = 0.8u; used only when border_style = segmented
phase                 = @border.edge.phase    # where the dash pattern starts on the ring · 7 · len · @border.edge.phase = 0u; used only when border_style = segmented
bracket_len           = @border.edge.bracket_len
                                              # length of each corner bracket · 7 · frac of the SHORTER SIDE of the host rect, clamped [0.8u, 4.0u] · @border.edge.bracket_len = 18%; used only when border_style = brackets
bracket_inset         = @border.edge.bracket_inset
                                              # how far the brackets sit inside the ring · 7 · len · @border.edge.bracket_inset = 0u; used only when border_style = brackets

# ---------------------------------------------------------------- shape.hex
# image 1's five gradient hexagons, image 3's solid ones
[shape.hex]
corners               = [ hexagon, 0u ]       # all four corners of the hex ring · 1, 3 · [ style, len ] · enum: square | round | chamfer | chevron | hexagon · a shape word, not a corner: a 6-triangle fan whose orientation is shape.hex.orientation
corners_tl            = [ same_as_parent, same_as_parent ]
                                              # the top-left corner alone · 1, 3 · [ style, len ] · a slot left same_as_parent copies @shape.hex.corners
corners_tr            = [ same_as_parent, same_as_parent ]
                                              # the top-right corner alone · 1, 3 · [ style, len ] · a slot left same_as_parent copies @shape.hex.corners
corners_br            = [ same_as_parent, same_as_parent ]
                                              # the bottom-right corner alone · 1, 3 · [ style, len ] · a slot left same_as_parent copies @shape.hex.corners
corners_bl            = [ same_as_parent, same_as_parent ]
                                              # the bottom-left corner alone · 1, 3 · [ style, len ] · a slot left same_as_parent copies @shape.hex.corners
border_style          = solid                 # how the ring is stroked · 1, 3 · enum: solid | segmented | brackets | none · @border.edge.style; brackets draw only the corners and any preset may wear them (5.7)
border_width          = @border.edge.width    # stroke weight of the ring · 1, 3 · str (device px, never panel-scaled) or same_as_parent · @border.edge.width -> @stroke.hair, i.e. the "solid 1x" of 5.18's table
border_color          = @component.hexcell.border
                                              # colour of the ring · 1, 3 · colour or same_as_parent · -> @border.default -> alpha(@accent.primary, 0.78)
border_alpha          = 1.0                   # alpha multiplier on border_color · 1, 3 · frac, 0..1 · opaque
fill                  = @ornament.hex.fill    # the interior · 1, 3 · colour, none, or same_as_parent · 5.18's table
fill_alpha            = 1.0                   # alpha multiplier on fill · 1, 3 · frac, 0..1 · opaque
fill_to               = @ornament.hex.fill_to # the far stop of the interior gradient · 1, 3 · colour · differs from fill, so the fan is drawn with per-vertex colour - the gradient itself is free
fill_angle            = @ornament.hex.fill_angle
                                              # direction of the interior gradient · 1, 3 · deg, 0..360 · vertical, image 1's hexagons
round_segments        = @corner.segments      # arc tessellation of a round corner · 1, 3 · n, 3 .. 16 · @corner.segments = 6, a 0.4px chord error at an 8px radius: invisible, and 6 quads instead of 16
glow                  = @glow.hexagon         # which glow class this preset's edge wears · 1, 3 · @glow.<class> or none · every glow.*.enabled is false in default, so this reference costs nothing until a theme turns it on
dash                  = @border.edge.dash     # dash length along the ring · 1, 3 · len · @border.edge.dash = 1.6u; used only when border_style = segmented
gap                   = @border.edge.gap      # gap length along the ring · 1, 3 · len · @border.edge.gap = 0.8u; used only when border_style = segmented
phase                 = @border.edge.phase    # where the dash pattern starts on the ring · 1, 3 · len · @border.edge.phase = 0u; used only when border_style = segmented
bracket_len           = @border.edge.bracket_len
                                              # length of each corner bracket · 1, 3 · frac of the SHORTER SIDE of the host rect, clamped [0.8u, 4.0u] · @border.edge.bracket_len = 18%; used only when border_style = brackets
bracket_inset         = @border.edge.bracket_inset
                                              # how far the brackets sit inside the ring · 1, 3 · len · @border.edge.bracket_inset = 0u; used only when border_style = brackets

# ---------------------------------------------------------------- shape.tile
# a launcher tile: FILES, CPU, STAR MAP
[shape.tile]
corners               = [ round, @corner.md ] # all four corners of the tile ring · 1 · [ style, len ] · enum: square | round | chamfer | chevron | hexagon · the same radius as a panel; a tile is a small panel
