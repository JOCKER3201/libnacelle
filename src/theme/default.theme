                                              # the bottom-right corner alone · 3 · [ style, len ] · a slot left same_as_parent copies @shape.key.corners
corners_bl            = [ same_as_parent, same_as_parent ]
                                              # the bottom-left corner alone · 3 · [ style, len ] · a slot left same_as_parent copies @shape.key.corners
